---
// BO monogram, v3: no ornament at all — two letters drawn as one even,
// unbroken line each, the way a pen would write them quickly and lightly:
// the B a slanted stem with two open bowls (the lower one never closes back
// onto the stem), the O an open, tilted loop beside it. Apart, never
// touching. A single round tube in black chrome. Not linked yet.
export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>BO monogram v3</title>
    <style>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #f4f4f2;
        overflow: hidden;
      }
      canvas {
        display: block;
        width: 100vw;
        height: 100vh;
      }
      .tag {
        position: fixed;
        left: 24px;
        bottom: 20px;
        font: 13px/1.3 system-ui, sans-serif;
        color: #888;
      }
    </style>
  </head>
  <body>
    <canvas data-logo></canvas>
    <p class="tag">BO monogram v3 · move the pointer</p>
    <script>
      import * as THREE from 'three';
      import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-logo]')!;
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 1.25;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 0, 9);
      const key = new THREE.DirectionalLight(0xffffff, 2.4);
      key.position.set(-3, 4, 6);
      scene.add(key);

      const mat = new THREE.MeshPhysicalMaterial({ color: 0x16161a, roughness: 0.18, metalness: 1, clearcoat: 1, clearcoatRoughness: 0.05 });

      // a path of cubic segments [p0, c1, c2, p1] (x, y), turned into a tube
      type P = [number, number];
      const V = (p: P, z = 0) => new THREE.Vector3(p[0], p[1], z);
      const stroke = (segs: [P, P, P, P][], r = 0.055) => {
        const path = new THREE.CurvePath<THREE.Vector3>();
        segs.forEach(([a, b, c, d]) => path.add(new THREE.CubicBezierCurve3(V(a), V(b), V(c), V(d))));
        const tube = new THREE.TubeGeometry(path, 400, r, 20, false);
        const mesh = new THREE.Mesh(tube, mat);
        // round caps
        const cap = new THREE.SphereGeometry(r, 20, 14);
        const a = new THREE.Mesh(cap, mat);
        a.position.copy(path.getPoint(0));
        const z = new THREE.Mesh(cap, mat);
        z.position.copy(path.getPoint(1));
        const g = new THREE.Group();
        g.add(mesh, a, z);
        return g;
      };
      // everything leans like quick handwriting
      const lean = (p: P): P => [p[0] + p[1] * 0.22, p[1]];
      const seg = (...pts: P[]) => pts.map(lean) as [P, P, P, P];

      // B: up the stem, round the small upper bowl back to the waist, then a
      // larger lower bowl that sweeps out and stops short of the stem
      const B = stroke([
        seg([0, -1.1], [0, -0.4], [0, 0.4], [0, 1.1]),
        seg([0, 1.1], [0.95, 1.15], [1.0, 0.18], [0.12, 0.12]),
        seg([0.12, 0.12], [1.35, 0.1], [1.35, -1.12], [0.32, -1.05]),
      ]);
      // O: one tilted loop that doesn't quite close
      const O = stroke([
        seg([1.0, 0.55], [0.6, 1.05], [-0.55, 0.85], [-0.6, -0.15]),
        seg([-0.6, -0.15], [-0.62, -1.15], [0.62, -1.25], [0.9, -0.35]),
        seg([0.9, -0.35], [1.02, 0.0], [0.98, 0.2], [0.86, 0.34]),
      ]);
      B.position.set(-1.15, 0.12, 0.05);
      O.position.set(1.25, -0.18, -0.05);
      O.scale.setScalar(0.92);
      const logo = new THREE.Group();
      logo.add(B, O);
      scene.add(logo);

      const resize = () => {
        renderer.setSize(innerWidth, innerHeight, false);
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        camera.position.z = innerWidth < innerHeight ? 14 : 9;
      };
      addEventListener('resize', resize);
      resize();
      let px = 0, py = 0, rx = 0, ry = 0;
      addEventListener('pointermove', (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
      });
      const t0 = performance.now();
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tick = () => {
        const t = (performance.now() - t0) / 1000;
        const idle = calm ? 0 : Math.sin(t * 0.45) * 0.35;
        ry += (idle + px * 0.5 - ry) * 0.05;
        rx += (py * 0.3 - rx) * 0.05;
        logo.rotation.set(rx, ry, 0);
        logo.position.y = calm ? 0 : Math.sin(t * 0.8) * 0.05;
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      };
      tick();
    </script>
  </body>
</html>
