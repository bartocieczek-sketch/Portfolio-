---
// Draft: a quiet, Swiss info page (after the reference screenshot), mixed with
// the playful bits of domgola.pl/about (numbers, numbered services) and
// jordangilroy.com#info (a little stack of personal pictures). One light
// screen: the statement top-left (grey frame, black substance), the B mark
// and label/list columns on the right, a rotated live status and a fanning
// photo stack bottom-left; below it, numbered services. Content from Sanity.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { ABOUT_QUERY, HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';
import glyphs from '../lib/monogram-b.json';

const [settings, about, home] = await Promise.all([
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, ABOUT_QUERY),
  load(Astro.locals, HOME_QUERY),
]);
if (!settings || !about) return new Response('Content not found', { status: 500 });

const yy = (s: string) => {
  const m = s.match(/(\d{4})\D+(\d{4}|present)/i);
  if (!m) return '';
  const a = `’${m[1].slice(2)}`;
  return /present/i.test(m[2]) ? `${a}–now` : `${a}–’${m[2].slice(2)}`;
};
const title = (s: string) => s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase()).replace(/\bUi\b/g, 'UI').replace(/\bUx\b/g, 'UX');
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const jobs = ((about.experience ?? []) as any[]).map((e) => ({
  line: `${title(e.role ?? '')}, ${e.company}`,
  when: yy(e.period ?? ''),
}));
const nice = (f: string) => {
  const s = f.toLowerCase().replace(/\b(ux|ui|ai)\b/g, (m) => m.toUpperCase());
  return s.replace(/(^|\s)(\w)/g, (_m, a, b) => a + b.toUpperCase()).replace('Nocode', 'No-code');
};
const focus: string[] = (about.focus ?? []).map(nice);
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = ((home?.projects ?? []) as any[]).filter(Boolean);
const work = projects.map((p) => ({ name: (p.cardTitle || p.title) as string, year: p.year as string, to: href(Astro.locals, `/${p.slug}`) }));
const stack = [
  about.portrait?.asset ? urlFor(about.portrait).width(600).height(720).fit('crop').url() : null,
  ...projects.filter((p) => p.cover?.asset).slice(0, 2).map((p) => urlFor(p.cover).width(600).height(720).fit('crop').url()),
].filter(Boolean) as string[];
const firstYear = Math.min(...((about.experience ?? []) as { period?: string }[]).map((e) => Number(e.period?.match(/\d{4}/)?.[0] ?? 9999)));
const years = Number.isFinite(firstYear) ? new Date().getFullYear() - firstYear : 7;
const [bPath, bBox] = glyphs.g.B as [string, number[], number];
const bView = `${bBox[0]} ${-bBox[3]} ${bBox[2] - bBox[0]} ${bBox[3] - bBox[1]}`;
// one line per service (draft copy)
const blurbs: Record<string, string> = {
  'UX/UI Design': 'Interfaces that feel obvious — researched, systemised and polished to the last state.',
  'No-code Development': 'Production sites shipped fast, with a CMS your team can actually run.',
  'Game Design': 'Loops, feedback and delight — borrowed from games, used to make products stick.',
  'Design Systems': 'Tokens, components and rules that keep a growing product consistent.',
  'AI In Design': 'AI in the workflow, not in the look: faster exploration, sharper decisions.',
};
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="a5" data-a5>
    <header class="a5__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <section class="a5__screen">
      <!-- statement: the frame in grey, the substance in black -->
      <h1 class="a5__lead" data-in>
        <span class="g">Bart Ocieczek is a</span>{' '}design engineer{' '}<span class="g">from Warsaw, working across</span>{' '}AI-driven
        web experiences, UX/UI design{' '}<span class="g">and</span>{' '}no-code development.
      </h1>

      <!-- right: the mark and the lists -->
      <aside class="a5__info">
        <svg class="a5__mark" viewBox={bView} aria-label="B" role="img" data-mark><path transform="scale(1,-1)" d={bPath} fill="currentColor" /></svg>

        <dl class="a5__list" data-in>
          <dt>Experience</dt>
          {jobs.map((j) => (
            <dd><span>{j.line}</span><em>({j.when})</em></dd>
          ))}
        </dl>

        <dl class="a5__list" data-in>
          <dt>Services</dt>
          {focus.map((f) => <dd><span>{f}</span></dd>)}
        </dl>

        <dl class="a5__list a5__list--two" data-in>
          <dt>Selected work</dt>
          {work.map((w) => (
            <dd><a href={w.to}>{w.name}</a><em>{w.year}</em></dd>
          ))}
        </dl>

        <dl class="a5__list a5__list--two" data-in>
          <dt>Imprint</dt>
          <dd><span>Font</span><em>Neue Montreal by Pangram Pangram</em></dd>
          <dd><span>Design</span><em>Bart Ocieczek</em></dd>
          <dd><span>Development</span><em>Bart Ocieczek</em></dd>
        </dl>
      </aside>

      <!-- bottom-left: a rotated live status and a stack of pictures -->
      <div class="a5__corner">
        <p class="a5__status" data-in>
          <span data-clock>Warsaw</span><br />
          Open for new work,<br />except training at 18:00
        </p>
        <button class="a5__stack" type="button" aria-label="Shuffle the pictures" data-stack>
          {stack.map((src, i) => <img src={src} alt="" width="600" height="720" style={`--i:${i}`} />)}
        </button>
      </div>
    </section>

    <!-- below: numbers + numbered services -->
    <section class="a5__more">
      <div class="a5__nums" data-in>
        <p><strong data-count={years}>0</strong>+<em>years designing</em></p>
        <p><strong data-count={projects.length}>0</strong><em>selected projects</em></p>
        <p><strong data-count={jobs.length}>0</strong><em>teams, studios & juries</em></p>
      </div>
      <ol class="a5__services">
        {focus.map((f, i) => (
          <li data-in>
            <span class="a5__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{f}</h3>
            <p>{blurbs[f] ?? ''}</p>
          </li>
        ))}
      </ol>
      <a class="a5__cta" href={settings.callUrl ?? '#'} target="_blank" rel="noopener" data-in>
        <span class="g">{about.ctaText?.split('?')[0]}?</span> Let’s talk ↗
      </a>
    </section>
  </main>
</Base>

<style>
  .a5 {
    --e-out: cubic-bezier(0.23, 1, 0.32, 1);
    --e-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ink: rgb(17, 17, 17);
    --grey: rgb(140, 140, 140);
    --rule: rgba(17, 17, 17, 0.1);
    --pad: clamp(20px, 2.8vw, 40px);
    background: #fff;
    color: var(--ink);
  }
  .a5__nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    padding: var(--gutter);
  }
  .g {
    color: var(--grey);
  }

  /* ---------- the one screen ---------- */
  .a5__screen {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 34vw);
    grid-template-rows: auto 1fr;
    gap: 40px var(--pad);
    min-height: 100svh;
    padding: clamp(110px, 14vh, 150px) var(--pad) var(--pad);
    box-sizing: border-box;
  }
  .a5__lead {
    grid-column: 1;
    grid-row: 1;
    max-width: 22em;
    margin: 0;
    font: 500 clamp(24px, 2.4vw, 40px) / 1.1 var(--font-head);
    letter-spacing: -0.035em;
  }

  .a5__info {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 5vh, 56px);
    font: 500 clamp(15px, 1.15vw, 19px) / 1.3 var(--font-head);
    letter-spacing: -0.02em;
  }
  /* the mark: turns over once when you hover it (a coin flip) */
  .a5__mark {
    width: 54px;
    height: auto;
    margin-bottom: clamp(20px, 10vh, 120px);
    transition: transform 0.7s var(--e-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .a5__mark:hover {
      transform: perspective(300px) rotateY(360deg);
    }
  }
  .a5__list {
    margin: 0;
  }
  .a5__list dt {
    margin-bottom: 10px;
    font-size: 13px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--grey);
  }
  .a5__list dd {
    display: flex;
    gap: 0.4em;
    margin: 0;
    padding: 1px 0;
  }
  .a5__list em {
    font-style: normal;
    color: var(--grey);
    font-variant-numeric: tabular-nums;
  }
  .a5__list--two dd {
    display: grid;
    grid-template-columns: minmax(0, 11em) minmax(0, 1fr);
  }
  .a5__list--two em {
    color: var(--ink);
  }
  .a5__list a {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 0.35s var(--e-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .a5__list a:hover {
      background-size: 100% 1px;
    }
  }

  .a5__corner {
    grid-column: 1;
    grid-row: 2;
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }
  /* rotated, reading bottom-to-top like a spine label */
  .a5__status {
    margin: 0;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font: 500 15px/1.2 var(--font-head);
    letter-spacing: -0.02em;
  }
  /* the picture stack: fans out on hover, a click sends the top one to the back */
  .a5__stack {
    position: relative;
    width: clamp(180px, 17vw, 260px);
    aspect-ratio: 5 / 6;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .a5__stack img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #eee;
    filter: grayscale(1) blur(var(--blur, 0px));
    z-index: calc(10 - var(--o, var(--i)));
    transform: translate(calc(var(--o, var(--i)) * 6px), calc(var(--o, var(--i)) * -6px)) rotate(calc(var(--o, var(--i)) * 2deg));
    transition:
      transform 0.55s var(--e-out),
      filter 0.5s var(--e-out);
  }
  .a5__stack img:first-child {
    --blur: 3px;
  }
  @media (hover: hover) and (pointer: fine) {
    .a5__stack:hover img {
      --blur: 0px;
      filter: grayscale(0);
      transform: translate(calc(var(--o, var(--i)) * 58%), 0) rotate(calc(var(--o, var(--i)) * 4deg));
    }
  }
  .a5__stack:active {
    scale: 0.98;
  }

  /* ---------- below the screen ---------- */
  .a5__more {
    padding: clamp(80px, 14vh, 160px) var(--pad) clamp(60px, 10vh, 120px);
    border-top: 1px solid var(--rule);
  }
  .a5__nums {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--pad);
    margin-bottom: clamp(60px, 12vh, 140px);
  }
  .a5__nums p {
    margin: 0;
    font: 500 clamp(56px, 8vw, 140px) / 0.85 var(--font-head);
    letter-spacing: -0.06em;
  }
  .a5__nums strong {
    font-weight: inherit;
    font-variant-numeric: tabular-nums;
  }
  .a5__nums em {
    display: block;
    margin-top: 14px;
    font: 500 14px/1.2 var(--font-head);
    letter-spacing: -0.01em;
    font-style: normal;
    color: var(--grey);
  }
  .a5__services {
    list-style: none;
    margin: 0 0 clamp(60px, 12vh, 140px);
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .a5__services li {
    display: grid;
    grid-template-columns: 60px minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--pad);
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--rule);
  }
  .a5__n {
    font: 500 13px/1 var(--font-head);
    color: var(--grey);
  }
  .a5__services h3 {
    margin: 0;
    font: 500 clamp(26px, 3vw, 48px) / 1 var(--font-head);
    letter-spacing: -0.045em;
  }
  .a5__services p {
    margin: 0;
    max-width: 34ch;
    font: 500 clamp(15px, 1.15vw, 19px) / 1.3 var(--font-head);
    letter-spacing: -0.02em;
    color: var(--grey);
  }
  .a5__cta {
    display: block;
    max-width: 18em;
    color: var(--ink);
    text-decoration: none;
    font: 500 clamp(28px, 3.4vw, 56px) / 1.05 var(--font-head);
    letter-spacing: -0.045em;
  }
  @media (hover: hover) and (pointer: fine) {
    .a5__cta:hover .g {
      color: var(--ink);
    }
    .a5__cta .g {
      transition: color 0.3s ease;
    }
  }

  /* reveals: rise + fade, staggered among siblings */
  [data-in] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.8s var(--e-out),
      transform 1s var(--e-expo);
    transition-delay: var(--d, 0s);
  }
  [data-in].is-in {
    opacity: 1;
    transform: none;
  }
  .a5__status[data-in] {
    transform: rotate(180deg) translateY(-12px);
  }
  .a5__status[data-in].is-in {
    transform: rotate(180deg);
  }

  @media (max-width: 809px) {
    .a5__screen {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      padding-top: 96px;
    }
    .a5__info,
    .a5__corner,
    .a5__lead {
      grid-column: 1;
      grid-row: auto;
    }
    .a5__mark {
      margin-bottom: 0;
    }
    .a5__corner {
      flex-direction: row;
      align-items: flex-end;
    }
    .a5__nums {
      grid-template-columns: 1fr;
    }
    .a5__services li {
      grid-template-columns: 36px 1fr;
    }
    .a5__services p {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-in] {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-a5]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // reveal once, staggered among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
          e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(count);
        }),
      { rootMargin: '0px 0px -8% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-in]').forEach((el) => {
      const sib = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-in'));
      el.style.setProperty('--d', `${120 + Math.max(0, sib.indexOf(el)) * 70}ms`);
      io.observe(el);
    });

    const count = (el: HTMLElement) => {
      const to = Number(el.dataset.count);
      if (calm) return void (el.textContent = String(to));
      const t0 = performance.now();
      const step = () => {
        const p = Math.min(1, (performance.now() - t0) / 1100);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    // live Warsaw time in the rotated label
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const tick = () => {
      if (!clock) return;
      const t = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(new Date());
      clock.textContent = `Warsaw, ${t}`;
    };
    tick();
    setInterval(tick, 20000);

    // picture stack: a click sends the top picture to the back
    const stack = root.querySelector<HTMLElement>('[data-stack]');
    if (stack) {
      const imgs = [...stack.querySelectorAll<HTMLElement>('img')];
      let order = imgs.map((_, i) => i);
      stack.addEventListener('click', () => {
        order = [...order.slice(1), order[0]];
        order.forEach((o, k) => imgs[o].style.setProperty('--o', String(k)));
      });
    }
  }
</script>
