---
// Explorations: an endless field to wander through. The case study covers
// from home sit in it among loose shots (explorations, side work, details).
// Drag or scroll in any direction; the field bends like it sits under a
// lens (tiles toward the edges shrink, turn and blur). Click one to bring it
// up close. The nav stays (it holds still through the flight from home).
// Coming from home through "Explorations", the covers on screen fly out of
// the column into their tiles (a cross-document view transition, names set
// in Hero.astro and in the inline script below) while the shots around them
// fly in and settle. Any other way in, the whole field flies in.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { EXPLORE_QUERY, HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const [explore, home, settings] = await Promise.all([
  load(Astro.locals, EXPLORE_QUERY),
  load(Astro.locals, HOME_QUERY),
  load(Astro.locals, SETTINGS_QUERY),
]);
if (!settings) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
type Img = any;
type Item = { src: string; big: string; a: number; slug: string };

// the covers, cut like the column's (4:5)
const covers: Item[] = ((home?.projects ?? []) as Img[])
  .filter((p) => p?.cover?.asset && p.slug)
  .map((p) => ({
    slug: p.slug as string,
    src: urlFor(p.cover).width(800).height(1000).fit('crop').quality(80).url(),
    big: urlFor(p.cover).width(1600).height(2000).fit('crop').quality(85).url(),
    a: 0.8,
  }));

const chosen: Img[] = (explore?.shots ?? []).filter((i: Img) => i?.asset);
// nothing chosen yet: pictures from every case study gallery
const pool0: Img[] = chosen.length
  ? chosen
  : ((explore?.gallery ?? []) as { gallery?: { kind?: string; image?: Img; poster?: Img }[] }[])
      .flatMap((p) => p.gallery ?? [])
      .map((g) => (g.kind === 'video' ? g.poster : g.image))
      .filter((i) => i?.asset && !String(i.asset.mimeType ?? '').includes('gif'));
// a steady shuffle, so neighbours rarely come from the same project
const shots: Item[] = pool0
  .map((img, i) => ({ img, k: Math.sin(i * 12.9898 + 78.233) * 43758.5453 }))
  .map((x) => ({ ...x, k: x.k - Math.floor(x.k) }))
  .sort((a, b) => a.k - b.k)
  .map(({ img }) => {
    const d = img.asset?.metadata?.dimensions;
    return {
      slug: '',
      src: urlFor(img).width(1000).fit('max').quality(80).url(),
      big: urlFor(img).width(2000).fit('max').quality(85).url(),
      a: d?.aspectRatio ?? (d?.width && d?.height ? d.width / d.height : 4 / 3),
    };
  });

// Cell (c, r) shows item (c + r*K) mod n. The covers go where column 0 meets
// rows 0, 1, 2…, so they stand in the field in the same order, one above
// the other, as in the home column; the shots fill every other slot.
const n = covers.length + shots.length;
const m = covers.length;
const gcd = (a: number, b: number): number => (b ? gcd(b, a % b) : a);
const K = n > 6 ? ([3, 4, 5, 7, 8, 9, 11].find((k) => gcd(k, n) === 1) ?? 1) : 1;
const mod = (a: number, b: number) => ((a % b) + b) % b;
const items: Item[] = new Array(n);
covers.forEach((c, r) => (items[mod(r * K, n)] = c));
let si = 0;
for (let i = 0; i < n; i++) if (!items[i]) items[i] = shots[si++];

// the pool of tiles recycled as the field moves
const PC = 7;
const PR = 7;
const c0 = Math.floor(-PC / 2);
const r0 = Math.floor(-PR / 2);
const pool: { c: number; r: number; p: number }[] = [];
for (let b = 0; b < PR; b++)
  for (let a = 0; a < PC; a++) {
    const c = c0 + mod(a - c0, PC);
    const r = r0 + mod(b - r0, PR);
    pool.push({ c, r, p: n ? mod(c + r * K, n) : 0 });
  }
const cfg = { K, PC, PR, rowOf: Object.fromEntries(covers.map((c, r) => [c.slug, r])) };
---

<Base title={`Explorations · ${settings.seoTitle ?? 'Bart Ocieczek'}`} description={settings.seoDescription}>
  {/* the first frame waits for the inline script, so the covers land on the right tiles */}
  <link slot="head" rel="expect" href="#wk-ready" blocking="render" />
  <main class="wk" data-work>
    <h1 class="wk__sr">Explorations</h1>
    <header class="wk__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>
    <div class="wk__field" data-wk-field data-lenis-prevent>
      {n > 0 && pool.map((s) => (
        <div class="wk__cell" style={`--c:${s.c};--r:${s.r};--a:${items[s.p].a.toFixed(4)}`}>
          <img class="wk__img" src={items[s.p].src} alt="" decoding="async" loading="eager" draggable="false" data-p={s.p} />
        </div>
      ))}
    </div>
    <div class="wk__dim" data-wk-dim aria-hidden="true"></div>

    <footer class="wk__foot">
      <span class="t-label wk__hint">Drag to explore</span>
      <a class="wk__x" href={href(Astro.locals, '/')} aria-label="Close, back home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
    </footer>
  </main>
  <script type="application/json" id="wk-data" set:html={JSON.stringify({ items, ...cfg })} />
  <script is:inline>
    (function () {
      var main = document.querySelector('.wk');
      var field = document.querySelector('[data-wk-field]');
      var dim = document.querySelector('[data-wk-dim]');
      var cfg = JSON.parse(document.getElementById('wk-data').textContent || '{}');
      var data = cfg.items || [];
      if (!main || !field || !dim || !data.length) return;
      var n = data.length, K = cfg.K, PC = cfg.PC, PR = cfg.PR;
      var mod = function (a, b) { return ((a % b) + b) % b; };
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var cells = Array.prototype.map.call(field.querySelectorAll('.wk__cell'), function (el, i) {
        var img = el.querySelector('img');
        return { el: el, img: img, a: i % PC, b: Math.floor(i / PC), p: Number(img.dataset.p), sx: 0, sy: 0 };
      });

      var cw = 0, ch = 0, vw = 0, vh = 0, TW = 0, TH = 0, TR = 0;
      var measure = function () {
        var probe = document.createElement('div');
        probe.style.cssText = 'position:absolute;visibility:hidden;width:var(--cw);height:var(--ch)';
        field.appendChild(probe);
        cw = probe.offsetWidth;
        ch = probe.offsetHeight;
        probe.style.cssText = 'position:absolute;visibility:hidden;width:var(--w);height:var(--h);border-radius:var(--rad)';
        TW = probe.offsetWidth;
        TH = probe.offsetHeight;
        TR = parseFloat(getComputedStyle(probe).borderTopLeftRadius) || 0;
        probe.remove();
        vw = field.clientWidth;
        vh = field.clientHeight;
      };
      measure();

      // camera: where the centre of the screen sits in the field
      var x = 0, y = 0, tx = 0, ty = 0, speed = 0, mdx = 0, mdy = 1;
      // for the edge lens (see the module script below): how fast, which way
      window.__wkMotion = function () {
        return { speed: Math.min(speed / 2600, 1), dx: mdx, dy: mdy };
      };

      // from home: centre the field on the cover that was in the middle of
      // the column (its neighbours then sit above and below it, as there)
      var from = null;
      try {
        from = JSON.parse(sessionStorage.getItem('vt-work') || 'null');
        sessionStorage.removeItem('vt-work');
      } catch (e) {}
      if (from && from.mid in cfg.rowOf && 'startViewTransition' in document) {
        document.documentElement.classList.add('wk-flown');
        y = ty = cfg.rowOf[from.mid] * ch;
      } else from = null;

      var named = [];
      var clearNames = function () {
        named.forEach(function (k) {
          k.img.style.removeProperty('view-transition-name');
          k.img.style.removeProperty('view-transition-class');
        });
        named = [];
      };

      var render = function () {
        var c0 = Math.floor(x / cw - PC / 2);
        var r0 = Math.floor(y / ch - PR / 2);
        var z = 1 - Math.min(speed / 4000, 1) * 0.05; // the field eases back a touch while it flies
        for (var i = 0; i < cells.length; i++) {
          var k = cells[i];
          var c = c0 + mod(k.a - c0, PC);
          var r = r0 + mod(k.b - r0, PR);
          var p = mod(c + r * K, n);
          if (p !== k.p) {
            if (named.length) clearNames();
            k.p = p;
            k.img.src = data[p].src;
            k.img.dataset.p = String(p);
            k.el.style.setProperty('--a', String(data[p].a));
          }
          var sx = (c * cw - x) * z;
          var sy = (r * ch - y) * z;
          var pull = 1;
          var s = z;
          k.s = s;
          k.sx = sx * pull;
          k.sy = sy * pull;
          k.el.style.transform = 'translate3d(' + k.sx.toFixed(1) + 'px,' + k.sy.toFixed(1) + 'px,0) scale(' + s.toFixed(4) + ')';
        }
      };
      render();

      // the covers that were on screen at home: each one's tile nearest the
      // middle takes its name; every other tile flies in from further out,
      // the nearest first
      if (from) {
        (from.slugs || []).forEach(function (slug) {
          var best = null, bd = Infinity;
          cells.forEach(function (k) {
            if (data[k.p].slug !== slug) return;
            var d = Math.abs(k.sx) + Math.abs(k.sy);
            if (d < bd) { bd = d; best = k; }
          });
          if (!best || bd > vw + vh) return;
          best.img.style.setProperty('view-transition-name', 'x-' + slug);
          best.img.style.setProperty('view-transition-class', 'xcov');
          best.el.classList.add('is-named');
          named.push(best);
        });
      }
      cells.forEach(function (k) {
        var d = Math.hypot(k.sx / (vw * 0.5), k.sy / (vh * 0.5));
        k.el.style.setProperty('--fx', (k.sx * 0.7).toFixed(0) + 'px');
        k.el.style.setProperty('--fy', (k.sy * 0.7).toFixed(0) + 'px');
        k.el.style.setProperty('--dl', ((from ? 0.38 : 0.08) + Math.min(d, 2.4) * 0.11).toFixed(3) + 's');
      });
      // the names only matter for the flight in; recycled tiles must never share one
      setTimeout(clearNames, 2000);

      // warm every picture once, so recycled tiles never show an empty frame
      var warm = function () {
        data.forEach(function (d) {
          var i = new Image();
          i.decoding = 'async';
          i.src = d.src;
        });
      };
      if (document.readyState === 'complete') warm();
      else addEventListener('load', warm);

      var last = performance.now();
      var raf = 0;
      var dragging = false;
      var tick = function (now) {
        var dt = Math.min(now - last, 64);
        last = now;
        var f = 1 - Math.exp(-dt / (dragging ? 40 : 130));
        var px = x, py = y;
        x += (tx - x) * f;
        y += (ty - y) * f;
        var v = (Math.hypot(x - px, y - py) / Math.max(dt, 1)) * 1000;
        if (v > 30) {
          mdx += (-(x - px) / (Math.hypot(x - px, y - py) || 1) - mdx) * 0.2;
          mdy += (-(y - py) / (Math.hypot(x - px, y - py) || 1) - mdy) * 0.2;
        }
        speed += (v - speed) * (1 - Math.exp(-dt / 120));
        render();
        if (dragging || Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || speed > 2) raf = requestAnimationFrame(tick);
        else {
          speed = 0;
          render();
          raf = 0;
        }
      };
      var wake = function () {
        if (!raf) {
          last = performance.now();
          raf = requestAnimationFrame(tick);
        }
      };

      // ---------- close-up ----------
      var zoom = null;
      var EASE = 'cubic-bezier(0.77, 0, 0.175, 1)';
      var open = function (src) {
        if (zoom) return;
        var d = data[Number(src.dataset.p)];
        var r0 = src.getBoundingClientRect();
        var rad = parseFloat(getComputedStyle(src).borderTopLeftRadius) || 0;
        var maxW = vw * (vw < 810 ? 0.92 : 0.78);
        var maxH = vh * 0.78;
        var w = Math.min(maxW, maxH * d.a);
        var h = w / d.a;
        var L = (vw - w) / 2, T = (vh - h) / 2;
        var R = Math.max(rad * 1.6, 18);
        var img = document.createElement('img');
        img.className = 'wk__zoom';
        img.alt = '';
        img.src = src.currentSrc || src.src;
        img.style.width = w + 'px';
        img.style.height = h + 'px';
        main.appendChild(img);
        // swap in the sharp one once it has loaded
        var hi = new Image();
        hi.onload = function () {
          if (zoom && zoom.img === img) img.src = d.big;
        };
        hi.src = d.big;
        src.style.visibility = 'hidden';
        main.classList.add('is-zoom');
        var sx = r0.width / w, sy = r0.height / h;
        img.animate(
          [
            { transform: 'translate(' + r0.left + 'px,' + r0.top + 'px) scale(' + sx + ',' + sy + ')', borderRadius: rad / sx + 'px / ' + rad / sy + 'px' },
            { transform: 'translate(' + L + 'px,' + T + 'px) scale(1,1)', borderRadius: R + 'px' },
          ],
          { duration: reduce ? 1 : 750, easing: EASE, fill: 'both' },
        );
        zoom = { img: img, src: src };
      };
      var close = function () {
        if (!zoom) return;
        var img = zoom.img, src = zoom.src;
        zoom = null;
        main.classList.remove('is-zoom');
        var now = img.getBoundingClientRect();
        var back = src.getBoundingClientRect();
        var w = img.offsetWidth, h = img.offsetHeight;
        var rad = parseFloat(getComputedStyle(src).borderTopLeftRadius) || 0;
        var cur = getComputedStyle(img).borderRadius;
        img.getAnimations().forEach(function (a) { a.cancel(); });
        var sx = back.width / w, sy = back.height / h;
        var a = img.animate(
          [
            { transform: 'translate(' + now.left + 'px,' + now.top + 'px) scale(' + now.width / w + ',' + now.height / h + ')', borderRadius: cur },
            { transform: 'translate(' + back.left + 'px,' + back.top + 'px) scale(' + sx + ',' + sy + ')', borderRadius: rad / sx + 'px / ' + rad / sy + 'px' },
          ],
          { duration: reduce ? 1 : 650, easing: EASE, fill: 'both' },
        );
        a.finished.then(function () {
          src.style.visibility = '';
          img.remove();
        });
      };
      dim.addEventListener('click', close);
      main.addEventListener('click', function (e) {
        if (e.target.classList.contains('wk__zoom')) close();
      });

      // ---------- drag, with a flick that keeps going ----------
      var moved = 0, lx = 0, ly = 0, lt = 0, vx = 0, vy = 0, pid = -1;
      field.addEventListener('pointerdown', function (e) {
        if (e.button !== 0 || pid !== -1 || zoom) return;
        pid = e.pointerId;
        dragging = true;
        moved = 0;
        lx = e.clientX;
        ly = e.clientY;
        lt = performance.now();
        vx = vy = 0;
        wake();
      });
      addEventListener('pointermove', function (e) {
        if (e.pointerId !== pid) return;
        var dx = e.clientX - lx, dy = e.clientY - ly;
        var now = performance.now();
        var dt = Math.max(now - lt, 1);
        lx = e.clientX;
        ly = e.clientY;
        lt = now;
        moved += Math.abs(dx) + Math.abs(dy);
        if (moved > 6 && !field.classList.contains('is-drag')) {
          field.classList.add('is-drag');
          try { field.setPointerCapture(pid); } catch (err) {}
        }
        tx -= dx;
        ty -= dy;
        vx = vx * 0.6 + (dx / dt) * 0.4;
        vy = vy * 0.6 + (dy / dt) * 0.4;
      });
      var up = function (e) {
        if (e.pointerId !== pid) return;
        pid = -1;
        dragging = false;
        if (performance.now() - lt < 80) {
          tx -= vx * 320;
          ty -= vy * 320;
        }
        field.classList.remove('is-drag');
        wake();
      };
      addEventListener('pointerup', up);
      addEventListener('pointercancel', up);
      field.addEventListener('click', function (e) {
        if (moved > 6) return;
        if (e.target.classList.contains('wk__img')) open(e.target);
      });

      field.addEventListener('wheel', function (e) {
        e.preventDefault();
        if (zoom) return;
        var k = e.deltaMode === 1 ? 32 : 1;
        tx += e.deltaX * k;
        ty += e.deltaY * k;
        wake();
      }, { passive: false });
      dim.addEventListener('wheel', function (e) {
        e.preventDefault();
        close();
      }, { passive: false });

      addEventListener('keydown', function (e) {
        if (e.key === 'Escape') return close();
        var step = { ArrowLeft: [-cw, 0], ArrowRight: [cw, 0], ArrowUp: [0, -ch], ArrowDown: [0, ch] }[e.key];
        if (!step || zoom) return;
        e.preventDefault();
        tx = Math.round((tx + step[0]) / cw) * cw;
        ty = Math.round((ty + step[1]) / ch) * ch;
        wake();
      });

      // ---------- back home ----------
      // A cover flies back into its spot in the column while the field
      // dissolves with a light blur (home's own "back from a case study"
      // flight, see Hero.astro): the one on screen nearest the middle, or
      // with none on screen the nearest in the field, from just past the edge.
      addEventListener('pageswap', function (e) {
        var to = e.activation && e.activation.entry && e.activation.entry.url;
        try {
          sessionStorage.removeItem('vt-back');
          var u = new URL(to, location.href);
          if (u.origin !== location.origin || !/^\/(preview\/?)?$/.test(u.pathname)) return;
          clearNames();
          var best = null, bd = Infinity, near = null, nd = Infinity;
          cells.forEach(function (k) {
            var slug = data[k.p].slug;
            if (!slug) return;
            var d = Math.hypot(k.sx, k.sy);
            if (d < nd) { nd = d; near = k; }
            var r = k.img.getBoundingClientRect();
            var vis = r.right > 0 && r.left < vw && r.bottom > 0 && r.top < vh &&
              (Math.min(r.right, vw) - Math.max(r.left, 0)) * (Math.min(r.bottom, vh) - Math.max(r.top, 0)) > r.width * r.height * 0.4;
            if (vis && d < bd) { bd = d; best = k; }
          });
          // none on screen: the nearest one comes in from just past the edge
          var k = best || near;
          if (k && !zoom && !reduce) {
            var f = k.img.getBoundingClientRect();
            var s = f.width / k.img.offsetWidth;
            var fr = (parseFloat(getComputedStyle(k.img).borderTopLeftRadius) || 20) * s;
            var fx = Math.min(Math.max(f.left, -f.width * 0.85), vw - f.width * 0.15);
            var fy = Math.min(Math.max(f.top, -f.height * 0.85), vh - f.height * 0.15);
            k.img.style.viewTransitionName = 'project-cover';
            sessionStorage.setItem('vt-back', JSON.stringify({ slug: data[k.p].slug, frame: { w: f.width, h: f.height, x: fx, y: fy, r: fr }, focus: { x: 0.5, y: 0.5 } }));
          } else if (near) {
            sessionStorage.setItem('vt-back', JSON.stringify({ slug: data[near.p].slug, still: true }));
          }
        } catch (err) {}
      });

      addEventListener('resize', function () {
        measure();
        render();
      });
    })();
  </script>
  <div id="wk-ready" hidden></div>
  <script>
    // the home column's edge lens, on the field: tiles reaching the top or
    // bottom band bend as the covers do on home (after they've flown in)
    import { edgeLens } from '../scripts/edge-lens';
    const main = document.querySelector<HTMLElement>('.wk');
    if (main)
      edgeLens({
        items: () => [...main.querySelectorAll<HTMLElement>('.wk__img')],
        media: (el) => el as HTMLImageElement,
        parent: main,
        z: 2,
        motion: () => (window as unknown as { __wkMotion?: () => { speed: number; dx: number; dy: number } }).__wkMotion?.() ?? null,
        delay: document.documentElement.classList.contains('wk-flown') ? 2100 : 1700,
      });
  </script>
</Base>

<style>
  .wk {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #fff;
    color: var(--text-primary);
  }
  /* the nav stays put through the flight from home (same name there) */
  .wk__nav {
    position: relative;
    z-index: 5;
    padding: var(--gutter) var(--gutter) 0;
    pointer-events: none;
  }
  .wk__nav > :global(.nav) {
    pointer-events: auto;
    view-transition-name: site-nav;
  }
  .wk__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  /* the field: cells laid out from the centre; the script takes the positions over */
  .wk__field {
    --w: clamp(240px, 25vw, 440px);
    --h: calc(var(--w) * 0.78);
    --cw: calc(var(--w) * 1.18);
    --ch: calc(var(--h) * 1.22);
    --rad: calc(var(--w) * 0.075);
    position: absolute;
    inset: 0;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .wk__field.is-drag {
    cursor: grabbing;
  }
  .wk__cell {
    position: absolute;
    left: calc(50% - var(--w) / 2);
    top: calc(50% - var(--h) / 2);
    width: var(--w);
    height: var(--h);
    display: grid;
    place-items: center;
    transform: translate(calc(var(--c) * var(--cw)), calc(var(--r) * var(--ch)));
    will-change: transform;
    pointer-events: none;
  }
  /* a tile keeps its own shape, fitted to the cell, always rounded */
  .wk__img {
    display: block;
    width: min(var(--w), var(--h) * var(--a));
    height: min(var(--h), var(--w) / var(--a));
    object-fit: cover;
    border-radius: var(--rad);
    background: #f1f1f1;
    pointer-events: auto;
    cursor: inherit;
    transition: scale 0.5s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk__field:not(.is-drag) .wk__img:hover {
      scale: 1.03;
    }
  }
  /* the tiles fly in from further out and settle, the nearest first; the
     covers that came from home are already flying on their own */
  .wk__cell {
    animation: wk-fly 1.25s cubic-bezier(0.16, 1, 0.3, 1) var(--dl, 0.2s) both;
  }
  .wk__cell.is-named {
    animation: none;
  }
  @keyframes wk-fly {
    from {
      opacity: 0;
      translate: var(--fx, 0) var(--fy, 0);
      scale: 0.82;
    }
  }
  /* close-up: the field steps back behind a pale veil */
  .wk__dim {
    position: absolute;
    inset: 0;
    z-index: 6;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
