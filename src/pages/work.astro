---
// All work: an endless field of shots to wander through (explorations, side
// work, details), not the case studies from home. Drag or scroll in any
// direction; the field bends like it sits under a lens (shots toward the
// edges shrink, turn and blur). Click a shot to bring it up close.
// The page opens out of a line across the middle, like About (Base.astro).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { EXPLORE_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const [explore, settings] = await Promise.all([load(Astro.locals, EXPLORE_QUERY), load(Astro.locals, SETTINGS_QUERY)]);
if (!settings) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
type Img = any;
const shots: Img[] = (explore?.shots ?? []).filter((i: Img) => i?.asset);
// nothing chosen yet: pictures from every case study gallery
const pool0: Img[] = shots.length
  ? shots
  : ((explore?.gallery ?? []) as { gallery?: { kind?: string; image?: Img; poster?: Img }[] }[])
      .flatMap((p) => p.gallery ?? [])
      .map((g) => (g.kind === 'video' ? g.poster : g.image))
      .filter((i) => i?.asset && !String(i.asset.mimeType ?? '').includes('gif'));
// a steady shuffle, so neighbours rarely come from the same project
const seeded = pool0
  .map((img, i) => ({ img, k: Math.sin(i * 12.9898 + 78.233) * 43758.5453 }))
  .map((x) => ({ ...x, k: x.k - Math.floor(x.k) }))
  .sort((a, b) => a.k - b.k)
  .map((x) => x.img);
const items = seeded.map((img) => {
  const d = img.asset?.metadata?.dimensions;
  return {
    src: urlFor(img).width(1000).fit('max').quality(80).url(),
    big: urlFor(img).width(2000).fit('max').quality(85).url(),
    a: d?.aspectRatio ?? (d?.width && d?.height ? d.width / d.height : 4 / 3),
  };
});
const n = items.length;

// the pool of tiles recycled as the field moves; cell (c, r) shows item (c + r*K) mod n
const PC = 7;
const PR = 7;
const K = n > 6 ? (n % 3 === 0 ? 4 : 3) : 1;
const mod = (a: number, m: number) => ((a % m) + m) % m;
const c0 = Math.floor(-PC / 2);
const r0 = Math.floor(-PR / 2);
const pool: { c: number; r: number; p: number }[] = [];
for (let b = 0; b < PR; b++)
  for (let a = 0; a < PC; a++) {
    const c = c0 + mod(a - c0, PC);
    const r = r0 + mod(b - r0, PR);
    pool.push({ c, r, p: n ? mod(c + r * K, n) : 0 });
  }
---

<Base title={`All work · ${settings.seoTitle ?? 'Bart Ocieczek'}`} description={settings.seoDescription}>
  <main class="wk" data-work>
    <header class="wk__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <div class="wk__field" data-wk-field data-lenis-prevent data-k={K} data-pc={PC} data-pr={PR}>
      {n > 0 && pool.map((s) => (
        <div class="wk__cell" style={`--c:${s.c};--r:${s.r};--a:${items[s.p].a.toFixed(4)};--d:${Math.hypot(s.c, s.r * 1.3).toFixed(2)}`}>
          <img class="wk__img" src={items[s.p].src} alt="" decoding="async" loading="eager" draggable="false" data-p={s.p} />
        </div>
      ))}
    </div>
    <div class="wk__lens" aria-hidden="true"></div>
    <div class="wk__dim" data-wk-dim aria-hidden="true"></div>

    <footer class="wk__foot">
      <span class="t-label wk__hint">Drag to explore</span>
      <a class="wk__x" href={href(Astro.locals, '/')} aria-label="Close, back home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
    </footer>
  </main>
  <script type="application/json" id="wk-data" set:html={JSON.stringify(items)} />
</Base>

<style>
  .wk {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #fff;
    color: var(--text-primary);
  }
  .wk__nav {
    position: relative;
    z-index: 5;
    padding: var(--gutter) var(--gutter) 0;
    pointer-events: none;
  }
  .wk__nav > :global(*) {
    pointer-events: auto;
  }
  /* the field: cells laid out from the centre; JS takes the positions over */
  .wk__field {
    --w: clamp(240px, 25vw, 440px);
    --h: calc(var(--w) * 0.78);
    --cw: calc(var(--w) * 1.18);
    --ch: calc(var(--h) * 1.22);
    --rad: calc(var(--w) * 0.075);
    position: absolute;
    inset: 0;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .wk__field.is-drag {
    cursor: grabbing;
  }
  .wk__cell {
    position: absolute;
    left: calc(50% - var(--w) / 2);
    top: calc(50% - var(--h) / 2);
    width: var(--w);
    height: var(--h);
    display: grid;
    place-items: center;
    transform: translate(calc(var(--c) * var(--cw)), calc(var(--r) * var(--ch)));
    will-change: transform;
    pointer-events: none;
  }
  /* a shot keeps its own shape, fitted to the cell, always rounded */
  .wk__img {
    display: block;
    width: min(var(--w), var(--h) * var(--a));
    height: min(var(--h), var(--w) / var(--a));
    object-fit: cover;
    border-radius: var(--rad);
    background: #f1f1f1;
    pointer-events: auto;
    cursor: inherit;
    transition: scale 0.5s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk__field:not(.is-drag) .wk__img:hover {
      scale: 1.03;
    }
  }
  /* the lens: the rim of the view goes soft and pale */
  .wk__lens {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 45%, rgba(255, 255, 255, 0.6) 100%);
    mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, transparent 40%, #000 95%);
    -webkit-mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, transparent 40%, #000 95%);
  }
  /* close-up: the field steps back behind a pale veil */
  .wk__dim {
    position: absolute;
    inset: 0;
    z-index: 6;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  .wk.is-zoom .wk__dim {
    opacity: 1;
    pointer-events: auto;
    cursor: zoom-out;
  }
  :global(.wk__zoom) {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 7;
    object-fit: cover;
    transform-origin: 0 0;
    cursor: zoom-out;
    will-change: transform;
  }
  .wk__foot {
    position: absolute;
    z-index: 8;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .wk__hint {
    color: rgba(17, 17, 17, 0.5);
  }
  .wk__x {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--text-primary);
    color: #fff;
    transition: scale 0.16s var(--ease-out);
  }
  .wk__x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition: rotate 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk__x:hover svg {
      rotate: 90deg;
    }
  }
  .wk__x:active {
    scale: 0.94;
  }
  /* once the page has opened, the shots settle in from the centre outwards */
  .wk__cell {
    animation: wk-in 1s var(--ease-out) calc(0.45s + var(--d) * 60ms) both;
  }
  @keyframes wk-in {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }
  @media (max-width: 809px) {
    .wk__field {
      --w: 64vw;
      --h: calc(var(--w) * 0.9);
      --cw: calc(var(--w) * 1.12);
      --ch: calc(var(--h) * 1.14);
    }
    .wk__lens {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wk__cell {
      animation: wk-fade 0.3s ease both;
    }
    @keyframes wk-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  const main = document.querySelector<HTMLElement>('.wk');
  const field = document.querySelector<HTMLElement>('[data-wk-field]');
  const dim = document.querySelector<HTMLElement>('[data-wk-dim]');
  const data = JSON.parse(document.getElementById('wk-data')?.textContent || '[]') as { src: string; big: string; a: number }[];
  if (main && field && dim && data.length) {
    const n = data.length;
    const K = Number(field.dataset.k);
    const PC = Number(field.dataset.pc);
    const PR = Number(field.dataset.pr);
    const mod = (a: number, m: number) => ((a % m) + m) % m;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cells = [...field.querySelectorAll<HTMLElement>('.wk__cell')].map((el, i) => ({
      el,
      img: el.querySelector('img') as HTMLImageElement,
      a: i % PC,
      b: Math.floor(i / PC),
      p: Number(el.querySelector('img')?.dataset.p),
    }));
    // warm every picture once, so recycled tiles never show an empty frame
    data.forEach((d) => {
      const i = new Image();
      i.decoding = 'async';
      i.src = d.src;
    });

    let cw = 0, ch = 0, vw = 0, vh = 0;
    const measure = () => {
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;width:var(--cw);height:var(--ch)';
      field.appendChild(probe);
      cw = probe.offsetWidth;
      ch = probe.offsetHeight;
      probe.remove();
      vw = field.clientWidth;
      vh = field.clientHeight;
    };
    measure();

    // camera: where the centre of the screen sits in the field
    let x = 0, y = 0, tx = 0, ty = 0, speed = 0;

    const render = () => {
      const c0 = Math.floor(x / cw - PC / 2);
      const r0 = Math.floor(y / ch - PR / 2);
      const z = 1 - Math.min(speed / 4000, 1) * 0.05; // the field eases back a touch while it flies
      for (const k of cells) {
        const c = c0 + mod(k.a - c0, PC);
        const r = r0 + mod(k.b - r0, PR);
        const p = mod(c + r * K, n);
        if (p !== k.p) {
          k.p = p;
          k.img.src = data[p].src;
          k.img.dataset.p = String(p);
          k.el.style.setProperty('--a', String(data[p].a));
        }
        const sx = (c * cw - x) * z;
        const sy = (r * ch - y) * z;
        const nx = sx / (vw * 0.5);
        const ny = sy / (vh * 0.5);
        const d2 = Math.min(nx * nx + ny * ny, 3);
        // the lens: pulled in, shrunk and turned toward the middle
        const pull = 1 - 0.07 * d2;
        const s = z * (1 - 0.09 * d2);
        const ry = reduce ? 0 : nx * -9;
        const rx = reduce ? 0 : ny * 7;
        k.el.style.transform = `translate3d(${(sx * pull).toFixed(1)}px,${(sy * pull).toFixed(1)}px,0) perspective(1400px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${s.toFixed(4)})`;
      }
    };

    let last = performance.now();
    let raf = 0;
    let dragging = false;
    const tick = (now: number) => {
      const dt = Math.min(now - last, 64);
      last = now;
      const f = 1 - Math.exp(-dt / (dragging ? 40 : 130));
      const px = x, py = y;
      x += (tx - x) * f;
      y += (ty - y) * f;
      const v = (Math.hypot(x - px, y - py) / Math.max(dt, 1)) * 1000;
      speed += (v - speed) * (1 - Math.exp(-dt / 120));
      render();
      if (dragging || Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || speed > 2) raf = requestAnimationFrame(tick);
      else {
        speed = 0;
        render();
        raf = 0;
      }
    };
    const wake = () => {
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    };

    // ---------- close-up ----------
    let zoom: { img: HTMLImageElement; src: HTMLImageElement } | null = null;
    const EASE = 'cubic-bezier(0.77, 0, 0.175, 1)';
    const open = (src: HTMLImageElement) => {
      if (zoom) return;
      const d = data[Number(src.dataset.p)];
      const from = src.getBoundingClientRect();
      const rad = parseFloat(getComputedStyle(src).borderTopLeftRadius) || 0;
      const maxW = vw * (vw < 810 ? 0.92 : 0.78);
      const maxH = vh * 0.78;
      const w = Math.min(maxW, maxH * d.a);
      const h = w / d.a;
      const L = (vw - w) / 2, T = (vh - h) / 2;
      const R = Math.max(rad * 1.6, 18);
      const img = document.createElement('img');
      img.className = 'wk__zoom';
      img.alt = '';
      img.src = src.currentSrc || src.src;
      img.style.width = `${w}px`;
      img.style.height = `${h}px`;
      main.appendChild(img);
      // swap in the sharp one once it has loaded
      const hi = new Image();
      hi.onload = () => {
        if (zoom?.img === img) img.src = d.big;
      };
      hi.src = d.big;
      src.style.visibility = 'hidden';
      main.classList.add('is-zoom');
      const sx = from.width / w, sy = from.height / h;
      img.animate(
        [
          { transform: `translate(${from.left}px,${from.top}px) scale(${sx},${sy})`, borderRadius: `${rad / sx}px / ${rad / sy}px` },
          { transform: `translate(${L}px,${T}px) scale(1,1)`, borderRadius: `${R}px` },
        ],
        { duration: reduce ? 1 : 750, easing: EASE, fill: 'both' },
      );
      zoom = { img, src };
    };
    const close = () => {
      if (!zoom) return;
      const { img, src } = zoom;
      zoom = null;
      main.classList.remove('is-zoom');
      const now = img.getBoundingClientRect();
      const back = src.getBoundingClientRect();
      const w = img.offsetWidth, h = img.offsetHeight;
      const rad = parseFloat(getComputedStyle(src).borderTopLeftRadius) || 0;
      const cur = getComputedStyle(img).borderRadius;
      img.getAnimations().forEach((a) => a.cancel());
      const s0x = now.width / w, s0y = now.height / h;
      const sx = back.width / w, sy = back.height / h;
      const a = img.animate(
        [
          { transform: `translate(${now.left}px,${now.top}px) scale(${s0x},${s0y})`, borderRadius: cur },
          { transform: `translate(${back.left}px,${back.top}px) scale(${sx},${sy})`, borderRadius: `${rad / sx}px / ${rad / sy}px` },
        ],
        { duration: reduce ? 1 : 650, easing: EASE, fill: 'both' },
      );
      a.finished.then(() => {
        src.style.visibility = '';
        img.remove();
      });
    };
    dim.addEventListener('click', close);
    main.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).classList.contains('wk__zoom')) close();
    });

    // ---------- drag, with a flick that keeps going ----------
    let moved = 0, lx = 0, ly = 0, lt = 0, vx = 0, vy = 0, pid = -1;
    field.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || pid !== -1 || zoom) return;
      pid = e.pointerId;
      dragging = true;
      moved = 0;
      lx = e.clientX;
      ly = e.clientY;
      lt = performance.now();
      vx = vy = 0;
      wake();
    });
    window.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pid) return;
      const dx = e.clientX - lx, dy = e.clientY - ly;
      const now = performance.now();
      const dt = Math.max(now - lt, 1);
      lx = e.clientX;
      ly = e.clientY;
      lt = now;
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 6 && !field.classList.contains('is-drag')) {
        field.classList.add('is-drag');
        try { field.setPointerCapture(pid); } catch {}
      }
      tx -= dx;
      ty -= dy;
      vx = vx * 0.6 + (dx / dt) * 0.4;
      vy = vy * 0.6 + (dy / dt) * 0.4;
    });
    const up = (e: PointerEvent) => {
      if (e.pointerId !== pid) return;
      pid = -1;
      dragging = false;
      if (performance.now() - lt < 80) {
        tx -= vx * 320;
        ty -= vy * 320;
      }
      field.classList.remove('is-drag');
      wake();
    };
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    field.addEventListener('click', (e) => {
      if (moved > 6) return;
      const t = e.target as HTMLElement;
      if (t.classList.contains('wk__img')) open(t as HTMLImageElement);
    });

    field.addEventListener('wheel', (e) => {
      e.preventDefault();
      if (zoom) return;
      const k = e.deltaMode === 1 ? 32 : 1;
      tx += e.deltaX * k;
      ty += e.deltaY * k;
      wake();
    }, { passive: false });
    dim.addEventListener('wheel', (e) => {
      e.preventDefault();
      close();
    }, { passive: false });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return close();
      const step = ({ ArrowLeft: [-cw, 0], ArrowRight: [cw, 0], ArrowUp: [0, -ch], ArrowDown: [0, ch] } as Record<string, number[]>)[e.key];
      if (!step || zoom) return;
      e.preventDefault();
      tx = Math.round((tx + step[0]) / cw) * cw;
      ty = Math.round((ty + step[1]) / ch) * ch;
      wake();
    });

    window.addEventListener('resize', () => {
      measure();
      render();
    });
    render();
  }
</script>
