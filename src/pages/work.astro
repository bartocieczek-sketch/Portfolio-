---
// All work: an endless field of light cards, each holding a project floating
// inside it. Drag or scroll in any direction; the field bends like it sits
// under a lens (cards toward the edges shrink, turn and blur). Coming from
// home through "All work", the covers on screen fly into their cards (a
// cross-document view transition, see Hero.astro and Base.astro).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const [home, settings] = await Promise.all([load(Astro.locals, HOME_QUERY), load(Astro.locals, SETTINGS_QUERY)]);
if (!home || !settings) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = ((home.projects ?? []) as any[])
  .filter((p) => p?.cover?.asset && p.slug)
  .map((p) => ({
    slug: p.slug as string,
    title: ((p.cardTitle || p.title || '') as string).trim(),
    year: p.year ?? '',
    href: href(Astro.locals, `/${p.slug}`),
    src: urlFor(p.cover).width(1000).fit('max').quality(80).url(),
  }));
const n = projects.length;

// the pool of cards that gets recycled as the field moves (enough to cover
// any screen with a ring to spare); cell (c, r) shows project (c + r*K) mod n
const PC = 6;
const PR = 7;
const K = n % 3 === 0 ? 2 : 3;
const mod = (a: number, m: number) => ((a % m) + m) % m;
const c0 = Math.floor(-PC / 2);
const r0 = Math.floor(-PR / 2);
const pool: { c: number; r: number; p: number }[] = [];
for (let b = 0; b < PR; b++)
  for (let a = 0; a < PC; a++) {
    const c = c0 + mod(a - c0, PC);
    const r = r0 + mod(b - r0, PR);
    pool.push({ c, r, p: n ? mod(c + r * K, n) : 0 });
  }
// each project's view-transition name goes on the copy nearest the centre
const named = new Map<number, number>();
pool
  .map((s, i) => ({ i, d: s.c * s.c + s.r * s.r * 1.4, p: s.p }))
  .sort((x, y) => x.d - y.d)
  .forEach(({ i, p }) => {
    if (!named.has(p)) named.set(p, i);
  });
const nameOf = new Map([...named].map(([p, i]) => [i, p]));
const stagger = projects.map((p, i) => `::view-transition-group(w-${p.slug}){animation-delay:${i * 40}ms}`).join('');
---

<Base title={`All work · ${settings.seoTitle ?? 'Bart Ocieczek'}`} description={settings.seoDescription}>
  <Fragment set:html={`<style>html:active-view-transition-type(work)${stagger.split('}').filter(Boolean).join('}html:active-view-transition-type(work)')}}</style>`} />
  <main class="wk" data-work>
    <header class="wk__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <div class="wk__field" data-wk-field data-lenis-prevent aria-hidden="true" data-n={n} data-k={K} data-pc={PC} data-pr={PR}>
      {pool.map((s, i) => {
        const p = projects[s.p];
        if (!p) return null;
        const vt = nameOf.has(i) ? `view-transition-name:w-${p.slug};view-transition-class:wcov` : '';
        return (
          <a class="wk__card" href={p.href} tabindex="-1" style={`--c:${s.c};--r:${s.r};--d:${Math.hypot(s.c, s.r * 1.4).toFixed(2)}`} data-c={s.c} data-r={s.r} data-p={s.p}>
            <span class="wk__in">
              <img src={p.src} alt="" decoding="async" loading="eager" draggable="false" style={vt} />
              <span class="wk__cap t-label"><span>{p.title}</span><span>{p.year}</span></span>
            </span>
          </a>
        );
      })}
    </div>
    <div class="wk__lens" aria-hidden="true"></div>

    <ul class="wk__sr">
      {projects.map((p) => (
        <li><a href={p.href}>{p.title}{p.year && `, ${p.year}`}</a></li>
      ))}
    </ul>

    <footer class="wk__foot">
      <span class="t-label wk__count">{String(n).padStart(2, '0')} projects</span>
      <a class="wk__x" href={href(Astro.locals, '/')} aria-label="Close, back home">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </a>
    </footer>
  </main>
  <script type="application/json" id="wk-data" set:html={JSON.stringify(projects.map((p) => ({ src: p.src, href: p.href, title: p.title, year: p.year })))} />
</Base>

<style>
  .wk {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #fff;
    color: var(--text-primary);
  }
  .wk__nav {
    position: relative;
    z-index: 5;
    padding: var(--gutter) var(--gutter) 0;
    pointer-events: none;
  }
  .wk__nav > :global(*) {
    pointer-events: auto;
  }
  /* the field: cells laid out from the centre; JS takes the positions over */
  .wk__field {
    --w: clamp(280px, 31vw, 560px);
    --h: calc(var(--w) * 0.68);
    --cw: calc(var(--w) * 1.22);
    --ch: calc(var(--h) * 1.24);
    position: absolute;
    inset: 0;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
  }
  .wk__field.is-drag {
    cursor: grabbing;
  }
  .wk__card {
    position: absolute;
    left: calc(50% - var(--w) / 2);
    top: calc(50% - var(--h) / 2);
    width: var(--w);
    height: var(--h);
    transform: translate(calc(var(--c) * var(--cw)), calc(var(--r) * var(--ch)));
    will-change: transform;
    -webkit-tap-highlight-color: transparent;
  }
  .wk__in {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: calc(var(--w) * 0.085);
    background: #f3f4f5;
    transition:
      background-color 0.3s ease,
      scale 0.5s var(--ease-out);
  }
  .wk__in img {
    position: absolute;
    inset: 14% 13%;
    display: block;
    width: 74%;
    height: 72%;
    object-fit: contain;
    transition: scale 0.6s var(--ease-out);
    will-change: translate;
    pointer-events: none;
  }
  .wk__cap {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 16px;
    display: flex;
    justify-content: space-between;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity 0.25s ease,
      translate 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk__field:not(.is-drag) .wk__card:hover .wk__in {
      background: #ecedee;
    }
    .wk__field:not(.is-drag) .wk__card:hover img {
      scale: 1.035;
    }
    .wk__field:not(.is-drag) .wk__card:hover .wk__cap {
      opacity: 1;
      translate: 0 0;
    }
  }
  .wk__card:active .wk__in {
    scale: 0.985;
  }
  /* the lens: the rim of the view goes soft and pale */
  .wk__lens {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: radial-gradient(ellipse 75% 70% at 50% 50%, transparent 45%, rgba(255, 255, 255, 0.6) 100%);
    mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, transparent 40%, #000 95%);
    -webkit-mask-image: radial-gradient(ellipse 72% 68% at 50% 50%, transparent 40%, #000 95%);
  }
  .wk__foot {
    position: absolute;
    z-index: 5;
    left: var(--gutter);
    right: var(--gutter);
    bottom: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
  }
  .wk__count {
    color: rgba(17, 17, 17, 0.5);
  }
  .wk__x {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--text-primary);
    color: #fff;
    transition: scale 0.16s var(--ease-out);
  }
  .wk__x svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    transition: rotate 0.35s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .wk__x:hover svg {
      rotate: 90deg;
    }
  }
  .wk__x:active {
    scale: 0.94;
  }
  .wk__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .wk__sr a:focus {
    position: fixed;
  }
  /* arriving any other way: the cards settle in from the centre outwards */
  html:not(.wk-flown) .wk__in {
    animation: wk-in 0.9s var(--ease-out) calc(0.1s + var(--d) * 70ms) both;
  }
  @keyframes wk-in {
    from {
      opacity: 0;
      scale: 0.92;
    }
  }
  @media (max-width: 809px) {
    .wk__field {
      --w: 74vw;
      --h: calc(var(--w) * 0.8);
      --cw: calc(var(--w) * 1.14);
      --ch: calc(var(--h) * 1.16);
    }
    .wk__lens {
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html:not(.wk-flown) .wk__in {
      animation: wk-fade 0.3s ease both;
    }
    @keyframes wk-fade {
      from {
        opacity: 0;
      }
    }
  }
</style>

<script>
  try {
    if (sessionStorage.getItem('vt-work-flown')) {
      document.documentElement.classList.add('wk-flown');
      sessionStorage.removeItem('vt-work-flown');
    }
  } catch {}

  const field = document.querySelector<HTMLElement>('[data-wk-field]');
  const data = JSON.parse(document.getElementById('wk-data')?.textContent || '[]') as { src: string; href: string }[];
  if (field && data.length) {
    const n = data.length;
    const K = Number(field.dataset.k);
    const PC = Number(field.dataset.pc);
    const PR = Number(field.dataset.pr);
    const mod = (a: number, m: number) => ((a % m) + m) % m;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cards = [...field.querySelectorAll<HTMLAnchorElement>('.wk__card')].map((el, i) => ({
      el,
      img: el.querySelector('img') as HTMLImageElement,
      a: i % PC,
      b: Math.floor(i / PC),
      p: Number(el.dataset.p),
    }));

    let W = 0, H = 0, cw = 0, ch = 0, vw = 0, vh = 0;
    const measure = () => {
      const first = cards[0].el;
      W = first.offsetWidth;
      H = first.offsetHeight;
      const probe = document.createElement('div');
      probe.style.cssText = 'position:absolute;visibility:hidden;width:var(--cw);height:var(--ch)';
      field.appendChild(probe);
      cw = probe.offsetWidth;
      ch = probe.offsetHeight;
      probe.remove();
      vw = field.clientWidth;
      vh = field.clientHeight;
    };
    measure();

    // camera: where the centre of the screen sits in the field
    let x = 0, y = 0, tx = 0, ty = 0, speed = 0;
    let named = true;
    const clearNames = () => {
      if (!named) return;
      named = false;
      cards.forEach((c) => c.img.style.removeProperty('view-transition-name'));
    };

    const render = () => {
      const c0 = Math.floor(x / cw - PC / 2);
      const r0 = Math.floor(y / ch - PR / 2);
      const z = 1 - Math.min(speed / 4000, 1) * 0.05; // the field eases back a touch while it flies
      for (const k of cards) {
        const c = c0 + mod(k.a - c0, PC);
        const r = r0 + mod(k.b - r0, PR);
        const p = mod(c + r * K, n);
        if (p !== k.p) {
          k.p = p;
          k.img.src = data[p].src;
          k.el.href = data[p].href;
          clearNames();
        }
        // where the card's centre lands, measured from the screen centre
        const sx = (c * cw - x) * z;
        const sy = (r * ch - y) * z;
        const nx = sx / (vw * 0.5);
        const ny = sy / (vh * 0.5);
        const d2 = Math.min(nx * nx + ny * ny, 3);
        // the lens: pulled in, shrunk and turned toward the middle
        const pull = 1 - 0.07 * d2;
        const s = z * (1 - 0.09 * d2);
        const ry = reduce ? 0 : nx * -9;
        const rx = reduce ? 0 : ny * 7;
        k.el.style.transform = `translate3d(${(sx * pull).toFixed(1)}px,${(sy * pull).toFixed(1)}px,0) perspective(1400px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${s.toFixed(4)})`;
        // the project drifts inside its card, a little against the move
        k.img.style.translate = reduce ? '' : `${(nx * -16).toFixed(1)}px ${(ny * -12).toFixed(1)}px`;
      }
    };

    let last = performance.now();
    let raf = 0;
    const tick = (now: number) => {
      const dt = Math.min(now - last, 64);
      last = now;
      const f = 1 - Math.exp(-dt / (dragging ? 40 : 130));
      const px = x, py = y;
      x += (tx - x) * f;
      y += (ty - y) * f;
      const v = Math.hypot(x - px, y - py) / Math.max(dt, 1) * 1000;
      speed += (v - speed) * (1 - Math.exp(-dt / 120));
      render();
      if (dragging || Math.abs(tx - x) > 0.3 || Math.abs(ty - y) > 0.3 || speed > 2) raf = requestAnimationFrame(tick);
      else {
        speed = 0;
        render();
        raf = 0;
      }
    };
    const wake = () => {
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(tick);
      }
    };

    // drag, with a flick that keeps going
    let dragging = false, moved = 0, lx = 0, ly = 0, lt = 0, vx = 0, vy = 0, pid = -1;
    field.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || pid !== -1) return;
      pid = e.pointerId;
      dragging = true;
      moved = 0;
      lx = e.clientX;
      ly = e.clientY;
      lt = performance.now();
      vx = vy = 0;
      wake();
    });
    window.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pid) return;
      const dx = e.clientX - lx, dy = e.clientY - ly;
      const now = performance.now();
      const dt = Math.max(now - lt, 1);
      lx = e.clientX;
      ly = e.clientY;
      lt = now;
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 6 && !field.classList.contains('is-drag')) {
        field.classList.add('is-drag');
        try { field.setPointerCapture(pid); } catch {}
      }
      tx -= dx;
      ty -= dy;
      vx = vx * 0.6 + (dx / dt) * 0.4;
      vy = vy * 0.6 + (dy / dt) * 0.4;
    });
    const up = (e: PointerEvent) => {
      if (e.pointerId !== pid) return;
      pid = -1;
      dragging = false;
      if (performance.now() - lt < 80) {
        tx -= vx * 320;
        ty -= vy * 320;
      }
      field.classList.remove('is-drag');
      wake();
    };
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    // a drag is not a click
    field.addEventListener('click', (e) => {
      if (moved > 6) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);

    field.addEventListener('wheel', (e) => {
      e.preventDefault();
      const k = e.deltaMode === 1 ? 32 : 1;
      tx += e.deltaX * k;
      ty += e.deltaY * k;
      wake();
    }, { passive: false });

    window.addEventListener('keydown', (e) => {
      const step = { ArrowLeft: [-cw, 0], ArrowRight: [cw, 0], ArrowUp: [0, -ch], ArrowDown: [0, ch] }[e.key];
      if (!step) return;
      e.preventDefault();
      tx = Math.round((tx + step[0]) / cw) * cw;
      ty = Math.round((ty + step[1]) / ch) * ch;
      wake();
    });

    window.addEventListener('resize', () => {
      measure();
      render();
    });
    render();
  }
</script>
