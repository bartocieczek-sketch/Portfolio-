    // ---- 5: a real ECG trace. One beat is a sum of gaussians at clinical
    // timings (P 0.10s, Q 0.20s, R 0.22s, S 0.245s, T 0.42s); the beat
    // interval is 60/bpm, so a faster rate packs beats closer while the
    // complex keeps its shape — like a real monitor.
    const g = (t: number, at: number, w: number, a: number) => a * Math.exp(-((t - at) ** 2) / (2 * w * w));
    const ecg = (t: number) =>
      g(t, 0.1, 0.022, 0.12) + g(t, 0.2, 0.009, -0.12) + g(t, 0.22, 0.01, 1) + g(t, 0.245, 0.011, -0.25) + g(t, 0.42, 0.045, 0.3);
    const path = root.querySelector<SVGPathElement>('[data-ecg]');
    const bpmEl = root.querySelector<HTMLElement>('[data-bpm]');
    const digs = bpmEl ? [...bpmEl.querySelectorAll<HTMLElement>('.a9__dg')] : [];
    let shown = -1;
    const showBpm = (v: number) => {
      if (v === shown || !bpmEl) return;
      shown = v;
      const str = String(v).padStart(3, ' ');
      digs.forEach((d, i) => {
        const c = str[i];
        // the slot's width follows its digit; a blank hundreds slot folds away
        d.style.width = c === ' ' ? '0' : '0.56em';
        if (c !== ' ') (d.firstElementChild as HTMLElement).style.setProperty('--v', c);
      });
      bpmEl.setAttribute('aria-label', `${v} beats per minute`);
    };
    showBpm(62);
    const beatEl = root.querySelector<HTMLElement>('[data-beat]');
    const pen = root.querySelector<HTMLElement>('[data-pen]');
    const bigBpm = root.querySelector<HTMLElement>('[data-bpm-big]');
    const waves = root.querySelector<SVGGElement>('[data-waves]');
    let heartOn = false;
    const heartEl = root.querySelector('[data-heart]');
    if (heartEl) new IntersectionObserver((es) => (heartOn = es[0].isIntersecting)).observe(heartEl);
    const WIN = 4; // seconds on screen
    const samples: number[] = [];
    const RATE = 60; // samples per second
    let caffeine = 0;
    let running = false;
    let bpm = 62;
    let inBeat = 0; // seconds since this beat started
    let acc = 0;
    let last = performance.now();
    // pre-fill so the trace is full from the start
    for (let i = 0; i < WIN * RATE; i++) {
      inBeat += 1 / RATE;
      if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
      samples.push(ecg(inBeat));
    }

    // ---- scroll-driven bits + the monitor, in one loop
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const smooth = (v: number) => v * v * (3 - 2 * v);
    // the about paragraph: wrap its words (text only) and number every
    // word and object in order, so they arrive one after another
    root.querySelectorAll<HTMLElement>('[data-prose]').forEach((el) => {
      let k = 0;
      [...el.childNodes].forEach((n) => {
        if (n.nodeType === 3) {
          const parts = (n.textContent ?? '').split(/(\s+)/);
          const frag = document.createDocumentFragment();
          parts.forEach((p) => {
            if (!p) return;
            if (/^\s+$/.test(p)) {
              frag.append(' ');
              return;
            }
            const sp = document.createElement('span');
            sp.className = 'bw';
            sp.style.setProperty('--k', String(k++));
            sp.textContent = p;
            frag.append(sp);
          });
          n.replaceWith(frag);
        } else if (n instanceof HTMLElement) {
          n.style.setProperty('--k', String(k++));
        }
      });
    });
    // who: the lead, word by word
    root.querySelectorAll<HTMLElement>('[data-blur]').forEach((el) => {
      const ws = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      ws.forEach((w, k) => {
        const sp = document.createElement('span');
        sp.className = 'bw';
        sp.style.setProperty('--k', String(k));
        sp.textContent = w;
        el.append(sp);
        if (k < ws.length - 1) el.append(' ');
      });
    });
    const ab = root.querySelector<HTMLElement>('[data-ab]');
    const abIts = [...root.querySelectorAll<HTMLElement>('[data-ab-it]')];
    const abCur = root.querySelector<HTMLElement>('[data-ab-cur]');
    const abWide = matchMedia('(min-width: 810px)');
    let abIdx = 0;
    let heroPx = -1e4;
    let heroPy = -1e4;
    if (intro && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // (the hero doesn't take pointer events — it lies over the next section
      // at the end — so listen on the window)
      addEventListener('pointermove', (e) => {
        heroPx = e.clientX;
        heroPy = e.clientY;
      });
      document.addEventListener('pointerleave', () => (heroPx = heroPy = -1e4));
    }
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (intro) {
        const max = intro.offsetHeight - innerHeight;
        const p = max > 0 ? clamp(-intro.getBoundingClientRect().top / max) : 0;
        // light the words over the first half of the scroll, a soft edge of
        // ~3; around the pointer a soft spotlight lights them early
        const f = (p / 0.42) * (words.length + 3) - 3;
        const spot = heroPx > -1e3 && !calm;
        words.forEach((n, k) => {
          let v = clamp((f - k + 3) / 3);
          if (spot) {
            const r = n.getBoundingClientRect();
            const d = Math.hypot(r.left + r.width / 2 - heroPx, r.top + r.height / 2 - heroPy);
            v = Math.max(v, clamp(1 - d / 260) * 0.85);
          }
          const cur = Number(n.dataset.v ?? 0);
          const nv = cur + (v - cur) * 0.2;
          n.dataset.v = nv.toFixed(4);
          n.style.setProperty('--lit', (0.22 + 0.78 * nv).toFixed(3));
        });
        // then the B comes for the camera and the statement falls back into
        // the dark behind it
        const fly = smooth(clamp((p - 0.42) / 0.5));
        say.style.transform = `translateY(${(-p * 6).toFixed(2)}vh) scale(${(1 - fly * 0.14).toFixed(4)})`;
        say.style.filter = fly > 0.001 ? `blur(${(fly * 10).toFixed(2)}px)` : '';
        // gone completely before the B has passed: nothing left behind it
        const gone = smooth(clamp((p - 0.42) / 0.28));
        say.style.opacity = (1 - gone).toFixed(3);
        say.style.visibility = gone > 0.995 ? 'hidden' : '';
        sayWrap.parentElement!.style.setProperty('--p', p.toFixed(3));
        (window as any).__a9P = p;
      }
      if (ab && abIts.length && abWide.matches) {
        const r = ab.getBoundingClientRect();
        const max = ab.offsetHeight - innerHeight;
        const p = max > 0 ? clamp(-r.top / max) : 0;
        const idx = Math.min(abIts.length - 1, Math.floor(p * abIts.length * 0.999));
        if (idx !== abIdx) {
          const down = idx > abIdx;
          abIdx = idx;
          abIts.forEach((li, k) => li.classList.toggle('is-on', k === idx));
          if (abCur) {
            abCur.textContent = abIts[idx].querySelector('h3')?.textContent ?? '';
            if (!calm)
              abCur.animate([{ transform: `translateY(${down ? 100 : -100}%)` }, { transform: 'none' }], {
                duration: 420,
                easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
              });
          }
        }
      }
      // heart: caffeine wears off ~1 coffee per 40s; the rate eases toward its target
      caffeine = Math.max(0, caffeine - dt / 40);
      // a run lifts the rate hard; coffee lifts it from rest
      const target = running ? 132 + Math.min(caffeine, 8) * 3 : 62 + Math.min(caffeine, 8) * 8;
      bpm += (target - bpm) * Math.min(1, dt * 0.8);
      showBpm(Math.round(bpm));
      acc += dt * RATE;
      while (acc >= 1) {
        acc -= 1;
        const before = inBeat;
        inBeat += 1 / RATE;
        if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
        // the B jumps on the R wave
        if (!calm && before < 0.22 && inBeat >= 0.22) {
          beatEl?.animate([{ transform: 'scale(1.6)' }, { transform: 'scale(1)' }], { duration: 260, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          // a thin ring goes out from the dot (only while it's on screen)
          if (waves && heartOn) {
            const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            c.setAttribute('r', '20');
            c.setAttribute('class', 'a9__ring-wave');
            waves.append(c);
            c.animate(
              [
                { transform: 'scale(1)', opacity: 0.7 },
                { transform: 'scale(9)', opacity: 0 },
              ],
              { duration: 2200, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
            ).onfinish = () => c.remove();
          }
          bigBpm?.animate([{ transform: 'translateY(-100%) scale(1.08)' }, { transform: 'translateY(-100%)' }], { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        }
        samples.push(calm ? 0 : ecg(inBeat));
        if (samples.length > WIN * RATE) samples.shift();
      }
      if (path) {
        let d = '';
        const n = samples.length;
        for (let i = 0; i < n; i++) {
          const x = (i / (n - 1)) * 800;
          const y = 150 - samples[i] * 120;
          d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
        if (pen && n) pen.style.top = `${((150 - samples[n - 1] * 120) / 2).toFixed(2)}%`;
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // ---- hold to brew (slow fill, snappy release); each coffee adds caffeine
    const brew = root.querySelector<HTMLButtonElement>('[data-brew]');
    const cups = root.querySelector<HTMLElement>('[data-cups]');
    if (brew && cups) {
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: 'numeric', hour12: false }).format(new Date()));
      let n = Math.max(0, Math.min(4, Math.floor((hour - 6) / 3)));
      cups.textContent = String(n);
      // coffees as dots on rings round the pulse: eight to a ring; when a
      // ring is full the next, a little wider, draws itself round it
      const NS = 'http://www.w3.org/2000/svg';
      const ringsG = root.querySelector<SVGGElement>('[data-rings]');
      const dots: SVGCircleElement[] = [];
      let rings = 0;
      const addRing = (animate: boolean) => {
        if (!ringsG || rings >= 3) return;
        const R = 118 + rings * 40;
        const orbit = document.createElementNS(NS, 'circle');
        orbit.setAttribute('r', String(R));
        orbit.setAttribute('pathLength', '100');
        orbit.setAttribute('class', 'a9__ring-orbit');
        ringsG.append(orbit);
        const off = rings * 22.5; // each ring's dots sit between the last one's
        const made: SVGCircleElement[] = [];
        for (let k = 0; k < 8; k++) {
          const a = ((-90 + off + k * 45) * Math.PI) / 180;
          const c = document.createElementNS(NS, 'circle');
          c.setAttribute('cx', (Math.cos(a) * R).toFixed(2));
          c.setAttribute('cy', (Math.sin(a) * R).toFixed(2));
          c.setAttribute('r', '4');
          c.setAttribute('class', 'a9__cup');
          ringsG.append(c);
          made.push(c);
        }
        dots.push(...made);
        rings++;
        if (!animate || calm) return;
        orbit.animate([{ strokeDashoffset: 100 }, { strokeDashoffset: 0 }], { duration: 1100, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        made.forEach((c, k) =>
          c.animate([{ opacity: 0, transform: 'scale(0.4)' }, { opacity: 1, transform: 'none' }], {
            duration: 420,
            delay: 250 + k * 70,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
            fill: 'backwards',
          }),
        );
      };
      const paint = (animate = false) => {
        while (rings < Math.min(3, Math.floor(n / 8) + 1)) addRing(animate);
        dots.forEach((d, i) => d.classList.toggle('is-on', i < n));
      };
      paint();
      let t = 0;
      const label = brew.querySelector<HTMLElement>('[data-brew-t]')!;
      let rest = label.textContent ?? '';
      const start = (e: Event) => {
        e.preventDefault();
        brew.classList.add('is-holding');
        label.textContent = 'Brewing…';
        t = window.setTimeout(() => {
          n++;
          caffeine += 1;
          cups.textContent = String(n);
          paint(true);
          dots[Math.min(n, dots.length) - 1]?.animate([{ transform: 'scale(1.8)' }, { transform: 'none' }], { duration: 420, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          cups.animate([{ transform: 'translateY(40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          brew.classList.remove('is-holding');
          label.textContent = 'Another';
          rest = label.textContent;
        }, 1200);
      };
      const stop = () => {
        clearTimeout(t);
        if (brew.classList.contains('is-holding')) label.textContent = rest;
        brew.classList.remove('is-holding');
      };
      brew.addEventListener('pointerdown', start);
      brew.addEventListener('pointerup', stop);
      brew.addEventListener('pointerleave', stop);
      brew.addEventListener('pointercancel', stop);
      brew.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && start(e));
      brew.addEventListener('keyup', (e) => e.key === ' ' && stop());

      // ---- sport out: hold Run and a runner laps the outer ring; every
      // kilometre burns one coffee off (its dot goes dark, the rate settles)
      const run = root.querySelector<HTMLButtonElement>('[data-run]');
      const runT = root.querySelector<HTMLElement>('[data-run-t]');
      const runner = root.querySelector<SVGCircleElement>('[data-runner]');
      const lap = root.querySelector<SVGCircleElement>('[data-lap]');
      const kmEl = root.querySelector<HTMLElement>('[data-km]');
      const ring = root.querySelector<HTMLElement>('.a9__ring');
      if (run && runner && lap && kmEl && ring) {
        const LAP = 0.4; // km per lap
        const SPEED = 0.22; // km per second, held
        let km = 0;
        let burnt = 0;
        let raf = 0;
        let last = 0;
        const draw = () => {
          const f = (km % LAP) / LAP;
          const a = -Math.PI / 2 + f * Math.PI * 2;
          runner.setAttribute('cx', (Math.cos(a) * 190).toFixed(2));
          runner.setAttribute('cy', (Math.sin(a) * 190).toFixed(2));
          lap.style.strokeDashoffset = String(100 - f * 100);
          kmEl.textContent = km.toFixed(1);
        };
        const step = (now: number) => {
          const dt = Math.min(0.1, (now - last) / 1000);
          last = now;
          km += dt * SPEED;
          draw();
