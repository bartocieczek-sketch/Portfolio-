              const d = dots[n - 1];
              n--;
              cups.textContent = String(n);
              paint();
              d?.animate([{ transform: 'scale(1.8)', opacity: 0.4 }, { transform: 'none', opacity: 1 }], { duration: 420, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
            }
          }
          if (running) raf = requestAnimationFrame(step);
        };
        const go = (e: Event) => {
          e.preventDefault();
          if (running) return;
          running = true;
          run.classList.add('is-holding');
          ring.classList.add('is-running');
          if (runT) runT.textContent = 'Running…';
          last = performance.now();
          raf = requestAnimationFrame(step);
        };
        const halt = () => {
          if (!running) return;
          running = false;
          cancelAnimationFrame(raf);
          run.classList.remove('is-holding');
          ring.classList.remove('is-running');
          if (runT) runT.textContent = 'Hold to run';
          // the lap fades back to empty, the runner waits at the start
          lap.animate([{ strokeDashoffset: lap.style.strokeDashoffset || '100' }, { strokeDashoffset: '100' }], { duration: 500, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          lap.style.strokeDashoffset = '100';
        };
        draw();
        lap.style.strokeDashoffset = '100';
        run.addEventListener('pointerdown', go);
        run.addEventListener('pointerup', halt);
        run.addEventListener('pointerleave', halt);
        run.addEventListener('pointercancel', halt);
        run.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && go(e));
        run.addEventListener('keyup', (e) => e.key === ' ' && halt());
      }
    }

    // ---- text scramble: letters settle out of random glyphs, left to right
    const GLYPHS = 'abcdefghijklmnopqrstuvwxyz/-_·';
    const scramble = (el: HTMLElement) => {
      const final = el.textContent ?? '';
      if (calm) return;
      const t0 = performance.now();
      const step = () => {
        const p = (performance.now() - t0) / 900;
        let out = '';
        for (let i = 0; i < final.length; i++) {
          const ch = final[i];
          out += ch === ' ' || p > i / final.length + 0.25 ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        el.textContent = out;
        if (p < 1.3) requestAnimationFrame(step);
        else el.textContent = final;
      };
      step();
    };
    const sio = new IntersectionObserver((es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        sio.unobserve(e.target);
        scramble(e.target as HTMLElement);
      }),
    );
    root.querySelectorAll<HTMLElement>('[data-scramble], .a9__label').forEach((el) => sio.observe(el));

    // ---- the logo square follows the cursor over the experience rows
    const jobsEl = root.querySelector<HTMLElement>('[data-jobs]');
    const trail = root.querySelector<HTMLElement>('[data-trail]');
    if (jobsEl && trail && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // every logo loaded up front, so a swap never shows an empty square
      const srcs = [...new Set([...jobsEl.querySelectorAll<HTMLElement>('li[data-logo]')].map((li) => li.dataset.logo!).filter(Boolean))];
      srcs.forEach((src) => {
        const im = new Image();
        im.src = src;
      });
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0, last = 0;
      let cur = '';
      let on = false;
      let outT = 0;
      // eased after the cursor (time-based, same feel at 60 and 120 Hz)
      const follow = (now: number) => {
        const dt = last ? Math.min(64, now - last) : 16;
        last = now;
        const k = 1 - Math.exp(-dt / 90);
        x += (tx - x) * k;
        y += (ty - y) * k;
        trail.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;
        raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.2 || on ? requestAnimationFrame(follow) : 0;
        if (!raf) last = 0;
      };
      const layer = (src: string, wipe: boolean) => {
        const im = document.createElement('img');
        im.alt = '';
        im.src = src;
        trail.append(im);
        if (wipe && !calm) {
          im.animate([{ clipPath: 'inset(0 0 100% 0)' }, { clipPath: 'inset(0 0 0% 0)' }], {
            duration: 450,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
          }).finished.then(() => {
            // keep only the top layer once it covers the square
            while (trail.children.length > 1 && trail.firstElementChild !== im) trail.firstElementChild?.remove();
          }, () => {});
        } else {
          while (trail.children.length > 1) trail.firstElementChild?.remove();
        }
      };
      const show = (src: string) => {
        clearTimeout(outT);
        if (!on) {
          // arriving: jump to the cursor, reset the wipe, then open it
          x = tx;
          y = ty;
          trail.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;
          trail.classList.add('is-reset');
          trail.classList.remove('is-out', 'is-on');
          trail.replaceChildren();
          layer(src, false);
          void trail.offsetWidth;
          trail.classList.remove('is-reset');
          trail.classList.add('is-on');
          on = true;
          cur = src;
          if (!raf) raf = requestAnimationFrame(follow);
          return;
        }
        if (src !== cur) {
          cur = src;
          layer(src, true);
        }
      };
      const hide = () => {
        if (!on) return;
        on = false;
        cur = '';
        trail.classList.add('is-out');
        trail.classList.remove('is-on');
      };
      jobsEl.addEventListener('pointermove', (e) => {
        tx = e.clientX + 110;
        ty = e.clientY;
        const src = (e.target as Element).closest<HTMLElement>('li')?.dataset.logo;
        if (src) show(src);
        else outT = window.setTimeout(hide, 80);
        if (!raf) raf = requestAnimationFrame(follow);
      });
      jobsEl.addEventListener('pointerleave', hide);
    }

    // ---- CTA: the outline fills as the section arrives (all of it on
    // hover); the orb rests by the word and follows the pointer over it
    const end = root.querySelector<HTMLElement>('[data-end]');
    const cta = root.querySelector<HTMLElement>('[data-cta]');
    const fill = root.querySelector<HTMLElement>('[data-fill]');
    const orb = root.querySelector<HTMLElement>('[data-orb]');
    const huge = root.querySelector<HTMLElement>('.a9__huge-o')!;
    // size the word to run edge to edge of the content box
    const fitWord = () => {
      if (!cta || !huge) return;
      huge.parentElement!.style.setProperty('--fit', '1');
      const k = cta.clientWidth / huge.scrollWidth;
      huge.parentElement!.style.setProperty('--fit', (k * 0.995).toFixed(4));
    };
    fitWord();
    document.fonts?.ready.then(fitWord);
    addEventListener('resize', fitWord);
    root.querySelector('[data-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' }));
    if (end && cta && fill && orb) {
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      let over = false;
      let mx = 0;
      let my = 0;
      let f = 0;
      let ox = -1;
      let oy = 0;
      let os = 1;
      let press = false;
      let raf = 0;
      cta.addEventListener('pointerenter', () => fine && (over = true));
      cta.addEventListener('pointerleave', () => (over = press = false));
      cta.addEventListener('pointermove', (e) => {
        const r = cta.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
      cta.addEventListener('pointerdown', () => (press = true));
      addEventListener('pointerup', () => (press = false));
      const step = () => {
        const r = end.getBoundingClientRect();
        const arrive = clamp((innerHeight - r.top) / r.height);
        const tf = over ? 1 : calm ? 1 : clamp((arrive - 0.25) / 0.7);
        f += (tf - f) * (over ? 0.12 : 0.2);
        fill.style.setProperty('--f', f.toFixed(4));
        // rest: just right of the "k", on the word's middle
        const W = cta.clientWidth;
        const rx = W - orb.offsetWidth * 0.75;
        const ry = huge.offsetTop + orb.offsetHeight * 0.1;
        const tx = over ? mx : rx;
        const ty = over ? my : ry;
        if (ox < 0) {
          ox = tx;
          oy = ty;
        }
        const k = calm ? 1 : 0.2;
        ox += (tx - ox) * k;
        oy += (ty - oy) * k;
        // a little stretch along the way it's moving, eased back when still
        const v = Math.min(1, Math.hypot(tx - ox, ty - oy) / 300);
        os += ((press ? 0.9 : over ? 1.08 : 1) - os) * 0.25;
        orb.style.transform = `translate(${ox.toFixed(1)}px,${oy.toFixed(1)}px) scale(${(os * (1 + v * 0.08)).toFixed(3)})`;
        raf = requestAnimationFrame(step);
      };
      new IntersectionObserver((es) => {
        if (es[0].isIntersecting) {
          if (!raf) raf = requestAnimationFrame(step);
        } else if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }).observe(end);
    }

    // ---- the nav monogram turns on scroll, like on the home page: it spins
    // with the scroll's speed and settles back face-on when it stops
    const navB = calm ? null : root.querySelector<HTMLElement>('.a9__nav .nav__home');
    if (navB) {
      let ang = 0;
      let lastY = scrollY;
      let spin = 0;
      const turn = () => {
        const v = scrollY - lastY;
        lastY = scrollY;
        if (Math.abs(v) > 0.3) ang += Math.max(-24, Math.min(24, v * 0.45));
        else ang += (Math.round(ang / 360) * 360 - ang) * 0.07;
        navB.style.transform = `perspective(260px) rotateY(${ang.toFixed(2)}deg)`;
        spin = Math.abs(v) > 0.3 || Math.abs(Math.round(ang / 360) * 360 - ang) > 0.2 ? requestAnimationFrame(turn) : 0;
      };
      addEventListener('scroll', () => {
        if (!spin) spin = requestAnimationFrame(turn);
      }, { passive: true });
    }
    // ---- after hours: the square, the sheet, the words, the photos
    const ah = root.querySelector<HTMLElement>('[data-ah]');
    if (ah) {
      const sheet = ah.querySelector<HTMLElement>('[data-ah-sheet]')!;
      const heart = root.querySelector<HTMLElement>('.hz > [data-heart]');
      const navParts = [...root.querySelectorAll<HTMLElement>('.a9__nav .nav__home, .a9__nav .nav__links a, .a9__nav .nav__toggle')];
      const dot = heart?.querySelector<HTMLElement>('[data-beat]') ?? null;
      // where the dot sits in its section, so the section can stick with
      // the dot right in the middle of the screen
      let dotOff = 0;
      const measure = () => {
        if (!heart || !dot) return;
        // measured unstuck, so it doesn't matter where the page is
        heart.style.position = 'relative';
        const hb = heart.getBoundingClientRect();
        const db = dot.getBoundingClientRect();
        heart.style.position = '';
        dotOff = db.top + db.height / 2 - hb.top;
        heart.style.setProperty('--stick', `${innerHeight / 2 - dotOff}px`);
      };
      measure();
      addEventListener('resize', measure);
      const head = ah.querySelector<HTMLElement>('[data-ah-head]')!;
      const roll = ah.querySelector<HTMLElement>('[data-ah-roll]')!;
      const notes = ah.querySelector<HTMLElement>('[data-ah-notes]')!;
      const pics = [...ah.querySelectorAll<HTMLElement>('[data-ah-pic]')].map((el) => ({
        el,
        img: el.querySelector('img')!,
        c: Number(el.dataset.c),
        d: Number(el.dataset.d),
      }));
      const nC = Math.max(1, Number(getComputedStyle(ah).getPropertyValue('--n')) || 3);
      const bpmEl = ah.querySelector<HTMLElement>('[data-ah-bpm]');
      const bpmB = bpmEl?.querySelector('b');
      const bpms: number[] = bpmEl ? JSON.parse(bpmEl.dataset.ahBpm || '[]') : [];
      // what the counter shows: the desk's 62 bpm, then each chapter's own
      // figure (a half-marathon time, the longest ride...), as three digit
      // columns with an optional colon after the first
      type St = { d: (number | null)[]; colon: number; unit: string };
      const parse = (str: string, unit: string): St => {
        const digits = str.replace(/[^0-9]/g, '').slice(-3).split('').map(Number);
        const pad: (number | null)[] = [null, null, null].slice(digits.length).concat(digits);
        return { d: pad, colon: str.includes(':') ? 1 : 0, unit };
      };
      const stats: { s: string; u: string }[] = bpmEl ? JSON.parse(bpmEl.dataset.ahStats || '[]') : [];
      const states: St[] = stats.map((x) => parse(x.s, x.u));
      const unitEl = bpmEl?.querySelector<HTMLElement>('.ah__unit') ?? null;
      let aShown = 0;
      let aTarget = 0;
      let aRaf = 0;
      let aT = 0;
      let unitShown = states[0]?.unit ?? 'bpm';
      // the columns: each strip runs 0, 9, 8 ... 1, 0 from the top, so a
      // digit going up rolls in from above; every column rolls on its own,
      // slot-machine style, between one figure and the next
      const strips: HTMLElement[] = [];
      const cols: HTMLElement[] = [];
      let colonEl: HTMLElement | null = null;
      if (bpmB) {
        bpmB.textContent = '';
        for (let i = 0; i < 3; i++) {
          const col = document.createElement('span');
