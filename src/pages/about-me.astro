    position: sticky;
    top: var(--stick, 0px);
    z-index: 1;
  }
  .ah {
    position: relative;
    z-index: 2;
    /* the last screen overlaps the next section: once the white has closed
       the page carries straight on, no empty screen to scroll past */
    height: calc(100svh + var(--n, 3) * 240svh + 100svh);
    margin-bottom: -100svh;
    pointer-events: none;
  }
  .ah__pin {
    position: sticky;
    top: 0;
    height: 100svh;
  }
  /* the sheet reaches far above the pin, so the circle can open over the
     pulse while the pin is still on its way up */
  .ah__sheet {
    position: absolute;
    top: -180svh;
    right: 0;
    bottom: 0;
    left: 0;
    background: var(--ink);
    color: var(--bg);
    clip-path: circle(0 at 50% 100%);
    will-change: clip-path;
  }
  .ah__in {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 100svh;
    overflow: hidden;
  }
  .ah__head {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    text-align: center;
    pointer-events: none;
    opacity: 0;
  }
  /* the big words sit back, behind the photos */
  .ah__t,
  .ah__w {
    color: rgba(10, 10, 10, 0.6);
  }
  .ah__t {
    margin: 0;
    font: 500 clamp(56px, 11vw, 200px) / 0.9 var(--font-head);
    letter-spacing: -0.05em;
  }
  /* the word: a stack in a one-line window, rolled by scroll */
  .ah__w {
    height: 1.18em;
    margin: -0.02em 0 0;
    overflow: hidden;
    font: 500 clamp(56px, 11vw, 200px) / 1.18 var(--font-head);
    letter-spacing: -0.05em;
  }
  .ah__w-roll,
  .ah__note-roll {
    display: grid;
    will-change: transform;
  }
  .ah__w-roll span {
    height: 1.18em;
  }
  .ah__note {
    height: 1.4em;
    margin: clamp(12px, 1.6vw, 24px) 0 0;
    overflow: hidden;
    font-size: clamp(14px, 1.1vw, 17px);
    line-height: 1.4;
    color: rgb(110, 110, 110);
  }
  .ah__note-roll span {
    height: 1.4em;
  }
  .ah__pic {
    position: absolute;
    top: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    background: rgb(225, 225, 222);
    transform: translate3d(0, 120svh, 0);
    will-change: transform;
  }
  .ah__pic img {
    display: block;
    width: 100%;
    height: 118%;
    object-fit: cover;
    will-change: transform;
  }
  @media (max-width: 809px) {
    .ah__pic {
      border-radius: 4px;
    }
  }

  /* the odometer: a column per digit, its strip scrubbed by the scroll;
     soft edges so digits roll in and out of view rather than being cut */
  .ah__bpm b {
    display: inline-flex;
    font-variant-numeric: tabular-nums;
  }
  .ah__bpm :global(.ah__col) {
    display: inline-block;
    width: 0.6em;
    height: 1.04em;
    margin: -0.07em 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(transparent, #000 9%, #000 91%, transparent);
  }
  .ah__bpm :global(.ah__colon) {
    display: inline-block;
    overflow: hidden;
    text-align: center;
    line-height: 1.04em;
    height: 1.04em;
    margin: -0.07em 0;
  }
  /* one fixed box for every unit (h, km, bpm), so swapping it never
     shifts the number */
  .ah__unit {
    display: inline-block;
    width: 1.9em;
    text-align: left;
    transition:
      opacity 0.16s ease,
      filter 0.16s ease;
  }
  .ah__unit.is-swap {
    opacity: 0;
    filter: blur(4px);
  }
  .ah__bpm :global(.ah__strip) {
    display: block;
    will-change: transform;
  }
  .ah__bpm :global(.ah__strip > span) {
    display: block;
    height: 1.04em;
    line-height: 1.04em;
    text-align: center;
  }
  /* the Strava badge over the figure, quiet: a faint tint of the page,
     everything in the figure's grey; the logo turns Strava orange on
     hover. It takes the pointer even though the stage around it doesn't */
  .ah__strava {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(16px, 2.4vw, 32px);
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.045);
    font: 500 14px / 1 var(--font-head);
    letter-spacing: -0.01em;
    color: rgba(10, 10, 10, 0.6);
    text-decoration: none;
    pointer-events: auto;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.16s var(--e-out);
  }
  .ah__strava-i {
    display: inline-flex;
    transition: color 0.25s ease;
  }
  .ah__strava-i :global(svg) {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .ah__strava-a {
    transition: transform 0.25s var(--e-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ah__strava:hover {
      background: rgba(10, 10, 10, 0.08);
      color: var(--bg);
    }
    .ah__strava:hover .ah__strava-i {
      color: #fc4c02;
    }
    .ah__strava:hover .ah__strava-a {
      transform: translate(2px, -2px);
    }
  }
  .ah__strava:active {
    transform: scale(0.97);
  }
  .ah__strava:focus-visible {
    outline: 1px solid rgba(10, 10, 10, 0.4);
    outline-offset: 3px;
  }
  /* ---- after-hours layouts (drafts) ---- */
  /* counter, pared down: just the number, a small bpm and the word */
  .ah[data-layout='counter'] .ah__t,
  .ah[data-layout='counter'] .ah__note,
  .ah[data-layout='counter'] .ah__bpm i {
    display: none;
  }
  /* counter: the pulse is the headline, a big live number */
  .ah[data-layout='counter'] .ah__bpm {
    gap: 0.05em;
    margin: 0;
    font: 500 clamp(120px, 27vw, 480px) / 0.82 var(--font-head);
    letter-spacing: -0.06em;
    color: rgba(10, 10, 10, 0.6);
  }
  .ah[data-layout='counter'] .ah__bpm b {
    color: inherit;
    font-weight: 500;
  }
  .ah[data-layout='counter'] .ah__bpm i {
    width: 0.09em;
    height: 0.09em;
    align-self: flex-start;
    margin-top: 0.1em;
  }
  .ah[data-layout='counter'] .ah__bpm span {
    align-self: flex-end;
    margin-bottom: 0.08em;
    font-size: 0.14em;
    letter-spacing: -0.02em;
  }
  .ah[data-layout='counter'] .ah__t,
  .ah[data-layout='mask'] .ah__t {
    order: -1;
    margin-bottom: clamp(16px, 2vw, 28px);
    font-size: clamp(15px, 1.2vw, 18px);
    letter-spacing: -0.01em;
    color: rgb(110, 110, 110);
  }
  .ah[data-layout='counter'] .ah__note {
    margin-top: 6px;
    font-family: var(--font-head);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ah[data-layout='counter'] .ah__w {
    margin-top: clamp(8px, 1.2vw, 20px);
    font-size: clamp(22px, 2.2vw, 36px);
    letter-spacing: -0.02em;
    color: rgba(10, 10, 10, 0.6);
  }
  .ah[data-layout='counter'] .ah__head,
  .ah[data-layout='mask'] .ah__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  /* split: the text holds the left half, photos stream up the right */
  .ah[data-layout='split'] .ah__head {
    right: 50%;
    justify-items: start;
    text-align: left;
    padding-left: var(--pad);
  }
  .ah[data-layout='split'] .ah__t,
  .ah[data-layout='split'] .ah__w {
    font-size: clamp(48px, 7.4vw, 132px);
    color: var(--bg);
  }
  /* mask: the word is cut out of the chapter's first photo */
  .ah[data-layout='mask'] .ah__w {
    height: 0.98em;
    font-size: clamp(96px, 23vw, 420px);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }
  .ah[data-layout='mask'] .ah__w-roll span {
    height: 0.98em;
    padding: 0 0.04em;
    background: var(--img, var(--bg)) center / cover;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ah[data-layout='mask'] .ah__bpm {
    margin: clamp(12px, 1.6vw, 24px) 0 0;
    order: 3;
  }
  /* caption: one big photo per chapter in the middle, the text small in
     the bottom-left corner like a caption */
  .ah[data-layout='caption'] .ah__head {
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: var(--pad);
    padding-bottom: clamp(24px, 5vh, 56px);
    text-align: left;
  }
  .ah[data-layout='caption'] .ah__t {
    order: -1;
    font-size: clamp(15px, 1.2vw, 18px);
    letter-spacing: -0.01em;
    color: rgb(110, 110, 110);
  }
  .ah[data-layout='caption'] .ah__w {
    font-size: clamp(44px, 6vw, 104px);
    color: var(--bg);
  }
  .ah[data-layout='caption'] .ah__bpm {
    order: 3;
    margin: 12px 0 0;
  }
  .ah[data-layout='caption'] .ah__note {
    margin-top: 4px;
  }
  /* contact rows: bigger than the experience rows (they're the point of
     the page's end). One light block serves them all: it wipes in under
     the first row the pointer meets, glides from row to row, and wipes out
     when the pointer leaves. It sits on top in difference mode, so the
     text under it inverts exactly where it's covered, mid-glide too */
  .a9__ct {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .a9__ct li {
    border-bottom: 1px solid var(--rule);
  }
  .a9__ct li.a9__ct-hl {
    position: absolute;
    top: 0;
    left: calc(-1 * var(--pad) / 2);
    right: calc(-1 * var(--pad) / 2);
    height: var(--h, 0px);
    border: 0;
    background: var(--ink);
    mix-blend-mode: difference;
    pointer-events: none;
    transform: translateY(var(--y, 0px));
    clip-path: inset(0 100% 0 0);
    transition:
      transform 0.5s var(--e-out),
      height 0.5s var(--e-out),
      clip-path 0.45s var(--e-out);
  }
  .a9__ct li.a9__ct-hl.is-on {
    clip-path: inset(0 0 0 0);
  }
  .a9__ct li.a9__ct-hl.is-out {
    clip-path: inset(0 0 0 100%);
  }
  .a9__ct li.a9__ct-hl.is-snap {
    transition: none;
  }
  .a9__ct-row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 80px;
    gap: 16px;
    align-items: baseline;
    width: 100%;
    padding: clamp(14px, 1.6vw, 22px) 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.16s var(--e-out);
  }
  .a9__ct-n {
    font: 500 clamp(22px, 2.4vw, 38px) / 1.05 var(--font-head);
    letter-spacing: -0.03em;
    transition: transform 0.5s var(--e-out);
  }
  .a9__ct-d {
    font-size: 15px;
    color: var(--grey);
    transition:
      color 0.3s ease,
      filter 0.2s ease,
      opacity 0.2s ease;
  }
  .a9__ct-a {
    justify-self: end;
    font-size: 15px;
    color: var(--grey);
    transition:
      color 0.3s ease,
      transform 0.5s var(--e-out);
  }
  .a9__ct-row:active {
    transform: scale(0.99);
  }
  .a9__ct-row:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.5);
    outline-offset: 4px;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__ct-row:hover .a9__ct-n {
      transform: translateX(14px);
    }
    /* under the block grey would turn mid-grey: lift it so it reads dark */
    .a9__ct-row:hover .a9__ct-d,
    .a9__ct-row:hover .a9__ct-a {
      color: var(--ink);
    }
    .a9__ct-row:hover .a9__ct-a {
      transform: translateX(-14px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .a9__ct li.a9__ct-hl {
      transition: clip-path 0.2s ease;
    }
    .a9__ct-n,
    .a9__ct-a {
      transition: color 0.2s ease;
    }
  }
  .a9__ct-d.is-swap {
    filter: blur(2px);
    opacity: 0;
  }
  @media (max-width: 809px) {
    .a9__ct-row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 4px;
    }
    .a9__ct-d {
      grid-row: 2;
      grid-column: 1 / -1;
    }
  }
  /* the footer as a hairline row, like the label rows above */
  .a9__lt-foot {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    position: relative;
    z-index: 1;
    margin: clamp(80px, 10vw, 160px) var(--pad) 0;
    padding: 14px 0 6px;
    font-size: 13px;
    color: var(--grey);
  }
  .a9__lt-foot > :nth-child(2) {
    justify-self: center;
  }
  .a9__lt-foot > :last-child {
    justify-self: end;
  }
  @media (max-width: 809px) {
    .a9__lt-foot {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .a9__lt-foot > :nth-child(2),
    .a9__lt-foot > :last-child {
      justify-self: start;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .a9__lt-c,
    .ob--live i {
      animation: none;
    }
  }

  /* 6 (old): the close */
  .a9__close {
    display: grid;
    gap: 0;
    padding: clamp(120px, 22vh, 240px) var(--pad) var(--pad);
  }
  .a9__close-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    font-size: 13px;
    color: var(--grey);
  }
  .a9__close-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    animation: a9-live 2.4s var(--e-out) infinite;
  }
  @keyframes a9-live {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.45); }
    70%, 100% { box-shadow: 0 0 0 10px rgba(255, 255, 255, 0); }
  }
  .a9__close-q {
    max-width: 30ch;
    margin: 0;
    font-size: 15px;
    color: var(--grey);
  }
  /* the hero's blackletter again, so the page opens and closes the same way */
  .a9__close-big {
    display: flex;
    align-items: flex-start;
    gap: 0.06em;
    width: fit-content;
    margin: clamp(8px, 1vw, 16px) 0 clamp(48px, 7vw, 96px);
    font: 400 clamp(88px, 15vw, 260px) / 0.95 'Pirata One', var(--font-display);
    color: var(--ink);
    text-decoration: none;
  }
  .a9__close-big :global(.w) {
    padding: 0.12em 0.06em;
    margin: -0.12em -0.06em;
  }
  .a9__close-big i {
    font: 400 0.32em/1 var(--font-head);
    font-style: normal;
    margin-top: 0.4em;
    color: var(--grey);
    transition:
      transform 0.35s var(--e-out),
      color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__close-big:hover i {
      color: var(--ink);
      transform: translate(0.12em, -0.12em);
    }
  }
  .a9__close-links a {
    display: contents;
    color: inherit;
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__close-links li:hover .a9__when {
      color: var(--ink);
    }
  }
  .a9__close .a9__foot {
    margin-top: clamp(64px, 9vw, 120px);
  }
  @media (prefers-reduced-motion: reduce) {
    .a9__close-dot {
      animation: none;
    }
  }

  /* 3b: numbers — no boxes: each figure set as big as the pulse readout,
     its label beside it, the rows stepping in and out across the page.
     They drop in like bricks and count once they've landed. */
  .a9__nm {
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.4vw, 24px);
  }
  .a9__nm-c {
    display: flex;
    align-items: flex-end;
    gap: clamp(12px, 1.6vw, 28px);
    margin-left: var(--x);
  }
  /* the same entrance as the rest of the page: each figure rises out of
     its own line mask while its blur clears, one row after another; the
     label follows a beat later; the figure counts while it settles */
  .a9__nm-v {
    overflow: hidden;
    padding-top: 0.06em;
  }
  .a9__nm-in {
    display: inline-block;
    transform: translateY(105%);
    filter: blur(10px);
    opacity: 0;
    transition:
      transform 1.2s var(--e-expo),
      filter 0.9s var(--e-out),
      opacity 0.6s var(--e-out);
    transition-delay: calc(var(--i) * 110ms);
  }
  .a9__nm.is-in .a9__nm-in {
    transform: none;
    filter: none;
    opacity: 1;
  }
  .a9__nm-l {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.6s var(--e-out),
      transform 0.8s var(--e-out);
    transition-delay: calc(var(--i) * 110ms + 350ms);
  }
  .a9__nm.is-in .a9__nm-l {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .a9__nm-in,
    .a9__nm-l {
      transform: none;
      filter: none;
    }
  }
  .a9__nm-v {
    margin: 0;
    font: 500 clamp(96px, 15vw, 260px) / 0.8 var(--font-head);
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .a9__nm-l {
    max-width: 16ch;
    margin: 0 0 0.6em;
    font-size: 14px;
    color: var(--grey);
  }
  @media (max-width: 809px) {
    .a9__nm-c {
      margin-left: calc(var(--x) * 0.4);
    }
    .a9__nm-v {
      font-size: 24vw;
    }
    .a9__nm-l {
      font-size: 13px;
    }
  }

  /* numbers and clients as rows like the experience list */
  .a9__rows-sec {
    padding-top: 0;
  }
  .a9__sec:has(+ .a9__rows-sec) {
    padding-bottom: clamp(56px, 8vh, 96px);
  }
  .a9__nmr-v {
    color: var(--ink);
  }
  .a9__clr a {
    display: contents;
    color: inherit;
    text-decoration: none;
  }
  .a9__clr-n {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .a9__clr-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    overflow: hidden;
    background: #1a1a1a;
  }
  .a9__clr-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .a9__clr-logo.is-svg {
    padding: 4px;
  }
  .a9__clr-logo.is-svg img {
    object-fit: contain;
  }
  .a9__clr-logo b {
    font-weight: 500;
    font-size: 12px;
    color: var(--grey);
  }
  /* logos under the numbers: a row of tiles with names, arriving in turn
     with the same blur-clear as everything else */
  .a9__cl {
    margin-top: clamp(64px, 9vw, 140px);
    padding-top: 18px;
    border-top: 1px solid var(--rule);
  }
  .a9__cl-t {
    margin: 0 0 24px;
    font-size: 13px;
    color: var(--grey);
  }
  .a9__cl ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: clamp(20px, 2.4vw, 36px) clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .a9__cl li {
    opacity: 0;
    filter: blur(8px);
    transform: translateY(10px);
    transition:
      opacity 0.7s var(--e-out),
      filter 0.8s var(--e-out),
      transform 1s var(--e-expo);
    transition-delay: calc(var(--i) * 70ms);
  }
  .a9__cl.is-in li {
    opacity: 1;
    filter: none;
    transform: none;
  }
  .a9__cl a,
  .a9__cl-w {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--ink);
    text-decoration: none;
  }
  .a9__cl-logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    overflow: hidden;
    background: #1a1a1a;
  }
  .a9__cl-logo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .a9__cl-logo.is-svg {
    padding: 10px;
  }
  .a9__cl-logo.is-svg img {
    object-fit: contain;
  }
  .a9__cl-logo b {
    font-weight: 500;
    color: var(--grey);
  }
  .a9__cl-n {
    font-size: 15px;
    color: var(--grey);
    transition: color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
