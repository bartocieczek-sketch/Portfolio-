    addEventListener('a9:reveal', reveal);
    // no 3D (or calm): nothing to uncover it, so it just follows the hero
    setTimeout(() => {
      if (!(window as any).__a9Mask) {
        root.querySelector('[data-who]')?.classList.add('is-flat');
        reveal();
      }
