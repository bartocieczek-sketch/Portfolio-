---
// About me, for now: just the B, in silver chrome on the dark page, rising
// into place as the page opens out of its line (see global.css about-in).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { SETTINGS_QUERY } from '../lib/sanity';
import { load } from '../lib/load';

const settings = await load(Astro.locals, SETTINGS_QUERY);
if (!settings) return new Response('Content not found', { status: 500 });
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="about">
    <header class="about__top">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>
    <div class="about__say">
      <h1 class="t-display" data-split style="--split-delay:700ms">
        Hi, I’m Bart — a designer &amp; developer pushing my horizons further with AI every day. Fuelled by sport and way too much coffee.
      </h1>
    </div>
    <canvas class="about__mark" data-monogram aria-label="B monogram" role="img"></canvas>
  </main>
</Base>

<style>
  .about {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--surface-dark);
  }
  .about__top {
    position: relative;
    z-index: 2;
    padding: var(--gutter);
  }
  /* the statement sits underneath the B; the chrome passes over it */
  .about__say {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .about__say h1 {
    margin: 0;
    max-width: 1400px;
    text-align: center;
    font-size: clamp(40px, 7.4vw, 120px);
    color: var(--text-primary);
  }
  .about__mark {
    z-index: 2;
    opacity: 0.85;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
      import * as THREE from 'three';
      import { SVGLoader } from 'three/examples/jsm/loaders/SVGLoader.js';
      import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
      import glyphs from '../lib/monogram-b.json';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-monogram]');
      if (canvas) {
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;
      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 1.25;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      // soft key light + a warm rim, on top of the room reflections
      const key = new THREE.DirectionalLight(0xffffff, 2.4);
      key.position.set(-3, 4, 6);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0xffe2c4, 0.8);
      rim.position.set(4, -2, -3);
      scene.add(rim);


      // polished black chrome: deep, with crisp reflections running along
      // the strokes as it turns
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xd9d9de,
        roughness: 0.16,
        metalness: 1.0,
        clearcoat: 1,
        clearcoatRoughness: 0.05,
        transparent: true,
        opacity: 0,
      });

      const U = glyphs.upm;
      const shapesOf = (d: string) => {
        const data = new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${d}"/></svg>`);
        return data.paths.flatMap((p) => p.toShapes(true));
      };
      const letter = (ch: 'B', depth: number) => {
        const [d] = glyphs.g[ch] as [string, number[], number];
        const geo = new THREE.ExtrudeGeometry(shapesOf(d), {
          depth,
          bevelEnabled: true,
          bevelThickness: 22,
          bevelSize: 6,
          bevelSegments: 6,
          curveSegments: 28,
        });
        geo.computeBoundingBox();
        const bb = geo.boundingBox!;
        geo.translate(-(bb.min.x + bb.max.x) / 2, -(bb.min.y + bb.max.y) / 2, -(bb.min.z + bb.max.z) / 2);
        geo.scale(1 / U, 1 / U, 1 / U);
        geo.computeVertexNormals();
        return new THREE.Mesh(geo, mat);
      };

      // just the B, a slim slab: thin, with a fine bevel catching the light
      const logo = new THREE.Group();
      const B = letter('B', 150);
      B.scale.setScalar(3.1);
      logo.add(B);
      scene.add(logo);

      const resize = () => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        camera.position.z = w < h ? 13 : 9;
      };
      addEventListener('resize', resize);
      resize();

      // slow idle turn; the pointer tilts it (eased, never snaps)
      let px = 0;
      let py = 0;
      addEventListener('pointermove', (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
      });
      let rx = 0;
      let ry = 0;
      const t0 = performance.now();
      // entrance (as the dark page opens): it rises a little, turns in from a
      // three-quarter view and grows to size on a long ease-out
      const IN_DELAY = 0.45;
      const IN_DUR = 1.8;
      const easeOut = (x: number) => 1 - Math.pow(1 - x, 4);
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tick = () => {
        const t = (performance.now() - t0) / 1000;
        const idle = calm ? 0 : Math.sin(t * 0.45) * 0.35;
        ry += (idle + px * 0.5 - ry) * 0.05;
        rx += (py * 0.3 - rx) * 0.05;
        const k = calm ? 1 : easeOut(Math.min(1, Math.max(0, (t - IN_DELAY) / IN_DUR)));
        logo.rotation.set(rx + (1 - k) * 0.5, ry - (1 - k) * 1.6, (1 - k) * -0.15);
        logo.position.y = (calm ? 0 : Math.sin(t * 0.8) * 0.05) - (1 - k) * 0.9;
        logo.scale.setScalar(0.75 + 0.25 * k);
        (mat as THREE.MeshPhysicalMaterial).opacity = k;
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      };
      tick();
      }
</script>
