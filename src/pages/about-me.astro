---
// About me: the B in silver chrome on the dark page over a short statement.
// The page scrolls: the words light up one by one and the B turns.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { SETTINGS_QUERY } from '../lib/sanity';
import { load } from '../lib/load';

const settings = await load(Astro.locals, SETTINGS_QUERY);
if (!settings) return new Response('Content not found', { status: 500 });
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="about" data-about>
    <header class="about__top">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>
    <!-- a tall page with one sticky stage: scrolling lights the statement up
         word by word and turns the B -->
    <section class="about__stage">
      <div class="about__say">
        <h1 class="t-display" data-say>
          Hi, I’m Bart — a design engineer pushing my horizons further with AI every day. Fuelled by sport and way too much coffee.
        </h1>
      </div>
      <canvas class="about__mark" data-monogram aria-label="B monogram" role="img"></canvas>
      <span class="about__hint" aria-hidden="true">Scroll</span>
    </section>
  </main>
</Base>

<style>
  .about {
    position: relative;
    height: 260svh;
    background: var(--surface-dark);
  }
  .about__top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 3;
    padding: var(--gutter);
  }
  .about__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  /* the statement sits underneath the B; the chrome passes over it */
  .about__say {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .about__say h1 {
    margin: 0;
    max-width: 1000px;
    text-align: center;
    font-size: clamp(28px, 4.4vw, 68px);
    line-height: 0.98;
    color: var(--text-primary);
    will-change: transform;
  }
  /* each word rises out of its own mask, tilted, line after line */
  .about__say :global(.sw) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .about__say :global(.swi) {
    display: inline-block;
    transform: translateY(115%) rotate(7deg);
    transform-origin: 0 100%;
    opacity: var(--lit, 0.28);
    transition:
      transform 1.15s var(--ease-expo),
      opacity 0.35s var(--ease-out);
    transition-delay: calc(var(--l, 0) * 90ms + var(--i, 0) * 14ms), 0ms;
  }
  .about__say.is-in :global(.swi) {
    transform: none;
  }
  .about__mark {
    z-index: 2;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .about__hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 3;
    transform: translateX(-50%);
    font: 500 12px/1 var(--font-head);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-secondary);
    opacity: 0;
    transition: opacity 0.6s var(--ease-out) 1.6s;
  }
  .about__say.is-in ~ .about__hint {
    opacity: calc(1 - var(--p, 0) * 6);
    transition-delay: 1.6s;
  }
  @media (prefers-reduced-motion: reduce) {
    .about__say :global(.swi) {
      transform: none;
      transition: opacity 0.35s ease;
    }
  }
</style>

<script>
  // The statement: split into words, each in a mask; the lines rise in as the
  // dark page opens. Then the scroll lights it up word by word (from dim to
  // full) and lifts it a touch, while the B (below) turns with it.
  const say = document.querySelector<HTMLElement>('[data-say]');
  const wrap = say?.parentElement;
  const page = document.querySelector<HTMLElement>('[data-about]');
  if (say && wrap && page) {
    const words: HTMLElement[] = [];
    const text = say.textContent!.trim().split(/\s+/);
    say.textContent = '';
    text.forEach((w, i) => {
      const o = document.createElement('span');
      o.className = 'sw';
      const n = document.createElement('span');
      n.className = 'swi';
      n.textContent = w;
      o.appendChild(n);
      say.appendChild(o);
      if (i < text.length - 1) say.appendChild(document.createTextNode(' '));
      words.push(n);
    });
    const lines = () => {
      let line = -1;
      let top = -1;
      let i = 0;
      words.forEach((n) => {
        const t = (n.parentElement as HTMLElement).offsetTop;
        if (t !== top) {
          line++;
          top = t;
          i = 0;
        }
        n.style.setProperty('--l', String(line));
        n.style.setProperty('--i', String(i++));
      });
    };
    lines();
    addEventListener('resize', lines);
    // in once the page has opened out of its line
    setTimeout(() => wrap.classList.add('is-in'), 650);

    let p = 0;
    const onScroll = () => {
      const max = page.offsetHeight - innerHeight;
      p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      // light the words over the first 85% of the scroll, a soft edge of ~3
      const f = (p / 0.85) * (words.length + 3) - 3;
      words.forEach((n, k) => {
        const v = Math.min(1, Math.max(0, (f - k + 3) / 3));
        n.style.setProperty('--lit', (0.28 + 0.72 * v).toFixed(3));
      });
      say.style.transform = `translateY(${(-p * 6).toFixed(2)}vh)`;
      wrap.parentElement!.style.setProperty('--p', p.toFixed(3));
      (window as any).__aboutP = p;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<script>
      import * as THREE from 'three';
      import { SVGLoader } from 'three/examples/jsm/loaders/SVGLoader.js';
      import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
      import glyphs from '../lib/monogram-b.json';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-monogram]');
      if (canvas) {
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;
      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 1.25;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      // soft key light + a warm rim, on top of the room reflections
      const key = new THREE.DirectionalLight(0xffffff, 2.4);
      key.position.set(-3, 4, 6);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0xffe2c4, 0.8);
      rim.position.set(4, -2, -3);
      scene.add(rim);


      // polished black chrome: deep, with crisp reflections running along
      // the strokes as it turns
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xd9d9de,
        roughness: 0.16,
        metalness: 1.0,
        clearcoat: 1,
        clearcoatRoughness: 0.05,
        transparent: true,
        opacity: 0,
      });

      const U = glyphs.upm;
      const shapesOf = (d: string) => {
        const data = new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${d}"/></svg>`);
        return data.paths.flatMap((p) => p.toShapes(true));
      };
      const letter = (ch: 'B', depth: number) => {
        const [d] = glyphs.g[ch] as [string, number[], number];
        const geo = new THREE.ExtrudeGeometry(shapesOf(d), {
          depth,
          bevelEnabled: true,
          bevelThickness: 22,
          bevelSize: 6,
          bevelSegments: 6,
          curveSegments: 28,
        });
        geo.computeBoundingBox();
        const bb = geo.boundingBox!;
        geo.translate(-(bb.min.x + bb.max.x) / 2, -(bb.min.y + bb.max.y) / 2, -(bb.min.z + bb.max.z) / 2);
        geo.scale(1 / U, 1 / U, 1 / U);
        geo.computeVertexNormals();
        return new THREE.Mesh(geo, mat);
      };

      // just the B, a slim slab: thin, with a fine bevel catching the light
      const logo = new THREE.Group();
      const B = letter('B', 150);
      B.scale.setScalar(3.1);
      logo.add(B);
      scene.add(logo);

      const resize = () => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        camera.position.z = w < h ? 13 : 9;
      };
      addEventListener('resize', resize);
      resize();

      // slow idle turn; the pointer tilts it (eased, never snaps)
      let px = 0;
      let py = 0;
      addEventListener('pointermove', (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
      });
      let rx = 0;
      let ry = 0;
      let sy = 0; // the scroll, smoothed
      const t0 = performance.now();
      // entrance (as the dark page opens): it rises a little, turns in from a
      // three-quarter view and grows to size on a long ease-out
      const IN_DELAY = 0.45;
      const IN_DUR = 1.8;
      const easeOut = (x: number) => 1 - Math.pow(1 - x, 4);
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tick = () => {
        const t = (performance.now() - t0) / 1000;
        const idle = calm ? 0 : Math.sin(t * 0.45) * 0.35;
        ry += (idle + px * 0.5 - ry) * 0.05;
        rx += (py * 0.3 - rx) * 0.05;
        const k = calm ? 1 : easeOut(Math.min(1, Math.max(0, (t - IN_DELAY) / IN_DUR)));
        const sp = (window as any).__aboutP ?? 0;
        sy += (sp - sy) * 0.08;
        logo.rotation.set(rx + (1 - k) * 0.5, ry - (1 - k) * 1.6 + sy * Math.PI * 2, (1 - k) * -0.15);
        logo.position.y = (calm ? 0 : Math.sin(t * 0.8) * 0.05) - (1 - k) * 0.9;
        logo.scale.setScalar(0.75 + 0.25 * k);
        (mat as THREE.MeshPhysicalMaterial).opacity = k;
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      };
      tick();
      }
</script>
