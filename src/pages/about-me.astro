          // nearer = bigger and brighter; fast dots streak a little brighter
          const near = Math.min(Math.max((z2 + depth) / (depth * 2), 0), 1.6);
          const speed = Math.min(Math.abs(qx[i]) + Math.abs(qy[i]) + Math.abs(qz[i]) * 0.5, 20) / 20;
          const tw8 = calm ? 0 : Math.sin(now * 0.0014 + tw[i]) * 0.05;
          dctx.globalAlpha = Math.min(v * (0.22 + near * 0.26 + tw8 + lit * 0.7 + speed * 0.5), 1);
          const s = dot * f * (0.8 + near * 0.35 + lit * 0.8);
          dctx.fillRect(sx - s / 2, sy - s / 2, s, s);
        }
        dctx.globalCompositeOperation = 'source-over';
        if (pending && !left) pending = false;
        if (inView) raf = requestAnimationFrame(frame);
      };
      const kick = () => {
        if (!raf && inView) raf = requestAnimationFrame(frame);
      };
      build();
      caption(0);
      mark.classList.add('has-dots');
      new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        if (inView && !entered) {
          start = 0;
          entered = true;
        }
        if (inView) nextAt = Math.max(nextAt, performance.now() + 1500);
        kick();
      }, { threshold: 0.1 }).observe(mark);
      let rw = innerWidth;
      addEventListener('resize', () => {
        if (Math.abs(innerWidth - rw) < 2 && mark.clientHeight === H) return;
        rw = innerWidth;
        build();
        kick();
      });
      if (!calm) {
        const at = (e: PointerEvent) => {
          const b = mark.getBoundingClientRect();
          mx = e.clientX - b.left;
          my = e.clientY - b.top;
          axT = ((mx / W) - 0.5) * 0.7;
          ayT = -((my / H) - 0.5) * 0.45;
          pullT = 1;
          kick();
        };
        mark.addEventListener('pointermove', at);
        mark.addEventListener('pointerdown', at);
        const off = () => {
          pullT = 0;
          axT = 0;
          ayT = 0;
        };
        mark.addEventListener('pointerleave', off);
        mark.addEventListener('pointerup', (e) => {
          if (e.pointerType !== 'mouse') off();
        });
        mark.addEventListener('pointercancel', off);
        // a click sends the dots flying into the next shape straight away
        mark.addEventListener('click', (e) => {
          const now = performance.now();
          const st = (e.target as HTMLElement).closest<HTMLElement>('[data-step]');
          if (st && Number(st.dataset.step) === cur) return;
          morph(now, st ? Number(st.dataset.step) : undefined);
          nextAt = now + HOLD + 900;
          kick();
        });
      }
    }
    const ftTime = root.querySelector<HTMLElement>('[data-ft-time]');
    const ftTick = () => {
      if (ftTime) ftTime.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date());
    };
    ftTick();
    setInterval(ftTick, 15000);
    const ftCoffee = root.querySelector<HTMLElement>('[data-ft-coffee]');
    const cupsEl = root.querySelector<HTMLElement>('[data-cups]');
    if (ftCoffee && cupsEl) {
      const say = () => {
        const n = Number(cupsEl.textContent) || 0;
        const t = n === 0 ? ftCoffee.dataset.rest || 'Made with a lot of coffee' : n === 1 ? 'Made with 1 coffee so far' : `Made with ${n} coffees today`;
        if (t === ftCoffee.textContent) return;
        ftCoffee.classList.add('is-swap');
        setTimeout(() => {
          ftCoffee.textContent = t;
          ftCoffee.classList.remove('is-swap');
        }, 180);
      };
      say();
      new MutationObserver(say).observe(cupsEl, { childList: true, characterData: true, subtree: true });
    }

    // ---- the email row copies the address (falls back to mailto)
    // contact rows: one highlight block that follows the pointer
    const ct = root.querySelector<HTMLElement>('[data-ct]');
    const hl = ct?.querySelector<HTMLElement>('[data-ct-hl]');
    if (ct && hl && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let shown = false;
      let outT = 0;
      const to = (row: HTMLElement, snap: boolean) => {
        const li = row.closest('li')!;
        if (snap) hl.classList.add('is-snap');
        hl.style.setProperty('--y', `${li.offsetTop}px`);
        hl.style.setProperty('--h', `${li.offsetHeight - 1}px`);
        if (snap) {
          void hl.offsetWidth;
          hl.classList.remove('is-snap');
        }
      };
      ct.querySelectorAll<HTMLElement>('.a9__ct-row').forEach((row) => {
        row.addEventListener('pointerenter', () => {
          clearTimeout(outT);
          if (!shown) {
            // arriving from outside: jump to the row, reset the wipe to the
            // left edge, then wipe in
            hl.classList.add('is-snap');
            hl.classList.remove('is-out', 'is-on');
            to(row, true);
            hl.classList.add('is-on');
            shown = true;
          } else {
            to(row, false);
          }
        });
      });
      ct.addEventListener('pointerleave', () => {
        // a short grace period, so brushing past a hairline doesn't flicker
        outT = window.setTimeout(() => {
          shown = false;
          hl.classList.add('is-out');
          hl.classList.remove('is-on');
        }, 60);
      });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
      const t = b.querySelector<HTMLElement>('[data-copy-t]');
      const addr = b.dataset.copy ?? '';
      let timer = 0;
      const swap = (text: string) => {
        if (!t) return;
        t.classList.add('is-swap');
        setTimeout(() => {
          t.textContent = text;
          t.classList.remove('is-swap');
        }, 160);
      };
      b.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(addr);
          swap('Copied to clipboard');
          clearTimeout(timer);
          timer = window.setTimeout(() => swap(addr), 1800);
        } catch {
          location.href = `mailto:${addr}`;
        }
      });
    });

    // ---- let's talk: the clock row (Kraków) and the name sized to the page
    const ltH = root.querySelector<HTMLElement>('[data-lt-h]');
    const ltM = root.querySelector<HTMLElement>('[data-lt-m]');
    const ltTick = () => {
      const [hh, mm] = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit', hour12: false })
        .format(new Date())
        .split(':');
      if (ltH) ltH.textContent = hh;
      if (ltM) ltM.textContent = mm;
    };
    ltTick();
    setInterval(ltTick, 15000);
    const ltName = root.querySelector<HTMLElement>('[data-lt-name]');
    const fitName = () => {
      if (!ltName) return;
      const sp = ltName.firstElementChild as HTMLElement;
      ltName.style.setProperty('--fit', '1');
      ltName.style.setProperty('--fit', ((ltName.clientWidth / sp.scrollWidth) * 0.99).toFixed(4));
    };
    fitName();
    document.fonts?.ready.then(fitName);
    addEventListener('resize', fitName);

    // ---- live Kraków time
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const tick = () => {
      if (clock) clock.textContent = `Kraków, ${new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(new Date())} · open for new work`;
    };
    tick();
    setInterval(tick, 20000);
  }
</script>

<script>
      import * as THREE from 'three';
      import { SVGLoader } from 'three/examples/jsm/loaders/SVGLoader.js';
      import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
      import glyphs from '../lib/monogram-b.json';
      import { hasGPU } from '../lib/gpu';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-monogram]');
      // no real GPU: a flat silver B instead of the 3D one
      if (canvas && !hasGPU()) {
        const [d, b] = glyphs.g.B as [string, number[], number];
        const box = document.createElement('div');
        box.className = canvas.className;
        box.style.cssText = 'position:absolute;inset:0;z-index:2;display:grid;place-items:center;pointer-events:none';
        box.innerHTML = `<svg viewBox="${b[0]} ${-b[3]} ${b[2] - b[0]} ${b[3] - b[1]}" style="width:min(46vmin,420px);height:auto" aria-hidden="true"><path transform="scale(1,-1)" d="${d}" fill="#d9d9de"/></svg>`;
        canvas.replaceWith(box);
      } else if (canvas) {
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;
      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 1.25;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      // soft key light + a warm rim, on top of the room reflections
      const key = new THREE.DirectionalLight(0xffffff, 2.4);
      key.position.set(-3, 4, 6);
      scene.add(key);
      // a light that rides with the pointer, so glints run over the chrome
      const glint = new THREE.PointLight(0xffffff, 0, 0, 1.6);
      glint.position.set(0, 0, 3);
      scene.add(glint);
      const rim = new THREE.DirectionalLight(0xffe2c4, 0.8);
      rim.position.set(4, -2, -3);
      scene.add(rim);


      // polished black chrome: deep, with crisp reflections running along
      // the strokes as it turns
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xd9d9de,
        roughness: 0.16,
        metalness: 1.0,
        clearcoat: 1,
        clearcoatRoughness: 0.05,
        transparent: true,
        opacity: 0,
      });

      const U = glyphs.upm;
      const shapesOf = (d: string) => {
        const data = new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${d}"/></svg>`);
        return data.paths.flatMap((p) => p.toShapes(true));
      };
      const letter = (ch: 'B', depth: number) => {
        const [d] = glyphs.g[ch] as [string, number[], number];
        const geo = new THREE.ExtrudeGeometry(shapesOf(d), {
          depth,
          bevelEnabled: true,
          bevelThickness: 22,
          bevelSize: 6,
          bevelSegments: 6,
          curveSegments: 28,
        });
        geo.computeBoundingBox();
        const bb = geo.boundingBox!;
        geo.translate(-(bb.min.x + bb.max.x) / 2, -(bb.min.y + bb.max.y) / 2, -(bb.min.z + bb.max.z) / 2);
        geo.scale(1 / U, 1 / U, 1 / U);
        geo.computeVertexNormals();
        return new THREE.Mesh(geo, mat);
      };

      // just the B, a slim slab: thin, with a fine bevel catching the light
      const logo = new THREE.Group();
      const B = letter('B', 150);
      B.scale.setScalar(3.1);
      logo.add(B);
      scene.add(logo);

      const resize = () => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        camera.position.z = w < h ? 13 : 9;
      };
      addEventListener('resize', resize);
      resize();

      // slow idle turn; the pointer tilts it (eased, never snaps)
      let px = 0;
      let py = 0;
      addEventListener('pointermove', (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
      });
      let rx = 0;
      let ry = 0;
      let sy = 0; // the scroll, smoothed
      const t0 = performance.now();
      // entrance (as the dark page opens): it rises a little, turns in from a
      // three-quarter view and grows to size on a long ease-out
      const IN_DELAY = 0.45;
      const IN_DUR = 1.8;
      const easeOut = (x: number) => 1 - Math.pow(1 - x, 4);
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      // ---- the next section opens out of the B's edge: at the moment the
      // turning letter is side-on (a thin sliver), a slit the size of that
      // sliver opens behind it to the full screen, the B flying on in front
      const who = calm ? null : document.querySelector<HTMLElement>('[data-who]');
      if (who) (window as any).__a9Mask = true;
      B.geometry.computeBoundingBox();
      const bb = B.geometry.boundingBox!;
      const corners = Array.from({ length: 8 }, () => new THREE.Vector3());
      // the scroll value at which the letter turns side-on (rotation.y hits
      // 3π/2 on its way round), found once
      const flyAt = (s: number) => {
        const z = Math.min(1, Math.max(0, (s - 0.42) / 0.5));
        return z * z * (3 - 2 * z);
      };
      let sEdge = 0.75;
      for (let s = 0.42; s <= 1; s += 0.001) {
        const fa = flyAt(s);
        if (s * Math.PI * 2 + fa * 0.9 >= Math.PI * 1.5) {
          sEdge = s;
          break;
        }
      }
      let sent = false;
      const project = () => {
        logo.updateMatrixWorld(true);
        const W = canvas.clientWidth;
        const H = canvas.clientHeight;
        let x0 = 1e9, y0 = 1e9, x1 = -1e9, y1 = -1e9;
        let k = 0;
        for (const x of [bb.min.x, bb.max.x]) for (const y of [bb.min.y, bb.max.y]) for (const z of [bb.min.z, bb.max.z]) {
          const c = corners[k++].set(x, y, z).applyMatrix4(B.matrixWorld).project(camera);
          const sx = (c.x * 0.5 + 0.5) * W;
          const sy2 = (-c.y * 0.5 + 0.5) * H;
          x0 = Math.min(x0, sx); x1 = Math.max(x1, sx);
          y0 = Math.min(y0, sy2); y1 = Math.max(y1, sy2);
        }
        return { x0: Math.max(0, x0), y0: Math.max(0, y0), x1: Math.min(W, x1), y1: Math.min(H, y1), W, H };
      };
      const uncover = () => {
        if (!who) return;
        // hold the section in place while it opens
        const top = who.offsetTop - scrollY;
        who.style.transform = top > 0 ? `translate3d(0,${(-top).toFixed(1)}px,0)` : '';
        if (top <= 0) {
          who.style.clipPath = '';
          who.style.webkitMaskImage = who.style.maskImage = '';
          // (arrived without passing the reveal, e.g. a reload further down)
          if (!sent) {
            sent = true;
            dispatchEvent(new Event('a9:reveal'));
          }
          return;
        }
        const raw = Math.min(1, Math.max(0, (sy - sEdge) / 0.2));
        if (raw <= 0) {
          who.style.clipPath = 'inset(50% 50% 50% 50%)';
          who.style.webkitMaskImage = who.style.maskImage = '';
          return;
        }
        who.style.clipPath = '';
        // the window follows the letter itself: it is the B's own on-screen
        // box (live, so it moves and grows with it), opening out to the
        // whole screen as the letter closes in. Its edges are feathered, so
        // there's never a hard cut through the text beside the B.
        const pr = project();
        const e = raw < 0.5 ? 4 * raw * raw * raw : 1 - Math.pow(-2 * raw + 2, 3) / 2;
        const F = Math.max(60, Math.min(pr.W, pr.H) * 0.12);
        const l = pr.x0 + (-F - pr.x0) * e;
        const r = pr.x1 + (pr.W + F - pr.x1) * e;
        const t = pr.y0 + (-F - pr.y0) * e;
        const b = pr.y1 + (pr.H + F - pr.y1) * e;
        const g = (dir: string, a: number, z: number) =>
          `linear-gradient(${dir}, transparent ${a.toFixed(1)}px, #000 ${(a + F).toFixed(1)}px, #000 ${(z - F).toFixed(1)}px, transparent ${z.toFixed(1)}px)`;
        const m = `${g('to right', l, r)}, ${g('to bottom', t, b)}`;
        who.style.webkitMaskImage = who.style.maskImage = m;
        if (!sent && raw > 0.25) {
          sent = true;
          dispatchEvent(new Event('a9:reveal'));
        }
      };
      const tick = () => {
        const t = (performance.now() - t0) / 1000;
        const idle = calm ? 0 : Math.sin(t * 0.45) * 0.35;
        ry += (idle + px * 0.5 - ry) * 0.05;
        rx += (py * 0.3 - rx) * 0.05;
        const k = calm ? 1 : easeOut(Math.min(1, Math.max(0, (t - IN_DELAY) / IN_DUR)));
        const sp = (window as any).__a9P ?? 0;
        sy += (sp - sy) * 0.14;
        logo.rotation.set(rx + (1 - k) * 0.5, ry - (1 - k) * 1.6 + sy * Math.PI * 2, (1 - k) * -0.15);
        logo.position.y = (calm ? 0 : Math.sin(t * 0.8) * 0.05) - (1 - k) * 0.9;
        logo.scale.setScalar(0.75 + 0.25 * k);
        // the finale: past halfway the B rushes the camera, half-turning,
        // until the viewer passes through its bowl into the page
        const fz = Math.min(1, Math.max(0, (sy - 0.42) / 0.5));
        const fly = calm ? 0 : fz * fz * (3 - 2 * fz);
        // it flies on past the camera (no fading: it simply goes by)
        logo.position.z = fly * fly * (camera.position.z + 1.5);
        logo.position.x = fly * 0.35;
        logo.rotation.y += fly * 0.9;
        logo.rotation.x += fly * -0.25;
        if (who) uncover();
        (mat as THREE.MeshPhysicalMaterial).opacity = k;
        glint.position.x += (px * 3.2 - glint.position.x) * 0.12;
        glint.position.y += (-py * 2.2 - glint.position.y) * 0.12;
        glint.intensity += ((px || py ? 26 : 0) * k - glint.intensity) * 0.06;
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      };
      tick();
      }
</script>
