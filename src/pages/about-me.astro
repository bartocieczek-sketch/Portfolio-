    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // ---- 1: as on /about-me — each word in a tilted mask, lines rise in,
    // then the scroll lights them up word by word
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const sayWrap = say.parentElement!;
    const words: HTMLElement[] = [];
    const sayText = (say.textContent ?? '').trim().split(/\s+/);
    say.textContent = '';
    sayText.forEach((w, i) => {
      const o = document.createElement('span');
      o.className = 'sw';
      const n = document.createElement('span');
      n.className = 'swi';
      n.textContent = w;
      o.append(n);
      say.append(o);
      if (i < sayText.length - 1) say.append(' ');
      words.push(n);
    });
    const lines = () => {
      let line = -1;
      let top = -1;
      let i = 0;
      words.forEach((n) => {
        const t = (n.parentElement as HTMLElement).offsetTop;
        if (t !== top) {
          line++;
          top = t;
          i = 0;
        }
        n.style.setProperty('--l', String(line));
        n.style.setProperty('--i', String(i++));
      });
    };
    lines();
    addEventListener('resize', lines);
    // only show (and line up) the title once Pirata One is in; the rise
    // starts from there. A slow network gets the fallback after 2.5s
    let sayShown = false;
    const showSay = () => {
      if (sayShown) return;
      sayShown = true;
      lines();
      sayWrap.classList.add('is-font');
      setTimeout(() => sayWrap.classList.add('is-in'), 350);
    };
    (document.fonts?.load("400 100px 'Pirata One'") ?? Promise.resolve()).then(showSay, showSay);
    setTimeout(showSay, 2500);

    // ---- masked word rise for [data-words]
    root.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      const t = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      t.forEach((w, k) => {
        const o = document.createElement('span');
        o.className = 'w';
        const i = document.createElement('span');
        i.className = 'wi';
        i.style.setProperty('--k', String(k));
        i.textContent = w;
        o.append(i);
        el.append(o);
        if (k < t.length - 1) el.append(' ');
      });
    });

    // ---- reveal once, staggered among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
          if ((e.target as HTMLElement).hasAttribute('data-nm')) countUp(e.target as HTMLElement);
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    // figures count up with their column (ease-out, a touch after it starts)
    // figures count up while they rise into place (ease-out, same stagger)
    function countUp(box: HTMLElement) {
      box.querySelectorAll<HTMLElement>('[data-drop]').forEach((el) => {
        const num = el.querySelector<HTMLElement>('[data-count]');
        const to = Number(num?.dataset.count ?? 0);
        if (calm || !num || !to) return;
        const t0 = performance.now() + Number(el.dataset.drop) * 110;
        num.textContent = '0';
        const step = (now: number) => {
          const x = Math.min(1, Math.max(0, (now - t0) / 1200));
          num.textContent = String(Math.round(to * (1 - Math.pow(1 - x, 4))));
          if (x < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }
    const later: HTMLElement[] = [];
    root.querySelectorAll<HTMLElement>('[data-in], [data-words], [data-blur], [data-hm-mid], [data-nm], [data-prose], [data-cl], [data-lt-mark]').forEach((el) => {
      const sib = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-in'));
      el.style.setProperty('--d', `${Math.max(0, sib.indexOf(el)) * 60}ms`);
      // the section behind the B only starts once it's being uncovered
      if (el.closest('[data-who]')) later.push(el);
      else io.observe(el);
    });
    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      later.forEach((el) => io.observe(el));
