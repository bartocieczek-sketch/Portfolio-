---
// Variant of home after an editorial reference: a centred headline over one
// row of covers. The cover in the middle is the biggest, the rest step down
// towards both edges and run off-screen; the row loops and can be moved with
// the wheel, a drag, a swipe or the arrow keys, settling on a project.
// Intro: a small picture grows in the middle while flicking through the
// covers like a flip book, lands on the first project, then the others slide
// out from behind it to both sides.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const [home, settings] = await Promise.all([load(Astro.locals, HOME_QUERY), load(Astro.locals, SETTINGS_QUERY)]);
if (!home || !settings) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = (home.projects ?? []).filter((p: any) => p?.cover?.asset).map((p: any) => {
  const ar = p.cover.asset.metadata?.dimensions?.aspectRatio ?? 0.8;
  return {
    title: (p.cardTitle || p.title || '').trim(),
    href: href(Astro.locals, `/${p.slug}`),
    // the picture's own shape, kept between a tall portrait and a gentle landscape
    ratio: Math.min(1.3, Math.max(0.72, ar)),
    src: urlFor(p.cover).width(1100).fit('max').quality(82).url(),
  };
});
const clients = projects.map((p: { title: string }) => p.title);
---

<Base title={settings.seoTitle} description={settings.seoDescription}>
  <main class="v3" data-v3>
    <header class="v3__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <h1 class="v3__title">
      <span class="v3__m"><span class="v3__l">Bold, high-end sites,</span></span>
      <span class="v3__m"><span class="v3__l">built fast.</span></span>
    </h1>

    <div class="v3__row" data-row aria-label="Projects">
      {projects.map((p: { title: string; href: string; ratio: number; src: string }, i: number) => (
        <a class="v3__card" href={p.href} style={`--r:${p.ratio}`} data-i={i} aria-label={p.title} draggable="false">
          <img src={p.src} alt="" decoding="async" loading={i < 4 || i > projects.length - 4 ? 'eager' : 'lazy'} draggable="false" />
        </a>
      ))}
      <!-- the intro's flip book: the covers, stacked, shown one at a time -->
      <div class="v3__flip" data-flip aria-hidden="true">
        {projects.map((p: { src: string }) => <img src={p.src} alt="" decoding="async" />)}
      </div>
    </div>

    <p class="v3__text">{home.heroText}</p>

    <div class="v3__marquee" aria-hidden="true">
      <div class="v3__track">
        {[0, 1, 2, 3].map(() => clients.map((c: string) => <span>{c}</span>))}
      </div>
    </div>
  </main>
</Base>

<style>
  .v3 {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--surface-dark);
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    user-select: none;
    -webkit-user-select: none;
  }
  .v3__nav {
    position: relative;
    z-index: 4;
    width: 100%;
    box-sizing: border-box;
    padding: var(--gutter) var(--gutter) 0;
  }
  .v3__title {
    margin: clamp(28px, 7vh, 80px) 0 0;
    padding: 0 var(--gutter);
    text-align: center;
    font: 500 clamp(30px, 3.4vw, 54px) / 1.02 var(--font-head);
    letter-spacing: -0.045em;
  }
  .v3__m {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .v3__l {
    display: block;
    transform: translateY(110%);
    transition: transform 1.1s var(--ease-expo);
  }
  .v3__m + .v3__m .v3__l {
    transition-delay: 0.08s;
  }
  .v3.is-in .v3__l {
    transform: none;
  }

  /* the row: every card is placed by the script around the centre line */
  .v3__row {
    position: relative;
    flex: 1 1 auto;
    width: 100%;
    min-height: 0;
    touch-action: pan-y;
    cursor: grab;
  }
  .v3__row.is-dragging {
    cursor: grabbing;
  }
  .v3__card,
  .v3__flip {
    position: absolute;
    left: 50%;
    top: 50%;
    height: var(--h, 40vh);
    will-change: transform;
  }
  .v3__card {
    width: calc(var(--h, 40vh) * var(--r));
    margin: calc(var(--h, 40vh) / -2) 0 0 calc(var(--h, 40vh) * var(--r) / -2);
    overflow: hidden;
    background: #e9e9e7;
    opacity: 0;
  }
  .v3__card img,
  .v3__flip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .v3__card img {
    transition: transform 0.6s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .v3__card:hover img {
      transform: scale(1.04);
    }
  }
  .v3__flip {
    width: calc(var(--h, 40vh) * var(--r0, 0.8));
    margin: calc(var(--h, 40vh) / -2) 0 0 calc(var(--h, 40vh) * var(--r0, 0.8) / -2);
    overflow: hidden;
    z-index: 50;
    pointer-events: none;
    transform: scale(0.26);
    opacity: 0;
  }
  .v3__flip img {
    position: absolute;
    inset: 0;
    visibility: hidden;
  }
  .v3__flip img.is-on {
    visibility: visible;
  }

  .v3__text {
    max-width: 380px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    text-align: center;
    font: 400 14px / 1.4 var(--font-body);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s var(--ease-out),
      transform 1s var(--ease-expo);
  }
  .v3__marquee {
    width: 100%;
    overflow: hidden;
    margin: clamp(18px, 4vh, 44px) 0 clamp(16px, 3vh, 28px);
    opacity: 0;
    transition: opacity 1s var(--ease-out) 0.2s;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .v3__track {
    display: flex;
    gap: 64px;
    width: max-content;
    animation: v3-marquee 40s linear infinite;
  }
  .v3__track span {
    font: 500 13px / 1 var(--font-head);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  @keyframes v3-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .v3.is-done .v3__text {
    opacity: 1;
    transform: none;
  }
  .v3.is-done .v3__marquee {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .v3__track {
      animation: none;
    }
    .v3__l {
      transform: none;
    }
  }
</style>

<script>
  const page = document.querySelector<HTMLElement>('[data-v3]');
  const row = document.querySelector<HTMLElement>('[data-row]');
  const flip = document.querySelector<HTMLElement>('[data-flip]');
  if (page && row && flip) {
    const cards = [...row.querySelectorAll<HTMLAnchorElement>('.v3__card')];
    const N = cards.length;
    const ratios = cards.map((c) => parseFloat(c.style.getPropertyValue('--r')) || 0.8);
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GAP = 10;

    // size: the middle card's height, from the space the row has
    let H = 300;
    const measure = () => {
      const r = row.getBoundingClientRect();
      const phone = innerWidth < 810;
      H = Math.max(160, Math.min(r.height * 0.86, (phone ? innerWidth * 0.62 : innerWidth * 0.2) / Math.min(ratios[0], 1) * 1.05));
      row.style.setProperty('--h', `${H}px`);
    };
    addEventListener('resize', measure);
    measure();

    // how big a card is at distance d from the middle (1 in the middle,
    // stepping down to ~0.72 two places out, then flat)
    const sizeAt = (d: number) => {
      const a = Math.min(Math.abs(d), 3);
      return 1 - 0.09 * a - 0.03 * Math.max(0, a - 1) + 0.02 * Math.max(0, a - 2);
    };
    const wrap = (d: number) => {
      let v = ((d % N) + N) % N;
      if (v > N / 2) v -= N;
      return v;
    };

    // ---------- position: eased, settles on a project ----------
    let pos = 0;
    let target = 0;
    let vel = 0;
    const SMOOTH = 0.28; // seconds to (almost) arrive
    let last = performance.now();
    let settleTimer = 0;
    const settle = () => {
      clearTimeout(settleTimer);
      settleTimer = window.setTimeout(() => (target = Math.round(target)), 140);
    };

    // intro: 0 = all stacked in the middle, 1 = spread out
    const spread = new Array(N).fill(calm ? 1 : 0);
    let introStart = Infinity;

    const draw = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      // critically damped spring (smooth damp) towards the target
      const omega = 2 / SMOOTH;
      const x = omega * dt;
      const exp = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
      const change = pos - target;
      const temp = (vel + omega * change) * dt;
      vel = (vel - omega * temp) * exp;
      pos = target + (change + temp) * exp;

      // place: walk out from the middle on each side, adding scaled widths
      const ds = cards.map((_, i) => wrap(i - pos));
      const order = cards.map((_, i) => i).sort((a, b) => ds[a] - ds[b]);
      const xs = new Array(N).fill(0);
      const centre = order.reduce((best, i) => (Math.abs(ds[i]) < Math.abs(ds[best]) ? i : best), order[0]);
      // the card nearest the middle sits offset by its fractional distance
      const w = (i: number) => H * ratios[i] * sizeAt(ds[i]);
      const k0 = order.indexOf(centre);
      xs[centre] = ds[centre] * (w(centre) + GAP);
      for (let k = k0 + 1; k < N; k++) xs[order[k]] = xs[order[k - 1]] + w(order[k - 1]) / 2 + GAP + w(order[k]) / 2;
      for (let k = k0 - 1; k >= 0; k--) xs[order[k]] = xs[order[k + 1]] - w(order[k + 1]) / 2 - GAP - w(order[k]) / 2;

      for (let i = 0; i < N; i++) {
        const t = introStart === Infinity ? 0 : Math.min(1, Math.max(0, (now - introStart - Math.abs(ds[i]) * 55) / 1000));
        // expo out
        const e = calm ? 1 : t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
        spread[i] = e;
        const s = sizeAt(ds[i]) * (0.86 + 0.14 * e);
        const c = cards[i];
        c.style.transform = `translate3d(${(xs[i] * e).toFixed(2)}px,0,0) scale(${s.toFixed(4)})`;
        c.style.zIndex = String(20 - Math.round(Math.abs(ds[i]) * 2));
        c.style.opacity = calm || introStart !== Infinity ? '1' : '0';
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);

    // ---------- input ----------
    row.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const d = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
        target += d / 420;
        settle();
      },
      { passive: false },
    );
    addEventListener('wheel', (e) => {
      if (!row.contains(e.target as Node)) {
        target += (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) / 420;
        settle();
      }
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') target = Math.round(target) + 1;
      if (e.key === 'ArrowLeft') target = Math.round(target) - 1;
    });
    let dragX = 0;
    let startT = 0;
    let moved = 0;
    let dragging = false;
    row.addEventListener('pointerdown', (e) => {
      dragging = true;
      moved = 0;
      dragX = e.clientX;
      startT = target;
      row.setPointerCapture(e.pointerId);
      row.classList.add('is-dragging');
    });
    row.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragX;
      moved = Math.max(moved, Math.abs(dx));
      target = startT - dx / (H * 0.8);
    });
    const up = () => {
      if (!dragging) return;
      dragging = false;
      row.classList.remove('is-dragging');
      target = Math.round(target + vel * 0.12);
    };
    row.addEventListener('pointerup', up);
    row.addEventListener('pointercancel', up);
    // a click on a side card brings it to the middle; on the middle one opens it
    cards.forEach((c, i) =>
      c.addEventListener('click', (e) => {
        if (moved > 6) {
          e.preventDefault();
          return;
        }
        const d = wrap(i - target);
        if (Math.abs(d) > 0.5) {
          e.preventDefault();
          target = Math.round(target + d);
        }
      }),
    );

    // ---------- intro ----------
    const imgs = [...flip.querySelectorAll('img')];
    flip.style.setProperty('--r0', String(ratios[0]));
    const begin = () => {
      page.classList.add('is-in');
      if (calm) {
        page.classList.add('is-done');
        return;
      }
      // 1. the flip book: a small picture grows in the middle, flicking
      //    through the covers faster and faster, and lands on the first
      const GROW = 1250;
      flip.animate(
        [
          { opacity: 0, transform: 'scale(0.22)' },
          { opacity: 1, transform: 'scale(0.3)', offset: 0.12 },
          { opacity: 1, transform: 'scale(1)' },
        ],
        { duration: GROW, easing: 'cubic-bezier(0.65, 0, 0.35, 1)', fill: 'forwards' },
      );
      const order = [...imgs.slice(1), ...imgs.slice(1, 4), imgs[0]];
      let k = 0;
      const t0 = performance.now();
      const step = () => {
        imgs.forEach((im) => im.classList.remove('is-on'));
        order[Math.min(k, order.length - 1)].classList.add('is-on');
        k++;
        if (k < order.length) {
          // frames stretch out as it grows: ~70ms early, ~140ms at the end
          const p = (performance.now() - t0) / GROW;
          window.setTimeout(step, 70 + 70 * Math.min(1, p));
        } else {
          window.setTimeout(land, Math.max(0, GROW - (performance.now() - t0)) + 60);
        }
      };
      step();
      // 2. the real middle card takes over; the others slide out from behind
      const land = () => {
        cards[0].style.opacity = '1';
        flip.style.visibility = 'hidden';
        introStart = performance.now();
        window.setTimeout(() => page.classList.add('is-done'), 900);
      };
    };
    // wait for the first few pictures so the flip book never shows a blank
    const first = imgs.slice(0, Math.min(6, imgs.length)).map((im) => (im.complete ? Promise.resolve() : im.decode().catch(() => {})));
    Promise.race([Promise.all(first), new Promise((r) => setTimeout(r, 1500))]).then(() => requestAnimationFrame(begin));
  }
</script>
