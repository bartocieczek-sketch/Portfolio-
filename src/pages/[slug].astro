---
import { PortableText } from 'astro-portabletext';
import { stegaClean } from '@sanity/client/stega';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Media from '../components/Media.astro';
import Footer from '../components/Footer.astro';
import { PROJECT_ORDER_QUERY, PROJECT_QUERY, SETTINGS_QUERY, srcset, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const { slug } = Astro.params;
const [project, settings, about, order] = await Promise.all([
  load(Astro.locals, PROJECT_QUERY, { slug }),
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, `*[_id == "aboutPage"][0]{ctaText}`),
  load(Astro.locals, PROJECT_ORDER_QUERY),
]);
if (!project) return Astro.rewrite('/404');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const list: any[] = (order ?? []).filter(Boolean);
const index = list.findIndex((p) => p.slug === project.slug);
const next = list.length > 1 ? list[(index + 1) % list.length] : undefined;
const number = (n: number) => String(n).padStart(2, '0');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
// The cover opens the gallery, so skip a gallery image that is the same file
const gallery: any[] = (project.gallery ?? []).filter(
  (g: any) => !(project.cover?.asset?._id && g?.image?.asset?._id === project.cover.asset._id),
);
// First graphic: the card cover in the same 4:5 crop as the home carousel,
// so the thumbnail can morph straight into it
const coverSrc = project.cover?.asset ? urlFor(project.cover).width(1000).height(1250).fit('crop').quality(82).url() : undefined;

// biome-ignore lint/suspicious/noExplicitAny: Portable Text blocks
const intro: any[] = project.intro ?? [];
const [lead] = intro;
const meta = [
  ['Client', project.client],
  ['Services', project.services],
  ['Year', project.yearLabel],
  ['Credits', project.credits],
].filter(([, v]) => v);
const description = stegaClean(lead?.children?.map((c: { text: string }) => c.text).join('') ?? settings?.seoDescription);
---

<Base title={`${stegaClean(project.title)} – ${settings?.name ?? 'Bart Ocieczek'}`} description={description} image={project.cover}>
  <main class="case">
    <div class="case__nav">
      <Nav callUrl={settings?.callUrl} socials={settings?.socials} role={settings?.role} />
    </div>

    <section class="case__row">
      <div class="case__gallery">
        {coverSrc && (
          <div class="case__cover" data-vt-cover>
            <img src={coverSrc} alt="" width="1000" height="1250" fetchpriority="high" decoding="async" />
          </div>
        )}
        {gallery.map((item, i) => <Media item={item} eager={i < 2} />)}
      </div>

      <aside class="case__side">
        <div class="case__head">
          <p class="t-label-small muted" data-split>
            Case study {index >= 0 && `— ${number(index + 1)}/${number(list.length)}`}
          </p>
          <h1 class="case__title" data-split>{project.title}</h1>
        </div>

        {intro.length > 0 && (
          <div class="case__intro t-compact" data-split style="--split-delay:120ms">
            <PortableText value={intro} />
          </div>
        )}

        {project.liveUrl && (
          <a class="line-button is-closed" href={project.liveUrl} target="_blank" rel="noopener" data-reveal>
            <span>Visit live ↗</span>
          </a>
        )}

        {meta.length > 0 && (
          <dl class="case__meta" data-reveal>
            {meta.map(([k, v]) => (
              <div>
                <dt class="t-label-small">{k}</dt>
                <dd class="t-label">{v}</dd>
              </div>
            ))}
          </dl>
        )}

        <a href={href(Astro.locals, '/')} class="u-link t-label-small case__back">← Back to work</a>
      </aside>
    </section>

    {next && (
      <a class="next" href={href(Astro.locals, `/${next.slug}`)} data-build>
        <div class="next__head">
          <span class="t-label-small" data-split>Next project</span>
          <span class="t-label-small" aria-hidden="true">→</span>
        </div>
        <p class="next__title" data-split>{next.cardTitle || next.title}</p>
        {next.cover?.asset && (
          <div class="next__media" data-parallax data-build-item>
            <img
              src={urlFor(next.cover).width(1800).height(900).fit('crop').quality(80).url()}
              srcset={srcset(next.cover, [800, 1400, 2000])}
              sizes="100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </a>
    )}

    {settings && <Footer settings={settings} ctaText={about?.ctaText} />}
  </main>
</Base>

<style>
  .case {
    background: var(--surface-dark);
  }

  /* ---------- Gallery left, story right ---------- */
  .case__nav {
    padding: var(--gutter) var(--gutter) 0;
  }
  .case__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
    padding: 32px var(--gutter) 0;
  }
  .case__gallery {
    width: 65%;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: row dense;
    gap: 12px;
  }
  .case__gallery :global(.media--full) {
    grid-column: 1 / -1;
  }
  .case__cover {
    aspect-ratio: 0.8;
    overflow: hidden;
    background: #222;
  }
  .case__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case__side {
    position: sticky;
    top: var(--gutter);
    width: 30%;
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .case__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .case__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(30px, 2.6vw, 42px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }
  .case__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .case__intro :global(p) {
    color: var(--text-secondary);
  }
  .case__intro :global(p:first-child) {
    color: var(--text-highlight);
  }
  .case__meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .case__meta dt {
    margin-bottom: 6px;
    color: var(--text-secondary);
  }
  .case__meta dd {
    margin: 0;
    font-size: 13px;
  }
  .case__back {
    align-self: flex-start;
    color: var(--text-secondary);
  }
  @media (hover: hover) and (pointer: fine) {
    .case__back:hover {
      color: var(--text-primary);
    }
  }

  /* ---------- Next project ---------- */
  .next {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 160px var(--gutter) 120px;
  }
  .next__head {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .next__title {
    font-family: var(--font-display);
    font-size: clamp(64px, 11vw, 200px);
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }
  .next__media {
    position: relative;
    aspect-ratio: 2 / 1;
    background: #111;
  }
  .next__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover .next__title {
      color: var(--text-highlight);
    }
  }

  @media (max-width: 1199px) {
    .case__side {
      width: 36%;
    }
    .case__gallery {
      width: 60%;
    }
  }
  @media (max-width: 809px) {
    .case__row {
      flex-direction: column-reverse;
      gap: 40px;
    }
    .case__gallery,
    .case__side {
      width: 100%;
    }
    .case__side {
      position: static;
    }
    .case__gallery {
      grid-template-columns: 1fr;
    }
    .next {
      padding: 96px var(--gutter) 80px;
    }
    .next__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
