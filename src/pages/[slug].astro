---
import { PortableText } from 'astro-portabletext';
import { stegaClean } from '@sanity/client/stega';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Footer from '../components/Footer.astro';
import { PROJECT_ORDER_QUERY, PROJECT_QUERY, SETTINGS_QUERY, srcset, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const { slug } = Astro.params;
const [project, settings, about, order] = await Promise.all([
  load(Astro.locals, PROJECT_QUERY, { slug }),
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, `*[_id == "aboutPage"][0]{ctaText}`),
  load(Astro.locals, PROJECT_ORDER_QUERY),
]);
if (!project) return Astro.rewrite('/404');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const list: any[] = (order ?? []).filter(Boolean);
const index = list.findIndex((p) => p.slug === project.slug);
const next = list.length > 1 ? list[(index + 1) % list.length] : undefined;
const number = (n: number) => String(n).padStart(2, '0');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
// The cover opens the gallery, so skip a gallery image that is the same file
const gallery: any[] = (project.gallery ?? []).filter(
  (g: any) => !(project.cover?.asset?._id && g?.image?.asset?._id === project.cover.asset._id),
);
// First graphic: the card cover in the same 4:5 crop as the home carousel,
// so the thumbnail can morph straight into it
const coverSrc = project.cover?.asset ? urlFor(project.cover).width(1000).height(1250).fit('crop').quality(82).url() : undefined;
// the cover fills the first screen here, so it gets the full picture
// where the cover's subject is (Sanity hotspot): the full-screen frame crops
// around it instead of the photo's centre
const focusX = project.cover?.hotspot?.x ?? 0.5;
const focusY = project.cover?.hotspot?.y ?? 0.5;
// same 4:5 crop as the home pill, only larger, so swapping to it just sharpens
const heroSrc = project.cover?.asset ? urlFor(project.cover).width(2000).height(2500).fit('crop').quality(80).url() : undefined;
const heroSet = project.cover?.asset
  ? [1400, 2000, 2600].map((w) => `${urlFor(project.cover).width(w).height(Math.round(w * 1.25)).fit('crop').quality(80).url()} ${w}w`).join(', ')
  : undefined;

// each picture keeps its own shape in the strip (all share one height)
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const ratio = (g: any): number => {
  const d = g?.image?.asset?.metadata?.dimensions;
  if (g?.kind === 'image' && d?.width && d?.height) return d.width / d.height;
  if (g?.kind === 'video') return 16 / 9;
  if (g?.kind === 'lottie') return 1.66;
  return 0.82;
};

// biome-ignore lint/suspicious/noExplicitAny: Portable Text blocks
const intro: any[] = project.intro ?? [];
const [lead] = intro;
const meta = [
  ['Client', project.client],
  ['Services', project.services],
  ['Year', project.yearLabel],
  ['Credits', project.credits],
].filter(([, v]) => v);
const description = stegaClean(lead?.children?.map((c: { text: string }) => c.text).join('') ?? settings?.seoDescription);
---

<Base title={`${stegaClean(project.title)} – ${settings?.name ?? 'Bart Ocieczek'}`} description={description} image={project.cover}>
  <main class="case">
    <!-- Two columns: the pictures on the left, the story on the right in a
         panel that stays put (sticky) while the pictures scroll. The cover
         grows up to where the panel starts; the panel slides in once. -->
    <a class="case__back-btn" href={href(Astro.locals, '/')} aria-label="Back to work">
      <span class="case__back-arrow" aria-hidden="true">←</span>
      <span class="t-label-small">Work</span>
    </a>

    <section class="case__row">
      <!-- First screen: the main visual (whole, 4:5) and the next two pictures
           stacked beside it, filling the width up to the story panel -->
      <div class="case__top">
      {coverSrc && (
        <div class="case__cover" data-vt-cover data-focus-x={focusX} data-focus-y={focusY} style={`--focus:${(focusX * 100).toFixed(1)}% ${(focusY * 100).toFixed(1)}%`}>
          <!-- the home pill's own picture (already in the cache) carries the
               flight; the full-size one, same crop, sharpens it once decoded -->
          <img class="case__cover-lo" src={coverSrc} alt="" width="1000" height="1250" decoding="sync" />
          <img class="case__cover-hi" src={heroSrc} srcset={heroSet} sizes="(max-width: 809px) 100vw, 50vw" alt="" fetchpriority="high" decoding="async" data-cover-hi />
        </div>
      )}
      {gallery.length > 0 && (
        <div class="case__stack">
          {gallery.slice(0, 2).map((item) => <Media item={item} eager />)}
        </div>
      )}
      </div>
      <aside class="case__panel is-out" data-panel aria-label="About the project">
        <div class="case__panel-in">
          <div class="case__panel-top">
            <p class="t-label-small muted">
              Case study {index >= 0 && `— ${number(index + 1)}/${number(list.length)}`}
            </p>
            <h1 class="case__title">{project.title}</h1>
            {intro.length > 0 && (
              <div class="case__intro">
                <PortableText value={intro} />
              </div>
            )}
            <p class="case__hint t-label-small">[ Scroll to explore ]</p>
          </div>

          {meta.length > 0 && (
            <dl class="case__meta">
              {meta.map(([k, v]) => (
                <div>
                  <dt class="t-label-small">{k}</dt>
                  <dd>{v}</dd>
                </div>
              ))}
            </dl>
          )}

          <div class="case__panel-foot">
            <span class="t-label-small">{project.yearLabel}</span>
            {project.liveUrl && (
              <a class="case__live t-label-small" href={project.liveUrl} target="_blank" rel="noopener">Live site ↗</a>
            )}
          </div>
        </div>
      </aside>
      <div class="case__gallery">
        {gallery.slice(2).map((item, i) => <Media item={item} eager={i < 2} />)}
      </div>
    </section>



    <!-- Next project, the way it looks on home: title, the pill, year and
         tags. Clicking it flies the pill into that project's cover. -->
    {next && (
      <a class="next" href={href(Astro.locals, `/${next.slug}`)} data-next>
        <span class="next__label t-label-small">Next project</span>
        <div class="next__row">
          <p class="next__title">{next.cardTitle || next.title}</p>
          {next.cover?.asset && (
            <span class="next__pill" data-next-pill>
              <img
                src={urlFor(next.cover).width(1000).height(1250).fit('crop').quality(82).url()}
                width="1000"
                height="1250"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          )}
          <div class="next__meta">
            {next.year && <span class="t-label-small muted">{next.year}</span>}
            {next.cardTags?.length > 0 && (
              <span class="next__tags">
                {next.cardTags.slice(0, 3).map((t: string) => <span>{t.replace(/,\s*$/, '')}</span>)}
              </span>
            )}
          </div>
        </div>
      </a>
    )}

    {settings && <Footer settings={settings} ctaText={about?.ctaText} />}
  </main>
</Base>

<style>
  .case {
    background: var(--surface-dark);
  }

  /* ---------- Pictures left, story right ---------- */
  .case {
    --panel-w: min(440px, 32vw);
  }
  .case__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--panel-w);
    grid-template-areas:
      'top panel'
      'gallery panel';
    column-gap: 16px;
    row-gap: 8px;
    align-items: start;
    padding: 24px;
    /* the panel waits off to the right before it slides in */
    overflow-x: clip;
  }
  /* no fill behind the picture: if it isn't painted yet when the cover
     starts flying, the frame is see-through (the pill's photo underneath
     shows) instead of a pale block over the photo */
  /* the main visual in its own 4:5 shape, as big as the screen allows: the
     whole picture is visible (nothing cropped away), and the home pill only
     has to grow, not change shape, on the way in */
  .case__top {
    grid-area: top;
    display: flex;
    gap: 8px;
    align-items: stretch;
  }
  .case__cover {
    position: relative;
    flex: none;
    /* as tall as the screen allows, but always leaving room beside it */
    width: min(64%, calc((100svh - 48px) * 0.8));
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius);
  }
  /* the next two pictures, one above the other, as tall as the cover */
  .case__stack {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .case__stack > :global(.media) {
    flex: 1;
    min-height: 0;
    aspect-ratio: auto;
  }
  .case__stack :global(.media img),
  .case__stack :global(.media video) {
    height: 100% !important;
    min-height: 0;
    object-fit: cover;
  }
  .case__gallery {
    grid-area: gallery;
  }
  .case__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focus, 50% 50%);
  }
  .case__cover-hi {
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .case__cover-hi.is-ready {
    opacity: 1;
  }
  .case__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: row dense;
    gap: 8px;
  }
  .case__gallery :global(.media--full) {
    grid-column: 1 / -1;
  }

  /* ---------- Back to work (top left) ---------- */
  .case__back-btn {
    position: fixed;
    z-index: 20;
    top: 20px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--text-primary);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04), 0 6px 24px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s var(--ease-out);
  }
  .case__back-btn:active {
    transform: scale(0.97);
  }
  .case__back-arrow {
    font-size: 14px;
    line-height: 1;
  }

  /* ---------- The panel ---------- */
  .case__panel {
    grid-area: panel;
    position: sticky;
    z-index: 5;
    top: 24px;
    height: calc(100svh - 48px);
    transition: transform 0.8s var(--ease-cover);
  }
  .case__panel.is-out {
    transform: translate3d(calc(100% + 40px), 0, 0);
  }
  .case__panel-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 36px 32px 28px;
    background: #f4f4f2;
    border-radius: var(--radius);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .case__panel-in::-webkit-scrollbar {
    display: none;
  }
  .case__panel-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .case__title {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(32px, 2.6vw, 44px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .case__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }
  .case__intro :global(p) {
    color: var(--text-secondary);
  }
  .case__intro :global(p:first-child) {
    color: var(--text-primary);
  }
  .case__hint {
    color: var(--text-secondary);
    margin-top: 6px;
  }
  .case__meta {
    margin: auto 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    padding-top: 22px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .case__meta dt {
    margin-bottom: 6px;
    color: var(--text-secondary);
  }
  .case__meta dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
  }
  .case__panel-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: var(--text-secondary);
  }
  .case__live {
    color: var(--text-primary);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  /* the panel's contents settle in just after it slides out */
  .case__panel-in > * {
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .case__panel.is-out .case__panel-in > * {
    opacity: 0;
    transform: translateX(24px);
    transition-duration: 0.25s;
  }
  .case__panel:not(.is-out) .case__panel-in > :nth-child(2) {
    transition-delay: 0.08s;
  }
  .case__panel:not(.is-out) .case__panel-in > :nth-child(3) {
    transition-delay: 0.14s;
  }

  /* ---------- Next project (a home row) ---------- */
  .next {
    --pill-w: clamp(220px, 19vw, 340px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding: 140px var(--gutter) 140px;
    color: var(--text-primary);
  }
  .next__label {
    color: var(--text-secondary);
  }
  .next__row {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr var(--pill-w) 1fr;
    align-items: center;
    column-gap: 56px;
  }
  .next__title {
    justify-self: end;
    text-align: right;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(30px, 3.2vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }
  .next__pill {
    position: relative;
    display: block;
    width: var(--pill-w);
    aspect-ratio: 0.75;
    border-radius: 999px;
    overflow: hidden;
    background: #f2f2f2;
  }
  .next__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  .next__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .next__tags {
    display: flex;
    flex-direction: column;
    font-size: 15px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover .next__pill img {
      transform: scale(1.06);
    }
  }
  .next:active .next__pill {
    transform: scale(0.98);
    transition: transform 0.16s var(--ease-out);
  }

  /* Arriving from a home cover: the cover morphs into place (view transition);
     the story and the rest of the gallery rise in after it, one by one */
  /* Arriving from a home cover: the panel waits off screen until the cover
     has landed, then slides in (see the script) */
  :global(html.from-card .case__gallery > *),
  :global(html.from-card .case__stack > *) {
    opacity: 0;
    transform: translateY(48px);
    transition: none;
  }
  :global(html.from-card .case__stack > *) {
    transform: translateX(48px);
  }
  :global(html.from-card.cover-landed .case__stack > *),
  :global(html.from-card.cover-landed .case__gallery > *) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1s var(--ease-out);
  }
  :global(html.from-card.cover-landed .case__stack > :nth-child(2)) {
    transition-delay: 0.08s;
  }
  /* Leaving for home: the same moves in reverse, quicker — the side
     pictures slide back out to the right, the panel after them */
  .case.is-leaving .case__stack > :global(*) {
    opacity: 0;
    transform: translateX(48px);
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.4s var(--ease-in-out);
  }
  .case.is-leaving .case__stack > :global(:nth-child(1)) {
    transition-delay: 0.05s;
  }
  .case.is-leaving .case__panel {
    transform: translate3d(calc(100% + 40px), 0, 0);
    transition: transform 0.45s var(--ease-in-out) 0.06s;
  }
  .case.is-leaving .case__panel-in > * {
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }
  .case.is-leaving .case__back-btn {
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }
  :global(html.from-card) .case__back-btn {
    animation: case-rise 0.7s 0.5s var(--ease-out) both;
  }
  @keyframes case-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case__panel,
    .case__panel-in > *,
    :global(html.from-card .case__gallery > *),
    :global(html.from-card .case__stack > *) {
      animation: none;
      transform: none;
      transition: opacity 0.3s ease;
    }
  }

  @media (max-width: 1099px) {
    .case {
      --panel-w: min(400px, 40vw);
    }
  }
  @media (max-width: 809px) {
    /* phones: the main picture is 4:3, not the whole screen */
    .case__top {
      flex-direction: column;
    }
    .case__cover {
      width: 100%;
      aspect-ratio: 4 / 3;
    }
    .case__stack {
      flex-direction: row;
    }
    .case__stack > :global(.media) {
      aspect-ratio: 0.82;
    }
    /* phones: one column — picture, story, then the rest of the pictures */
    .case__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'top'
        'panel'
        'gallery';
      padding: 12px;
      row-gap: 12px;
    }
    .case__panel {
      position: static;
      height: auto;
      transform: none !important;
    }
    .case__panel-in {
      padding: 28px 22px 22px;
    }
    .case__gallery {
      grid-template-columns: 1fr;
    }
    .next {
      --pill-w: 58vw;
      padding: 96px var(--gutter) 80px;
      gap: 24px;
    }
    .next__row {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: 20px;
    }
    .next__title {
      justify-self: center;
      text-align: center;
      order: 2;
    }
    .next__pill {
      order: 1;
    }
    .next__meta {
      order: 3;
      align-items: center;
      text-align: center;
    }
    .next__tags {
      align-items: center;
    }
  }
</style>

<script>
  // Heading back home, something on screen always flies into the pill the
  // project was opened from (Hero.astro restores the column):
  // - the big cover, when it's still in view (corners round off into the pill)
  // - otherwise the small pill in the story column (pill to pill, no reshape)
  const slug = location.pathname.replace(/\/$/, '').split('/').pop();
  const cover = document.querySelector<HTMLElement>('[data-vt-cover]');
  const isHome = (url: string) => /^\/(preview\/?)?$/.test(new URL(url).pathname);

  // ---------- Cover: sharp picture over the flight picture ----------
  const hi = document.querySelector<HTMLImageElement>('[data-cover-hi]');
  const heroReady: Promise<void> = hi
    ? (hi.complete ? Promise.resolve() : new Promise<void>((r) => hi.addEventListener('load', () => r(), { once: true })))
        .then(() => hi.decode().catch(() => {}))
        .then(() => {
          // swap after the next frame, never in the middle of the flight paint
          requestAnimationFrame(() => hi.classList.add('is-ready'));
        })
    : Promise.resolve();

  // ---------- The story panel ----------
  // Always there (it can't be closed): it slides in once, after the cover has
  // landed and turned sharp (from home) or just after the page shows, and
  // slides out again only when leaving for home.
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  let setPanel: (open: boolean) => void = () => {};
  const startPanel = () => {
    if (!panel) return;
    setPanel = (open: boolean) => panel.classList.toggle('is-out', !open);
    let opened = false;
    const openOnce = () => {
      if (opened) return;
      opened = true;
      setPanel(true);
    };
    const root = document.documentElement;
    // decide after the page has been revealed (Base.astro marks a cover
    // flight with .from-card in 'pagereveal', which runs before this frame)
    requestAnimationFrame(() => {
      let fromCard = root.classList.contains('from-card');
      try {
        fromCard ||= !!sessionStorage.getItem('vt-card');
      } catch (err) {}
      const landed = new Promise<void>((resolve) => {
        if (!fromCard || root.classList.contains('cover-landed')) return resolve();
        new MutationObserver((_, mo) => {
          if (!root.classList.contains('cover-landed')) return;
          mo.disconnect();
          resolve();
        }).observe(root, { attributes: true, attributeFilter: ['class'] });
      });
      Promise.all([landed, heroReady]).then(() => window.setTimeout(openOnce, fromCard ? 120 : 250));
      // never wait forever (slow network)
      window.setTimeout(openOnce, 3500);
    });
  };
  // a page prerendered on hover runs this early: wait until it's really shown
  if ((document as unknown as { prerendering?: boolean }).prerendering) {
    document.addEventListener('prerenderingchange', startPanel, { once: true });
  } else startPanel();

  // which picture flies home: the cover while a third of it is visible,
  // otherwise the small pill in the back button
  let coverShowing = true;
  if (cover) {
    new IntersectionObserver(
      ([e]) => {
        coverShowing = e.intersectionRatio > 0.33;
      },
      { threshold: [0, 0.33, 0.5, 1] },
    ).observe(cover);
  }

  // Back to work: the panel tucks away, the page glides up to the main
  // picture, and from there the cover shrinks into its pill on home.
  // Came here from the home column? Then it's a real history step: the browser
  // restores home exactly as it was left (column, covers, WebGL).
  const nav = (window as unknown as { navigation?: { entries(): { url: string | null }[]; currentEntry?: { index: number } } }).navigation;
  const lenis = () => (window as unknown as { lenis?: { scrollTo(y: number, o: object): void } }).lenis;
  let leaving = false;
  const leave = (url: string) => {
    const i = nav?.currentEntry?.index ?? -1;
    const prev = i > 0 ? nav!.entries()[i - 1] : null;
    if (prev?.url && isHome(prev.url) && new URL(prev.url).origin === location.origin) history.back();
    else location.href = url;
  };
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
    if (!isHome(a.href)) return;
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      if (leaving) return;
      leaving = true;
      // the story panel stays where it is; only the pictures travel
      const y = window.scrollY;
      // at the top: the side pictures and the panel go back out the way they
      // came in, then the cover flies home
      const main = document.querySelector<HTMLElement>('.case');
      const goHome = () => {
        coverShowing = true;
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !main) return leave(a.href);
        main.classList.add('is-leaving');
        window.setTimeout(() => leave(a.href), 430);
      };
      if (y < 4 || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        goHome();
        return;
      }
      // Glide up to the main picture: the page is moving on screen, so a
      // strong ease-in-out (starts gently, travels, settles) — no jolt at
      // either end. Longer ways take a little longer (square root), within
      // 0.45–0.9s, then the cover flies home the moment it has settled.
      const dur = Math.min(0.9, Math.max(0.45, 0.25 + Math.sqrt(y) * 0.012));
      const easeInOut = (t: number) => (t < 0.5 ? 8 * t * t * t * t : 1 - Math.pow(-2 * t + 2, 4) / 2);
      const done = goHome;
      const l = lenis();
      if (l) l.scrollTo(0, { duration: dur, easing: easeInOut, force: true, lock: true, onComplete: done });
      else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        window.setTimeout(done, dur * 1000);
      }
    });
  });
  // ---------- Next project: its pill flies into that project's cover ----------
  const nextLink = document.querySelector<HTMLAnchorElement>('[data-next]');
  const nextPill = nextLink?.querySelector<HTMLElement>('[data-next-pill]');
  nextLink?.addEventListener('click', (e) => {
    if (!nextPill || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const img = nextPill.querySelector('img');
    if (!img?.complete) return; // not loaded yet: a plain page change
    e.preventDefault();
    const pc = (window as unknown as { __pillCover(p: HTMLElement, on: boolean): { w: number; h: number } | null }).__pillCover;
    const box = pc(nextPill, true);
    try {
      sessionStorage.setItem('vt-card', '1');
      sessionStorage.setItem('vt-pill', JSON.stringify(box));
      sessionStorage.setItem('vt-pill-shape', JSON.stringify({ r: nextPill.offsetWidth / 2, clip: box ? (box.w - nextPill.offsetWidth) / 2 : 0 }));
    } catch (err) {}
    requestAnimationFrame(() => {
      location.href = nextLink.href;
    });
  });

  // back from the bfcache onto this page: allow leaving again
  window.addEventListener('pageshow', () => {
    document.querySelector('.case')?.classList.remove('is-leaving');
    if (nextPill) (window as unknown as { __pillCover(p: HTMLElement, on: boolean): unknown }).__pillCover(nextPill, false);
    leaving = false;
  });

  window.addEventListener('pageswap', (e) => {
    const to = (e as unknown as { activation?: { entry?: { url?: string } } }).activation?.entry?.url;
    try {
      sessionStorage.removeItem('vt-back');
      if (!cover || !to || !isHome(to) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // cover scrolled away: nothing flies in from off screen, home just
      // dissolves in with the column where it was
      if (!coverShowing) {
        sessionStorage.setItem('vt-back', JSON.stringify({ slug, still: true }));
        return;
      }
      cover.style.viewTransitionName = 'project-cover';
      // the frame's size, so home can scale the photo evenly into the pill
      const f = cover.getBoundingClientRect();
      const focus = { x: parseFloat(cover.dataset.focusX || '0.5'), y: parseFloat(cover.dataset.focusY || '0.5') };
      sessionStorage.setItem('vt-back', JSON.stringify({ slug, frame: { w: f.width, h: f.height }, focus }));
    } catch (err) {}
  });
</script>

