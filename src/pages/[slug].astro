---
import { PortableText } from 'astro-portabletext';
import { stegaClean } from '@sanity/client/stega';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Footer from '../components/Footer.astro';
import { PROJECT_ORDER_QUERY, PROJECT_QUERY, SETTINGS_QUERY, srcset, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const { slug } = Astro.params;
const [project, settings, about, order] = await Promise.all([
  load(Astro.locals, PROJECT_QUERY, { slug }),
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, `*[_id == "aboutPage"][0]{ctaText}`),
  load(Astro.locals, PROJECT_ORDER_QUERY),
]);
if (!project) return Astro.rewrite('/404');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const list: any[] = (order ?? []).filter(Boolean);
const index = list.findIndex((p) => p.slug === project.slug);
const next = list.length > 1 ? list[(index + 1) % list.length] : undefined;
const number = (n: number) => String(n).padStart(2, '0');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
// The cover opens the gallery, so skip a gallery image that is the same file
const gallery: any[] = (project.gallery ?? []).filter(
  (g: any) => !(project.cover?.asset?._id && g?.image?.asset?._id === project.cover.asset._id),
);
// First graphic: the card cover in the same 4:5 crop as the home carousel,
// so the thumbnail can morph straight into it
const coverSrc = project.cover?.asset ? urlFor(project.cover).width(1000).height(1250).fit('crop').quality(82).url() : undefined;
// the cover fills the first screen here, so it gets the full picture
// same 4:5 crop as the home pill, only larger, so swapping to it just sharpens
const heroSrc = project.cover?.asset ? urlFor(project.cover).width(2000).height(2500).fit('crop').quality(80).url() : undefined;
const heroSet = project.cover?.asset
  ? [1400, 2000, 2600].map((w) => `${urlFor(project.cover).width(w).height(Math.round(w * 1.25)).fit('crop').quality(80).url()} ${w}w`).join(', ')
  : undefined;

// each picture keeps its own shape in the strip (all share one height)
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const ratio = (g: any): number => {
  const d = g?.image?.asset?.metadata?.dimensions;
  if (g?.kind === 'image' && d?.width && d?.height) return d.width / d.height;
  if (g?.kind === 'video') return 16 / 9;
  if (g?.kind === 'lottie') return 1.66;
  return 0.82;
};

// biome-ignore lint/suspicious/noExplicitAny: Portable Text blocks
const intro: any[] = project.intro ?? [];
const [lead] = intro;
const meta = [
  ['Client', project.client],
  ['Services', project.services],
  ['Year', project.yearLabel],
  ['Credits', project.credits],
].filter(([, v]) => v);
const description = stegaClean(lead?.children?.map((c: { text: string }) => c.text).join('') ?? settings?.seoDescription);
---

<Base title={`${stegaClean(project.title)} – ${settings?.name ?? 'Bart Ocieczek'}`} description={description} image={project.cover}>
  <main class="case">
    <!-- Pictures fill the page edge to edge, one after another. The story
         lives in a panel that slides in from the right: open on arrival,
         tucked away once you scroll, back with the handle on the edge. -->
    <a class="case__back-btn" href={href(Astro.locals, '/')} aria-label="Back to work">
      <span class="case__back-arrow" aria-hidden="true">←</span>
      <span class="t-label-small">Work</span>
    </a>

    <section class="case__media">
      {coverSrc && (
        <div class="case__cover" data-vt-cover>
          <!-- the home pill's own picture (already in the cache) carries the
               flight; the full-size one, same crop, sharpens it once decoded -->
          <img class="case__cover-lo" src={coverSrc} alt="" width="1000" height="1250" decoding="sync" />
          <img class="case__cover-hi" src={heroSrc} srcset={heroSet} sizes="100vw" alt="" fetchpriority="high" decoding="async" data-cover-hi />
        </div>
      )}
      <div class="case__gallery">
        {gallery.map((item, i) => <Media item={item} eager={i < 2} />)}
      </div>
    </section>

    <aside class="case__panel" data-panel aria-label="About the project">
      <button class="case__handle" type="button" data-panel-toggle aria-expanded="false" aria-label="Project info">
        <span></span>
      </button>
      <div class="case__panel-in">
        <div class="case__panel-top">
          <p class="t-label-small muted">
            Case study {index >= 0 && `— ${number(index + 1)}/${number(list.length)}`}
          </p>
          <h1 class="case__title">{project.title}</h1>
          {intro.length > 0 && (
            <div class="case__intro">
              <PortableText value={intro} />
            </div>
          )}
          <p class="case__hint t-label-small">[ Scroll to explore ]</p>
        </div>

        {meta.length > 0 && (
          <dl class="case__meta">
            {meta.map(([k, v]) => (
              <div>
                <dt class="t-label-small">{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )}

        <div class="case__panel-foot">
          <span class="t-label-small">{project.yearLabel}</span>
          {project.liveUrl && (
            <a class="case__live t-label-small" href={project.liveUrl} target="_blank" rel="noopener">Live site ↗</a>
          )}
        </div>
      </div>
    </aside>

    {next && (
      <a class="next" href={href(Astro.locals, `/${next.slug}`)} data-build>
        <div class="next__head">
          <span class="t-label-small" data-split>Next project</span>
          <span class="t-label-small" aria-hidden="true">→</span>
        </div>
        <p class="next__title" data-split>{next.cardTitle || next.title}</p>
        {next.cover?.asset && (
          <div class="next__media" data-parallax data-build-item>
            <img
              src={urlFor(next.cover).width(1800).height(900).fit('crop').quality(80).url()}
              srcset={srcset(next.cover, [800, 1400, 2000])}
              sizes="100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </a>
    )}

    {settings && <Footer settings={settings} ctaText={about?.ctaText} />}
  </main>
</Base>

<style>
  .case {
    background: var(--surface-dark);
  }

  /* ---------- Pictures, edge to edge ---------- */
  .case__media {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
  }
  .case__cover {
    height: calc(100svh - 16px);
    overflow: hidden;
    background: #f2f2f2;
    border-radius: var(--radius);
  }
  .case__cover {
    position: relative;
  }
  .case__cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case__cover-hi {
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .case__cover-hi.is-ready {
    opacity: 1;
  }
  .case__gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-flow: row dense;
    gap: 8px;
  }
  .case__gallery :global(.media--full) {
    grid-column: 1 / -1;
  }

  /* ---------- Back to work (top left) ---------- */
  .case__back-btn {
    position: fixed;
    z-index: 20;
    top: 20px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--text-primary);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04), 0 6px 24px rgba(0, 0, 0, 0.08);
    transition: transform 0.2s var(--ease-out);
  }
  .case__back-btn:active {
    transform: scale(0.97);
  }
  .case__back-arrow {
    font-size: 14px;
    line-height: 1;
  }

  /* ---------- The panel ---------- */
  .case__panel {
    position: fixed;
    z-index: 15;
    top: 24px;
    right: 24px;
    bottom: 24px;
    width: min(440px, 32vw);
    transform: translate3d(calc(100% + 16px), 0, 0);
    transform-origin: 100% 50%;
    will-change: transform;
    touch-action: pan-y;
  }
  .case__panel.is-dragging {
    cursor: grabbing;
    user-select: none;
  }
  .case__panel.is-dragging .case__handle {
    cursor: grabbing;
  }
  /* pulled out by hand: its contents are there under the finger */
  .case__panel.is-dragging .case__panel-in > * {
    opacity: 1;
    transform: none;
    transition-duration: 0.2s;
    transition-delay: 0s;
  }
  .case__panel-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 36px 32px 28px;
    background: #f4f4f2;
    border-radius: var(--radius);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .case__panel-in::-webkit-scrollbar {
    display: none;
  }
  /* the handle rides on the panel's left edge, so it stays on the screen
     edge when the panel is tucked away */
  .case__handle {
    position: absolute;
    top: 50%;
    left: -36px;
    width: 28px;
    height: 76px;
    margin-top: -38px;
    border: 0;
    padding: 0;
    border-radius: 10px;
    background: #f4f4f2;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
    cursor: grab;
    touch-action: none;
    display: grid;
    place-items: center;
    transition: transform 0.2s var(--ease-out), background-color 0.2s ease;
  }
  .case__handle span {
    width: 2px;
    height: 22px;
    border-radius: 2px;
    background: var(--text-primary);
    transition: transform 0.45s var(--ease-cover);
  }
  /* the grip leans with the drag speed (--grip, -1..1) */
  .case__handle span {
    rotate: calc(var(--grip, 0) * 14deg);
  }
  .case__panel:not(.is-open) .case__handle span {
    transform: scaleY(0.6);
  }
  @media (hover: hover) and (pointer: fine) {
    .case__handle:hover {
      background: #fff;
    }
    .case__handle:hover span {
      transform: scaleY(1.2);
    }
  }
  .case__handle:active {
    transform: scale(0.95);
  }
  .case__panel-top {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .case__title {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(32px, 2.6vw, 44px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .case__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 1.42;
    letter-spacing: -0.01em;
  }
  .case__intro :global(p) {
    color: var(--text-secondary);
  }
  .case__intro :global(p:first-child) {
    color: var(--text-primary);
  }
  .case__hint {
    color: var(--text-secondary);
    margin-top: 6px;
  }
  .case__meta {
    margin: auto 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px 16px;
    padding-top: 22px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }
  .case__meta dt {
    margin-bottom: 6px;
    color: var(--text-secondary);
  }
  .case__meta dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.35;
  }
  .case__panel-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    color: var(--text-secondary);
  }
  .case__live {
    color: var(--text-primary);
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  /* the panel's contents settle in just after it slides out */
  .case__panel-in > * {
    transition: opacity 0.5s var(--ease-out), transform 0.7s var(--ease-out);
  }
  .case__panel:not(.is-open) .case__panel-in > * {
    opacity: 0;
    transform: translateX(24px);
    transition-duration: 0.25s;
  }
  .case__panel.is-open .case__panel-in > :nth-child(2) {
    transition-delay: 0.08s;
  }
  .case__panel.is-open .case__panel-in > :nth-child(3) {
    transition-delay: 0.14s;
  }

  /* ---------- Next project ---------- */
  .next {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 160px var(--gutter) 120px;
  }
  .next__head {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .next__title {
    font-family: var(--font-display);
    font-size: clamp(64px, 11vw, 200px);
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }
  .next__media {
    position: relative;
    aspect-ratio: 2 / 1;
    background: #f2f2f2;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }
  .next__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover .next__title {
      color: var(--text-highlight);
    }
  }

  /* Arriving from a home cover: the cover morphs into place (view transition);
     the story and the rest of the gallery rise in after it, one by one */
  /* Arriving from a home cover: the panel waits off screen until the cover
     has landed, then slides in (see the script) */
  :global(html.from-card .case__gallery > *) {
    opacity: 0;
    transform: translateY(48px);
    transition: none;
  }
  :global(html.from-card.cover-landed .case__gallery > *) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1s var(--ease-out);
  }
  :global(html.from-card) .case__back-btn {
    animation: case-rise 0.7s 0.5s var(--ease-out) both;
  }
  @keyframes case-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .case__panel,
    .case__panel-in > *,
    :global(html.from-card .case__gallery > *) {
      animation: none;
      transform: none;
      transition: opacity 0.3s ease;
    }
  }

  @media (max-width: 1099px) {
    .case__panel {
      width: min(440px, 46vw);
    }
  }
  @media (max-width: 809px) {
    .case__panel {
      left: 24px;
      width: auto;
      top: auto;
      max-height: 78svh;
    }
    .case__panel-in {
      padding: 28px 22px 22px;
    }
    .case__handle {
      top: -14px;
      left: auto;
      right: 18px;
      margin-top: 0;
      transform: translateY(-100%);
    }
    .case__gallery {
      grid-template-columns: 1fr;
    }
    .next {
      padding: 96px var(--gutter) 80px;
    }
    .next__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  // Heading back home, something on screen always flies into the pill the
  // project was opened from (Hero.astro restores the column):
  // - the big cover, when it's still in view (corners round off into the pill)
  // - otherwise the small pill in the story column (pill to pill, no reshape)
  const slug = location.pathname.replace(/\/$/, '').split('/').pop();
  const cover = document.querySelector<HTMLElement>('[data-vt-cover]');
  const isHome = (url: string) => /^\/(preview\/?)?$/.test(new URL(url).pathname);

  // ---------- Cover: sharp picture over the flight picture ----------
  const hi = document.querySelector<HTMLImageElement>('[data-cover-hi]');
  const heroReady: Promise<void> = hi
    ? (hi.complete ? Promise.resolve() : new Promise<void>((r) => hi.addEventListener('load', () => r(), { once: true })))
        .then(() => hi.decode().catch(() => {}))
        .then(() => {
          // swap after the next frame, never in the middle of the flight paint
          requestAnimationFrame(() => hi.classList.add('is-ready'));
        })
    : Promise.resolve();

  // ---------- The story panel ----------
  // Always slides in: after the cover has landed and turned sharp (from home),
  // or just after the page shows (direct visit). Tucked away on the first
  // scroll, back with the handle or "i". It can be dragged by its handle or
  // its body: it follows the finger, stretches like rubber past its limits
  // (more the further it's pulled), and springs to open or closed on release,
  // carrying the speed it was let go with.
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const toggle = panel?.querySelector<HTMLButtonElement>('[data-panel-toggle]');
  let setPanel: (open: boolean) => void = () => {};
  const startPanel = () => {
    if (!panel || !toggle) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let touched = false;
    let open = false;
    // x: how far right of its open place the panel is (0 = open)
    // closed: the panel is off screen with just its handle showing at the
    // edge of the page (left of any scrollbar)
    const closedX = () => document.documentElement.clientWidth + 2 - panel.offsetLeft;
    let x = closedX();
    let v = 0; // px per second
    let target = x;
    let raf = 0;
    let dragging = false;

    // rubber: the further past the limit, the less it gives (never stops)
    const rubber = (d: number, c: number) => (1 - 1 / ((d * 0.55) / c + 1)) * c;
    const render = () => {
      const W = panel.offsetWidth;
      const max = closedX();
      let tx = x;
      let sx = 1;
      if (x < 0) {
        // pulled out further than open: it stretches from its right edge
        const over = -x;
        tx = -over * 0.55;
        sx = 1 + (over * 0.45) / W;
      } else if (x > max) tx = max + (x - max) * 0.3;
      panel.style.transform = `translate3d(${tx.toFixed(2)}px,0,0) scaleX(${sx.toFixed(4)})`;
      // the grip leans with the speed, so a fling feels physical
      panel.style.setProperty('--grip', `${Math.max(-1, Math.min(1, v / 2400)).toFixed(3)}`);
    };
    // damped spring towards target; the release speed carries into it
    let last = 0;
    const step = (now: number) => {
      const dt = Math.min(1 / 30, (now - last) / 1000 || 1 / 60);
      last = now;
      const k = 210; // stiffness
      const c = 24; // damping (a touch under critical: one soft overshoot)
      v += (-k * (x - target) - c * v) * dt;
      x += v * dt;
      render();
      if (Math.abs(x - target) < 0.4 && Math.abs(v) < 6) {
        x = target;
        v = 0;
        render();
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(step);
    };
    const springTo = (t: number) => {
      target = t;
      if (reduce) {
        x = t;
        v = 0;
        render();
        return;
      }
      if (!raf) {
        last = performance.now();
        raf = requestAnimationFrame(step);
      }
    };
    const set = (o: boolean) => {
      open = o;
      panel.classList.toggle('is-open', o);
      toggle.setAttribute('aria-expanded', String(o));
      springTo(o ? 0 : closedX());
    };
    setPanel = set;
    render();
    panel.classList.add('is-js');

    // ---- drag ----
    let startX = 0;
    let startPanelX = 0;
    let moved = 0;
    let lastPX = 0;
    let lastT = 0;
    let pid = -1;
    panel.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      // links and text in the panel stay clickable/selectable with a mouse
      if (e.pointerType === 'mouse' && e.target !== toggle && !toggle.contains(e.target as Node) && (e.target as HTMLElement).closest('a, dd, dt, p, h1')) return;
      pid = e.pointerId;
      startX = lastPX = e.clientX;
      lastT = performance.now();
      startPanelX = x;
      moved = 0;
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    });
    window.addEventListener('pointermove', (e) => {
      if (e.pointerId !== pid) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (!dragging && moved > 5) {
        dragging = true;
        touched = true;
        panel.classList.add('is-dragging');
        try {
          panel.setPointerCapture(pid);
        } catch (err) {}
      }
      if (!dragging) return;
      const now = performance.now();
      const dt = Math.max(1, now - lastT);
      // smoothed finger speed (px/s)
      v = v * 0.6 + ((e.clientX - lastPX) / dt) * 1000 * 0.4;
      lastPX = e.clientX;
      lastT = now;
      const raw = startPanelX + dx;
      const max = closedX();
      // past the open place: rubber (stretch grows with the pull, but slower)
      if (raw < 0) x = -rubber(-raw, 160);
      else if (raw > max) x = max + rubber(raw - max, 80);
      else x = raw;
      render();
    });
    const end = (e: PointerEvent) => {
      if (e.pointerId !== pid) return;
      pid = -1;
      if (!dragging) {
        // a press without a pull: let the spring finish what it was doing
        springTo(target);
        return;
      }
      dragging = false;
      panel.classList.remove('is-dragging');
      // a fling decides; otherwise wherever it is closer to
      const max = closedX();
      const flingOpen = v < -450;
      const flingClose = v > 450;
      set(flingOpen ? true : flingClose ? false : x < max / 2);
    };
    window.addEventListener('pointerup', end);
    window.addEventListener('pointercancel', end);

    toggle.addEventListener('click', (e) => {
      // the end of a drag isn't a click
      if (moved > 5) {
        e.preventDefault();
        moved = 0;
        return;
      }
      touched = true;
      set(!open);
    });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
      if (e.key === 'i' && !(e.target as HTMLElement).closest('input, textarea')) {
        touched = true;
        set(!open);
      }
    });
    window.addEventListener('resize', () => {
      if (!open && !dragging) {
        x = target = closedX();
        render();
      }
    });

    let opened = false;
    const openOnce = () => {
      if (opened || touched || window.scrollY > 60) return;
      opened = true;
      set(true);
    };
    const root = document.documentElement;
    // decide after the page has been revealed (Base.astro marks a cover
    // flight with .from-card in 'pagereveal', which runs before this frame)
    requestAnimationFrame(() => {
      let fromCard = root.classList.contains('from-card');
      try {
        fromCard ||= !!sessionStorage.getItem('vt-card');
      } catch (err) {}
      const landed = new Promise<void>((resolve) => {
        if (!fromCard || root.classList.contains('cover-landed')) return resolve();
        new MutationObserver((_, mo) => {
          if (!root.classList.contains('cover-landed')) return;
          mo.disconnect();
          resolve();
        }).observe(root, { attributes: true, attributeFilter: ['class'] });
      });
      Promise.all([landed, heroReady]).then(() => window.setTimeout(openOnce, fromCard ? 120 : 350));
      // never wait forever (slow network)
      window.setTimeout(openOnce, 3500);
    });
    // the first scroll down tucks it away (once; after that it's the user's)
    window.addEventListener(
      'scroll',
      () => {
        if (touched || dragging || window.scrollY < 60) return;
        touched = true;
        set(false);
      },
      { passive: true },
    );
  };
  // a page prerendered on hover runs this early: wait until it's really shown
  if ((document as unknown as { prerendering?: boolean }).prerendering) {
    document.addEventListener('prerenderingchange', startPanel, { once: true });
  } else startPanel();

  // which picture flies home: the cover while a third of it is visible,
  // otherwise the small pill in the back button
  let coverShowing = true;
  if (cover) {
    new IntersectionObserver(
      ([e]) => {
        coverShowing = e.intersectionRatio > 0.33;
      },
      { threshold: [0, 0.33, 0.5, 1] },
    ).observe(cover);
  }

  // Back to work: the panel tucks away, the page glides up to the main
  // picture, and from there the cover shrinks into its pill on home.
  // Came here from the home column? Then it's a real history step: the browser
  // restores home exactly as it was left (column, covers, WebGL).
  const nav = (window as unknown as { navigation?: { entries(): { url: string | null }[]; currentEntry?: { index: number } } }).navigation;
  const lenis = () => (window as unknown as { lenis?: { scrollTo(y: number, o: object): void } }).lenis;
  let leaving = false;
  const leave = (url: string) => {
    const i = nav?.currentEntry?.index ?? -1;
    const prev = i > 0 ? nav!.entries()[i - 1] : null;
    if (prev?.url && isHome(prev.url) && new URL(prev.url).origin === location.origin) history.back();
    else location.href = url;
  };
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
    if (!isHome(a.href)) return;
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      e.preventDefault();
      if (leaving) return;
      leaving = true;
      setPanel(false);
      const y = window.scrollY;
      if (y < 4 || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        coverShowing = true;
        leave(a.href);
        return;
      }
      // glide up (longer for longer ways, but never slow), then fly home
      const dur = Math.min(0.8, Math.max(0.4, y / 3200));
      const done = () => {
        coverShowing = true;
        requestAnimationFrame(() => leave(a.href));
      };
      const l = lenis();
      if (l) l.scrollTo(0, { duration: dur, easing: (t: number) => 1 - Math.pow(1 - t, 4), force: true, lock: true, onComplete: done });
      else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
        window.setTimeout(done, dur * 1000);
      }
    });
  });
  // back from the bfcache onto this page: allow leaving again
  window.addEventListener('pageshow', () => {
    leaving = false;
  });

  window.addEventListener('pageswap', (e) => {
    const to = (e as unknown as { activation?: { entry?: { url?: string } } }).activation?.entry?.url;
    try {
      sessionStorage.removeItem('vt-back');
      if (!cover || !to || !isHome(to) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // cover scrolled away: nothing flies in from off screen, home just
      // dissolves in with the column where it was
      if (!coverShowing) {
        sessionStorage.setItem('vt-back', JSON.stringify({ slug, still: true }));
        return;
      }
      cover.style.viewTransitionName = 'project-cover';
      // the frame's size, so home can scale the photo evenly into the pill
      const f = cover.getBoundingClientRect();
      sessionStorage.setItem('vt-back', JSON.stringify({ slug, frame: { w: f.width, h: f.height } }));
    } catch (err) {}
  });
</script>

