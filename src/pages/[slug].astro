---
import { PortableText } from 'astro-portabletext';
import { stegaClean } from '@sanity/client/stega';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Media from '../components/Media.astro';
import Footer from '../components/Footer.astro';
import { PROJECT_ORDER_QUERY, PROJECT_QUERY, SETTINGS_QUERY, srcset, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import { href } from '../lib/preview';

const { slug } = Astro.params;
const [project, settings, about, order] = await Promise.all([
  load(Astro.locals, PROJECT_QUERY, { slug }),
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, `*[_id == "aboutPage"][0]{ctaText}`),
  load(Astro.locals, PROJECT_ORDER_QUERY),
]);
if (!project) return Astro.rewrite('/404');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const list: any[] = (order ?? []).filter(Boolean);
const index = list.findIndex((p) => p.slug === project.slug);
const next = list.length > 1 ? list[(index + 1) % list.length] : undefined;
const number = (n: number) => String(n).padStart(2, '0');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
// The cover opens the gallery, so skip a gallery image that is the same file
const gallery: any[] = (project.gallery ?? []).filter(
  (g: any) => !(project.cover?.asset?._id && g?.image?.asset?._id === project.cover.asset._id),
);
// First graphic: the card cover in the same 4:5 crop as the home carousel,
// so the thumbnail can morph straight into it
const coverSrc = project.cover?.asset ? urlFor(project.cover).width(1000).height(1250).fit('crop').quality(82).url() : undefined;

// each picture keeps its own shape in the strip (all share one height)
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const ratio = (g: any): number => {
  const d = g?.image?.asset?.metadata?.dimensions;
  if (g?.kind === 'image' && d?.width && d?.height) return d.width / d.height;
  if (g?.kind === 'video') return 16 / 9;
  if (g?.kind === 'lottie') return 1.66;
  return 0.82;
};

// biome-ignore lint/suspicious/noExplicitAny: Portable Text blocks
const intro: any[] = project.intro ?? [];
const [lead] = intro;
const meta = [
  ['Client', project.client],
  ['Services', project.services],
  ['Year', project.yearLabel],
  ['Credits', project.credits],
].filter(([, v]) => v);
const description = stegaClean(lead?.children?.map((c: { text: string }) => c.text).join('') ?? settings?.seoDescription);
---

<Base title={`${stegaClean(project.title)} – ${settings?.name ?? 'Bart Ocieczek'}`} description={description} image={project.cover}>
  <main class="case">
    <!-- First screen: the project's name on top, its pictures side by side in
         one line below. Scrolling down moves the line sideways (pinned). -->
    <section class="case__pin" data-pin>
      <div class="case__stage">
        <div class="case__nav">
          <Nav callUrl={settings?.callUrl} socials={settings?.socials} role={settings?.role} />
        </div>

        <header class="case__top">
          <div class="case__name">
            <p class="t-label-small muted">
              Case study {index >= 0 && `— ${number(index + 1)}/${number(list.length)}`}
            </p>
            <h1 class="case__title">{project.title}</h1>
          </div>
          <div class="case__facts">
            {project.yearLabel && <span class="t-label-small muted">{project.yearLabel}</span>}
            {project.services && <span class="case__services">{project.services}</span>}
          </div>
          {coverSrc && (
            <a class="case__mini" href={href(Astro.locals, '/')} data-vt-mini aria-label="Back to work">
              <img src={coverSrc} alt="" width="1000" height="1250" decoding="async" />
            </a>
          )}
        </header>

        <div class="case__strip" data-strip>
          <div class="case__track" data-track>
            {coverSrc && (
              <div class="case__slot case__cover" data-vt-cover style="--ar:0.8">
                <img src={coverSrc} alt="" width="1000" height="1250" fetchpriority="high" decoding="async" />
              </div>
            )}
            {gallery.map((item, i) => (
              <div class="case__slot" style={`--ar:${ratio(item).toFixed(4)}`}>
                <Media item={item} eager={i < 4} />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="case__info">
      {intro.length > 0 && (
        <div class="case__intro t-compact" data-split>
          <PortableText value={intro} />
        </div>
      )}
      <aside class="case__side">
        {meta.length > 0 && (
          <dl class="case__meta" data-reveal>
            {meta.map(([k, v]) => (
              <div>
                <dt class="t-label-small">{k}</dt>
                <dd class="t-label">{v}</dd>
              </div>
            ))}
          </dl>
        )}
        {project.liveUrl && (
          <a class="line-button is-closed" href={project.liveUrl} target="_blank" rel="noopener" data-reveal>
            <span>Visit live ↗</span>
          </a>
        )}
        <a href={href(Astro.locals, '/')} class="u-link t-label-small case__back">← Back to work</a>
      </aside>
    </section>

    {next && (
      <a class="next" href={href(Astro.locals, `/${next.slug}`)} data-build>
        <div class="next__head">
          <span class="t-label-small" data-split>Next project</span>
          <span class="t-label-small" aria-hidden="true">→</span>
        </div>
        <p class="next__title" data-split>{next.cardTitle || next.title}</p>
        {next.cover?.asset && (
          <div class="next__media" data-parallax data-build-item>
            <img
              src={urlFor(next.cover).width(1800).height(900).fit('crop').quality(80).url()}
              srcset={srcset(next.cover, [800, 1400, 2000])}
              sizes="100vw"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        )}
      </a>
    )}

    {settings && <Footer settings={settings} ctaText={about?.ctaText} />}
  </main>
</Base>

<style>
  .case {
    background: var(--surface-dark);
  }

  /* ---------- First screen: name on top, pictures in one line ---------- */
  /* --travel (set by the script) is how far the line moves sideways; the
     section is that much taller than the screen and the stage stays pinned */
  .case__pin {
    position: relative;
    height: calc(100svh + var(--travel, 0px));
  }
  .case__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .case__nav {
    padding: var(--gutter) var(--gutter) 0;
  }
  .case__top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding: clamp(24px, 5vh, 56px) var(--gutter) clamp(20px, 3.4vh, 36px);
  }
  .case__name {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
  }
  .case__title {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(44px, 6.4vw, 112px);
    line-height: 0.92;
    letter-spacing: -0.045em;
    color: var(--text-primary);
  }
  .case__facts {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    text-align: right;
    padding-bottom: 6px;
    margin-right: 84px;
  }
  .case__services {
    font-size: 17px;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }
  /* The home pill, at the end of the title row. It shows up once the big
     cover has moved away, so there's always something on screen to fly home. */
  .case__mini {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(20px, 3.4vh, 36px);
    width: 64px;
    aspect-ratio: 0.75;
    border-radius: 999px;
    overflow: hidden;
    background: #f2f2f2;
    opacity: 0;
    transform: translateY(8px) scale(0.92);
    pointer-events: none;
    transition: opacity 0.35s var(--ease-out), transform 0.45s var(--ease-out);
  }
  .case__mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .case__mini.is-shown {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .case__mini:active {
    transform: scale(0.96);
    transition-duration: 0.16s;
  }

  /* the line: every picture is as tall as the space left, its width follows
     its own proportions */
  .case__strip {
    flex: 1;
    min-height: 0;
    padding: 0 0 var(--gutter);
  }
  .case__track {
    display: flex;
    gap: 12px;
    height: 100%;
    padding: 0 var(--gutter);
    width: max-content;
    will-change: transform;
  }
  .case__slot {
    position: relative;
    flex: none;
    height: 100%;
    aspect-ratio: var(--ar, 0.8);
    border-radius: var(--radius);
    overflow: hidden;
    background: #f2f2f2;
  }
  .case__slot > :global(.media) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    /* always shown: the line itself handles how pictures come in */
    opacity: 1;
    transform: none;
    transition: none;
  }
  .case__slot :global(.media img),
  .case__slot :global(.media video) {
    height: 100% !important;
    min-height: 0;
    object-fit: cover;
  }
  /* no vertical drift inside pictures that move sideways */
  .case__slot :global([data-parallax].has-parallax > *) {
    transform: none !important;
  }
  .case__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- About the project ---------- */
  .case__info {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 64px;
    padding: clamp(80px, 12vh, 140px) var(--gutter) 0;
  }
  .case__intro {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
  }
  .case__intro :global(p) {
    color: var(--text-secondary);
  }
  .case__intro :global(p:first-child) {
    color: var(--text-primary);
    font-size: clamp(20px, 1.6vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
  .case__side {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .case__meta {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .case__meta dt {
    margin-bottom: 6px;
    color: var(--text-secondary);
  }
  .case__meta dd {
    margin: 0;
    font-size: 13px;
  }
  .case__back {
    align-self: flex-start;
    color: var(--text-secondary);
  }
  @media (hover: hover) and (pointer: fine) {
    .case__back:hover {
      color: var(--text-primary);
    }
  }

  /* ---------- Next project ---------- */
  .next {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 160px var(--gutter) 120px;
  }
  .next__head {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 16px;
  }
  .next__title {
    font-family: var(--font-display);
    font-size: clamp(64px, 11vw, 200px);
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--text-primary);
    transition: color 0.3s ease;
  }
  .next__media {
    position: relative;
    aspect-ratio: 2 / 1;
    background: #f2f2f2;
    border-radius: var(--radius);
    overflow: hidden;
    isolation: isolate;
  }
  .next__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (hover: hover) and (pointer: fine) {
    .next:hover .next__title {
      color: var(--text-highlight);
    }
  }

  /* Arriving from a home cover: the cover morphs into place (view transition);
     the story and the rest of the gallery rise in after it, one by one */
  :global(html.from-card) :is(.case__name, .case__facts) > * {
    animation: case-rise 0.9s var(--ease-out) both;
  }
  :global(html.from-card) .case__name > :nth-child(1) {
    animation-delay: 0.4s;
  }
  :global(html.from-card) .case__name > :nth-child(2) {
    animation-delay: 0.47s;
  }
  :global(html.from-card) .case__facts > * {
    animation-delay: 0.56s;
  }
  /* The project's other pictures wait until the cover has landed (Base.astro
     adds .cover-landed when the flight ends), then slide in one after another
     from the right, along the line */
  :global(html.from-card .case__track > .case__slot:not(.case__cover)) {
    opacity: 0;
    transform: translateX(80px);
    transition: none;
  }
  :global(html.from-card.cover-landed .case__track > .case__slot:not(.case__cover)) {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out),
      transform 1s var(--ease-out);
  }
  :global(html.from-card.cover-landed .case__track > :nth-child(3)) {
    transition-delay: 0.07s;
  }
  :global(html.from-card.cover-landed .case__track > :nth-child(4)) {
    transition-delay: 0.14s;
  }
  :global(html.from-card.cover-landed .case__track > :nth-child(n + 5)) {
    transition-delay: 0.21s;
  }
  @keyframes case-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.from-card) :is(.case__name, .case__facts) > *,
    :global(html.from-card .case__track > *) {
      animation: none;
      transform: none;
      transition: opacity 0.3s ease;
    }
  }

  @media (max-width: 1099px) {
    .case__info {
      grid-template-columns: 1fr;
      gap: 48px;
    }
  }
  /* phones: no pinning, the line scrolls sideways with the finger */
  @media (max-width: 809px) {
    .case__pin {
      height: auto;
    }
    .case__stage {
      position: relative;
      height: auto;
    }
    .case__top {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .case__facts {
      align-items: flex-start;
      text-align: left;
      margin-right: 0;
    }
    .case__strip {
      flex: none;
      height: 62svh;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .case__strip::-webkit-scrollbar {
      display: none;
    }
    .case__slot {
      scroll-snap-align: center;
    }
    .case__info {
      padding-top: 64px;
    }
    .next {
      padding: 96px var(--gutter) 80px;
    }
    .next__media {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  // Heading back home, something on screen always flies into the pill the
  // project was opened from (Hero.astro restores the column):
  // - the big cover, when it's still in view (corners round off into the pill)
  // - otherwise the small pill in the story column (pill to pill, no reshape)
  const slug = location.pathname.replace(/\/$/, '').split('/').pop();
  const cover = document.querySelector<HTMLElement>('[data-vt-cover]');
  const mini = document.querySelector<HTMLElement>('[data-vt-mini]');
  const isHome = (url: string) => /^\/(preview\/?)?$/.test(new URL(url).pathname);

  // ---------- The line moves sideways while the page scrolls ----------
  const pin = document.querySelector<HTMLElement>('[data-pin]');
  const strip = document.querySelector<HTMLElement>('[data-strip]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  if (pin && strip && track) {
    const wide = window.matchMedia('(min-width: 810px)');
    let travel = 0;
    const measure = () => {
      travel = wide.matches ? Math.max(0, track.scrollWidth - strip.clientWidth) : 0;
      pin.style.setProperty('--travel', `${travel}px`);
      update();
    };
    let queued = false;
    const update = () => {
      queued = false;
      if (!travel) {
        track.style.transform = '';
        return;
      }
      const p = Math.min(1, Math.max(0, (window.scrollY - pin.offsetTop) / travel));
      track.style.transform = `translate3d(${(-p * travel).toFixed(1)}px, 0, 0)`;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener('resize', measure);
    wide.addEventListener('change', measure);
    // pictures that load late can change nothing (fixed ratios), but fonts can
    document.fonts?.ready.then(measure);
    new ResizeObserver(measure).observe(strip);
    measure();
  }

  // the mini pill appears once less than a third of the cover is visible
  let coverShowing = true;
  if (cover && mini) {
    new IntersectionObserver(
      ([e]) => {
        coverShowing = e.intersectionRatio > 0.33;
        mini.classList.toggle('is-shown', !coverShowing);
      },
      { threshold: [0, 0.33, 0.5, 1] },
    ).observe(cover);
  }

  // Came here from the home column? Going "back to work" is then a real
  // history step: the browser restores home exactly as it was left (column,
  // loaded covers, WebGL) instead of building it again.
  const nav = (window as unknown as { navigation?: { entries(): { url: string | null }[]; currentEntry?: { index: number } } }).navigation;
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((a) => {
    if (!isHome(a.href)) return;
    a.addEventListener('click', (e) => {
      if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
      const i = nav?.currentEntry?.index ?? -1;
      const prev = i > 0 ? nav!.entries()[i - 1] : null;
      if (prev?.url && isHome(prev.url) && new URL(prev.url).origin === location.origin) {
        e.preventDefault();
        history.back();
      }
    });
  });

  window.addEventListener('pageswap', (e) => {
    const to = (e as unknown as { activation?: { entry?: { url?: string } } }).activation?.entry?.url;
    try {
      sessionStorage.removeItem('vt-back');
      if (!cover || !to || !isHome(to) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const usePill = !coverShowing && !!mini;
      const el = usePill ? mini! : cover;
      el.style.viewTransitionName = 'project-cover';
      // its corner radius, so the flight rounds off evenly into the home pill
      const r = usePill ? mini!.offsetWidth / 2 : parseFloat(getComputedStyle(cover).borderTopLeftRadius) || 20;
      sessionStorage.setItem('vt-back', JSON.stringify({ slug, pill: usePill, r }));
    } catch (err) {}
  });
</script>

