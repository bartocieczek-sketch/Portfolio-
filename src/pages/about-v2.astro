---
// Draft: a story-led About page. Six chapters, read top to bottom:
// 01 Hello (who) → 02 Path (where from, a pinned horizontal timeline) →
// 03 Craft (what, a list that previews real work under the cursor) →
// 04 AI (how, a draggable "same brief, two timelines" comparison) →
// 05 Off-screen (who, beyond work: a hold-to-brew coffee and a pulse that
// follows your scroll speed) → 06 Talk (a live Warsaw clock + magnetic CTA).
// A chapter index on the left tracks where you are. Content from Sanity.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { ABOUT_QUERY, HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import glyphs from '../lib/monogram-b.json';

const [settings, about, home] = await Promise.all([
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, ABOUT_QUERY),
  load(Astro.locals, HOME_QUERY),
]);
if (!settings || !about) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const covers: string[] = ((home?.projects ?? []) as any[])
  .filter((p) => p?.cover?.asset)
  .map((p) => urlFor(p.cover).width(640).height(800).fit('crop').quality(80).url());
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const jobs = ((about.experience ?? []) as any[]).map((e) => ({
  company: e.company as string,
  role: (e.role as string)?.toLowerCase(),
  period: (e.period as string) ?? '',
  now: /present/i.test(e.period ?? ''),
  logo: e.logo?.asset ? urlFor(e.logo).width(160).height(160).fit('crop').url() : null,
}));
// "UX/UI DESIGN" → "UX/UI design", "AI IN DESIGN" → "AI in design"
const focus: string[] = (about.focus ?? []).map((f: string) => {
  const s = f.toLowerCase().replace(/\b(ux|ui|ai)\b/g, (m) => m.toUpperCase());
  return s.charAt(0).toUpperCase() + s.slice(1);
});
const portrait = about.portrait?.asset ? urlFor(about.portrait).width(300).height(300).fit('crop').url() : null;
const [bPath, bBox] = glyphs.g.B as [string, number[], number];
const bView = `${bBox[0]} ${-bBox[3]} ${bBox[2] - bBox[0]} ${bBox[3] - bBox[1]}`;
const chapters = ['Hello', 'Path', 'Craft', 'AI', 'Off-screen', 'Talk'];
// the hero line with the name swapped for an inline portrait
const lead: string = about.introLead ?? "Hi, I'm Bart, a digital designer.";
const [leadA, leadB] = lead.split(/Bart/);
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="about ab" data-ab>
    <header class="ab__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <!-- chapter index: where you are in the story -->
    <nav class="ab__index" aria-label="Chapters">
      {chapters.map((c, i) => (
        <a href={`#ch-${i + 1}`} data-ch-link={i}>
          <span class="ab__index-n">0{i + 1}</span>
          <span class="ab__index-t">{c}</span>
        </a>
      ))}
      <span class="ab__index-bar"><span data-progress></span></span>
    </nav>

    <!-- 01 Hello -->
    <section class="ab__ch ab__hello" id="ch-1" data-ch>
      <p class="ab__kicker" data-reveal>01 — Hello</p>
      <h1 class="ab__lead" data-words>
        {leadA}
        {portrait ? (
          <span class="ab__me" tabindex="0" aria-label="Bart">
            <img src={portrait} alt="" width="300" height="300" />
            <span>Bart</span>
          </span>
        ) : 'Bart'}
        {leadB}
      </h1>
      <p class="ab__body" data-reveal>{about.introBody}</p>
      <p class="ab__clock" data-reveal><span class="ab__dot"></span><span data-clock>Warsaw</span></p>
    </section>

    <!-- 02 Path: pinned, scrolls sideways -->
    <section class="ab__ch ab__path" id="ch-2" data-ch data-path style={`--n:${jobs.length}`}>
      <div class="ab__path-pin">
        <div class="ab__path-head">
          <p class="ab__kicker" data-reveal>02 — Path</p>
          <p class="ab__h2" data-reveal>{about.experienceLead}</p>
        </div>
        <div class="ab__track-wrap">
        <div class="ab__track" data-track>
          {jobs.map((j, i) => (
            <article class="ab__job" style={`--i:${i}`}>
              <div class="ab__job-top">
                {j.logo ? <img src={j.logo} alt="" width="160" height="160" loading="lazy" /> : <span class="ab__job-logo" />}
                {j.now && <span class="ab__now">now</span>}
              </div>
              <p class="ab__job-period">{j.period.toLowerCase()}</p>
              <h3 class="ab__job-co">{j.company}</h3>
              <p class="ab__job-role">{j.role}</p>
            </article>
          ))}
          <blockquote class="ab__quote">{about.quote}</blockquote>
        </div>
        </div>
        <div class="ab__path-line"><span data-path-fill></span></div>
      </div>
    </section>

    <!-- 03 Craft: hover a skill, see the work -->
    <section class="ab__ch ab__craft" id="ch-3" data-ch>
      <p class="ab__kicker" data-reveal>03 — Craft</p>
      <p class="ab__h2" data-reveal>{about.experienceBody}</p>
      <ul class="ab__skills" data-skills>
        {focus.map((f, i) => (
          <li data-cover={covers.length ? covers[i % covers.length] : ''} data-reveal>
            <span class="ab__skill-n">0{i + 1}</span>
            <span class="ab__skill-t">{f}</span>
          </li>
        ))}
      </ul>
      <div class="ab__peek" aria-hidden="true" data-peek><img alt="" /></div>
    </section>

    <!-- 04 AI: same brief, two timelines -->
    <section class="ab__ch ab__ai" id="ch-4" data-ch>
      <p class="ab__kicker" data-reveal>04 — AI in the loop</p>
      <p class="ab__h2" data-reveal>AI does the legwork. Judgment stays human. Drag to compare the same brief, built two ways.</p>
      <div class="ab__cmp" data-cmp style="--t:0.5">
        <div class="ab__cmp-rows">
          {[
            ['Research', 0.22, 0.1],
            ['Concepts', 0.28, 0.12],
            ['Design', 0.3, 0.2],
            ['Build', 0.36, 0.22],
            ['QA & launch', 0.14, 0.08],
          ].map(([name, a, b], i) => (
            <div class="ab__cmp-row" style={`--a:${a};--b:${b};--i:${i}`}>
              <span class="ab__cmp-name">{name}</span>
              <span class="ab__cmp-bar"><span /></span>
            </div>
          ))}
        </div>
        <div class="ab__cmp-foot">
          <span>classic workflow</span>
          <strong data-weeks>5.5 weeks</strong>
          <span>with AI in the loop</span>
        </div>
        <input type="range" min="0" max="100" value="50" aria-label="Classic workflow to AI-assisted workflow" data-cmp-input />
      </div>
    </section>

    <!-- 05 Off-screen -->
    <section class="ab__ch ab__off" id="ch-5" data-ch>
      <p class="ab__kicker" data-reveal>05 — Off-screen</p>
      <div class="ab__off-grid">
        <div class="ab__card" data-reveal>
          <p class="ab__card-k">Fuel</p>
          <p class="ab__card-big"><span data-cups>0</span> coffees today</p>
          <button class="ab__brew" type="button" data-brew>
            <span class="ab__brew-fill" aria-hidden="true"></span>
            <span class="ab__brew-t">Hold to brew one</span>
          </button>
        </div>
        <div class="ab__card" data-reveal>
          <p class="ab__card-k">Sport</p>
          <p class="ab__card-big">Training keeps the head clear.</p>
          <p class="ab__bpm"><span data-bpm>62</span> bpm</p>
          <svg class="ab__pulse" viewBox="0 0 600 120" preserveAspectRatio="none" aria-hidden="true"><path data-pulse d="" /></svg>
          <p class="ab__card-s">Every coffee pushes it up. So does scrolling fast.</p>
        </div>
      </div>
    </section>

    <!-- 06 Talk -->
    <section class="ab__ch ab__talk" id="ch-6" data-ch>
      <svg class="ab__talk-b" viewBox={bView} aria-hidden="true"><path transform="scale(1,-1)" d={bPath} fill="currentColor" /></svg>
      <p class="ab__kicker" data-reveal>06 — Talk</p>
      <p class="ab__cta" data-words>{about.ctaText}</p>
      <a class="ab__btn" href={settings.callUrl ?? '#'} target="_blank" rel="noopener" data-magnet>
        <span>Let’s talk</span>
      </a>
      <p class="ab__clock ab__clock--end" data-reveal><span class="ab__dot"></span><span data-clock>Warsaw</span></p>
    </section>
  </main>
</Base>

<style>
  .ab {
    --e-out: cubic-bezier(0.23, 1, 0.32, 1);
    --e-io: cubic-bezier(0.77, 0, 0.175, 1);
    --e-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --pad: clamp(24px, 8vw, 160px);
    position: relative;
    color: var(--text-primary);
    background: var(--surface-dark);
  }
  .ab__nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    padding: var(--gutter);
    mix-blend-mode: difference;
  }

  /* chapter index */
  .ab__index {
    position: fixed;
    left: var(--gutter);
    top: 50%;
    z-index: 10;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 6px;
    font: 500 12px/1 var(--font-head);
    letter-spacing: -0.01em;
  }
  .ab__index a {
    display: flex;
    gap: 10px;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 3px 0;
    transition: color 0.25s ease;
  }
  .ab__index a.is-on {
    color: var(--text-primary);
  }
  .ab__index-t {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.4s var(--e-out);
  }
  .ab__index a.is-on .ab__index-t,
  .ab__index:hover .ab__index-t {
    clip-path: inset(0 0 0 0);
  }
  .ab__index-bar {
    width: 1px;
    height: 64px;
    margin: 8px 0 0 7px;
    background: var(--line);
    overflow: hidden;
  }
  .ab__index-bar span {
    display: block;
    height: 100%;
    background: var(--text-primary);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }

  /* chapters */
  .ab__ch {
    position: relative;
    padding: clamp(96px, 16vh, 200px) var(--pad);
  }
  .ab__kicker {
    margin: 0 0 28px;
    font: 500 12px/1 var(--font-head);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .ab__h2 {
    max-width: 30ch;
    margin: 0 0 48px;
    font: 500 clamp(22px, 2.4vw, 36px) / 1.12 var(--font-head);
    letter-spacing: -0.035em;
  }

  /* generic reveal: rise + unblur (blur bridges the soft start) */
  [data-reveal] {
    opacity: 0;
    transform: translateY(18px);
    filter: blur(6px);
    transition:
      opacity 0.9s var(--e-out),
      transform 1.1s var(--e-expo),
      filter 0.9s var(--e-out);
    transition-delay: var(--d, 0s);
  }
  [data-reveal].is-in {
    opacity: 1;
    transform: none;
    filter: none;
  }
  /* words: each rises out of its own line mask */
  :global(.ab .w) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  :global(.ab .wi) {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 1s var(--e-expo);
    transition-delay: calc(var(--k) * 28ms);
  }
  :global(.ab .is-in .wi) {
    transform: none;
  }

  /* 01 */
  .ab__hello {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .ab__lead {
    max-width: 22ch;
    margin: 0 0 40px;
    font: 500 clamp(38px, 5.6vw, 88px) / 0.98 var(--font-head);
    letter-spacing: -0.05em;
  }
  /* the name as an inline portrait pill that opens on hover/focus */
  .ab__me {
    display: inline-flex;
    align-items: center;
    gap: 0.12em;
    height: 0.86em;
    padding: 0 0.22em 0 0.06em;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    vertical-align: -0.06em;
    cursor: default;
    outline: none;
  }
  .ab__me img {
    width: 0.74em;
    height: 0.74em;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
    transition:
      width 0.5s var(--e-out),
      filter 0.5s var(--e-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ab__me:hover img {
      width: 1.6em;
      border-radius: 999px;
      filter: none;
    }
  }
  .ab__me:focus-visible img {
    width: 1.6em;
    border-radius: 999px;
    filter: none;
  }
  .ab__body {
    max-width: 44ch;
    margin: 0 0 32px;
    font: 400 17px/1.45 var(--font-body);
    color: var(--text-secondary);
  }
  .ab__clock {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font: 500 13px/1 var(--font-head);
    color: var(--text-secondary);
  }
  .ab__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.5);
    animation: ab-ping 2.4s ease-out infinite;
  }
  .ab__dot.is-off {
    background: #f59e0b;
    animation: none;
  }
  @keyframes ab-ping {
    to {
      box-shadow: 0 0 0 10px rgba(74, 222, 128, 0);
    }
  }

  /* 02: a tall section with a sticky stage; the track moves sideways */
  .ab__path {
    height: calc(100svh + var(--n) * 38vh);
    padding: 0;
  }
  .ab__path-pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 var(--pad);
  }
  .ab__path-head .ab__h2 {
    margin-bottom: 36px;
  }
  /* cards fade out as they slide past the left edge (and the chapter index) */
  .ab__track-wrap {
    margin: 0 calc(var(--pad) * -1);
    padding: 0 var(--pad);
    -webkit-mask-image: linear-gradient(90deg, transparent calc(var(--pad) * 0.4), #000 var(--pad));
    mask-image: linear-gradient(90deg, transparent calc(var(--pad) * 0.4), #000 var(--pad));
  }
  .ab__track {
    display: flex;
    align-items: stretch;
    gap: 16px;
    width: max-content;
    will-change: transform;
  }
  .ab__job {
    width: clamp(220px, 22vw, 300px);
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ab__job:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.24);
    }
  }
  .ab__job-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 48px;
  }
  .ab__job-top img,
  .ab__job-logo {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #222;
  }
  .ab__now {
    padding: 5px 9px;
    border-radius: 999px;
    background: #4ade80;
    color: #062b14;
    font: 500 11px/1 var(--font-head);
  }
  .ab__job-period {
    margin: 0 0 10px;
    font: 500 12px/1 var(--font-head);
    color: var(--text-secondary);
  }
  .ab__job-co {
    margin: 0 0 6px;
    font: 500 26px/1 var(--font-head);
    letter-spacing: -0.04em;
  }
  .ab__job-role {
    margin: 0;
    font: 400 14px/1.3 var(--font-body);
    color: var(--text-secondary);
    text-transform: capitalize;
  }
  .ab__quote {
    width: clamp(260px, 30vw, 420px);
    margin: 0 0 0 40px;
    align-self: center;
    font: 500 clamp(20px, 2vw, 28px) / 1.15 var(--font-head);
    letter-spacing: -0.03em;
  }
  .ab__path-line {
    height: 1px;
    margin-top: 40px;
    background: var(--line);
  }
  .ab__path-line span {
    display: block;
    height: 100%;
    background: var(--text-primary);
    transform-origin: left;
    transform: scaleX(0);
  }

  /* 03: skills list + a picture that follows the cursor */
  .ab__skills {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .ab__skills li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    cursor: default;
  }
  .ab__skill-n {
    font: 500 12px/1 var(--font-head);
    color: var(--text-secondary);
  }
  .ab__skill-t {
    font: 500 clamp(30px, 5vw, 76px) / 1 var(--font-head);
    letter-spacing: -0.05em;
    transition:
      transform 0.45s var(--e-out),
      color 0.3s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .ab__skills:hover .ab__skill-t {
      color: var(--text-secondary);
    }
    .ab__skills li:hover .ab__skill-t {
      color: var(--text-primary);
      transform: translateX(14px);
    }
  }
  .ab__peek {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 5;
    width: 220px;
    aspect-ratio: 4 / 5;
    margin: -137px 0 0 -110px;
    border-radius: 14px;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.9);
    transition:
      opacity 0.25s var(--e-out),
      scale 0.35s var(--e-out);
    will-change: transform;
  }
  .ab__peek.is-on {
    opacity: 1;
    scale: 1.111;
  }
  .ab__peek img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 04: comparison */
  .ab__cmp {
    position: relative;
    max-width: 880px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 22px;
  }
  .ab__cmp-rows {
    display: grid;
    gap: 14px;
  }
  .ab__cmp-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    align-items: center;
    gap: 16px;
    font: 500 13px/1 var(--font-head);
    color: var(--text-secondary);
  }
  .ab__cmp-bar {
    height: 12px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }
  .ab__cmp-bar span {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, #fff, #9ae6b4 calc((1 - var(--t)) * 220%));
    transform-origin: left;
    /* bar length interpolates between the classic (a) and AI-assisted (b) share */
    transform: scaleX(calc((var(--a) + (var(--b) - var(--a)) * var(--t)) / 0.36));
    transition: transform 0.5s var(--e-out);
    transition-delay: calc(var(--i) * 25ms);
  }
  .ab__cmp.is-dragging .ab__cmp-bar span {
    transition-duration: 0.12s;
  }
  .ab__cmp-foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-top: 26px;
    font: 500 12px/1 var(--font-head);
    color: var(--text-secondary);
  }
  .ab__cmp-foot strong {
    font: 500 clamp(28px, 3vw, 44px) / 1 var(--font-head);
    letter-spacing: -0.04em;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .ab__cmp input {
    width: 100%;
    margin: 22px 0 0;
    accent-color: #fff;
    cursor: ew-resize;
  }

  /* 05 */
  .ab__off-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 16px;
  }
  .ab__card {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 22px;
    min-height: 280px;
    display: flex;
    flex-direction: column;
  }
  .ab__card-k {
    margin: 0 0 auto;
    font: 500 12px/1 var(--font-head);
    color: var(--text-secondary);
    text-transform: uppercase;
  }
  .ab__card-big {
    margin: 40px 0 20px;
    font: 500 clamp(26px, 2.6vw, 40px) / 1.05 var(--font-head);
    letter-spacing: -0.04em;
  }
  .ab__card-s {
    margin: 10px 0 0;
    font: 400 13px/1.3 var(--font-body);
    color: var(--text-secondary);
  }
  /* hold to brew: slow, deliberate fill; snappy release */
  .ab__brew {
    position: relative;
    align-self: flex-start;
    overflow: hidden;
    padding: 14px 20px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    background: none;
    color: var(--text-primary);
    font: 500 14px/1 var(--font-head);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition: transform 0.16s var(--e-out);
  }
  .ab__brew:active {
    transform: scale(0.97);
  }
  .ab__brew-fill {
    position: absolute;
    inset: 0;
    background: #c08457;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.2s var(--e-out);
  }
  .ab__brew.is-holding .ab__brew-fill {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s linear;
  }
  .ab__brew-t {
    position: relative;
  }
  .ab__bpm {
    margin: 0 0 6px;
    font: 500 13px/1 var(--font-head);
    color: var(--text-secondary, rgb(150, 150, 150));
  }
  .ab__bpm span {
    display: inline-block;
    min-width: 2.2ch;
    font-variant-numeric: tabular-nums;
    color: currentColor;
  }
  .ab__pulse {
    width: 100%;
    height: 80px;
    margin-top: auto;
  }
  .ab__pulse path {
    fill: none;
    stroke: #f87171;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }

  /* 06 */
  .ab__talk {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .ab__talk-b {
    position: absolute;
    right: -6vw;
    bottom: -10vh;
    width: 60vmin;
    color: rgba(255, 255, 255, 0.04);
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .ab__cta {
    max-width: 20ch;
    margin: 0 0 48px;
    font: 500 clamp(36px, 5.4vw, 88px) / 1 var(--font-head);
    letter-spacing: -0.05em;
  }
  .ab__btn {
    align-self: flex-start;
    display: inline-grid;
    place-items: center;
    width: 160px;
    height: 160px;
    margin-bottom: 48px;
    border-radius: 50%;
    background: #fff;
    color: #0b0b0b;
    font: 500 16px/1 var(--font-head);
    text-decoration: none;
    will-change: transform;
  }
  .ab__btn span {
    display: block;
    will-change: transform;
  }
  .ab__clock--end {
    margin-top: 8px;
  }

  @media (max-width: 809px) {
    .ab__index {
      display: none;
    }
    .ab__path {
      height: calc(100svh + var(--n) * 52vh);
    }
    .ab__job {
      width: 72vw;
    }
    .ab__cmp-row {
      grid-template-columns: 84px 1fr;
    }
    .ab__btn {
      width: 128px;
      height: 128px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      transform: none;
      filter: none;
    }
    :global(.ab .wi) {
      transform: none;
    }
    .ab__dot {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ab]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;

    // ---- split headings into masked words
    root.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      let k = 0;
      const walk = (n: Node) => {
        [...n.childNodes].forEach((c) => {
          if (c.nodeType === 3) {
            const parts = (c.textContent ?? '').split(/(\s+)/);
            const frag = document.createDocumentFragment();
            parts.forEach((p) => {
              if (!p) return;
              if (/^\s+$/.test(p)) return frag.append(' ');
              const w = document.createElement('span');
              w.className = 'w';
              const i = document.createElement('span');
              i.className = 'wi';
              i.style.setProperty('--k', String(k++));
              i.textContent = p;
              w.append(i);
              frag.append(w);
            });
            c.replaceWith(frag);
          } else if ((c as HTMLElement).classList?.contains('ab__me')) {
            const w = document.createElement('span');
            w.className = 'w';
            const i = document.createElement('span');
            i.className = 'wi';
            i.style.setProperty('--k', String(k++));
            c.replaceWith(w);
            i.append(c);
            w.append(i);
          }
        });
      };
      walk(el);
    });

    // ---- reveal on view (once), with a small stagger among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -12% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-reveal], [data-words]').forEach((el) => {
      const sibs = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-reveal'));
      el.style.setProperty('--d', `${Math.max(0, sibs.indexOf(el)) * 60}ms`);
      io.observe(el);
    });

    // ---- live Warsaw clock with an honest status
    const clocks = [...root.querySelectorAll<HTMLElement>('[data-clock]')];
    const tick = () => {
      const now = new Date();
      const t = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(now);
      const h = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: 'numeric', hour12: false }).format(now));
      const day = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', weekday: 'short' }).format(now);
      const weekend = day === 'Sat' || day === 'Sun';
      const status = h < 7 ? 'probably asleep' : h < 9 ? 'first coffee' : h < 18 && !weekend ? 'designing' : h < 21 ? 'training or off' : 'off for the day';
      const on = h >= 9 && h < 18 && !weekend;
      clocks.forEach((c) => {
        c.textContent = `Warsaw ${t} — ${status}`;
        c.previousElementSibling?.classList.toggle('is-off', !on);
      });
      return h;
    };
    const hour = tick();
    setInterval(tick, 20000);

    // ---- chapters: index highlight + overall progress
    const chs = [...root.querySelectorAll<HTMLElement>('[data-ch]')];
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-ch-link]')];
    const progress = root.querySelector<HTMLElement>('[data-progress]');
    links.forEach((a) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelector(a.getAttribute('href')!)?.scrollIntoView({ behavior: calm ? 'auto' : 'smooth' });
      }),
    );

    // ---- path: the track slides sideways while the section is pinned
    const path = root.querySelector<HTMLElement>('[data-path]');
    const track = root.querySelector<HTMLElement>('[data-track]');
    const fill = root.querySelector<HTMLElement>('[data-path-fill]');

    // ---- pulse line: beats faster with scroll speed
    const pulse = root.querySelector<SVGPathElement>('[data-pulse]');
    let phase = 0;
    let speed = 0;
    // heart rate: a resting 62 bpm; every coffee brewed adds ~9 (wearing
    // off slowly), fast scrolling adds a little more; the line follows it
    let caffeine = 0;
    let bpm = 62;
    let kick = 0;
    let lastT = performance.now();
    const bpmEl = root.querySelector<HTMLElement>('[data-bpm]');
    let lastY = scrollY;
    const beat = (x: number) => {
      // one ECG-like beat per unit
      const f = x - Math.floor(x);
      if (f < 0.42) return 0;
      if (f < 0.46) return -0.25;
      if (f < 0.5) return 1;
      if (f < 0.54) return -0.55;
      if (f < 0.6) return 0.08;
      return 0;
    };

    const frame = () => {
      const y = scrollY;
      const vh = innerHeight;
      // overall progress + active chapter
      const doc = document.documentElement.scrollHeight - vh;
      progress?.parentElement && (progress.style.transform = '', progress.parentElement.style.setProperty('--p', String(doc > 0 ? y / doc : 0)));
      let active = 0;
      chs.forEach((c, i) => {
        if (c.getBoundingClientRect().top < vh * 0.5) active = i;
      });
      links.forEach((a, i) => a.classList.toggle('is-on', i === active));

      // pinned horizontal track
      if (path && track && fill) {
        const r = path.getBoundingClientRect();
        const span = r.height - vh;
        const p = Math.min(1, Math.max(0, -r.top / span));
        // how far the track overflows the pinned area's content box
        const pin = track.parentElement!.parentElement!;
        const cs = getComputedStyle(pin);
        const inner = pin.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
        const max = track.scrollWidth - inner;
        track.style.transform = `translate3d(${(-p * Math.max(0, max)).toFixed(1)}px,0,0)`;
        fill.style.transform = `scaleX(${p.toFixed(4)})`;
      }

      // pulse
      if (pulse) {
        const v = Math.abs(y - lastY);
        speed += (Math.min(60, v) - speed) * 0.08;
        const now = performance.now();
        const dt = Math.min(0.05, (now - lastT) / 1000);
        lastT = now;
        caffeine = Math.max(0, caffeine - dt * 0.05); // wears off ~1 coffee / 20 s
        const target = 62 + Math.min(caffeine, 10) * 9 + speed * 0.6;
        bpm += (target - bpm) * Math.min(1, dt * 1.6); // eases toward the new rate
        kick *= Math.pow(0.02, dt); // a brew's jolt fades in well under a second
        phase += (bpm / 60) * dt * 0.5; // two beats across the line
        if (bpmEl) bpmEl.textContent = String(Math.round(bpm));
        let d = '';
        for (let i = 0; i <= 120; i++) {
          const x = (i / 120) * 600;
          const yy = 60 - beat(phase + (i / 120) * 2) * 46 * (1 + kick * 0.35);
          d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${yy.toFixed(1)}`;
        }
        pulse.setAttribute('d', d);
      }
      lastY = y;
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // ---- craft: a preview of real work follows the cursor (lerped, so it trails)
    const skills = root.querySelector<HTMLElement>('[data-skills]');
    const peek = root.querySelector<HTMLElement>('[data-peek]');
    if (fine && skills && peek) {
      const img = peek.querySelector('img')!;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let raf = 0;
      const follow = () => {
        x += (tx - x) * 0.16;
        y += (ty - y) * 0.16;
        const rot = Math.max(-8, Math.min(8, (tx - x) * 0.08));
        peek.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${rot.toFixed(2)}deg)`;
        raf = requestAnimationFrame(follow);
      };
      skills.addEventListener('pointerenter', (e) => {
        x = tx = e.clientX;
        y = ty = e.clientY;
        peek.classList.add('is-on');
        cancelAnimationFrame(raf);
        follow();
      });
      skills.addEventListener('pointermove', (e) => {
        tx = e.clientX;
        ty = e.clientY;
        const li = (e.target as Element).closest<HTMLElement>('li');
        const src = li?.dataset.cover;
        if (src && img.getAttribute('src') !== src) img.src = src;
      });
      skills.addEventListener('pointerleave', () => {
        peek.classList.remove('is-on');
        setTimeout(() => cancelAnimationFrame(raf), 300);
      });
    }

    // ---- AI comparison
    const cmp = root.querySelector<HTMLElement>('[data-cmp]');
    const input = root.querySelector<HTMLInputElement>('[data-cmp-input]');
    const weeks = root.querySelector<HTMLElement>('[data-weeks]');
    if (cmp && input && weeks) {
      const set = () => {
        const t = Number(input.value) / 100;
        cmp.style.setProperty('--t', String(t));
        // 8 weeks classic → 3 weeks with AI
        weeks.textContent = `${(8 - 5 * t).toFixed(1).replace('.0', '')} weeks`;
      };
      input.addEventListener('input', set);
      input.addEventListener('pointerdown', () => cmp.classList.add('is-dragging'));
      addEventListener('pointerup', () => cmp.classList.remove('is-dragging'));
      set();
    }

    // ---- hold to brew (slow fill, snappy release); the count starts from the time of day
    const brew = root.querySelector<HTMLButtonElement>('[data-brew]');
    const cups = root.querySelector<HTMLElement>('[data-cups]');
    if (brew && cups) {
      let n = Math.max(0, Math.min(4, Math.floor((hour - 6) / 3)));
      cups.textContent = String(n);
      let t = 0;
      const start = (e: Event) => {
        e.preventDefault();
        brew.classList.add('is-holding');
        t = window.setTimeout(() => {
          n++;
          caffeine += 1;
          kick = 1;
          cups.textContent = String(n);
          cups.animate([{ transform: 'translateY(40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          brew.classList.remove('is-holding');
          brew.querySelector('.ab__brew-t')!.textContent = n > 5 ? 'Maybe that’s enough' : 'Hold to brew another';
        }, 1200);
      };
      const stop = () => {
        clearTimeout(t);
        brew.classList.remove('is-holding');
      };
      brew.addEventListener('pointerdown', start);
      brew.addEventListener('pointerup', stop);
      brew.addEventListener('pointerleave', stop);
      brew.addEventListener('pointercancel', stop);
      brew.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && start(e));
      brew.addEventListener('keyup', (e) => e.key === ' ' && stop());
    }

    // ---- magnetic CTA: pulled toward the cursor, springs back
    const mag = root.querySelector<HTMLElement>('[data-magnet]');
    if (fine && mag && !calm) {
      const label = mag.querySelector('span')!;
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let vx = 0;
      let vy = 0;
      let raf = 0;
      const step = () => {
        // a light spring (stiffness/damping) so it carries a little momentum
        vx += (tx - x) * 0.12;
        vy += (ty - y) * 0.12;
        vx *= 0.72;
        vy *= 0.72;
        x += vx;
        y += vy;
        mag.style.transform = `translate3d(${x.toFixed(2)}px,${y.toFixed(2)}px,0)`;
        label.style.transform = `translate3d(${(x * 0.35).toFixed(2)}px,${(y * 0.35).toFixed(2)}px,0)`;
        if (Math.abs(vx) + Math.abs(vy) + Math.abs(tx - x) + Math.abs(ty - y) > 0.05) raf = requestAnimationFrame(step);
        else raf = 0;
      };
      const kick = () => raf || (raf = requestAnimationFrame(step));
      addEventListener('pointermove', (e) => {
        const r = mag.getBoundingClientRect();
        const cx = r.left + r.width / 2 - x;
        const cy = r.top + r.height / 2 - y;
        const dx = e.clientX - cx;
        const dy = e.clientY - cy;
        const near = Math.hypot(dx, dy) < r.width * 1.1;
        tx = near ? dx * 0.35 : 0;
        ty = near ? dy * 0.35 : 0;
        kick();
      });
    }
  }
</script>
