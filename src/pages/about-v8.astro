---
// Draft (minimal take on v7): About, cut down to six beats and built from the home page's
// language (white page, pill-shaped pictures, the thin line, small grey
// labels, Neue Montreal) with the B woven through:
// 1 big uppercase statement (who / what / into), lit word by word as you
//   scroll, the B turning in the corner;
// 2 who I am — a pill portrait and a short text;
// 3 experience & what I do;
// 4 how it connects — the capabilities graph with the B at its centre;
// 5 coffee & heart — a real ECG trace; every coffee raises the rate;
// 6 the call to action.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import CapGraph from '../components/CapGraph.astro';
import { ABOUT_QUERY, HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import glyphs from '../lib/monogram-b.json';

const [settings, about, home] = await Promise.all([
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, ABOUT_QUERY),
  load(Astro.locals, HOME_QUERY),
]);
if (!settings || !about) return new Response('Content not found', { status: 500 });

const yy = (s: string) => {
  const m = s.match(/(\d{4})\D+(\d{4}|present)/i);
  if (!m) return '';
  const a = `’${m[1].slice(2)}`;
  return /present/i.test(m[2]) ? `${a}–now` : `${a}–’${m[2].slice(2)}`;
};
const title = (s: string) =>
  s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase()).replace(/\bUi\b/g, 'UI').replace(/\bUx\b/g, 'UX');
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const jobs = ((about.experience ?? []) as any[]).map((e) => ({
  role: title(e.role ?? ''),
  company: e.company as string,
  when: yy(e.period ?? ''),
  now: /present/i.test(e.period ?? ''),
  logo: e.logo?.asset ? urlFor(e.logo).width(96).height(96).fit('crop').url() : null,
}));
const nice = (f: string) => {
  const s = f.toLowerCase().replace(/\b(ux|ui|ai)\b/g, (m) => m.toUpperCase());
  return s.replace(/(^|\s)(\w)/g, (_m, a, b) => a + b.toUpperCase()).replace('Nocode', 'No-code');
};
const focus: string[] = (about.focus ?? []).map(nice);
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = ((home?.projects ?? []) as any[]).filter(Boolean);
const portrait = about.portrait?.asset ? urlFor(about.portrait).width(700).height(930).fit('crop').url() : null;
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const pix = (p: any) => (p?.cover?.asset ? urlFor(p.cover).width(24).height(30).fit('crop').url() : null);
const caps = [
  { name: 'Design', img: null, items: ['UX/UI', 'Art direction', 'Design systems', 'Prototyping', 'Typography', 'Motion', 'Branding', 'Research'] },
  { name: 'Technology', img: null, items: ['No-code', 'Astro', 'Sanity CMS', 'WebGL', 'Three.js', 'Animation', 'Performance', 'Accessibility'] },
  { name: 'AI & Play', img: null, items: ['AI workflows', 'Generative UI', 'Prompting', 'Game design', 'Interaction', 'Playtesting'] },
];
const [bPath, bBox] = glyphs.g.B as [string, number[], number];
const bView = `${bBox[0]} ${-bBox[3]} ${bBox[2] - bBox[0]} ${bBox[3] - bBox[1]}`;
const bSvg = `<svg viewBox="${bView}"><path transform="scale(1,-1)" d="${bPath}" fill="currentColor"/></svg>`;
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="a8" data-a8>
    <header class="a8__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <!-- 1 -->
    <section class="a8__intro" data-intro>
      <div class="a8__pin">
                <span class="a8__mark" set:html={bSvg} data-mark aria-hidden="true" />
        <h1 class="a8__say" data-lit>
          Hi, I’m Bart — a design engineer from Warsaw. I design and build bold web experiences with AI in the loop. Into sport, games and way too much coffee.
        </h1>
      </div>
    </section>

    <!-- 2 -->
    <section class="a8__sec a8__who">
      <p class="a8__label" data-in>Who I am</p>
      <div class="a8__who-grid">
        <figure class="a8__pill" data-in>
          {portrait ? <img src={portrait} alt="Bart Ocieczek" width="700" height="930" loading="lazy" /> : <span />}
        </figure>
        <div class="a8__who-t">
          <p class="a8__big" data-words>{about.introLead}</p>
          <p class="a8__p" data-in>{about.introBody}</p>
        </div>
      </div>
    </section>

    <!-- 3 -->
    <section class="a8__sec">
      <p class="a8__label" data-in>Experience & what I do</p>
      <div class="a8__two">
        <ul class="a8__jobs">
          {jobs.map((j, i) => (
            <li data-in>
              <span>{j.company}</span>
              <span class="a8__dim">{j.role}</span>
              <span class="a8__when">{j.when}</span>
            </li>
          ))}
        </ul>
        <p class="a8__focus" data-in>{focus.join(', ')}.</p>
      </div>
    </section>

    <!-- 4 -->
    <section class="a8__caps">
      <p class="a8__label a8__caps-label">How it connects</p>
      <CapGraph groups={caps} core={bSvg} />
    </section>

    <!-- 5 -->
    <section class="a8__sec a8__heart">
      <p class="a8__label" data-in>Off-screen</p>
      <div class="a8__heart-grid">
        <div class="a8__heart-l">
          <p class="a8__big" data-words>Coffee in, sport out.</p>
          <div class="a8__brew-row" data-in>
            <button class="a8__brew" type="button" data-brew>
              <span class="a8__brew-fill" aria-hidden="true"></span>
              <span class="a8__brew-t">Hold to brew</span>
            </button>
            <p class="a8__cups"><span data-cups>0</span> today</p>
          </div>
        </div>
        <div class="a8__monitor" data-in>
          <div class="a8__mon-top">
            <span class="a8__beat" aria-hidden="true" set:html={bSvg} data-beat />
            <span><strong data-bpm>62</strong> bpm</span>
          </div>
          <svg class="a8__ecg" viewBox="0 0 800 200" preserveAspectRatio="none" aria-label="Heart rate trace"><path data-ecg d="" /></svg>
        </div>
      </div>
    </section>

    <!-- 6 -->
    <section class="a8__sec a8__end">
      <a class="a8__cta" href={settings.callUrl ?? '#'} target="_blank" rel="noopener" data-in>
        <span class="a8__cta-q">{about.ctaText?.split('?')[0]}?</span>
        <span class="a8__cta-go">Let’s talk <i>↗</i></span>
      </a>
      <p class="a8__clock" data-in><span data-clock>Warsaw</span></p>
    </section>
  </main>
</Base>

<style>
  /* minimal: one type family in three sizes, grey + black, hairlines,
     lots of air; a label column on the left like the home details row */
  .a8 {
    --e-out: cubic-bezier(0.23, 1, 0.32, 1);
    --e-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ink: rgb(17, 17, 17);
    --grey: rgb(150, 150, 150);
    --faint: rgb(222, 222, 222);
    --rule: rgba(17, 17, 17, 0.08);
    --pad: var(--gutter);
    --col: clamp(120px, 24vw, 360px);
    background: #fff;
    color: var(--ink);
    font: 500 16px/1.4 var(--font-head);
    letter-spacing: -0.015em;
  }
  .a8__nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    padding: var(--gutter);
  }
  .a8__label {
    margin: 0;
    font-size: 13px;
    color: var(--grey);
  }
  .a8__sec {
    display: grid;
    grid-template-columns: var(--col) minmax(0, 1fr);
    gap: var(--pad);
    padding: clamp(96px, 18vh, 200px) var(--pad);
  }
  .a8__sec > .a8__label {
    margin: 0;
  }

  /* 1 */
  .a8__intro {
    height: 240svh;
  }
  .a8__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    display: flex;
    align-items: center;
    padding: 0 var(--pad) 0 calc(var(--pad) + var(--col) + var(--pad));
  }
  .a8__mark {
    position: absolute;
    left: var(--pad);
    top: 50%;
    width: 28px;
    margin-top: -18px;
    will-change: transform;
  }
  .a8__mark :global(svg),
  .a8__beat :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .a8__say {
    max-width: 16em;
    margin: 0;
    font: 500 clamp(28px, 3.6vw, 56px) / 1.02 var(--font-head);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }
  :global(.a8 .lw) {
    color: var(--faint);
    transition: color 0.2s linear;
  }
  :global(.a8 .lw.on) {
    color: var(--ink);
  }

  /* 2 */
  .a8__who-grid {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .a8__pill {
    margin: 0;
    aspect-ratio: 0.75;
    border-radius: 999px;
    overflow: hidden;
    background: #f2f2f2;
  }
  .a8__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1);
  }
  .a8__big {
    max-width: 20em;
    margin: 0 0 24px;
    font: 500 clamp(20px, 1.8vw, 28px) / 1.2 var(--font-head);
    letter-spacing: -0.03em;
  }
  .a8__p {
    max-width: 36ch;
    margin: 0;
    color: var(--grey);
  }
  .a8__dim {
    color: var(--grey);
  }

  /* 3 */
  .a8__two {
    display: grid;
    gap: 40px;
  }
  .a8__jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .a8__jobs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 100px;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .a8__jobs li:first-child {
    border-top: 1px solid var(--rule);
  }
  .a8__when {
    justify-self: end;
    color: var(--grey);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .a8__focus {
    max-width: 36ch;
    margin: 0;
    color: var(--grey);
  }

  /* 4: the graph, quiet */
  .a8__caps {
    position: relative;
    padding: 0 var(--pad);
  }
  .a8__caps-label {
    position: absolute;
    top: 0;
    left: var(--pad);
    z-index: 2;
  }
  .a8__caps :global(.cg) {
    background: transparent;
    height: clamp(420px, 70svh, 720px);
  }
  .a8__caps :global(.cg__core--mark) {
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    background: #fff;
  }
  .a8__caps :global(.cg__core--mark svg) {
    width: 24px;
  }
  .a8__caps :global(.cg__lines line) {
    stroke: rgba(17, 17, 17, 0.09);
  }
  .a8__caps :global(.cg__lines line.is-hub) {
    stroke: rgba(17, 17, 17, 0.5);
  }
  .a8__caps :global(.cg__hub-t) {
    font: 500 13px/1 var(--font-head);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .a8__caps :global(.cg__hub-t i) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .a8__caps :global(.cg__dot i) {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.25);
  }

  /* 5 */
  .a8__heart-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .a8__brew-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .a8__cups {
    margin: 0;
    color: var(--grey);
  }
  .a8__cups span {
    display: inline-block;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  /* hold to brew: slow deliberate fill, snappy release */
  .a8__brew {
    position: relative;
    overflow: hidden;
    padding: 10px 16px;
    border: 1px solid rgba(17, 17, 17, 0.16);
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition: transform 0.16s var(--e-out);
  }
  .a8__brew:active {
    transform: scale(0.97);
  }
  .a8__brew-fill {
    position: absolute;
    inset: 0;
    background: rgba(17, 17, 17, 0.08);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.2s var(--e-out);
  }
  .a8__brew.is-holding .a8__brew-fill {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s linear;
  }
  .a8__brew-t {
    position: relative;
  }
  .a8__mon-top {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--grey);
  }
  .a8__mon-top strong {
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .a8__beat {
    width: 14px;
    color: var(--ink);
    transform-origin: 50% 60%;
  }
  .a8__ecg {
    display: block;
    width: 100%;
    height: 120px;
    margin-top: 8px;
  }
  .a8__ecg path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* 6 */
  .a8__end {
    align-items: end;
    min-height: 60svh;
  }
  .a8__end > .a8__cta {
    grid-column: 2;
  }
  .a8__end > .a8__clock {
    grid-column: 1;
    grid-row: 1;
  }
  .a8__cta {
    color: var(--ink);
    text-decoration: none;
  }
  .a8__cta-q {
    display: block;
    max-width: 24em;
    color: var(--grey);
    transition: color 0.3s ease;
  }
  .a8__cta-go {
    display: block;
    margin-top: 10px;
    font: 500 clamp(32px, 4vw, 64px) / 1 var(--font-head);
    letter-spacing: -0.045em;
  }
  .a8__cta-go i {
    display: inline-block;
    font-style: normal;
    font-size: 0.6em;
    vertical-align: 0.3em;
    transition: transform 0.45s var(--e-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .a8__cta:hover .a8__cta-q {
      color: var(--ink);
    }
    .a8__cta:hover i {
      transform: translate(0.12em, -0.12em);
    }
  }
  .a8__clock {
    margin: 0;
    font-size: 13px;
    color: var(--grey);
  }

  /* reveals */
  [data-in] {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s var(--e-out),
      transform 1s var(--e-expo);
    transition-delay: var(--d, 0s);
  }
  [data-in].is-in {
    opacity: 1;
    transform: none;
  }
  :global(.a8 .w) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  :global(.a8 .wi) {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 1s var(--e-expo);
    transition-delay: calc(var(--k) * 22ms);
  }
  :global(.a8 .is-in .wi) {
    transform: none;
  }

  @media (max-width: 809px) {
    .a8 {
      --col: 0px;
    }
    .a8__sec,
    .a8__heart-grid {
      grid-template-columns: 1fr;
    }
    .a8__pin {
      padding: 0 var(--pad);
    }
    .a8__mark {
      top: 90px;
      margin-top: 0;
    }
    .a8__who-grid {
      grid-template-columns: 96px 1fr;
    }
    .a8__jobs li {
      grid-template-columns: 1fr auto;
    }
    .a8__jobs .a8__dim {
      grid-column: 1;
      grid-row: 2;
      font-size: 14px;
    }
    .a8__when {
      grid-row: 1;
      grid-column: 2;
    }
    .a8__end > .a8__cta,
    .a8__end > .a8__clock {
      grid-column: 1;
      grid-row: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-in],
    :global(.a8 .wi) {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-a8]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // ---- 1: words to light
    const say = root.querySelector<HTMLElement>('[data-lit]')!;
    const words = (say.textContent ?? '').trim().split(/\s+/).map((w, i, all) => {
      const s = document.createElement('span');
      s.className = 'lw';
      s.textContent = w;
      return s;
    });
    say.textContent = '';
    words.forEach((w, i) => {
      say.append(w);
      if (i < words.length - 1) say.append(' ');
    });

    // ---- masked word rise for [data-words]
    root.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      const t = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      t.forEach((w, k) => {
        const o = document.createElement('span');
        o.className = 'w';
        const i = document.createElement('span');
        i.className = 'wi';
        i.style.setProperty('--k', String(k));
        i.textContent = w;
        o.append(i);
        el.append(o);
        if (k < t.length - 1) el.append(' ');
      });
    });

    // ---- reveal once, staggered among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-in], [data-words]').forEach((el) => {
      const sib = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-in'));
      el.style.setProperty('--d', `${Math.max(0, sib.indexOf(el)) * 60}ms`);
      io.observe(el);
    });

    // ---- 5: a real ECG trace. One beat is a sum of gaussians at clinical
    // timings (P 0.10s, Q 0.20s, R 0.22s, S 0.245s, T 0.42s); the beat
    // interval is 60/bpm, so a faster rate packs beats closer while the
    // complex keeps its shape — like a real monitor.
    const g = (t: number, at: number, w: number, a: number) => a * Math.exp(-((t - at) ** 2) / (2 * w * w));
    const ecg = (t: number) =>
      g(t, 0.1, 0.022, 0.12) + g(t, 0.2, 0.009, -0.12) + g(t, 0.22, 0.01, 1) + g(t, 0.245, 0.011, -0.25) + g(t, 0.42, 0.045, 0.3);
    const path = root.querySelector<SVGPathElement>('[data-ecg]');
    const bpmEl = root.querySelector<HTMLElement>('[data-bpm]');
    const beatEl = root.querySelector<HTMLElement>('[data-beat]');
    const WIN = 4; // seconds on screen
    const samples: number[] = [];
    const RATE = 60; // samples per second
    let caffeine = 0;
    let bpm = 62;
    let inBeat = 0; // seconds since this beat started
    let acc = 0;
    let last = performance.now();
    // pre-fill so the trace is full from the start
    for (let i = 0; i < WIN * RATE; i++) {
      inBeat += 1 / RATE;
      if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
      samples.push(ecg(inBeat));
    }

    // ---- scroll-driven bits + the monitor, in one loop
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const mark = root.querySelector<HTMLElement>('[data-mark]');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    let markR = 0;
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (intro) {
        const r = intro.getBoundingClientRect();
        const p = clamp(-r.top / (r.height - innerHeight));
        const n = Math.round(clamp(p / 0.85) * words.length);
        words.forEach((w, k) => w.classList.toggle('on', k < n));
        if (hint) hint.style.opacity = String(1 - clamp(p * 8));
        if (mark && !calm) {
          markR += (p * 360 - markR) * 0.1;
          mark.style.transform = `perspective(300px) rotateY(${markR.toFixed(2)}deg)`;
        }
      }
      // heart: caffeine wears off ~1 coffee per 40s; the rate eases toward its target
      caffeine = Math.max(0, caffeine - dt / 40);
      const target = 62 + Math.min(caffeine, 8) * 8;
      bpm += (target - bpm) * Math.min(1, dt * 0.8);
      if (bpmEl) bpmEl.textContent = String(Math.round(bpm));
      acc += dt * RATE;
      while (acc >= 1) {
        acc -= 1;
        const before = inBeat;
        inBeat += 1 / RATE;
        if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
        // the B jumps on the R wave
        if (beatEl && !calm && before < 0.22 && inBeat >= 0.22)
          beatEl.animate([{ transform: 'scale(1.18)' }, { transform: 'scale(1)' }], { duration: 260, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        samples.push(calm ? 0 : ecg(inBeat));
        if (samples.length > WIN * RATE) samples.shift();
      }
      if (path) {
        let d = '';
        const n = samples.length;
        for (let i = 0; i < n; i++) {
          const x = (i / (n - 1)) * 800;
          const y = 150 - samples[i] * 120;
          d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // ---- hold to brew (slow fill, snappy release); each coffee adds caffeine
    const brew = root.querySelector<HTMLButtonElement>('[data-brew]');
    const cups = root.querySelector<HTMLElement>('[data-cups]');
    if (brew && cups) {
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: 'numeric', hour12: false }).format(new Date()));
      let n = Math.max(0, Math.min(4, Math.floor((hour - 6) / 3)));
      cups.textContent = String(n);
      let t = 0;
      const start = (e: Event) => {
        e.preventDefault();
        brew.classList.add('is-holding');
        t = window.setTimeout(() => {
          n++;
          caffeine += 1;
          cups.textContent = String(n);
          cups.animate([{ transform: 'translateY(40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          brew.classList.remove('is-holding');
          brew.querySelector('.a8__brew-t')!.textContent = n > 5 ? 'Enough' : 'Another';
        }, 1200);
      };
      const stop = () => {
        clearTimeout(t);
        brew.classList.remove('is-holding');
      };
      brew.addEventListener('pointerdown', start);
      brew.addEventListener('pointerup', stop);
      brew.addEventListener('pointerleave', stop);
      brew.addEventListener('pointercancel', stop);
      brew.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && start(e));
      brew.addEventListener('keyup', (e) => e.key === ' ' && stop());
    }

    // ---- live Warsaw time
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const tick = () => {
      if (clock) clock.textContent = `Warsaw, ${new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(new Date())} — open for new work`;
    };
    tick();
    setInterval(tick, 20000);
  }
</script>
