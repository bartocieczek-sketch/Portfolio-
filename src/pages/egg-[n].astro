---
// Easter-egg previews: home as it is, plus one egg each (/egg-1 … /egg-5).
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import { HOME_QUERY, SETTINGS_QUERY } from '../lib/sanity';
import { load } from '../lib/load';

const n = Number(Astro.params.n);
if (!(n >= 1 && n <= 10)) return new Response('Not found', { status: 404 });
const [home, settings] = await Promise.all([load(Astro.locals, HOME_QUERY), load(Astro.locals, SETTINGS_QUERY)]);
if (!home || !settings) return new Response('Content not found', { status: 500 });
const hints = [
  '',
  'Click the B logo 5× quickly',
  'Scroll through all the projects',
  'Type “hi” on your keyboard',
  'Leave the mouse still for 3 seconds',
  'Night mode — forced on here (normally 22:00–06:00)',
  'Press B, then move the mouse (B again to stop)',
  'Double-click the empty white (again to put it back)',
  'Press and hold on the empty white',
  'Shake the column: scroll up, down, up, down quickly',
  'Just start typing',
];
---

<Base title={settings.seoTitle} description={settings.seoDescription}>
  <main class="home" data-egg={n} data-call={settings.callUrl ?? '#'}>
    <Hero home={home} settings={settings} />
  </main>
  <div class="egg-hint">Easter egg {n} · {hints[n]}</div>
</Base>

<style is:global>
  .egg-hint {
    position: fixed;
    top: 64px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 60;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(17, 17, 17, 0.06);
    font: 500 12px/1 var(--font-head);
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    pointer-events: none;
    white-space: nowrap;
  }
  /* 1 */
  .egg-spin {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .egg-spin canvas {
    width: min(70vmin, 560px);
    height: min(70vmin, 560px);
  }
  /* 2 */
  .egg-pill {
    position: fixed;
    left: 50%;
    bottom: 22px;
    z-index: 60;
    transform: translateX(-50%);
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font: 500 13px/1 var(--font-head);
    letter-spacing: -0.01em;
    white-space: nowrap;
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s var(--ease-out),
      translate 0.6s var(--ease-expo);
    pointer-events: none;
  }
  .egg-pill.is-on {
    opacity: 1;
    translate: 0 0;
  }
  .egg-pill__n {
    font-variant-numeric: tabular-nums;
    opacity: 0.6;
    margin-right: 4px;
  }
  /* 3 */
  .egg-bubble {
    position: fixed;
    z-index: 60;
    transform-origin: top right;
  }
  .egg-bubble a {
    display: inline-block;
    padding: 10px 14px;
    border-radius: 14px 4px 14px 14px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font: 500 14px/1 var(--font-head);
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .egg-bubble span {
    display: inline-block;
    transition: transform 0.25s var(--ease-out);
  }
  .egg-bubble a:hover span {
    transform: translateX(3px);
  }
  /* 4 */
  .egg-cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 80;
    width: 28px;
    height: 28px;
    margin: -14px 0 0 -14px;
    color: var(--text-primary);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
  }
  .egg-cursor svg {
    width: 100%;
    height: 100%;
    animation: egg-turn 5s linear infinite;
  }
  .egg-cursor.is-on {
    opacity: 1;
  }
  html.egg-nocursor,
  html.egg-nocursor * {
    cursor: none !important;
  }
  @keyframes egg-turn {
    to {
      transform: rotateY(360deg);
    }
  }
  /* 6 */
  .egg-trail {
    position: fixed;
    z-index: 55;
    width: 150px;
    height: 190px;
    object-fit: cover;
    border-radius: 6px;
    pointer-events: none;
  }
  .egg-mode {
    position: fixed;
    left: 50%;
    bottom: 22px;
    z-index: 60;
    transform: translateX(-50%);
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font: 500 13px/1 var(--font-head);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }
  .egg-mode.is-on {
    opacity: 1;
  }
  /* 8 */
  .egg-dark {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle 180px at var(--x, 50%) var(--y, 50%), transparent 0, transparent 40%, rgba(5, 5, 5, 0.94) 100%);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }
  .egg-dark.is-on {
    opacity: 1;
  }
  /* 10 */
  .egg-type {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    pointer-events: none;
    font: 500 clamp(90px, 22vw, 380px) / 1 var(--font-head);
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1.2px rgba(17, 17, 17, 0.42);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .egg-type.is-on {
    opacity: 1;
    transition-duration: 0.15s;
  }
  /* 5 */
  html.egg-night {
    --surface-dark: rgb(11, 11, 11);
    --surface-black: rgb(11, 11, 11);
    --text-primary: rgb(236, 236, 236);
    --text-secondary: rgb(120, 120, 120);
    --text-highlight: rgb(255, 255, 255);
    --line: rgba(255, 255, 255, 0.12);
    background: var(--surface-dark);
    color-scheme: dark;
  }
  html.egg-night .egg-hint {
    background: rgba(255, 255, 255, 0.08);
  }
  .egg-night-note {
    position: fixed;
    right: var(--gutter);
    top: 64px;
    z-index: 60;
    font: 500 13px/1 var(--font-head);
    letter-spacing: -0.01em;
    color: var(--text-secondary);
    pointer-events: none;
  }
</style>

<script>
  import { eggLogoSpin, eggSeenAll, eggHi, eggIdleCursor, eggNight, eggTrail, eggGravity, eggTorch, eggJelly, eggTypeBehind } from '../scripts/eggs';
  const main = document.querySelector<HTMLElement>('[data-egg]')!;
  const n = Number(main.dataset.egg);
  if (n === 1) eggLogoSpin();
  if (n === 2) eggSeenAll();
  if (n === 3) eggHi(main.dataset.call ?? '#');
  if (n === 4) eggIdleCursor();
  if (n === 5) eggNight(true);
  if (n === 6) eggTrail();
  if (n === 7) eggGravity();
  if (n === 8) eggTorch();
  if (n === 9) eggJelly();
  if (n === 10) eggTypeBehind();
</script>
