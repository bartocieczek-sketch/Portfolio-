<script>
  const root = document.querySelector<HTMLElement>('[data-a9]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // ---- 1: as on /about-me — each word in a tilted mask, lines rise in,
    // then the scroll lights them up word by word
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const sayWrap = say.parentElement!;
    const words: HTMLElement[] = [];
    const sayText = (say.textContent ?? '').trim().split(/\s+/);
    say.textContent = '';
    sayText.forEach((w, i) => {
      const o = document.createElement('span');
      o.className = 'sw';
      const n = document.createElement('span');
      n.className = 'swi';
      n.textContent = w;
      o.append(n);
      say.append(o);
      if (i < sayText.length - 1) say.append(' ');
      words.push(n);
    });
    const lines = () => {
      let line = -1;
      let top = -1;
      let i = 0;
      words.forEach((n) => {
        const t = (n.parentElement as HTMLElement).offsetTop;
        if (t !== top) {
          line++;
          top = t;
          i = 0;
        }
        n.style.setProperty('--l', String(line));
        n.style.setProperty('--i', String(i++));
      });
    };
    lines();
    addEventListener('resize', lines);
    setTimeout(() => sayWrap.classList.add('is-in'), 650);

    // ---- masked word rise for [data-words]
    root.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      const t = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      t.forEach((w, k) => {
        const o = document.createElement('span');
        o.className = 'w';
        const i = document.createElement('span');
        i.className = 'wi';
        i.style.setProperty('--k', String(k));
        i.textContent = w;
        o.append(i);
        el.append(o);
        if (k < t.length - 1) el.append(' ');
      });
    });

    // ---- reveal once, staggered among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
          if ((e.target as HTMLElement).hasAttribute('data-nm')) countUp(e.target as HTMLElement);
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    // figures count up with their column (ease-out, a touch after it starts)
    // bricks: each box drops in from above, lands with a little squash and
    // snaps into place; lower ones first, so the upper ones land on top.
    // Its figure counts up once it has landed.
    function countUp(box: HTMLElement) {
      const DROP = 620;
      const GAP = 140;
      box.querySelectorAll<HTMLElement>('[data-drop]').forEach((el) => {
        const delay = 300 + Number(el.dataset.drop) * GAP;
        const num = el.querySelector<HTMLElement>('[data-count]');
        const to = Number(num?.dataset.count ?? 0);
        if (calm) return;
        const tilt = (Number(el.dataset.drop) % 2 ? 1 : -1) * 4;
        el.animate(
          [
            { transform: `translateY(-75vh) rotate(${tilt}deg)`, easing: 'cubic-bezier(0.55, 0, 0.9, 0.55)' },
            { transform: 'translateY(0) rotate(0deg)', offset: 0.7, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
            { transform: 'translateY(0) scale(1.015, 0.975)', offset: 0.8, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
            { transform: 'none' },
          ],
          { duration: DROP, delay, fill: 'backwards' },
        );
        if (!num || !to) return;
        num.textContent = '0';
        const t0 = performance.now() + delay + DROP * 0.7;
        const step = (now: number) => {
          const x = Math.min(1, Math.max(0, (now - t0) / 700));
          num.textContent = String(Math.round(to * (1 - Math.pow(1 - x, 4))));
          if (x < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }
    const later: HTMLElement[] = [];
    root.querySelectorAll<HTMLElement>('[data-in], [data-words], [data-blur], [data-hm-mid], [data-nm]').forEach((el) => {
      const sib = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-in'));
      el.style.setProperty('--d', `${Math.max(0, sib.indexOf(el)) * 60}ms`);
      // the section behind the B only starts once it's being uncovered
      if (el.closest('[data-who]')) later.push(el);
      else io.observe(el);
    });
    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      later.forEach((el) => io.observe(el));
    };
    addEventListener('a9:reveal', reveal);
    // no 3D (or calm): nothing to uncover it, so it just follows the hero
    setTimeout(() => {
      if (!(window as any).__a9Mask) {
        root.querySelector('[data-who]')?.classList.add('is-flat');
        reveal();
      }
    }, 1500);

    // ---- 5: a real ECG trace. One beat is a sum of gaussians at clinical
    // timings (P 0.10s, Q 0.20s, R 0.22s, S 0.245s, T 0.42s); the beat
    // interval is 60/bpm, so a faster rate packs beats closer while the
    // complex keeps its shape — like a real monitor.
    const g = (t: number, at: number, w: number, a: number) => a * Math.exp(-((t - at) ** 2) / (2 * w * w));
    const ecg = (t: number) =>
      g(t, 0.1, 0.022, 0.12) + g(t, 0.2, 0.009, -0.12) + g(t, 0.22, 0.01, 1) + g(t, 0.245, 0.011, -0.25) + g(t, 0.42, 0.045, 0.3);
    const path = root.querySelector<SVGPathElement>('[data-ecg]');
    const bpmEl = root.querySelector<HTMLElement>('[data-bpm]');
    const digs = bpmEl ? [...bpmEl.querySelectorAll<HTMLElement>('.a9__dg')] : [];
    let shown = -1;
    const showBpm = (v: number) => {
      if (v === shown || !bpmEl) return;
      shown = v;
      const str = String(v).padStart(3, ' ');
      digs.forEach((d, i) => {
        const c = str[i];
        // the slot's width follows its digit; a blank hundreds slot folds away
        d.style.width = c === ' ' ? '0' : '0.56em';
        if (c !== ' ') (d.firstElementChild as HTMLElement).style.setProperty('--v', c);
      });
      bpmEl.setAttribute('aria-label', `${v} beats per minute`);
    };
    showBpm(62);
    const beatEl = root.querySelector<HTMLElement>('[data-beat]');
    const pen = root.querySelector<HTMLElement>('[data-pen]');
    const bigBpm = root.querySelector<HTMLElement>('[data-bpm-big]');
    const WIN = 4; // seconds on screen
    const samples: number[] = [];
    const RATE = 60; // samples per second
    let caffeine = 0;
    let bpm = 62;
    let inBeat = 0; // seconds since this beat started
    let acc = 0;
    let last = performance.now();
    // pre-fill so the trace is full from the start
    for (let i = 0; i < WIN * RATE; i++) {
      inBeat += 1 / RATE;
      if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
      samples.push(ecg(inBeat));
    }

    // ---- scroll-driven bits + the monitor, in one loop
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const smooth = (v: number) => v * v * (3 - 2 * v);
    // who: the lead, word by word
    root.querySelectorAll<HTMLElement>('[data-blur]').forEach((el) => {
      const ws = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      ws.forEach((w, k) => {
        const sp = document.createElement('span');
        sp.className = 'bw';
        sp.style.setProperty('--k', String(k));
        sp.textContent = w;
        el.append(sp);
        if (k < ws.length - 1) el.append(' ');
      });
    });
    let heroPx = -1e4;
    let heroPy = -1e4;
    if (intro && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      // (the hero doesn't take pointer events — it lies over the next section
      // at the end — so listen on the window)
      addEventListener('pointermove', (e) => {
        heroPx = e.clientX;
        heroPy = e.clientY;
      });
      document.addEventListener('pointerleave', () => (heroPx = heroPy = -1e4));
    }
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (intro) {
        const max = intro.offsetHeight - innerHeight;
        const p = max > 0 ? clamp(-intro.getBoundingClientRect().top / max) : 0;
        // light the words over the first half of the scroll, a soft edge of
        // ~3; around the pointer a soft spotlight lights them early
        const f = (p / 0.42) * (words.length + 3) - 3;
        const spot = heroPx > -1e3 && !calm;
        words.forEach((n, k) => {
          let v = clamp((f - k + 3) / 3);
          if (spot) {
            const r = n.getBoundingClientRect();
            const d = Math.hypot(r.left + r.width / 2 - heroPx, r.top + r.height / 2 - heroPy);
            v = Math.max(v, clamp(1 - d / 260) * 0.85);
          }
          const cur = Number(n.dataset.v ?? 0);
          const nv = cur + (v - cur) * 0.2;
          n.dataset.v = nv.toFixed(4);
          n.style.setProperty('--lit', (0.22 + 0.78 * nv).toFixed(3));
        });
        // then the B comes for the camera and the statement falls back into
        // the dark behind it
        const fly = smooth(clamp((p - 0.42) / 0.5));
        say.style.transform = `translateY(${(-p * 6).toFixed(2)}vh) scale(${(1 - fly * 0.14).toFixed(4)})`;
        say.style.filter = fly > 0.001 ? `blur(${(fly * 10).toFixed(2)}px)` : '';
        // gone completely before the B has passed: nothing left behind it
        const gone = smooth(clamp((p - 0.42) / 0.28));
        say.style.opacity = (1 - gone).toFixed(3);
        say.style.visibility = gone > 0.995 ? 'hidden' : '';
        sayWrap.parentElement!.style.setProperty('--p', p.toFixed(3));
        (window as any).__a9P = p;
      }
      // heart: caffeine wears off ~1 coffee per 40s; the rate eases toward its target
      caffeine = Math.max(0, caffeine - dt / 40);
      const target = 62 + Math.min(caffeine, 8) * 8;
      bpm += (target - bpm) * Math.min(1, dt * 0.8);
      showBpm(Math.round(bpm));
      acc += dt * RATE;
      while (acc >= 1) {
        acc -= 1;
        const before = inBeat;
        inBeat += 1 / RATE;
        if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
        // the B jumps on the R wave
        if (!calm && before < 0.22 && inBeat >= 0.22) {
          beatEl?.animate([{ transform: 'scale(1.8)' }, { transform: 'scale(1)' }], { duration: 260, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          bigBpm?.animate([{ transform: 'scale(1.025)' }, { transform: 'scale(1)' }], { duration: 320, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        }
        samples.push(calm ? 0 : ecg(inBeat));
        if (samples.length > WIN * RATE) samples.shift();
      }
      if (path) {
        let d = '';
        const n = samples.length;
        for (let i = 0; i < n; i++) {
          const x = (i / (n - 1)) * 800;
          const y = 150 - samples[i] * 120;
          d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
        if (pen && n) pen.style.top = `${((150 - samples[n - 1] * 120) / 2).toFixed(2)}%`;
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // ---- hold to brew (slow fill, snappy release); each coffee adds caffeine
    const brew = root.querySelector<HTMLButtonElement>('[data-brew]');
    const cups = root.querySelector<HTMLElement>('[data-cups]');
    if (brew && cups) {
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: 'numeric', hour12: false }).format(new Date()));
      let n = Math.max(0, Math.min(4, Math.floor((hour - 6) / 3)));
      cups.textContent = String(n);
      const dots = [...root.querySelectorAll<HTMLElement>('[data-cupdots] i')];
      const paint = () => dots.forEach((d, i) => d.classList.toggle('is-on', i < n));
      paint();
      let t = 0;
      const label = brew.querySelector<HTMLElement>('[data-brew-t]')!;
      let rest = label.textContent ?? '';
      const start = (e: Event) => {
        e.preventDefault();
        brew.classList.add('is-holding');
        label.textContent = 'Brewing…';
        t = window.setTimeout(() => {
          n++;
          caffeine += 1;
          cups.textContent = String(n);
          paint();
          dots[Math.min(n, dots.length) - 1]?.animate([{ transform: 'scale(2)' }, { transform: 'scale(1)' }], { duration: 420, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          cups.animate([{ transform: 'translateY(40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          brew.classList.remove('is-holding');
          label.textContent = n > 5 ? 'Enough' : 'Another';
          rest = label.textContent;
        }, 1200);
      };
      const stop = () => {
        clearTimeout(t);
        if (brew.classList.contains('is-holding')) label.textContent = rest;
        brew.classList.remove('is-holding');
      };
      brew.addEventListener('pointerdown', start);
      brew.addEventListener('pointerup', stop);
      brew.addEventListener('pointerleave', stop);
      brew.addEventListener('pointercancel', stop);
      brew.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && start(e));
      brew.addEventListener('keyup', (e) => e.key === ' ' && stop());
    }

    // ---- text scramble: letters settle out of random glyphs, left to right
    const GLYPHS = 'abcdefghijklmnopqrstuvwxyz/—_·';
    const scramble = (el: HTMLElement) => {
      const final = el.textContent ?? '';
      if (calm) return;
      const t0 = performance.now();
      const step = () => {
        const p = (performance.now() - t0) / 900;
        let out = '';
        for (let i = 0; i < final.length; i++) {
          const ch = final[i];
          out += ch === ' ' || p > i / final.length + 0.25 ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        el.textContent = out;
        if (p < 1.3) requestAnimationFrame(step);
        else el.textContent = final;
      };
      step();
    };
    const sio = new IntersectionObserver((es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        sio.unobserve(e.target);
        scramble(e.target as HTMLElement);
      }),
    );
    root.querySelectorAll<HTMLElement>('[data-scramble], .a9__label').forEach((el) => sio.observe(el));

    // ---- a logo pill trails the cursor over the experience rows
    const jobsEl = root.querySelector<HTMLElement>('[data-jobs]');
    const trail = root.querySelector<HTMLElement>('[data-trail]');
    if (jobsEl && trail && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const img = trail.querySelector('img')!;
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const follow = () => {
        x += (tx - x) * 0.15;
        y += (ty - y) * 0.15;
        trail.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${Math.max(-10, Math.min(10, (tx - x) * 0.1)).toFixed(2)}deg)`;
        raf = requestAnimationFrame(follow);
      };
      jobsEl.addEventListener('pointermove', (e) => {
        tx = e.clientX + 90;
        ty = e.clientY;
        const li = (e.target as Element).closest<HTMLElement>('li');
        const src = li?.dataset.logo;
        if (src) {
          if (img.getAttribute('src') !== src) img.src = src;
          if (!trail.classList.contains('is-on')) {
            x = tx;
            y = ty;
            trail.classList.add('is-on');
            cancelAnimationFrame(raf);
            follow();
          }
        }
      });
      jobsEl.addEventListener('pointerleave', () => {
        trail.classList.remove('is-on');
        setTimeout(() => cancelAnimationFrame(raf), 300);
      });
    }

    // ---- CTA: the outline fills as the section arrives (all of it on
    // hover); the orb rests by the word and follows the pointer over it
    const end = root.querySelector<HTMLElement>('[data-end]');
    const cta = root.querySelector<HTMLElement>('[data-cta]');
    const fill = root.querySelector<HTMLElement>('[data-fill]');
    const orb = root.querySelector<HTMLElement>('[data-orb]');
    const huge = root.querySelector<HTMLElement>('.a9__huge-o')!;
    // size the word to run edge to edge of the content box
    const fitWord = () => {
      if (!cta || !huge) return;
      huge.parentElement!.style.setProperty('--fit', '1');
      const k = cta.clientWidth / huge.scrollWidth;
      huge.parentElement!.style.setProperty('--fit', (k * 0.995).toFixed(4));
    };
    fitWord();
    document.fonts?.ready.then(fitWord);
    addEventListener('resize', fitWord);
    root.querySelector('[data-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' }));
    if (end && cta && fill && orb) {
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      let over = false;
      let mx = 0;
      let my = 0;
      let f = 0;
      let ox = -1;
      let oy = 0;
      let os = 1;
      let press = false;
      let raf = 0;
      cta.addEventListener('pointerenter', () => fine && (over = true));
      cta.addEventListener('pointerleave', () => (over = press = false));
      cta.addEventListener('pointermove', (e) => {
        const r = cta.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
      cta.addEventListener('pointerdown', () => (press = true));
      addEventListener('pointerup', () => (press = false));
      const step = () => {
        const r = end.getBoundingClientRect();
        const arrive = clamp((innerHeight - r.top) / r.height);
        const tf = over ? 1 : calm ? 1 : clamp((arrive - 0.25) / 0.7);
        f += (tf - f) * (over ? 0.12 : 0.2);
        fill.style.setProperty('--f', f.toFixed(4));
        // rest: just right of the "k", on the word's middle
        const W = cta.clientWidth;
        const rx = W - orb.offsetWidth * 0.75;
        const ry = huge.offsetTop + orb.offsetHeight * 0.1;
        const tx = over ? mx : rx;
        const ty = over ? my : ry;
        if (ox < 0) {
          ox = tx;
          oy = ty;
        }
        const k = calm ? 1 : 0.2;
        ox += (tx - ox) * k;
        oy += (ty - oy) * k;
        // a little stretch along the way it's moving, eased back when still
        const v = Math.min(1, Math.hypot(tx - ox, ty - oy) / 300);
        os += ((press ? 0.9 : over ? 1.08 : 1) - os) * 0.25;
        orb.style.transform = `translate(${ox.toFixed(1)}px,${oy.toFixed(1)}px) scale(${(os * (1 + v * 0.08)).toFixed(3)})`;
        raf = requestAnimationFrame(step);
      };
      new IntersectionObserver((es) => {
        if (es[0].isIntersecting) {
          if (!raf) raf = requestAnimationFrame(step);
        } else if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
