---
// Draft (v8 with more show: a portrait that opens out of a pill, scrubbed
// blur-in words, hairlines that draw, a logo that trails the cursor, text
// scramble, a page-wide CTA that fills in with a pointer-following orb): About, cut down to six beats and built from the home page's
// language (white page, pill-shaped pictures, the thin line, small grey
// labels, Neue Montreal) with the B woven through:
// 1 big uppercase statement (who / what / into), lit word by word as you
//   scroll, the B turning in the corner;
// 2 who I am — a pill portrait and a short text;
// 3 experience & what I do;
// 4 how it connects — the capabilities graph with the B at its centre;
// 5 coffee & heart — a real ECG trace; every coffee raises the rate;
// 6 the call to action.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import CapGraph from '../components/CapGraph.astro';
import { ABOUT_QUERY, HOME_QUERY, SETTINGS_QUERY, urlFor } from '../lib/sanity';
import { load } from '../lib/load';
import glyphs from '../lib/monogram-b.json';

const [settings, about, home] = await Promise.all([
  load(Astro.locals, SETTINGS_QUERY),
  load(Astro.locals, ABOUT_QUERY),
  load(Astro.locals, HOME_QUERY),
]);
if (!settings || !about) return new Response('Content not found', { status: 500 });

const yy = (s: string) => {
  const m = s.match(/(\d{4})\D+(\d{4}|present)/i);
  if (!m) return '';
  const a = `’${m[1].slice(2)}`;
  return /present/i.test(m[2]) ? `${a}–now` : `${a}–’${m[2].slice(2)}`;
};
const title = (s: string) =>
  s.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase()).replace(/\bUi\b/g, 'UI').replace(/\bUx\b/g, 'UX');
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const jobs = ((about.experience ?? []) as any[]).map((e) => ({
  role: title(e.role ?? ''),
  company: e.company as string,
  when: yy(e.period ?? ''),
  now: /present/i.test(e.period ?? ''),
  logo: e.logo?.asset ? urlFor(e.logo).width(96).height(96).fit('crop').url() : null,
}));
const nice = (f: string) => {
  const s = f.toLowerCase().replace(/\b(ux|ui|ai)\b/g, (m) => m.toUpperCase());
  return s.replace(/(^|\s)(\w)/g, (_m, a, b) => a + b.toUpperCase()).replace('Nocode', 'No-code');
};
const focus: string[] = (about.focus ?? []).map(nice);
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = ((home?.projects ?? []) as any[]).filter(Boolean);
const portrait = about.portrait?.asset ? urlFor(about.portrait).width(700).height(930).fit('crop').url() : null;
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const pix = (p: any) => (p?.cover?.asset ? urlFor(p.cover).width(24).height(30).fit('crop').url() : null);
const caps = [
  { name: 'Design', img: null, items: ['UX/UI', 'Art direction', 'Design systems', 'Prototyping', 'Typography', 'Motion', 'Branding', 'Research'] },
  { name: 'Technology', img: null, items: ['No-code', 'Astro', 'Sanity CMS', 'WebGL', 'Three.js', 'Animation', 'Performance', 'Accessibility'] },
  { name: 'AI & Play', img: null, items: ['AI workflows', 'Generative UI', 'Prompting', 'Game design', 'Interaction', 'Playtesting'] },
];
const [bPath, bBox] = glyphs.g.B as [string, number[], number];
const bView = `${bBox[0]} ${-bBox[3]} ${bBox[2] - bBox[0]} ${bBox[3] - bBox[1]}`;
const bSvg = `<svg viewBox="${bView}"><path transform="scale(1,-1)" d="${bPath}" fill="currentColor"/></svg>`;
---

<Base title={`About me – ${settings.name}`} description={settings.seoDescription ?? ''}>
  <main class="a9" data-a9>
    <header class="a9__nav">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </header>

    <!-- 1 -->
    <section class="a9__intro" data-intro>
      <div class="a9__stage">
        <div class="a9__say">
          <h1 class="t-display" data-say>
            Hi, I’m Bart — a design engineer from Warsaw. I design and build bold web experiences with AI in the loop. Into sport, games and way too much coffee.
          </h1>
        </div>
        <canvas class="a9__mono" data-monogram aria-label="B monogram" role="img"></canvas>
        <span class="a9__hint" aria-hidden="true">Scroll</span>
      </div>
    </section>

    <!-- 2 -->
    <section class="a9__sec a9__who">
      <p class="a9__label" data-in>Who I am</p>
      <div class="a9__who-grid">
        <figure class="a9__pill" data-in>
          {portrait ? <img src={portrait} alt="Bart Ocieczek" width="700" height="930" loading="lazy" /> : <span />}
        </figure>
        <div class="a9__who-t">
          <p class="a9__big" data-words>{about.introLead}</p>
          <p class="a9__p" data-in>{about.introBody}</p>
        </div>
      </div>
    </section>

    <!-- 3 -->
    <section class="a9__sec">
      <p class="a9__label" data-in>Experience & what I do</p>
      <div class="a9__two">
        <ul class="a9__jobs" data-jobs>
          {jobs.map((j, i) => (
            <li data-in data-logo={j.logo ?? ''}>
              <span>{j.company}</span>
              <span class="a9__dim">{j.role}</span>
              <span class="a9__when">{j.when}</span>
            </li>
          ))}
        </ul>
        <p class="a9__focus" data-in data-scramble>{focus.join(', ')}.</p>
        <div class="a9__trail" aria-hidden="true" data-trail><img alt="" /></div>
      </div>
    </section>

    <!-- 4 -->
    <section class="a9__caps">
      <p class="a9__label a9__caps-label">How it connects</p>
      <CapGraph groups={caps} core={bSvg} />
    </section>

    <!-- 5 -->
    <section class="a9__sec a9__heart">
      <p class="a9__label" data-in>Off-screen</p>
      <div class="a9__heart-grid">
        <div class="a9__heart-l">
          <p class="a9__big" data-words>Coffee in, sport out.</p>
          <div class="a9__brew-row" data-in>
            <button class="a9__brew" type="button" data-brew>
              <span class="a9__brew-fill" aria-hidden="true"></span>
              <span class="a9__brew-t">Hold to brew</span>
            </button>
            <p class="a9__cups"><span data-cups>0</span> today</p>
          </div>
        </div>
        <div class="a9__monitor" data-in>
          <div class="a9__mon-top">
            <span class="a9__beat" aria-hidden="true" data-beat />
            <span><strong data-bpm>62</strong> bpm</span>
          </div>
          <svg class="a9__ecg" viewBox="0 0 800 200" preserveAspectRatio="none" aria-label="Heart rate trace"><path data-ecg d="" /></svg>
        </div>
      </div>
    </section>

    <!-- 6 -->
    <section class="a9__end" data-end>
      <a class="a9__cta" href={settings.callUrl ?? '#'} target="_blank" rel="noopener" data-cta>
        <span class="a9__cta-q" data-in>{about.ctaText?.split('?')[0]}?</span>
        <span class="a9__huge">
          <span class="a9__huge-o">Let’s talk</span>
          <span class="a9__huge-f" aria-hidden="true" data-fill>Let’s talk</span>
        </span>
        <span class="a9__orb" aria-hidden="true" data-orb><span>Book a call</span><i>↗</i></span>
      </a>
      <div class="a9__foot">
        <span data-clock>Warsaw</span>
        <button type="button" class="a9__top" data-top>Back to top ↑</button>
      </div>
    </section>
  </main>
</Base>

<style>
  /* minimal: one type family in three sizes, grey + black, hairlines,
     lots of air; a label column on the left like the home details row */
  .a9 {
    --e-out: cubic-bezier(0.23, 1, 0.32, 1);
    --e-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --ink: rgb(240, 240, 238);
    --grey: rgb(120, 120, 120);
    --faint: rgb(40, 40, 40);
    --rule: rgba(255, 255, 255, 0.1);
    --bg: rgb(10, 10, 10);
    --text-primary: var(--ink);
    --text-secondary: var(--grey);
    --surface-dark: var(--bg);
    --pad: var(--gutter);
    --col: clamp(120px, 24vw, 360px);
    background: var(--bg);
    color: var(--ink);
    font: 500 16px/1.4 var(--font-head);
    letter-spacing: -0.015em;
  }
  .a9__nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    padding: var(--gutter);
  }
  .a9__label {
    margin: 0;
    font-size: 13px;
    color: var(--grey);
  }
  .a9__sec {
    display: grid;
    grid-template-columns: var(--col) minmax(0, 1fr);
    gap: var(--pad);
    padding: clamp(96px, 18vh, 200px) var(--pad);
  }
  .a9__sec > .a9__label {
    margin: 0;
  }

  /* 1: same as /about-me — a sticky stage, the statement under a chrome B */
  .a9__intro {
    position: relative;
    height: 260svh;
  }
  .a9__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }
  .a9__say {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0 var(--pad);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .a9__say h1 {
    margin: 0;
    max-width: 1000px;
    text-align: center;
    font-size: clamp(28px, 4.4vw, 68px);
    line-height: 0.98;
    color: var(--ink);
    will-change: transform;
  }
  .a9__say :global(.sw) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .a9__say :global(.swi) {
    display: inline-block;
    transform: translateY(115%) rotate(7deg);
    transform-origin: 0 100%;
    opacity: var(--lit, 0.28);
    transition:
      transform 1.15s var(--e-expo),
      opacity 0.35s var(--e-out);
    transition-delay: calc(var(--l, 0) * 90ms + var(--i, 0) * 14ms), 0ms;
  }
  .a9__say.is-in :global(.swi) {
    transform: none;
  }
  .a9__mono {
    z-index: 2;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .a9__hint {
    position: absolute;
    left: 50%;
    bottom: 28px;
    z-index: 3;
    transform: translateX(-50%);
    font: 500 12px/1 var(--font-head);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--grey);
    opacity: 0;
    transition: opacity 0.6s var(--e-out) 1.6s;
  }
  .a9__say.is-in ~ .a9__hint {
    opacity: calc(1 - var(--p, 0) * 6);
    transition-delay: 1.6s;
  }
  .a9__beat :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  :global(html:has(.a9)),
  :global(body:has(.a9)) {
    background: rgb(10, 10, 10);
    color-scheme: dark;
  }

  /* 2 */
  .a9__who-grid {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: start;
  }
  .a9__pill {
    margin: 0;
    aspect-ratio: 0.75;
    border-radius: 999px;
    overflow: hidden;
    background: #1a1a1a;
  }
  .a9__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(1);
  }
  .a9__big {
    max-width: 20em;
    margin: 0 0 24px;
    font: 500 clamp(20px, 1.8vw, 28px) / 1.2 var(--font-head);
    letter-spacing: -0.03em;
  }
  .a9__p {
    max-width: 36ch;
    margin: 0;
    color: var(--grey);
  }
  .a9__dim {
    color: var(--grey);
  }

  /* 3 */
  .a9__two {
    display: grid;
    gap: 40px;
  }
  .a9__jobs {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .a9__jobs li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) 100px;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
  }
  .a9__jobs li:first-child {
    border-top: 1px solid var(--rule);
  }
  /* the rule under each row draws in from the left as it reveals */
  .a9__jobs li {
    border-bottom-color: transparent;
  }
  .a9__jobs li::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1.1s var(--e-expo) calc(var(--d, 0s) + 0.1s);
  }
  .a9__jobs li.is-in::after {
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__jobs li {
      cursor: default;
      transition: padding 0.4s var(--e-out);
    }
    .a9__jobs li:hover {
      padding-left: 12px;
    }
  }
  /* a pill with the company's logo trails the cursor over the rows */
  .a9__trail {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 5;
    width: 120px;
    height: 160px;
    margin: -80px 0 0 -60px;
    border-radius: 999px;
    overflow: hidden;
    background: #1a1a1a;
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.25s var(--e-out),
      scale 0.35s var(--e-out);
  }
  .a9__trail.is-on {
    opacity: 1;
    scale: 1;
  }
  .a9__trail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .a9__when {
    justify-self: end;
    color: var(--grey);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .a9__focus {
    max-width: 36ch;
    margin: 0;
    color: var(--grey);
  }

  /* 4: the graph, quiet */
  .a9__caps {
    position: relative;
    padding: 0 var(--pad);
  }
  .a9__caps-label {
    position: absolute;
    top: 0;
    left: var(--pad);
    z-index: 2;
  }
  .a9__caps :global(.cg) {
    --ink: rgb(240, 240, 238);
    background: transparent;
    height: clamp(420px, 70svh, 720px);
  }
  .a9__caps :global(.cg__core--mark) {
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    background: var(--bg);
    color: var(--ink);
  }
  .a9__caps :global(.cg__core--mark svg) {
    width: 24px;
  }
  .a9__caps :global(.cg__lines line) {
    stroke: rgba(255, 255, 255, 0.09);
  }
  .a9__caps :global(.cg__lines line.is-hub) {
    stroke: rgba(255, 255, 255, 0.5);
  }
  .a9__caps :global(.cg__lines line.is-on) {
    stroke: rgba(255, 255, 255, 0.4);
  }
  .a9__caps :global(.cg__hub-t) {
    font: 500 13px/1 var(--font-head);
    letter-spacing: -0.01em;
    text-transform: none;
  }
  .a9__caps :global(.cg__hub-t i) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .a9__caps :global(.cg__dot i) {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  /* 5 */
  .a9__heart-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
  }
  .a9__brew-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .a9__cups {
    margin: 0;
    color: var(--grey);
  }
  .a9__cups span {
    display: inline-block;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  /* hold to brew: slow deliberate fill, snappy release */
  .a9__brew {
    position: relative;
    overflow: hidden;
    padding: 10px 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
    transition: transform 0.16s var(--e-out);
  }
  .a9__brew:active {
    transform: scale(0.97);
  }
  .a9__brew-fill {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.08);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.2s var(--e-out);
  }
  .a9__brew.is-holding .a9__brew-fill {
    clip-path: inset(0 0 0 0);
    transition: clip-path 1.2s linear;
  }
  .a9__brew-t {
    position: relative;
  }
  .a9__mon-top {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--grey);
  }
  .a9__mon-top strong {
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  /* a small dot that beats with the heart */
  .a9__beat {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
  }
  .a9__ecg {
    display: block;
    width: 100%;
    height: 120px;
    margin-top: 8px;
  }
  .a9__ecg path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  /* 6: a word the width of the page, drawn as an outline that fills with
     ink as you arrive; a round "Book a call" follows the pointer over it */
  .a9__end {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 var(--pad) var(--pad);
  }
  .a9__cta {
    position: relative;
    display: block;
    color: var(--ink);
    text-decoration: none;
  }
  .a9__cta-q {
    display: block;
    max-width: 24em;
    margin-left: calc(var(--col) + var(--pad));
    color: var(--grey);
  }
  .a9__huge {
    position: relative;
    display: block;
    margin-top: 2vw;
    font: 500 calc(19.4vw * var(--fit, 1)) / 0.82 var(--font-head);
    letter-spacing: -0.06em;
    white-space: nowrap;
  }
  .a9__huge-o {
    display: inline-block;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.28);
  }
  .a9__huge-f {
    position: absolute;
    inset: 0;
    color: var(--ink);
    clip-path: inset(-0.2em calc((1 - var(--f, 0)) * 100%) -0.2em 0);
  }
  .a9__orb {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: clamp(96px, 9vw, 140px);
    aspect-ratio: 1;
    margin: calc(clamp(96px, 9vw, 140px) / -2) 0 0 calc(clamp(96px, 9vw, 140px) / -2);
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--bg);
    font-size: 14px;
    pointer-events: none;
    will-change: transform;
    /* inverts over the letters: black over the ink, white over the page */
    mix-blend-mode: difference;
  }
  .a9__orb i {
    font-style: normal;
    font-size: 20px;
    line-height: 1;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__cta {
      cursor: none;
    }
  }
  .a9__foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: clamp(24px, 3vw, 48px);
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--grey);
  }
  .a9__top {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .a9__top:hover {
      color: var(--ink);
    }
  }

  /* reveals */
  [data-in] {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.8s var(--e-out),
      transform 1s var(--e-expo);
    transition-delay: var(--d, 0s);
  }
  [data-in].is-in {
    opacity: 1;
    transform: none;
  }
  :global(.a9 .w) {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  :global(.a9 .wi) {
    display: inline-block;
    transform: translateY(110%);
    transition: transform 1s var(--e-expo);
    transition-delay: calc(var(--k) * 22ms);
  }
  :global(.a9 .is-in .wi) {
    transform: none;
  }

  @media (max-width: 809px) {
    .a9 {
      --col: 0px;
    }
    .a9__cta-q {
      margin-left: 0;
      max-width: 62%;
    }
    .a9__sec,
    .a9__heart-grid {
      grid-template-columns: 1fr;
    }
    .a9__who-grid {
      grid-template-columns: 96px 1fr;
    }
    .a9__jobs li {
      grid-template-columns: 1fr auto;
    }
    .a9__jobs .a9__dim {
      grid-column: 1;
      grid-row: 2;
      font-size: 14px;
    }
    .a9__when {
      grid-row: 1;
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-in],
    :global(.a9 .wi),
    .a9__say :global(.swi) {
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-a9]');
  if (root) {
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    // ---- 1: as on /about-me — each word in a tilted mask, lines rise in,
    // then the scroll lights them up word by word
    const say = root.querySelector<HTMLElement>('[data-say]')!;
    const sayWrap = say.parentElement!;
    const words: HTMLElement[] = [];
    const sayText = (say.textContent ?? '').trim().split(/\s+/);
    say.textContent = '';
    sayText.forEach((w, i) => {
      const o = document.createElement('span');
      o.className = 'sw';
      const n = document.createElement('span');
      n.className = 'swi';
      n.textContent = w;
      o.append(n);
      say.append(o);
      if (i < sayText.length - 1) say.append(' ');
      words.push(n);
    });
    const lines = () => {
      let line = -1;
      let top = -1;
      let i = 0;
      words.forEach((n) => {
        const t = (n.parentElement as HTMLElement).offsetTop;
        if (t !== top) {
          line++;
          top = t;
          i = 0;
        }
        n.style.setProperty('--l', String(line));
        n.style.setProperty('--i', String(i++));
      });
    };
    lines();
    addEventListener('resize', lines);
    setTimeout(() => sayWrap.classList.add('is-in'), 650);

    // ---- masked word rise for [data-words]
    root.querySelectorAll<HTMLElement>('[data-words]').forEach((el) => {
      const t = (el.textContent ?? '').trim().split(/\s+/);
      el.textContent = '';
      t.forEach((w, k) => {
        const o = document.createElement('span');
        o.className = 'w';
        const i = document.createElement('span');
        i.className = 'wi';
        i.style.setProperty('--k', String(k));
        i.textContent = w;
        o.append(i);
        el.append(o);
        if (k < t.length - 1) el.append(' ');
      });
    });

    // ---- reveal once, staggered among siblings
    const io = new IntersectionObserver(
      (es) =>
        es.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }),
      { rootMargin: '0px 0px -10% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-in], [data-words]').forEach((el) => {
      const sib = [...(el.parentElement?.children ?? [])].filter((s) => s.hasAttribute('data-in'));
      el.style.setProperty('--d', `${Math.max(0, sib.indexOf(el)) * 60}ms`);
      io.observe(el);
    });

    // ---- 5: a real ECG trace. One beat is a sum of gaussians at clinical
    // timings (P 0.10s, Q 0.20s, R 0.22s, S 0.245s, T 0.42s); the beat
    // interval is 60/bpm, so a faster rate packs beats closer while the
    // complex keeps its shape — like a real monitor.
    const g = (t: number, at: number, w: number, a: number) => a * Math.exp(-((t - at) ** 2) / (2 * w * w));
    const ecg = (t: number) =>
      g(t, 0.1, 0.022, 0.12) + g(t, 0.2, 0.009, -0.12) + g(t, 0.22, 0.01, 1) + g(t, 0.245, 0.011, -0.25) + g(t, 0.42, 0.045, 0.3);
    const path = root.querySelector<SVGPathElement>('[data-ecg]');
    const bpmEl = root.querySelector<HTMLElement>('[data-bpm]');
    const beatEl = root.querySelector<HTMLElement>('[data-beat]');
    const WIN = 4; // seconds on screen
    const samples: number[] = [];
    const RATE = 60; // samples per second
    let caffeine = 0;
    let bpm = 62;
    let inBeat = 0; // seconds since this beat started
    let acc = 0;
    let last = performance.now();
    // pre-fill so the trace is full from the start
    for (let i = 0; i < WIN * RATE; i++) {
      inBeat += 1 / RATE;
      if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
      samples.push(ecg(inBeat));
    }

    // ---- scroll-driven bits + the monitor, in one loop
    const intro = root.querySelector<HTMLElement>('[data-intro]');
    const frame = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      if (intro) {
        const max = intro.offsetHeight - innerHeight;
        const p = max > 0 ? clamp(-intro.getBoundingClientRect().top / max) : 0;
        // light the words over the first 85% of the scroll, a soft edge of ~3
        const f = (p / 0.85) * (words.length + 3) - 3;
        words.forEach((n, k) => n.style.setProperty('--lit', (0.28 + 0.72 * clamp((f - k + 3) / 3)).toFixed(3)));
        say.style.transform = `translateY(${(-p * 6).toFixed(2)}vh)`;
        sayWrap.parentElement!.style.setProperty('--p', p.toFixed(3));
        (window as any).__a9P = p;
      }
      // heart: caffeine wears off ~1 coffee per 40s; the rate eases toward its target
      caffeine = Math.max(0, caffeine - dt / 40);
      const target = 62 + Math.min(caffeine, 8) * 8;
      bpm += (target - bpm) * Math.min(1, dt * 0.8);
      if (bpmEl) bpmEl.textContent = String(Math.round(bpm));
      acc += dt * RATE;
      while (acc >= 1) {
        acc -= 1;
        const before = inBeat;
        inBeat += 1 / RATE;
        if (inBeat >= 60 / bpm) inBeat -= 60 / bpm;
        // the B jumps on the R wave
        if (beatEl && !calm && before < 0.22 && inBeat >= 0.22)
          beatEl.animate([{ transform: 'scale(1.8)' }, { transform: 'scale(1)' }], { duration: 260, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
        samples.push(calm ? 0 : ecg(inBeat));
        if (samples.length > WIN * RATE) samples.shift();
      }
      if (path) {
        let d = '';
        const n = samples.length;
        for (let i = 0; i < n; i++) {
          const x = (i / (n - 1)) * 800;
          const y = 150 - samples[i] * 120;
          d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
        }
        path.setAttribute('d', d);
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // ---- hold to brew (slow fill, snappy release); each coffee adds caffeine
    const brew = root.querySelector<HTMLButtonElement>('[data-brew]');
    const cups = root.querySelector<HTMLElement>('[data-cups]');
    if (brew && cups) {
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: 'numeric', hour12: false }).format(new Date()));
      let n = Math.max(0, Math.min(4, Math.floor((hour - 6) / 3)));
      cups.textContent = String(n);
      let t = 0;
      const start = (e: Event) => {
        e.preventDefault();
        brew.classList.add('is-holding');
        t = window.setTimeout(() => {
          n++;
          caffeine += 1;
          cups.textContent = String(n);
          cups.animate([{ transform: 'translateY(40%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 400, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });
          brew.classList.remove('is-holding');
          brew.querySelector('.a9__brew-t')!.textContent = n > 5 ? 'Enough' : 'Another';
        }, 1200);
      };
      const stop = () => {
        clearTimeout(t);
        brew.classList.remove('is-holding');
      };
      brew.addEventListener('pointerdown', start);
      brew.addEventListener('pointerup', stop);
      brew.addEventListener('pointerleave', stop);
      brew.addEventListener('pointercancel', stop);
      brew.addEventListener('keydown', (e) => e.key === ' ' && !e.repeat && start(e));
      brew.addEventListener('keyup', (e) => e.key === ' ' && stop());
    }

    // ---- text scramble: letters settle out of random glyphs, left to right
    const GLYPHS = 'abcdefghijklmnopqrstuvwxyz/—_·';
    const scramble = (el: HTMLElement) => {
      const final = el.textContent ?? '';
      if (calm) return;
      const t0 = performance.now();
      const step = () => {
        const p = (performance.now() - t0) / 900;
        let out = '';
        for (let i = 0; i < final.length; i++) {
          const ch = final[i];
          out += ch === ' ' || p > i / final.length + 0.25 ? ch : GLYPHS[(Math.random() * GLYPHS.length) | 0];
        }
        el.textContent = out;
        if (p < 1.3) requestAnimationFrame(step);
        else el.textContent = final;
      };
      step();
    };
    const sio = new IntersectionObserver((es) =>
      es.forEach((e) => {
        if (!e.isIntersecting) return;
        sio.unobserve(e.target);
        scramble(e.target as HTMLElement);
      }),
    );
    root.querySelectorAll<HTMLElement>('[data-scramble], .a9__label').forEach((el) => sio.observe(el));

    // ---- a logo pill trails the cursor over the experience rows
    const jobsEl = root.querySelector<HTMLElement>('[data-jobs]');
    const trail = root.querySelector<HTMLElement>('[data-trail]');
    if (jobsEl && trail && matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const img = trail.querySelector('img')!;
      let tx = 0, ty = 0, x = 0, y = 0, raf = 0;
      const follow = () => {
        x += (tx - x) * 0.15;
        y += (ty - y) * 0.15;
        trail.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0) rotate(${Math.max(-10, Math.min(10, (tx - x) * 0.1)).toFixed(2)}deg)`;
        raf = requestAnimationFrame(follow);
      };
      jobsEl.addEventListener('pointermove', (e) => {
        tx = e.clientX + 90;
        ty = e.clientY;
        const li = (e.target as Element).closest<HTMLElement>('li');
        const src = li?.dataset.logo;
        if (src) {
          if (img.getAttribute('src') !== src) img.src = src;
          if (!trail.classList.contains('is-on')) {
            x = tx;
            y = ty;
            trail.classList.add('is-on');
            cancelAnimationFrame(raf);
            follow();
          }
        }
      });
      jobsEl.addEventListener('pointerleave', () => {
        trail.classList.remove('is-on');
        setTimeout(() => cancelAnimationFrame(raf), 300);
      });
    }

    // ---- CTA: the outline fills as the section arrives (all of it on
    // hover); the orb rests by the word and follows the pointer over it
    const end = root.querySelector<HTMLElement>('[data-end]');
    const cta = root.querySelector<HTMLElement>('[data-cta]');
    const fill = root.querySelector<HTMLElement>('[data-fill]');
    const orb = root.querySelector<HTMLElement>('[data-orb]');
    const huge = root.querySelector<HTMLElement>('.a9__huge-o')!;
    // size the word to run edge to edge of the content box
    const fitWord = () => {
      if (!cta || !huge) return;
      huge.parentElement!.style.setProperty('--fit', '1');
      const k = cta.clientWidth / huge.scrollWidth;
      huge.parentElement!.style.setProperty('--fit', (k * 0.995).toFixed(4));
    };
    fitWord();
    document.fonts?.ready.then(fitWord);
    addEventListener('resize', fitWord);
    root.querySelector('[data-top]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' }));
    if (end && cta && fill && orb) {
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      let over = false;
      let mx = 0;
      let my = 0;
      let f = 0;
      let ox = -1;
      let oy = 0;
      let os = 1;
      let press = false;
      let raf = 0;
      cta.addEventListener('pointerenter', () => fine && (over = true));
      cta.addEventListener('pointerleave', () => (over = press = false));
      cta.addEventListener('pointermove', (e) => {
        const r = cta.getBoundingClientRect();
        mx = e.clientX - r.left;
        my = e.clientY - r.top;
      });
      cta.addEventListener('pointerdown', () => (press = true));
      addEventListener('pointerup', () => (press = false));
      const step = () => {
        const r = end.getBoundingClientRect();
        const arrive = clamp((innerHeight - r.top) / r.height);
        const tf = over ? 1 : calm ? 1 : clamp((arrive - 0.25) / 0.7);
        f += (tf - f) * (over ? 0.12 : 0.2);
        fill.style.setProperty('--f', f.toFixed(4));
        // rest: just right of the "k", on the word's middle
        const W = cta.clientWidth;
        const rx = W - orb.offsetWidth * 0.75;
        const ry = huge.offsetTop + orb.offsetHeight * 0.1;
        const tx = over ? mx : rx;
        const ty = over ? my : ry;
        if (ox < 0) {
          ox = tx;
          oy = ty;
        }
        const k = calm ? 1 : 0.2;
        ox += (tx - ox) * k;
        oy += (ty - oy) * k;
        // a little stretch along the way it's moving, eased back when still
        const v = Math.min(1, Math.hypot(tx - ox, ty - oy) / 300);
        os += ((press ? 0.9 : over ? 1.08 : 1) - os) * 0.25;
        orb.style.transform = `translate(${ox.toFixed(1)}px,${oy.toFixed(1)}px) scale(${(os * (1 + v * 0.08)).toFixed(3)})`;
        raf = requestAnimationFrame(step);
      };
      new IntersectionObserver((es) => {
        if (es[0].isIntersecting) {
          if (!raf) raf = requestAnimationFrame(step);
        } else if (raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      }).observe(end);
    }

    // ---- live Warsaw time
    const clock = root.querySelector<HTMLElement>('[data-clock]');
    const tick = () => {
      if (clock) clock.textContent = `Warsaw, ${new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(new Date())} — open for new work`;
    };
    tick();
    setInterval(tick, 20000);
  }
</script>

<script>
      import * as THREE from 'three';
      import { SVGLoader } from 'three/examples/jsm/loaders/SVGLoader.js';
      import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';
      import glyphs from '../lib/monogram-b.json';
      import { hasGPU } from '../lib/gpu';

      const canvas = document.querySelector<HTMLCanvasElement>('[data-monogram]');
      // no real GPU: a flat silver B instead of the 3D one
      if (canvas && !hasGPU()) {
        const [d, b] = glyphs.g.B as [string, number[], number];
        const box = document.createElement('div');
        box.className = canvas.className;
        box.style.cssText = 'position:absolute;inset:0;z-index:2;display:grid;place-items:center;pointer-events:none';
        box.innerHTML = `<svg viewBox="${b[0]} ${-b[3]} ${b[2] - b[0]} ${b[3] - b[1]}" style="width:min(46vmin,420px);height:auto" aria-hidden="true"><path transform="scale(1,-1)" d="${d}" fill="#d9d9de"/></svg>`;
        canvas.replaceWith(box);
      } else if (canvas) {
      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;
      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
      scene.environmentIntensity = 1.25;
      const camera = new THREE.PerspectiveCamera(30, 1, 0.1, 100);
      camera.position.set(0, 0, 9);

      // soft key light + a warm rim, on top of the room reflections
      const key = new THREE.DirectionalLight(0xffffff, 2.4);
      key.position.set(-3, 4, 6);
      scene.add(key);
      const rim = new THREE.DirectionalLight(0xffe2c4, 0.8);
      rim.position.set(4, -2, -3);
      scene.add(rim);


      // polished black chrome: deep, with crisp reflections running along
      // the strokes as it turns
      const mat = new THREE.MeshPhysicalMaterial({
        color: 0xd9d9de,
        roughness: 0.16,
        metalness: 1.0,
        clearcoat: 1,
        clearcoatRoughness: 0.05,
        transparent: true,
        opacity: 0,
      });

      // Where the B crosses a letter of the statement, its flat faces open
      // up (the text shows through) and only its walls stay: the B reads as
      // a chrome stroke over the words. The letters are drawn into a mask the
      // size of the stage, matched to the live DOM text every frame.
      const maskCv = document.createElement('canvas');
      const mctx = maskCv.getContext('2d')!;
      const maskTex = new THREE.CanvasTexture(maskCv);
      maskTex.minFilter = THREE.LinearFilter;
      maskTex.generateMipmaps = false;
      const uRes = new THREE.Vector2(1, 1);
      mat.onBeforeCompile = (sh) => {
        sh.uniforms.uMask = { value: maskTex };
        sh.uniforms.uRes = { value: uRes };
        sh.vertexShader = sh.vertexShader
          .replace('#include <common>', '#include <common>\nvarying vec3 vObjN;')
          .replace('#include <beginnormal_vertex>', '#include <beginnormal_vertex>\nvObjN = objectNormal;');
        sh.fragmentShader = sh.fragmentShader
          .replace('#include <common>', '#include <common>\nuniform sampler2D uMask;\nuniform vec2 uRes;\nvarying vec3 vObjN;')
          .replace(
            '#include <clipping_planes_fragment>',
            '#include <clipping_planes_fragment>\nif (texture2D(uMask, gl_FragCoord.xy / uRes).a > 0.5 && abs(vObjN.z) > 0.6) discard;',
          );
      };
      const sayEl = document.querySelector<HTMLElement>('[data-say]');
      const drawMask = () => {
        const W = canvas.clientWidth;
        const H = canvas.clientHeight;
        if (maskCv.width !== W || maskCv.height !== H) {
          maskCv.width = W;
          maskCv.height = H;
        }
        mctx.clearRect(0, 0, maskCv.width, maskCv.height);
        if (!sayEl) return;
        const cr = canvas.getBoundingClientRect();
        const cs = getComputedStyle(sayEl);
        mctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
        mctx.letterSpacing = cs.letterSpacing === 'normal' ? '0px' : cs.letterSpacing;
        mctx.textBaseline = 'alphabetic';
        mctx.fillStyle = '#000';
        mctx.strokeStyle = '#000';
        mctx.lineJoin = 'round';
        mctx.lineWidth = 3; // a hair wider than the letters, so they sit clear of the chrome
        // baseline inside each word's line box, from the font's own metrics
        const fm = mctx.measureText('H');
        const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize);
        const base = (lh - (fm.fontBoundingBoxAscent + fm.fontBoundingBoxDescent)) / 2 + fm.fontBoundingBoxAscent;
        const upper = cs.textTransform === 'uppercase';
        sayEl.querySelectorAll<HTMLElement>('.swi').forEach((w) => {
          const r = w.getBoundingClientRect();
          const t = upper ? (w.textContent ?? '').toUpperCase() : (w.textContent ?? '');
          const x = r.left - cr.left;
          const y = r.top - cr.top + base;
          mctx.strokeText(t, x, y);
          mctx.fillText(t, x, y);
        });
        maskTex.needsUpdate = true;
        const db = renderer.getDrawingBufferSize(new THREE.Vector2());
        uRes.set(db.x, db.y);
      };

      const U = glyphs.upm;
      const shapesOf = (d: string) => {
        const data = new SVGLoader().parse(`<svg xmlns="http://www.w3.org/2000/svg"><path d="${d}"/></svg>`);
        return data.paths.flatMap((p) => p.toShapes(true));
      };
      const letter = (ch: 'B', depth: number) => {
        const [d] = glyphs.g[ch] as [string, number[], number];
        const geo = new THREE.ExtrudeGeometry(shapesOf(d), {
          depth,
          bevelEnabled: true,
          bevelThickness: 22,
          bevelSize: 6,
          bevelSegments: 6,
          curveSegments: 28,
        });
        geo.computeBoundingBox();
        const bb = geo.boundingBox!;
        geo.translate(-(bb.min.x + bb.max.x) / 2, -(bb.min.y + bb.max.y) / 2, -(bb.min.z + bb.max.z) / 2);
        geo.scale(1 / U, 1 / U, 1 / U);
        geo.computeVertexNormals();
        return new THREE.Mesh(geo, mat);
      };

      // just the B, a slim slab: thin, with a fine bevel catching the light
      const logo = new THREE.Group();
      const B = letter('B', 150);
      B.scale.setScalar(3.1);
      logo.add(B);
      scene.add(logo);

      const resize = () => {
        const w = canvas.clientWidth;
        const h = canvas.clientHeight;
        renderer.setSize(w, h, false);
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        camera.position.z = w < h ? 13 : 9;
      };
      addEventListener('resize', resize);
      resize();

      // slow idle turn; the pointer tilts it (eased, never snaps)
      let px = 0;
      let py = 0;
      addEventListener('pointermove', (e) => {
        px = (e.clientX / innerWidth) * 2 - 1;
        py = (e.clientY / innerHeight) * 2 - 1;
      });
      let rx = 0;
      let ry = 0;
      let sy = 0; // the scroll, smoothed
      const t0 = performance.now();
      // entrance (as the dark page opens): it rises a little, turns in from a
      // three-quarter view and grows to size on a long ease-out
      const IN_DELAY = 0.45;
      const IN_DUR = 1.8;
      const easeOut = (x: number) => 1 - Math.pow(1 - x, 4);
      const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tick = () => {
        const t = (performance.now() - t0) / 1000;
        const idle = calm ? 0 : Math.sin(t * 0.45) * 0.35;
        ry += (idle + px * 0.5 - ry) * 0.05;
        rx += (py * 0.3 - rx) * 0.05;
        const k = calm ? 1 : easeOut(Math.min(1, Math.max(0, (t - IN_DELAY) / IN_DUR)));
        const sp = (window as any).__a9P ?? 0;
        sy += (sp - sy) * 0.08;
        logo.rotation.set(rx + (1 - k) * 0.5, ry - (1 - k) * 1.6 + sy * Math.PI * 2, (1 - k) * -0.15);
        logo.position.y = (calm ? 0 : Math.sin(t * 0.8) * 0.05) - (1 - k) * 0.9;
        logo.scale.setScalar(0.75 + 0.25 * k);
        (mat as THREE.MeshPhysicalMaterial).opacity = k;
        drawMask();
        renderer.render(scene, camera);
        requestAnimationFrame(tick);
      };
      tick();
      }
</script>
