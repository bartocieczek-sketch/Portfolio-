---
// Preloader lab: five ways to pair the 3D B with the name and the role, each
// on its own link (/preloader-1 … /preloader-5). Not linked anywhere.
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';

export const prerender = true;
export function getStaticPaths() {
  return [1, 2, 3, 4, 5].map((n) => ({ params: { n: String(n) } }));
}
const n = Number(Astro.params.n);
const names = ['', 'Lockup', 'B opens into the name', 'B as the first letter', 'Stacked', 'B in the background'];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Preloader {n} – {names[n]}</title>
  </head>
  <body data-v={n}>
    <div class="stage">
      {n === 5 && <canvas class="big" data-mark></canvas>}
      {n === 3 ? (
        <div class="lock3">
          <div class="row">
            <canvas class="mark" data-mark></canvas>
            <span class="m"><span class="i w">art</span></span>
            <span class="m"><span class="i w">Ocieczek</span></span>
          </div>
          <span class="m role"><span class="i">Designer &amp; Developer</span></span>
        </div>
      ) : (
        <div class={`lock lock${n}`}>
          {n !== 5 && <canvas class="mark" data-mark></canvas>}
          <div class="text">
            <span class="m name"><span class="i">Bart Ocieczek</span></span>
            <span class="m role"><span class="i">Designer &amp; Developer</span></span>
          </div>
        </div>
      )}
    </div>
    <nav class="lab">
      {[1, 2, 3, 4, 5].map((k) => <a href={`/preloader-${k}`} aria-current={k === n ? 'page' : undefined}>{k}</a>)}
      <button type="button" data-replay>Replay</button>
      <span class="lab__name">{names[n]}</span>
    </nav>

    <style is:global>
      html,
      body {
        margin: 0;
        height: 100%;
        background: #fff;
        color: #0b0b0b;
        font-family: Inter, system-ui, sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .stage {
        position: fixed;
        inset: 0;
        display: grid;
        place-items: center;
        overflow: hidden;
      }
      .m {
        display: block;
        overflow: hidden;
        padding-bottom: 0.08em;
        margin-bottom: -0.08em;
      }
      .i {
        display: block;
        will-change: transform;
        transform: translateY(110%);
      }
      .mark {
        display: block;
        width: 88px;
        height: 88px;
        opacity: 0;
        will-change: transform, opacity;
      }
      .name {
        font-weight: 500;
        font-size: 22px;
        line-height: 1.2;
        letter-spacing: -0.02em;
        white-space: nowrap;
      }
      .role {
        font-weight: 400;
        font-size: 15px;
        line-height: 1.3;
        letter-spacing: -0.01em;
        color: #8a8a8a;
        white-space: nowrap;
      }

      /* 1: B on the left, name and role beside it */
      .lock1 {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .lock1 .text {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .lock1 .i {
        transform: translateX(-110%);
      }

      /* 2: B turns edge-on, the name opens out of it */
      .lock2 {
        display: grid;
        place-items: center;
      }
      .lock2 > * {
        grid-area: 1 / 1;
      }
      .lock2 .text {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .lock2 .name {
        font-size: 30px;
      }
      .lock2 .i {
        transform: none;
        clip-path: inset(0 50% 0 50%);
      }

      /* 3: the B is the B of Bart */
      .lock3 {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }
      .lock3 .row {
        display: flex;
        align-items: center;
        font-weight: 500;
        font-size: clamp(34px, 4vw, 52px);
        line-height: 1;
        letter-spacing: -0.03em;
        white-space: nowrap;
      }
      .lock3 .mark {
        width: 1.9em;
        height: 1.9em;
        margin: 0 -0.32em 0 -0.3em;
      }
      .lock3 .row .m + .m {
        margin-left: 0.25em;
      }

      /* 4: B above, name and role below */
      .lock4 {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .lock4 .text {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
      }

      /* 5: a big, faint B turning behind the name */
      .big {
        position: absolute;
        width: 90vmin;
        height: 90vmin;
        opacity: 0;
      }
      .lock5 .text {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
      }
      .lock5 .name {
        font-size: 30px;
      }

      .lab {
        position: fixed;
        left: 50%;
        bottom: 22px;
        transform: translateX(-50%);
        display: flex;
        align-items: center;
        gap: 14px;
        font: 500 13px/1 Inter, system-ui, sans-serif;
        color: #9a9a9a;
      }
      .lab a {
        color: inherit;
        text-decoration: none;
      }
      .lab a[aria-current] {
        color: #0b0b0b;
      }
      .lab button {
        font: inherit;
        color: #0b0b0b;
        background: none;
        border: 1px solid #e3e3e3;
        border-radius: 999px;
        padding: 7px 12px;
        cursor: pointer;
      }
      .lab__name {
        color: #b5b5b5;
      }
    </style>

    <script>
      import { mountMark, turn, inOut, quartOut } from '../lib/lab-mark';

      const v = Number(document.body.dataset.v);
      document.querySelector('[data-replay]')!.addEventListener('click', () => location.reload());
      const OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
      const MOVE = 'cubic-bezier(0.77, 0, 0.175, 1)';
      const EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
      const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
      const canvas = $<HTMLCanvasElement>('[data-mark]');
      const markEl = canvas as unknown as HTMLElement;

      // one keyframe list on a shared timeline of T ms: [ms, frame, easing to next]
      const track = (el: Element, T: number, steps: [number, Keyframe, string?][]) =>
        el.animate(
          steps.map(([ms, f, e]) => ({ ...f, offset: ms / T, easing: e ?? 'linear' })),
          { duration: T, fill: 'both' },
        );
      const textW = (el: Element) => el.getBoundingClientRect().width;

      const run = () => {
        if (v === 1) {
          // B lands centred, glides left; the name and role slide out from behind it
          const T = 2900;
          const gap = 12;
          const dx = (textW($('.lock1 .text')) + gap) / 2;
          mountMark(canvas, turn(2350));
          track(markEl, T, [
            [0, { opacity: 0, transform: `translate(${dx}px, -12px) scale(0.9)` }, OUT],
            [750, { opacity: 1, transform: `translate(${dx}px, 0)` }],
            [820, { opacity: 1, transform: `translate(${dx}px, 0)` }, MOVE],
            [1450, { opacity: 1, transform: 'none' }],
            [2350, { opacity: 1, transform: 'none' }, MOVE],
            [T, { opacity: 0, transform: 'translateY(22%) scale(0.94)' }],
          ]);
          $$('.lock1 .i').forEach((el, k) =>
            track(el, T, [
              [0, { transform: 'translateX(-110%)' }],
              [1280 + k * 120, { transform: 'translateX(-110%)' }, EXPO],
              [2000 + k * 120, { transform: 'none' }],
              [2350 + k * 40, { transform: 'none' }, MOVE],
              [Math.min(T, 2870 + k * 40), { transform: 'translateY(110%)' }],
            ]),
          );
        }

        if (v === 2) {
          // B lands, turns edge-on into a thin bar; the name opens out of it
          const T = 3000;
          mountMark(canvas, (ms) => {
            const t = ms / 1000;
            const k = quartOut(ms / 1000);
            const e = inOut((ms - 900) / 480);
            return { rx: Math.sin(t * 1.1) * 0.05 * (1 - e), ry: (1 - k) * -1.9 + Math.sin(t * 1.5) * 0.18 * k * (1 - e) + e * (Math.PI / 2) };
          });
          track(markEl, T, [
            [0, { opacity: 0, transform: 'translateY(-12px) scale(0.9)' }, OUT],
            [750, { opacity: 1, transform: 'none' }],
            [1330, { opacity: 1, transform: 'none' }, OUT],
            [1520, { opacity: 0, transform: 'scaleY(0.6)' }],
          ]);
          $$('.lock2 .i').forEach((el, k) =>
            track(el, T, [
              [0, { clipPath: 'inset(0 50% 0 50%)', transform: 'none' }],
              [1330 + k * 110, { clipPath: 'inset(0 50% 0 50%)' }, EXPO],
              [2050 + k * 110, { clipPath: 'inset(0 0% 0 0%)' }],
              [2480, { clipPath: 'inset(0 0% 0 0%)' }, MOVE],
              [T - 60 + k * 30, { clipPath: 'inset(0 50% 0 50%)' }],
            ]),
          );
        }

        if (v === 3) {
          // B lands centred, glides into place as the B of "Bart"; the rest rises
          const T = 3050;
          const row = $('.lock3 .row');
          const rest = textW(row) - textW(markEl);
          const dx = rest / 2;
          mountMark(canvas, turn(2500));
          track(markEl, T, [
            [0, { opacity: 0, transform: `translate(${dx}px, -12px) scale(0.9)` }, OUT],
            [750, { opacity: 1, transform: `translate(${dx}px, 0)` }],
            [800, { opacity: 1, transform: `translate(${dx}px, 0)` }, MOVE],
            [1420, { opacity: 1, transform: 'none' }],
            [2500, { opacity: 1, transform: 'none' }, MOVE],
            [T, { opacity: 0, transform: 'translateY(22%) scale(0.94)' }],
          ]);
          $$('.lock3 .i').forEach((el, k) =>
            track(el, T, [
              [0, { transform: 'translateY(110%)' }],
              [1300 + k * 90 + (k === 2 ? 160 : 0), { transform: 'translateY(110%)' }, EXPO],
              [2150 + k * 90 + (k === 2 ? 160 : 0), { transform: 'none' }],
              [2500 + k * 40, { transform: 'none' }, MOVE],
              [Math.min(T, 2980 + k * 30), { transform: 'translateY(110%)' }],
            ]),
          );
        }

        if (v === 4) {
          // B lands centred, rises and shrinks; name and role come up beneath it
          const T = 3050;
          const lock = $('.lock4');
          const dy = (lock.getBoundingClientRect().height - markEl.getBoundingClientRect().height) / 2;
          mountMark(canvas, turn(2500));
          track(markEl, T, [
            [0, { opacity: 0, transform: `translateY(${dy - 12}px) scale(0.9)` }, OUT],
            [750, { opacity: 1, transform: `translateY(${dy}px)` }],
            [950, { opacity: 1, transform: `translateY(${dy}px)` }, MOVE],
            [1600, { opacity: 1, transform: 'scale(0.8)' }],
            [2500, { opacity: 1, transform: 'scale(0.8)' }, MOVE],
            [T, { opacity: 0, transform: 'translateY(22%) scale(0.74)' }],
          ]);
          $$('.lock4 .i').forEach((el, k) =>
            track(el, T, [
              [0, { transform: 'translateY(110%)' }],
              [1180 + k * 110, { transform: 'translateY(110%)' }, EXPO],
              [2000 + k * 110, { transform: 'none' }],
              [2500 + k * 40, { transform: 'none' }, MOVE],
              [Math.min(T, 2980 + k * 30), { transform: 'translateY(110%)' }],
            ]),
          );
        }

        if (v === 5) {
          // a big faint B turns slowly behind; the name and role rise in front
          const T = 2900;
          mountMark(canvas, (ms) => {
            const t = ms / 1000;
            const k = quartOut(ms / 1600);
            return { rx: Math.sin(t * 0.7) * 0.06, ry: (1 - k) * -1.2 + Math.sin(t * 0.6) * 0.25 + inOut((ms - 2200) / 700) * 0.8 };
          }, { z: 7.4 });
          track(markEl, T, [
            [0, { opacity: 0, transform: 'scale(0.94)' }, OUT],
            [1100, { opacity: 0.09, transform: 'none' }],
            [2200, { opacity: 0.09, transform: 'none' }, MOVE],
            [T, { opacity: 0, transform: 'scale(1.04)' }],
          ]);
          $$('.lock5 .i').forEach((el, k) =>
            track(el, T, [
              [0, { transform: 'translateY(110%)' }],
              [350 + k * 120, { transform: 'translateY(110%)' }, EXPO],
              [1200 + k * 120, { transform: 'none' }],
              [2200 + k * 40, { transform: 'none' }, MOVE],
              [Math.min(T, 2720 + k * 40), { transform: 'translateY(110%)' }],
            ]),
          );
        }
      };
      // start once the font is in, so every measurement is the real one
      Promise.race([document.fonts.ready, new Promise((r) => setTimeout(r, 800))]).then(() => requestAnimationFrame(run));
    </script>
  </body>
</html>
