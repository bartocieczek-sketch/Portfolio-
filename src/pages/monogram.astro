---
// Draft: simpler, sharper monogram ideas joining B and O (not linked anywhere)
import Base from '../layouts/Base.astro';
export const prerender = true;
const blackletter = [
  { n: "Stem + blackletter O", d: "The B stem with its flag and wedge foot, beside a blackletter O (hairline left, heavy crescent right); two hairlines tie B and O, like your reference.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 17 C11 9 19 7 27 11 L37 4 L37 85 L45 92 L31 100 L25 94 L14 99 L21 88 L22 23 C16 19 11 19 6 17 Z\" fill=\"currentColor\"/><path d=\"M49 7 L51 6 L51 93 L49 94 Z\" fill=\"currentColor\"/><path d=\"M52 7 C80 21 97 42 91 63 C87 77 77 87 61 95 C73 81 79 67 77 52 C75 36 66 21 52 7 Z\" fill=\"currentColor\"/><path d=\"M45 88 L61 95 L51 99 Z\" fill=\"currentColor\"/><path d=\"M37 49 L78 31 L78.6 34 L37 52.5 Z\" fill=\"currentColor\"/><path d=\"M37 62 L79 45 L79.4 48 L37 65.5 Z\" fill=\"currentColor\"/></svg>" },
  { n: "Blackletter B", d: "One glyph: a blackletter B whose bowls swell like an O, a hairline at the waist.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 17 C11 9 19 7 27 11 L37 4 L37 85 L45 92 L31 100 L25 94 L14 99 L21 88 L22 23 C16 19 11 19 6 17 Z\" fill=\"currentColor\"/><path d=\"M38 6 C62 12 80 22 82 36 C83 44 76 49 66 51 C80 54 90 64 88 76 C86 87 72 95 50 99 C64 90 72 82 72 74 C72 63 62 56 46 54 L46 49 C60 46 68 40 68 33 C68 23 56 14 38 6 Z\" fill=\"currentColor\"/><path d=\"M37 50 L58 50 L58 53 L37 53 Z\" fill=\"currentColor\"/></svg>" },
  { n: "Ligature BO", d: "B stem + a pointed blackletter O as a ligature, one hairline cutting through both.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 17 C11 9 19 7 27 11 L37 4 L37 85 L45 92 L31 100 L25 94 L14 99 L21 88 L22 23 C16 19 11 19 6 17 Z\" fill=\"currentColor\"/><path d=\"M37 6 L55 18 L55 21 L37 12 Z\" fill=\"currentColor\"/><path d=\"M62 10 C84 18 96 36 94 56 C92 76 80 90 64 96 C72 84 78 70 78 54 C78 38 72 22 62 10 Z\" fill=\"currentColor\"/><path d=\"M62 10 C54 20 48 34 48 54 C48 72 54 86 64 96 C50 88 40 74 40 56 C40 36 48 20 62 10 Z\" fill=\"currentColor\"/><path d=\"M30 58 L92 30 L92.6 33 L30 61 Z\" fill=\"currentColor\"/></svg>" },
];
const marks = [
  { n: "Stem + O", d: "A slanted stem fused to a perfect ring: the shortest way to say B and O.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.00 12.00 L26.00 4.00 L26.00 96.00 L10.00 88.00Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M24 50a36 36 0 1 0 72 0a36 36 0 1 0 -72 0Z M39 50a21 21 0 1 1 42 0a21 21 0 1 1 -42 0Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Lower bowl O", d: "A classic B whose lower bowl is a full O.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.00 4.00 L24.00 4.00 L24.00 96.00 L10.00 96.00Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M24 4 H40 A20 20 0 0 1 40 44 H24 V32 H40 A8 8 0 0 0 40 16 H24 Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M22 68a28 28 0 1 0 56 0a28 28 0 1 0 -56 0Z M36 68a14 14 0 1 1 28 0a14 14 0 1 1 -28 0Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Octagon", d: "The same idea cut sharp: chamfered bowl, octagonal O.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M10.00 4.00 L24.00 4.00 L24.00 96.00 L10.00 96.00Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M24.00 4.00 L54.00 4.00 L66.00 16.00 L66.00 30.00 L56.00 40.00 L24.00 40.00 L24.00 28.00 L50.00 28.00 L54.00 24.00 L54.00 18.00 L50.00 16.00 L24.00 16.00Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M78.79 79.10 L63.10 94.79 L40.90 94.79 L25.21 79.10 L25.21 56.90 L40.90 41.21 L63.10 41.21 L78.79 56.90Z M65.86 73.74 L57.74 81.86 L46.26 81.86 L38.14 73.74 L38.14 62.26 L46.26 54.14 L57.74 54.14 L65.86 62.26Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Cut ring", d: "An O with a stem through its side and a waist bar, so the ring reads as B too.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M16 50a40 40 0 1 0 80 0a40 40 0 1 0 -80 0Z M30 50a26 26 0 1 1 52 0a26 26 0 1 1 -52 0Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M18.00 10.00 L32.00 0.00 L32.00 100.00 L18.00 90.00Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/><path d=\"M32 46 H82 V54 H32 Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Badge", d: "A solid O with the B cut out of it, works as a stamp or avatar.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 50a46 46 0 1 0 92 0a46 46 0 1 0 -92 0Z M30 20 V80 H54 A16 16 0 0 0 58 50 A14 14 0 0 0 54 20 Z M40 30 H52 A6 6 0 0 1 52 42 H40 Z M40 56 H54 A7 7 0 0 1 54 70 H40 Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Square", d: "A sharp square O with B counters and a notch at the waist.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M8 8 H92 V44 L84 50 L92 56 V92 H8 Z M34 22 H74 V43 H34 Z M34 57 H74 V78 H34 Z\" fill=\"currentColor\" fill-rule=\"evenodd\"/></svg>" },
  { n: "Monoline", d: "One even stroke: B on top, a full O at the bottom.", svg: "<svg viewBox=\"0 0 100 100\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M20 6 V94 M20 6 H42 A16 16 0 0 1 42 38 H20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\" stroke-linejoin=\"miter\" stroke-linecap=\"square\"/><circle cx=\"49\" cy=\"66\" r=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"10\"/></svg>" }
];
---

<Base title="Monogram ideas" description="Draft monogram ideas">
  <main class="mg">
    <h1>B + O, simpler and sharper</h1>
    <h2>In the style of your reference</h2>
    <ol>
      {blackletter.map((m, i) => (
        <li>
          <div class="mg__big mg__light" set:html={m.svg} />
          <div class="mg__big mg__dark" set:html={m.svg} />
          <div class="mg__sizes">
            <span class="s48" set:html={m.svg} />
            <span class="s28" set:html={m.svg} />
            <span class="s18" set:html={m.svg} />
          </div>
          <p><b>{String.fromCharCode(65 + i)} {m.n}</b> {m.d}</p>
        </li>
      ))}
    </ol>
    <h2>Geometric</h2>
    <ol>
      {marks.map((m, i) => (
        <li>
          <div class="mg__big mg__light" set:html={m.svg} />
          <div class="mg__big mg__dark" set:html={m.svg} />
          <div class="mg__sizes">
            <span class="s48" set:html={m.svg} />
            <span class="s28" set:html={m.svg} />
            <span class="s18" set:html={m.svg} />
          </div>
          <p><b>{String(i + 1).padStart(2, '0')} {m.n}</b> {m.d}</p>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .mg { padding: 120px 24px 80px; background: #f0f0ee; color: #0a0a0a; min-height: 100vh; font: 500 15px/1.4 var(--font-head); }
  h2 { margin: 56px 0 20px; font-size: 20px; letter-spacing: -0.02em; }
  h1 { margin: 0 0 16px; font-size: clamp(32px, 4vw, 56px); letter-spacing: -0.04em; }
  ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .mg__big { aspect-ratio: 1; display: grid; place-items: center; border-radius: 20px; }
  .mg__big :global(svg) { width: 56%; height: 56%; }
  .mg__light { background: #f1f1f1; color: #2a2a2a; }
  .mg__dark { background: #0a0a0a; color: #f0f0ee; }
  .mg__sizes { grid-column: 1 / -1; display: flex; align-items: center; gap: 20px; padding: 12px 16px; border-radius: 14px; background: #fff; }
  .mg__sizes span { display: block; }
  .mg__sizes :global(svg) { display: block; width: 100%; height: 100%; }
  .s48 { width: 48px; height: 48px; }
  .s28 { width: 28px; height: 28px; }
  .s18 { width: 18px; height: 18px; }
  p { grid-column: 1 / -1; margin: 4px 0 0; color: #6e6e6e; }
  p b { color: #0a0a0a; font-weight: 500; }
</style>
