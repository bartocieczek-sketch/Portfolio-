---

<Base title="Monogram" description="Monogram drafts">
  <main class="mg">
    <h1>Bart Ocieczek, monogram</h1>
    <p class="mg__lede">Built from real blackletter type and joined the way scribes and punchcutters joined letters, rather than drawn from scratch. Each mark is a single clean outline.</p>
    <ol>
      {marks.map((m) => (
        <li>
          <div class="mg__big mg__light" set:html={m.svg} />
          <div class="mg__big mg__dark" set:html={m.svg} />
          <div class="mg__sizes">
            <span class="s64" set:html={m.svg} />
            <span class="s32" set:html={m.svg} />
            <span class="s20" set:html={m.svg} />
            <span class="s16" set:html={m.svg} />
          </div>
          <div class="mg__txt">
            <p class="mg__n">{m.k} {m.n}</p>
            <p class="mg__f">{m.f}</p>
            <p>{m.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </main>
</Base>

<style>
  .mg { padding: 120px 24px 80px; background: #f0f0ee; color: #0a0a0a; min-height: 100vh; font: 500 15px/1.45 var(--font-head); }
  h1 { margin: 0 0 12px; font-size: clamp(32px, 4vw, 56px); letter-spacing: -0.04em; }
  .mg__lede { max-width: 640px; margin: 0 0 48px; color: #6e6e6e; }
  ol { display: grid; gap: 56px; margin: 0; padding: 0; list-style: none; }
  li { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(240px, 0.9fr); gap: 10px; align-items: start; }
  .mg__big { aspect-ratio: 1; display: grid; place-items: center; border-radius: 24px; }
  .mg__big :global(svg) { width: 62%; height: 62%; }
  .mg__light { background: #fff; color: #141414; }
  .mg__dark { background: #0a0a0a; color: #f0f0ee; }
  .mg__sizes { grid-column: 1 / 3; display: flex; align-items: center; gap: 28px; padding: 16px 20px; border-radius: 16px; background: #fff; color: #141414; }
  .mg__sizes span { display: block; }
  .mg__sizes :global(svg) { display: block; width: 100%; height: 100%; }
  .s64 { width: 64px; height: 64px; } .s32 { width: 32px; height: 32px; } .s20 { width: 20px; height: 20px; } .s16 { width: 16px; height: 16px; }
  .mg__txt { grid-column: 3; grid-row: 1 / 3; padding: 4px 8px; }
  .mg__txt p { margin: 0 0 10px; color: #5a5a5a; }
  .mg__txt .mg__n { color: #0a0a0a; font-size: 22px; letter-spacing: -0.03em; margin-bottom: 2px; }
  .mg__txt .mg__f { font-size: 13px; color: #8a8a8a; margin-bottom: 14px; }
  @media (max-width: 809px) { li { grid-template-columns: 1fr 1fr; } .mg__txt { grid-column: 1 / -1; grid-row: auto; } }
</style>
