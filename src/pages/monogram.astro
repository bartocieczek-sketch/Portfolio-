  { k: "03", n: "BO, broken textura", f: "Textura, UnifrakturCook Bold", d: "Heavier and more graphic: two broken capitals locked together through the O\u2019s left stroke. Strong as a stamp or favicon, the most \u201csharp\u201d of the three.", svg: "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"22 -1960 2372 2372\"><path transform=\"scale(1 -1)\" d=\"M184.0 1170.0Q284.0 1087.0 282.0 965.0L276.0 474.0L22.0 289.0Q393.0 267.0 681.0 12.0Q926.7572631835938 122.09925079345703 1090.6165771484375 241.62026977539062Q1264.9744873046875 30.0 1640.0 30.0Q1731.0 30.0 1860.0 92.5Q1989.0 155.0 2107.0 278.5Q2225.0 402.0 2308.5 585.5Q2392.0 769.0 2394.0 1009.0Q2061.0 1209.0 1917.0 1502.0Q1870.0 1461.0 1822.0 1411.5Q1774.0 1362.0 1726.0 1315.0Q1727.0 1406.0 1736.0 1535.0Q1427.0 1489.0 1211.0 1327.0Q1208.9122314453125 1325.4342041015625 1206.820068359375 1323.8544921875Q997.0186157226562 1462.72802734375 807.0 1535.0ZM1725.0 1187.0Q1950.0 1015.0 2033.0 858.0Q2116.0 701.0 2116.0 582.0Q2116.0 423.0 1996.0 323.0Q1894.0 237.0 1736.0 232.0Q1726.0 231.0 1715.0 231.0Q1605.0 231.0 1507.0 290.0Q1584.0 435.0 1835.0 495.0Q1729.0 730.0 1725.0 1187.0ZM909.0 232.0Q788.0 353.0 496.0 499.0L597.0 561.0L599.0 829.0Q672.0 870.0 730.5 870.0Q789.0 870.0 832.0 857.0Q839.1224365234375 854.7476196289062 846.0341796875 852.3023071289062Q893.7034301757812 575.80322265625 1016.2045288085938 355.50579833984375Q977.0908813476562 291.57952880859375 909.0 232.0ZM1417.0 359.0Q1363.3388671875 409.3073425292969 1323.191162109375 470.08148193359375Q1219.6898193359375 626.7581787109375 1206.0 853.0Q1204.0 877.0 1204.0 900.0Q1204.0 939.4069213867188 1208.4525146484375 975.798095703125Q1235.2978515625 1195.2095947265625 1424.0 1305.0Q1446.0 1147.0 1448.0 986.0Q1450.0 825.0 1452.5 737.5Q1455.0 650.0 1455.0 634.0Q1455.0 465.0 1417.0 359.0ZM911.0 1137.0 600.0 926.0 602.0 1290.0Q771.0 1241.0 911.0 1137.0Z\" fill=\"currentColor\" fill-rule=\"nonzero\"/></svg>" }
