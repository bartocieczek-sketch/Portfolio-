---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { HOME_QUERY, SETTINGS_QUERY } from '../lib/sanity';
import { load } from '../lib/load';

const [home, settings] = await Promise.all([load(Astro.locals, HOME_QUERY), load(Astro.locals, SETTINGS_QUERY)]);
if (!home || !settings) return new Response('Content not found', { status: 500 });

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects: any[] = (home.projects ?? []).filter(Boolean);
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const brands: any[] = home.brands ?? [];
---

<Base title={settings.seoTitle} description={settings.seoDescription} image={projects[0]?.cover}>
  <main class="home">
    <Hero home={home} settings={settings} />

    <div class="home__wrapper">
      {brands.length > 0 && (
        <section class="brands" aria-label={home.brandsLabel ?? 'Brands'}>
          <p class="t-label-small muted">{home.brandsLabel}</p>
          <div class="brands__ticker">
            <div class="brands__track">
              {[0, 1].map((copy) => (
                <div class="brands__set" aria-hidden={copy === 1 ? 'true' : undefined}>
                  {brands.map((b) => (
                    <>
                      <span class="brands__item">
                        {b.logo?.asset ? <img src={b.logo.asset.url} alt={copy === 0 ? b.name : ''} loading="lazy" /> : <span class="t-label">{b.name}</span>}
                      </span>
                      <span class="brands__divider" />
                    </>
                  ))}
                </div>
              ))}
            </div>
          </div>
        </section>
      )}



      <Footer settings={settings} ctaText={home.ctaText} />
    </div>
  </main>
</Base>

<style>
  .home__wrapper {
    position: relative;
    z-index: 2;
    background: var(--surface-dark);
    display: flex;
    flex-direction: column;
    gap: 120px;
  }
  .brands {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 96px var(--gutter) 0;
  }
  .brands__ticker {
    width: min(720px, 100%);
  }
  .brands__ticker {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 15%, #000 85%, transparent);
  }
  .brands__track {
    display: flex;
    width: max-content;
    animation: ticker 30s linear infinite;
  }
  .brands__set {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-right: 32px;
    height: 45px;
  }
  .brands__item {
    display: flex;
    align-items: center;
    height: 100%;
  }
  .brands__item img {
    height: 30px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    opacity: 0.7;
  }
  .brands__divider {
    width: 1px;
    align-self: stretch;
    background: var(--line);
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brands__track {
      animation: none;
    }
  }
  @media (max-width: 809px) {
    .home__wrapper {
      gap: 64px;
    }
    .brands {
      padding-top: 64px;
    }
  }
</style>
