---
import '../styles/fonts.css';
import '../styles/global.css';
import { urlFor } from '../lib/sanity';
import { stegaClean } from '@sanity/client/stega';
import { VisualEditing } from '@sanity/astro/visual-editing';

interface Props {
  title?: string;
  description?: string;
  image?: unknown;
}
const { image } = Astro.props;
const title = stegaClean(Astro.props.title);
const description = stegaClean(Astro.props.description);
const preview = Astro.locals.preview;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? urlFor(image).width(1200).height(630).fit('crop').url() : undefined;
---

<!doctype html>
<html lang="en" data-preview={preview ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#181818" />
    {preview && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Page transitions: tell the CSS whether we're going back or forward
      // so the slide runs in the matching direction.
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var a = window.navigation && navigation.activation;
        var back = a && a.navigationType === 'traverse' && a.from && a.entry && a.entry.index < a.from.index;
        e.viewTransition.types.add(back ? 'back' : 'forward');

        // Coming from a click on a home carousel card: the thumbnail morphs
        // into this page's cover instead of the page sliding up.
        var fromCard = null;
        try {
          fromCard = sessionStorage.getItem('vt-card');
          sessionStorage.removeItem('vt-card');
        } catch (err) {}
        if (fromCard === 'gl' && !back) {
          // the cover already flew into place on the previous page: swap at once
          e.viewTransition.types.add('card-gl');
        } else if (fromCard && !back) {
          var cover = document.querySelector('[data-vt-cover]');
          if (cover) {
            e.viewTransition.types.add('card');
            cover.style.viewTransitionName = 'project-cover';
            e.viewTransition.finished.finally(function () {
              cover.style.viewTransitionName = '';
            });
          }
        }
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Chivo+Mono:wght@500&family=Inter:wght@400;500;600&family=Inter+Tight:wght@700&display=swap"
    />
  </head>
  <body>
    <slot />
    {preview && <VisualEditing enabled zIndex={1000} />}

    <script>
      import Lenis from 'lenis';
      // build must run before motion: it claims blocks in [data-build] sections first
      import '../scripts/build';
      import '../scripts/motion';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Smooth scroll (Framer "SmoothScroll", intensity 8)
      if (!reduceMotion) {
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        (window as unknown as { lenis: Lenis }).lenis = lenis;
        // Home page intro locks scrolling until it finishes
        if (document.documentElement.classList.contains('is-scroll-locked')) {
          lenis.stop();
          document.addEventListener('intro:done', () => lenis.start(), { once: true });
        }
        const raf = (t: number) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Fade-up elements as they enter the viewport
      const revealIo = new IntersectionObserver(
        (entries) => {
          // Elements that enter in the same frame get a short stagger
          let n = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.setProperty('--reveal-delay', `${Math.min(n++, 5) * 60}ms`);
            el.classList.add('is-in');
            revealIo.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealIo.observe(el));

      // Lazy-load and auto-play videos only while they are on screen
      const videoIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (v.dataset.src) {
                v.src = v.dataset.src;
                delete v.dataset.src;
              }
              v.play().catch(() => {});
            } else if (!v.paused) {
              v.pause();
            }
          }
        },
        { rootMargin: '300px 0px' },
      );
      document.querySelectorAll('video[data-autoplay]').forEach((v) => videoIo.observe(v));

      // Lottie animations, loaded on demand
      const lottieEls = document.querySelectorAll<HTMLElement>('[data-lottie]');
      if (lottieEls.length) {
        const lottieIo = new IntersectionObserver(
          async (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              lottieIo.unobserve(e.target);
              const el = e.target as HTMLElement;
              const { default: lottie } = await import('lottie-web/build/player/lottie_light');
              lottie.loadAnimation({
                container: el,
                renderer: 'svg',
                loop: true,
                autoplay: !reduceMotion,
                path: el.dataset.lottie,
                rendererSettings: { preserveAspectRatio: 'xMidYMid slice' },
              });
            }
          },
          { rootMargin: '400px 0px' },
        );
        lottieEls.forEach((el) => lottieIo.observe(el));
      }
    </script>
  </body>
</html>
