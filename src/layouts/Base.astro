---
// The fallback face is served by the site itself (no third-party font
// request that Safari's privacy settings or a blocker could stop)
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-700.css';
import '../styles/fonts.css';
import '../styles/global.css';
import { urlFor } from '../lib/sanity';
import { stegaClean } from '@sanity/client/stega';
import { VisualEditing } from '@sanity/astro/visual-editing';

interface Props {
  title?: string;
  description?: string;
  image?: unknown;
}
const { image } = Astro.props;
const title = stegaClean(Astro.props.title);
const description = stegaClean(Astro.props.description);
const preview = Astro.locals.preview;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? urlFor(image).width(1200).height(630).fit('crop').url() : undefined;
---

<!doctype html>
<html lang="en" data-preview={preview ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    {preview && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Page transitions: tell the CSS whether we're going back or forward
      // so the slide runs in the matching direction.
      // The cover flight between a home pill and a case study frame of another
      // shape. Both pictures inside the flying box are sized so the photo is
      // shown at the same scale in each, centred, at every moment: the frame's
      // (wider, shorter) picture lies over the middle of the pill's, and they
      // grow or shrink together, so the photo scales evenly with no jump.
      // pill / frame: {w, h} of each box; forward: pill → frame.
      // focus (optional): {x, y} 0..1, where in the photo the frame's crop is
      // centred (the cover's focal point); both pictures shift so the photo
      // stays continuous while the crop moves off-centre.
      window.__vtSizes = function (pill, frame, forward, focus) {
        var ar = 0.8; // the cover photo is cropped 4:5 everywhere
        var dp = Math.max(pill.w, pill.h * ar); // photo width shown in the pill
        var df = Math.max(frame.w, frame.h * ar); // ... and in the frame
        var k = df / dp;
        var pillFrom = [pill.w, pill.h], pillTo = [pill.w * k, pill.h * k];
        var frameFrom = [frame.w / k, frame.h / k], frameTo = [frame.w, frame.h];
        // old = what leaves, new = what arrives
        var o = forward ? [pillFrom, pillTo] : [frameTo, frameFrom];
        var n = forward ? [frameFrom, frameTo] : [pillTo, pillFrom];
        // how far the frame's crop sits from the photo's centre, at frame size
        var fx = focus && focus.x != null ? focus.x : 0.5;
        var fy = focus && focus.y != null ? focus.y : 0.5;
        var ox = (df - frame.w) * (fx - 0.5);
        var oy = (df / ar - frame.h) * (fy - 0.5);
        var photoT = [[0, 0], [-ox, -oy]]; // pill → frame: photo slides so the crop is centred
        var bandT = [[ox / k, oy / k], [0, 0]]; // the frame's crop starts where it lies in the photo
        var ot = forward ? photoT : [bandT[1], bandT[0]];
        var nt = forward ? bandT : [photoT[1], photoT[0]];
        var st = document.documentElement.style;
        st.setProperty('--vo-t0', ot[0][0] + 'px ' + ot[0][1] + 'px');
        st.setProperty('--vo-t1', ot[1][0] + 'px ' + ot[1][1] + 'px');
        st.setProperty('--vn-t0', nt[0][0] + 'px ' + nt[0][1] + 'px');
        st.setProperty('--vn-t1', nt[1][0] + 'px ' + nt[1][1] + 'px');
        // each picture keeps one layout size (its larger one, so it stays
        // sharp) and only its scale animates: compositor-only, so the flight
        // stays smooth even while the arriving page is still busy loading
        var set = function (pre, pair) {
          var bw = Math.max(pair[0][0], pair[1][0]);
          var bh = Math.max(pair[0][1], pair[1][1]);
          st.setProperty(pre + '-w', bw + 'px');
          st.setProperty(pre + '-h', bh + 'px');
          st.setProperty(pre + '-s0', String(pair[0][0] / bw));
          st.setProperty(pre + '-s1', String(pair[1][0] / bw));
        };
        set('--vo', o);
        set('--vn', n);
      };
      // The flight as pure transform + clip, when both ends have the photo's
      // own shape (desktop: the case cover is 4:5, like the flying picture):
      // the box keeps its final size and only moves and scales, which the
      // compositor runs on its own — no stalls while the new page is busy.
      // from/to: {x, y, w, h} in viewport px; clips: {x, y, r} insets/radius
      // in each end's own px. Returns false when the shapes differ.
      window.__vtFlight = function (from, to, clipFrom, clipTo) {
        if (Math.abs(from.w / from.h - to.w / to.h) > 0.01) return false;
        // the group's own size is the landing element's layout size (to.nw
        // when it is drawn scaled, e.g. the enlarged middle cover on home)
        var nw = to.nw || to.w;
        var s = from.w / nw; // start scale against that size
        var s1 = to.w / nw;
        var st = document.documentElement.style;
        st.setProperty('--vt-g0', 'translate(' + from.x + 'px, ' + from.y + 'px) scale(' + s + ')');
        st.setProperty('--vt-g1', 'translate(' + to.x + 'px, ' + to.y + 'px)' + (s1 !== 1 ? ' scale(' + s1 + ')' : ''));
        // clip insets live in the final box's px; at the start they are seen
        // through the start scale, so divide by it
        st.setProperty('--vt-c0', 'inset(' + clipFrom.y / s + 'px ' + clipFrom.x / s + 'px round ' + clipFrom.r / s + 'px)');
        st.setProperty('--vt-c1', 'inset(' + clipTo.y / s1 + 'px ' + clipTo.x / s1 + 'px round ' + clipTo.r / s1 + 'px)');
        document.documentElement.classList.add('vt-uniform');
        window.__vtFP = {
          fx: from.x, fy: from.y, s: s, tx: to.x, ty: to.y, s1: s1, nw: nw, nh: nw * (to.h / to.w),
          c0: { x: clipFrom.x / s, y: clipFrom.y / s, r: clipFrom.r / s },
          c1: { x: clipTo.x / s1, y: clipTo.y / s1, r: clipTo.r / s1 },
        };
        return true;
      };
      // Like osply's: on its way the picture tilts a little in perspective,
      // leaning into its travel (strongest while it moves fastest, flat again
      // as it lands). The same flight as the CSS one (same curve, length and
      // clip), sampled into keyframes so the tilt can ride along; it takes
      // over from the CSS animation in its first frame.
      var bez = function (x1, y1, x2, y2) {
        return function (t) {
          var lo = 0, hi = 1, u = t;
          for (var i = 0; i < 24; i++) {
            u = (lo + hi) / 2;
            var x = 3 * (1 - u) * (1 - u) * u * x1 + 3 * (1 - u) * u * u * x2 + u * u * u;
            if (x < t) lo = u; else hi = u;
          }
          return 3 * (1 - u) * (1 - u) * u * y1 + 3 * (1 - u) * u * u * y2 + u * u * u;
        };
      };
      var flightEase = bez(0.2, 0, 0, 1);
      var tiltFly = function () {
        var P = window.__vtFP;
        if (!P || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var pe = '::view-transition-group(project-cover)';
        var css = document.getAnimations().filter(function (a) {
          return a.effect && a.effect.pseudoElement === pe;
        })[0];
        var N = 40, kf = [], es = [];
        for (var i = 0; i <= N; i++) es.push(flightEase(i / N));
        var vmax = 0, vs = [];
        for (var j = 0; j <= N; j++) {
          var v = (es[Math.min(N, j + 1)] - es[Math.max(0, j - 1)]) / ((Math.min(N, j + 1) - Math.max(0, j - 1)) / N);
          vs.push(v);
          if (v > vmax) vmax = v;
        }
        // which way it travels decides the lean
        var dx = P.tx + (P.nw * P.s1) / 2 - (P.fx + (P.nw * P.s) / 2);
        var dy = P.ty + (P.nh * P.s1) / 2 - (P.fy + (P.nh * P.s) / 2);
        var clampDeg = function (d) { return Math.max(-11, Math.min(11, d)); };
        var ry = clampDeg((dx / window.innerWidth) * 26);
        var rx = clampDeg((-dy / window.innerHeight) * 26);
        var persp = Math.max(P.nw, P.nh) * 2.4;
        var L = function (a, b, e) { return a + (b - a) * e; };
        for (var k = 0; k <= N; k++) {
          var e = es[k], env = vmax ? vs[k] / vmax : 0;
          // ease the lean out completely at both ends
          env *= Math.sin(Math.PI * Math.min(1, k / N));
          var x = L(P.fx, P.tx, e), y = L(P.fy, P.ty, e), sc = L(P.s, P.s1, e);
          kf.push({
            offset: k / N,
            transform:
              'translate(' + x + 'px,' + y + 'px) scale(' + sc + ') translate(' + P.nw / 2 + 'px,' + P.nh / 2 + 'px) perspective(' + persp + 'px) rotateX(' +
              (rx * env).toFixed(3) + 'deg) rotateY(' + (ry * env).toFixed(3) + 'deg) translate(' + -P.nw / 2 + 'px,' + -P.nh / 2 + 'px)',
            // the corners (and the pill's side insets) change evenly as seen
            // on screen: interpolate in screen px, then express them in the
            // box's own px at this moment's scale (interpolating in the box's
            // px made the rounding trail behind the growing picture)
            clipPath:
              'inset(' + L(P.c0.y * P.s, P.c1.y * P.s1, e) / sc + 'px ' + L(P.c0.x * P.s, P.c1.x * P.s1, e) / sc + 'px round ' +
              L(P.c0.r * P.s, P.c1.r * P.s1, e) / sc + 'px)',
          });
        }
        // going home is a touch quicker than opening a project
        var back = document.documentElement.classList.contains('is-cover-back');
        var a = document.documentElement.animate(kf, { duration: back ? 680 : 850, easing: 'linear', fill: 'both', pseudoElement: pe });
        if (css) {
          a.currentTime = css.currentTime || 0;
          css.cancel();
        }

      };
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        var vt = e.viewTransition;
        vt.ready.then(function () {
          if (document.documentElement.classList.contains('vt-uniform')) tiltFly();
          window.__vtFP = null;
        }).catch(function () {});
        e.viewTransition.finished.finally(function () {
          document.documentElement.classList.remove('vt-uniform');
        });
      });
      // The home pill's picture as the flying element: widened (inside its
      // pill, which still crops it the same) to the whole 4:5 photo, so the
      // flight always has the full photo to show at every size; corners are
      // drawn by the transition's clip (--vt-pill-clip, --vt-pill-r).
      // Returns the picture's box, or clears it with on = false.
      window.__pillCover = function (p, on, zoom) {
        var img = p && p.querySelector('img');
        if (!img) return null;
        var st = img.style;
        if (!on) {
          st.position = st.left = st.top = st.width = st.height = st.maxWidth = st.transform = st.transition = st.viewTransitionName = '';
          return null;
        }
        // a hover zoom on the picture becomes part of its size here (a
        // transform would scale the whole flying box instead and jump)
        if (!zoom) {
          var m = getComputedStyle(img).transform;
          zoom = m && m !== 'none' ? parseFloat(m.split('(')[1]) || 1 : 1;
        }
        var w = p.offsetWidth, h = p.offsetHeight;
        // the whole 4:5 photo, just covering the cover's box (a square one
        // shows its full width)
        var W = Math.max(w, h * 0.8) * zoom, H = W / 0.8;
        var rad = Math.min(parseFloat(getComputedStyle(p).borderTopLeftRadius) || 0, w / 2);
        st.transition = 'none';
        st.transform = 'none';
        st.position = 'absolute';
        st.top = (h - H) / 2 + 'px';
        st.left = (w - W) / 2 + 'px';
        st.width = W + 'px';
        st.height = H + 'px';
        st.maxWidth = 'none';
        st.viewTransitionName = 'project-cover';
        var r = document.documentElement.style;
        r.setProperty('--vt-pill-r', rad + 'px');
        r.setProperty('--vt-pill-clip', (W - w) / 2 + 'px');
        r.setProperty('--vt-pill-clip-y', (H - h) / 2 + 'px');
        // the pill may be drawn scaled (the middle cover on home is a little
        // larger): everything handed to the flight is in on-screen px
        var k = p.getBoundingClientRect().width / w || 1;
        if (k !== 1) {
          r.setProperty('--vt-pill-r', rad * k + 'px');
          r.setProperty('--vt-pill-clip', ((W - w) / 2) * k + 'px');
          r.setProperty('--vt-pill-clip-y', ((H - h) / 2) * k + 'px');
        }
        var b = img.getBoundingClientRect();
        return { w: W * k, h: H * k, nw: W, cx: ((W - w) / 2) * k, cy: ((H - h) / 2) * k, r: rad * k, x: b.left, y: b.top };
      };
      window.addEventListener('pagereveal', function (e) {
        if (!e.viewTransition) return;
        try {
          // back home from a case study: a picture from the project flies into
          // its cover in the column (set up by the home hero, see Hero.astro)
          if (document.documentElement.classList.contains('is-cover-back')) {
            e.viewTransition.types.add('cover-back');
            e.viewTransition.finished.finally(function () {
              document.dispatchEvent(new CustomEvent('cover-back:done'));
            });
            return;
          }
          // leaving About: the dark page folds shut into a line across the
          // middle, over the page coming back
          var act = window.navigation && navigation.activation;
          var fromUrl = (act && act.from && act.from.url) || document.referrer || '';
          var fromAbout = false;
          try { fromAbout = new URL(fromUrl).pathname.indexOf('/about-me') === 0; } catch (err2) {}
          if (fromAbout && !document.querySelector('main.about')) {
            e.viewTransition.types.add('about-out');
            return;
          }
          // opening About: it opens out of a line across the middle
          if (document.querySelector('main.about') && !fromAbout) {
            e.viewTransition.types.add('about-in');
            return;
          }
          // any other way back to the home column: a calm dissolve, never a slide
          if (document.querySelector('[data-vh]')) {
            e.viewTransition.types.add('home');
            return;
          }
        } catch (err) {}
        try {
          // set by the home hero before first paint when a cover is flying back
          if (document.documentElement.classList.contains('is-returning')) {
            e.viewTransition.types.add('card-back');
            return;
          }
        } catch (err) {}
        var a = window.navigation && navigation.activation;
        var back = a && a.navigationType === 'traverse' && a.from && a.entry && a.entry.index < a.from.index;
        e.viewTransition.types.add(back ? 'back' : 'forward');

        // Coming from a click on a home carousel card: the thumbnail morphs
        // into this page's cover instead of the page sliding up.
        var fromCard = null;
        try {
          fromCard = sessionStorage.getItem('vt-card');
          sessionStorage.removeItem('vt-card');
        } catch (err) {}
        if (fromCard === 'gl' && !back) {
          // the cover already flew into place on the previous page: swap at once
          e.viewTransition.types.add('card-gl');
        } else if (fromCard && !back) {
          var cover = document.querySelector('[data-vt-cover]');
          if (cover) {
            e.viewTransition.types.add('card');
            cover.style.viewTransitionName = 'project-cover';
            try {
              var pr = JSON.parse(sessionStorage.getItem('vt-pill-shape') || 'null');
              if (pr) {
                document.documentElement.style.setProperty('--vt-pill-r', pr.r + 'px');
                document.documentElement.style.setProperty('--vt-pill-clip', pr.clip + 'px');
                document.documentElement.style.setProperty('--vt-pill-clip-y', (pr.clipY || 0) + 'px');
              }
            } catch (err) {}
            try {
              var pill = JSON.parse(sessionStorage.getItem('vt-pill') || 'null');
              var f = cover.getBoundingClientRect();
              var focus = { x: parseFloat(cover.dataset.focusX || '0.5'), y: parseFloat(cover.dataset.focusY || '0.5') };
              if (pill) {
                var fr = Math.min(parseFloat(getComputedStyle(cover).borderTopLeftRadius) || 20, f.width / 2, f.height / 2);
                var uniform =
                  pill.x != null &&
                  window.__vtFlight(
                    { x: pill.x, y: pill.y, w: pill.w, h: pill.h },
                    { x: f.left, y: f.top, w: f.width, h: f.height },
                    { x: pill.cx || 0, y: pill.cy || 0, r: pill.r != null ? pill.r : pill.w / 2 },
                    { x: 0, y: 0, r: fr },
                  );
                if (!uniform) window.__vtSizes(pill, { w: f.width, h: f.height }, true, focus);
              }
            } catch (err) {}
            // the rest of the case study comes in while the cover is still
            // flying (a third of the way), so it all arrives together
            document.documentElement.classList.add('from-card');
            e.viewTransition.ready.then(function () {
              setTimeout(function () {
                document.documentElement.classList.add('case-in');
              }, 450);
            });
            e.viewTransition.finished.finally(function () {
              cover.style.viewTransitionName = '';
              // the cover is in place: now the rest of the pictures come in
              document.documentElement.classList.add('cover-landed');
              setTimeout(function () {
                document.documentElement.classList.remove('from-card', 'cover-landed', 'case-in');
              }, 1600);
            });
          }
        }
      });
    </script>
    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
  </head>
  <body>
    <slot />
    {preview && <VisualEditing enabled zIndex={1000} />}

    <script>
      import Lenis from 'lenis';
      // build must run before motion: it claims blocks in [data-build] sections first
      import '../scripts/motion';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // While a cover is flying (into a case study, until it has landed; or
      // back home, until the home column has it again) the page doesn't
      // scroll: wheel, touch and scroll keys are swallowed before anything
      // else (smooth scroll, the home column) sees them.
      {
        const html = document.documentElement;
        // (a safety cap from when the page was shown: prerendered and
        // back/forward-cached pages are shown long after this runs)
        let since = performance.now();
        window.addEventListener('pagereveal', () => (since = performance.now()));
        window.addEventListener('pageshow', () => (since = performance.now()));
        const locked = () =>
          performance.now() - since < 4000 &&
          ((html.classList.contains('from-card') && !html.classList.contains('cover-landed')) || html.classList.contains('is-cover-back'));
        const swallow = (e: Event) => {
          if (!locked()) return;
          if (e.cancelable) e.preventDefault();
          e.stopPropagation();
        };
        const keys = new Set(['ArrowDown', 'ArrowUp', 'PageDown', 'PageUp', ' ', 'Home', 'End']);
        window.addEventListener('wheel', swallow, { capture: true, passive: false });
        window.addEventListener('touchmove', swallow, { capture: true, passive: false });
        window.addEventListener('keydown', (e) => keys.has(e.key) && swallow(e), { capture: true });
      }

      // Smooth scroll (Framer "SmoothScroll", intensity 8)
      if (!reduceMotion) {
        const lenis = new Lenis({ lerp: 0.1, wheelMultiplier: 1 });
        (window as unknown as { lenis: Lenis }).lenis = lenis;
        // Home page intro locks scrolling until it finishes
        if (document.documentElement.classList.contains('is-scroll-locked')) {
          lenis.stop();
          document.addEventListener('intro:done', () => lenis.start(), { once: true });
        }
        const raf = (t: number) => {
          lenis.raf(t);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Fade-up elements as they enter the viewport
      const revealIo = new IntersectionObserver(
        (entries) => {
          // Elements that enter in the same frame get a short stagger
          let n = 0;
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            el.style.setProperty('--reveal-delay', `${Math.min(n++, 5) * 60}ms`);
            el.classList.add('is-in');
            revealIo.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => revealIo.observe(el));

      // Lazy-load and auto-play videos only while they are on screen
      const videoIo = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) {
              if (v.dataset.src) {
                v.src = v.dataset.src;
                delete v.dataset.src;
              }
              v.play().catch(() => {});
            } else if (!v.paused) {
              v.pause();
            }
          }
        },
        { rootMargin: '300px 0px' },
      );
      // Videos and Lottie start only once a cover flight into this page has
      // ended: decoding video or building SVG during the flight would steal
      // frames from it. Everywhere else they start at once.
      const afterFlight = (start: () => void) => {
        let flying = false;
        try {
          flying = !!sessionStorage.getItem('vt-card');
        } catch (err) {}
        const root = document.documentElement;
        if (!flying && !root.classList.contains('from-card')) return start();
        let done = false;
        const go = () => {
          if (done) return;
          done = true;
          start();
        };
        new MutationObserver((_, mo) => {
          if (!root.classList.contains('cover-landed')) return;
          mo.disconnect();
          go();
        }).observe(root, { attributes: true, attributeFilter: ['class'] });
        window.setTimeout(go, 1400);
      };

      afterFlight(() => document.querySelectorAll('video[data-autoplay]').forEach((v) => videoIo.observe(v)));
      // a frame (and the slot holding it beside the cover) takes its
      // content's real shape once known
      function setShape(inner: Element, r: number) {
        const fig = inner.closest<HTMLElement>('.media--fit');
        if (!fig) return;
        fig.style.setProperty('--r', r.toFixed(4));
        const slot = fig.parentElement;
        if (slot?.classList.contains('case__stack')) slot.style.setProperty('--r', r.toFixed(4));
      }
      // a video's frame takes the video's own shape once it is known
      document.querySelectorAll<HTMLVideoElement>('.media--fit video').forEach((v) =>
        v.addEventListener(
          'loadedmetadata',
          () => {
            if (v.videoWidth && v.videoHeight) setShape(v, v.videoWidth / v.videoHeight);
          },
          { once: true },
        ),
      );

      // Lottie animations, loaded on demand
      const lottieEls = document.querySelectorAll<HTMLElement>('[data-lottie]');
      if (lottieEls.length) afterFlight(() => {
        const lottieIo = new IntersectionObserver(
          async (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              lottieIo.unobserve(e.target);
              const el = e.target as HTMLElement;
              const { default: lottie } = await import('lottie-web/build/player/lottie_light');
              const anim = lottie.loadAnimation({
                container: el,
                renderer: 'svg',
                loop: true,
                autoplay: !reduceMotion,
                path: el.dataset.lottie,
                rendererSettings: { preserveAspectRatio: 'xMidYMid meet' },
              });
              anim.addEventListener('data_ready', () => {
                // its frame takes the animation's own shape: shown whole
                const d = (anim as unknown as { animationData?: { w?: number; h?: number } }).animationData;
                if (d?.w && d?.h) setShape(el, d.w / d.h);
              });
            }
          },
          { rootMargin: '400px 0px' },
        );
        lottieEls.forEach((el) => lottieIo.observe(el));
      });
    </script>
  </body>
</html>
