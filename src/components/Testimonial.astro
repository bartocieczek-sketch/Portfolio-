---
import { urlFor } from '../lib/sanity';

interface Props {
  heading?: string;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  testimonial?: any;
}
const { heading, testimonial } = Astro.props;
const words: string[] = (testimonial?.quote ?? '').split(/\s+/).filter(Boolean);
const isGif = testimonial?.thumbnail?.asset?.mimeType === 'image/gif';
const thumb = testimonial?.thumbnail?.asset
  ? isGif
    ? testimonial.thumbnail.asset.url
    : urlFor(testimonial.thumbnail).width(320).url()
  : undefined;
---

{testimonial?.quote && (
  <section class="testimonial" data-build>
    <div class="testimonial__side">
      {heading && <h2 class="t-compact testimonial__heading" data-split>{heading}</h2>}
    </div>
    <div class="testimonial__main">
      <div class="testimonial__quote">
        <svg width="56" height="51" viewBox="0 0 56 51" aria-hidden="true">
          <path d="M55.675 0V2.83333C52.1806 6.42222 49.5833 10.1056 47.8833 13.8833C46.1833 17.6611 45.3333 21.6278 45.3333 25.7833H55.675V50.8583H32.725V29.6083C32.725 23.8472 33.6222 18.5111 35.4167 13.6C37.3056 8.59444 40.0917 4.06111 43.775 0H55.675ZM22.95 0V2.83333C19.4556 6.42222 16.8583 10.1056 15.1583 13.8833C13.4583 17.6611 12.6083 21.6278 12.6083 25.7833H22.95V50.8583H0V29.6083C0 23.8472 0.897222 18.5111 2.69167 13.6C4.58055 8.59444 7.36667 4.06111 11.05 0H22.95Z" fill="#575757" />
        </svg>
        <blockquote class="scroll-text" data-scroll-text>
          {words.map((w) => <span>{w} </span>)}
        </blockquote>
      </div>

      <div class="testimonial__author" data-build-item>
        {thumb && (
          <button class="testimonial__thumb" type="button" data-video-open={testimonial.videoUrl} aria-label={`Play video from ${testimonial.name}`} disabled={!testimonial.videoUrl}>
            <img src={thumb} alt="" width="140" height="171" loading="lazy" />
            {testimonial.videoUrl && (
              <span class="testimonial__play" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5.5v13l10.5-6.5L8 5.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
              </span>
            )}
          </button>
        )}
        <div>
          <p class="t-compact">{testimonial.name}</p>
          <p class="t-compact muted">{testimonial.role}</p>
        </div>
      </div>
    </div>
  </section>
)}

<dialog class="video-modal" data-video-modal>
  <button class="video-modal__close t-label" type="button" data-video-close aria-label="Close video">✕</button>
  <video controls playsinline></video>
</dialog>

<style>
  .testimonial {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 80px var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 24px;
  }
  .testimonial__side {
    width: 30%;
    padding-top: 75px;
  }
  .testimonial__heading {
    max-width: 165px;
  }
  .testimonial__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 140px;
  }
  .testimonial__quote {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .scroll-text {
    margin: 0;
    max-width: 680px;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .scroll-text span {
    color: var(--text-secondary);
    transition: color 0.25s linear;
  }
  .scroll-text span.is-lit {
    color: var(--text-primary);
  }
  .testimonial__author {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .testimonial__thumb {
    position: relative;
    width: 140px;
    aspect-ratio: 0.82;
    overflow: hidden;
  }
  .testimonial__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  .testimonial__thumb:hover img {
    transform: scale(1.05);
  }
  .testimonial__play {
    position: absolute;
    left: 4px;
    bottom: 4px;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(24, 24, 24, 0.55);
    backdrop-filter: blur(6px);
    color: var(--text-primary);
  }
  .video-modal {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 420px);
    max-height: 90vh;
    overflow: visible;
  }
  .video-modal::backdrop {
    background: rgba(0, 0, 0, 0.85);
  }
  .video-modal video {
    width: 100%;
    max-height: 86vh;
    background: #000;
  }
  .video-modal__close {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    color: var(--text-primary);
  }
  @media (max-width: 809px) {
    .testimonial {
      flex-direction: column;
    }
    .testimonial__side {
      width: 100%;
      padding-top: 0;
    }
    .testimonial__main {
      gap: 64px;
    }
    .scroll-text {
      font-size: 30px;
    }
  }
</style>

<script>
  // Words light up as the quote scrolls through the viewport
  // (Framer "ScrollRevealText": start at 85% of the viewport, finish at 40%).
  const blocks = document.querySelectorAll<HTMLElement>('[data-scroll-text]');
  if (blocks.length) {
    const update = () => {
      const vh = window.innerHeight;
      blocks.forEach((block) => {
        const r = block.getBoundingClientRect();
        const start = vh * 0.85;
        const end = vh * 0.4;
        const progress = Math.min(1, Math.max(0, (start - r.top) / (start - end + r.height * 0.5)));
        const words = block.children;
        const lit = Math.round(progress * words.length);
        for (let i = 0; i < words.length; i++) words[i].classList.toggle('is-lit', i < lit);
      });
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }

  // Video lightbox
  const modal = document.querySelector<HTMLDialogElement>('[data-video-modal]');
  const modalVideo = modal?.querySelector('video');
  document.querySelectorAll<HTMLElement>('[data-video-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!modal || !modalVideo || !btn.dataset.videoOpen) return;
      modalVideo.src = btn.dataset.videoOpen;
      (window as unknown as { posthog?: { capture: (event: string) => void } }).posthog?.capture('testimonial_video_opened');
      modal.showModal();
      (window as unknown as { lenis?: { stop(): void } }).lenis?.stop();
      modalVideo.play().catch(() => {});
    }),
  );
  const close = () => modal?.close();
  modal?.querySelector('[data-video-close]')?.addEventListener('click', close);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  modal?.addEventListener('close', () => {
    modalVideo?.pause();
    (window as unknown as { lenis?: { start(): void } }).lenis?.start();
  });
</script>
