---
// Conversion sections for the home page: proof in numbers, services,
// process and FAQ. Each section hides itself when it has no content.
interface Item {
  _key: string;
  title?: string;
  description?: string;
  value?: string;
  label?: string;
  question?: string;
  answer?: string;
}
interface Props {
  statsHeading?: string;
  stats?: Item[];
  servicesHeading?: string;
  services?: Item[];
  processHeading?: string;
  process?: Item[];
  faqHeading?: string;
  faq?: Item[];
}
const { statsHeading, stats = [], servicesHeading, services = [], processHeading, process = [], faqHeading, faq = [] } = Astro.props;
const num = (i: number) => String(i + 1).padStart(2, '0');
---

{stats.length > 0 && (
  <section class="sales stats" aria-label={statsHeading ?? 'Results'}>
    {statsHeading && <h2 class="sales__label t-label-small" data-split>{statsHeading}</h2>}
    <div class="stats__grid">
      {stats.map((s) => (
        <div class="stat" data-reveal>
          <p class="stat__value">{s.value}</p>
          <p class="t-compact muted">{s.label}</p>
        </div>
      ))}
    </div>
  </section>
)}

{services.length > 0 && (
  <section class="sales services">
    <div class="sales__head">
      <h2 class="t-heading-large" data-split>{servicesHeading}</h2>
      <span class="sales__count t-label-small">({services.length})</span>
    </div>
    <ol class="services__list">
      {services.map((s, i) => (
        <li class="service" data-reveal>
          <span class="service__num t-label-small">{num(i)}</span>
          <h3 class="service__title t-section">{s.title}</h3>
          {s.description && <p class="service__desc t-compact muted">{s.description}</p>}
        </li>
      ))}
    </ol>
  </section>
)}

{process.length > 0 && (
  <section class="sales process">
    <div class="sales__head">
      <h2 class="t-heading-large" data-split>{processHeading}</h2>
    </div>
    <ol class="process__grid">
      {process.map((s, i) => (
        <li class="step" data-reveal>
          <span class="step__num">{num(i)}</span>
          <h3 class="t-subheading">{s.title}</h3>
          {s.description && <p class="t-compact muted">{s.description}</p>}
        </li>
      ))}
    </ol>
  </section>
)}

{faq.length > 0 && (
  <section class="sales faq">
    <div class="faq__side">
      <h2 class="t-heading-large" data-split>{faqHeading}</h2>
    </div>
    <div class="faq__list" data-faq>
      {faq.map((q, i) => (
        <div class="faq__item">
          <h3>
            <button class="faq__q t-compact" type="button" aria-expanded="false" aria-controls={`faq-${q._key}`} id={`faq-q-${q._key}`}>
              <span>{q.question}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </button>
          </h3>
          <div class="faq__a" id={`faq-${q._key}`} role="region" aria-labelledby={`faq-q-${q._key}`}>
            <div class="faq__a-inner">
              <p class="t-compact muted">{q.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  .sales {
    padding: 0 var(--gutter);
  }
  .sales__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  .sales__count {
    margin-top: 4px;
  }

  /* ---------- Stats ---------- */
  .stats {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }
  .stat {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: clamp(64px, 8vw, 128px);
    line-height: 0.9;
    color: var(--text-primary);
  }

  /* ---------- Services ---------- */
  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service {
    display: grid;
    grid-template-columns: 60px 1fr 30%;
    align-items: baseline;
    gap: 24px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
  }
  .service__title {
    line-height: 1;
    transition: transform 0.35s var(--ease-out), color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .service:hover .service__title {
      transform: translateX(12px);
      color: var(--text-highlight);
    }
  }

  /* ---------- Process ---------- */
  .process__grid {
    list-style: none;
    margin: 0;
    padding: 40px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px;
    min-height: 320px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
  }
  .step__num {
    font-family: var(--font-display);
    font-size: 64px;
    line-height: 1;
    color: var(--text-secondary);
    margin-bottom: auto;
  }

  /* ---------- FAQ ---------- */
  .faq {
    display: flex;
    justify-content: space-between;
    gap: 48px;
  }
  .faq__side {
    width: 30%;
  }
  .faq__list {
    width: 65%;
    border-top: 1px solid var(--line);
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item h3 {
    margin: 0;
  }
  .faq__q {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 24px 0;
    text-align: left;
  }
  .faq__icon {
    position: relative;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__q[aria-expanded='true'] .faq__icon::after {
    transform: rotate(0deg);
  }
  .faq__a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s var(--ease-out);
  }
  .faq__a-inner {
    overflow: hidden;
  }
  .faq__a-inner p {
    padding-bottom: 24px;
    max-width: 620px;
  }
  .faq__q[aria-expanded='true'] + .faq__a,
  .faq__item:has(.faq__q[aria-expanded='true']) .faq__a {
    grid-template-rows: 1fr;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq__a,
    .service__title {
      transition: none;
    }
  }

  @media (max-width: 809px) {
    .service {
      grid-template-columns: 40px 1fr;
    }
    .service__desc {
      grid-column: 2;
    }
    .faq {
      flex-direction: column;
      gap: 24px;
    }
    .faq__side,
    .faq__list {
      width: 100%;
    }
    .step {
      min-height: 0;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((list) => {
    list.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.faq__q');
      if (!btn) return;
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>
