---
interface Props {
  callUrl?: string;
  socials?: { _key: string; label: string; url: string }[];
  role?: string;
  email?: string;
}
import { href } from '../lib/preview';
import glyphs from '../lib/monogram-b.json';
// the B monogram, flat, as the home link (font units are y-up, so flipped)
const [mPath, mBox] = glyphs.g.B as [string, number[], number];
const mView = `${mBox[0]} ${-mBox[3]} ${mBox[2] - mBox[0]} ${mBox[3] - mBox[1]}`;
const { callUrl, socials = [], role, email = 'bartocieczek@gmail.com' } = Astro.props;
// the contact methods in the Let's cooperate dropdown
const nice = (l: string) => (/linkedin/i.test(l) ? 'LinkedIn' : l.charAt(0).toUpperCase() + l.slice(1));
const handle = (u: string, l: string) =>
  /instagram|dribbble|behance|x\.com|twitter/i.test(u)
    ? `@${u.replace(/\/$/, '').split('/').pop()}`
    : /linkedin/i.test(l)
      ? 'Bartłomiej Ocieczek'
      : u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const path = Astro.url.pathname;
const to = (p: string) => href(Astro.locals, p);
---

<nav class="nav" aria-label="Main">
  <a href={to("/")} class="nav__home" aria-label="Home" aria-current={path === '/' ? 'page' : undefined}>
    <span class="nav__home-3d">
      {/* a few copies stepped back in depth give the flat B some thickness when it turns */}
      {[0, 1, 2, 3, 4, 5].map((k) => (
        <svg viewBox={mView} aria-hidden="true" style={`--z:${k}`} class={k === 0 ? 'is-face' : 'is-side'}><path transform="scale(1,-1)" d={mPath} fill="currentColor" /></svg>
      ))}
    </span>
  </a>
  <div class="nav__links">
    <a href={to("/about-me")} class="u-link t-label" aria-current={path.startsWith('/about-me') ? 'page' : undefined}>About me</a>
    <div class="nav__coop" data-coop>
      <button type="button" class="u-link t-label nav__coop-btn" aria-expanded="false" aria-controls="nav-coop" data-coop-btn>Let's cooperate</button>
      <div class="nav__coop-panel" id="nav-coop" data-coop-panel hidden>
        <p class="nav__coop-h">Pick a way to reach me</p>
        <ul>
          <li>
            <button type="button" class="nav__coop-row" data-coop-copy={email}>
              <span class="nav__coop-n">Email</span>
              <span class="nav__coop-d" data-coop-copy-t>{email}</span>
              <span class="nav__coop-a">Copy</span>
            </button>
          </li>
          {callUrl && (
            <li>
              <a class="nav__coop-row" href={callUrl} target="_blank" rel="noopener">
                <span class="nav__coop-n">Book a call</span>
                <span class="nav__coop-d">30 min, pick a time</span>
                <span class="nav__coop-a">↗</span>
              </a>
            </li>
          )}
          {socials.map((so) => (
            <li>
              <a class="nav__coop-row" href={so.url} target="_blank" rel="noopener">
                <span class="nav__coop-n">{nice(so.label)}</span>
                <span class="nav__coop-d">{handle(so.url, so.label)}</span>
                <span class="nav__coop-a">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <button class="nav__toggle t-label" type="button" aria-expanded="false" aria-controls="mobile-menu">
    <span class="nav__toggle-open">Menu</span>
    <span class="nav__toggle-close">Close</span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu__links">
    <a href={to("/")} class="t-display" style="--n:0"><span>Home</span></a>
    <a href={to("/about-me")} class="t-display" style="--n:1"><span>About me</span></a>
    {callUrl && <a href={callUrl} target="_blank" rel="noopener" class="t-display" style="--n:2"><span>Let's cooperate</span></a>}
  </div>
  <div class="mobile-menu__bottom">
    {role && <p class="t-body2 muted">{role}</p>}
    <div>
      {socials.map((s) => (
        <a class="line-button" href={s.url} target="_blank" rel="noopener"><span>{s.label}</span></a>
      ))}
    </div>
  </div>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    position: relative;
    z-index: 20;
  }
  .nav__links {
    width: 30%;
    display: flex;
    justify-content: space-between;
    gap: 30px;
  }
  /* the monogram as the home link: tips a little on hover */
  .nav__home {
    display: block;
    height: 26px;
    color: var(--text-primary);
  }
  .nav__home {
    transform-style: preserve-3d;
  }
  .nav__home-3d {
    position: relative;
    display: block;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.25s var(--ease-out);
  }
  .nav__home svg {
    display: block;
    height: 100%;
    width: auto;
  }
  .nav__home svg.is-side {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateZ(calc(var(--z) * -0.55px));
    filter: brightness(0.55);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__home:hover .nav__home-3d {
      transform: rotate(-8deg) scale(1.06);
    }
  }
  /* Menu ⇄ Close: the two labels roll past each other in a one-line mask */
  .nav__toggle {
    display: none;
    height: 18px;
    overflow: hidden;
    padding: 0;
  }
  .nav__toggle span {
    display: block;
    line-height: 18px;
    transition: transform 0.5s var(--ease-drawer);
  }
  :global(html.menu-open) .nav__toggle span {
    transform: translateY(-100%);
  }

  /* The menu: the panel wipes down from the top (iOS drawer curve), the big
     links rise out of their masks one after another, the bottom fades up
     last. Closing runs it back, quicker, links first. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--surface-dark);
    padding: 80px var(--gutter) 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 80px;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.42s var(--ease-in-out) 0.12s;
  }
  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.62s var(--ease-drawer);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mobile-menu__links a {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    font-size: 34px;
    line-height: 1;
  }
  .mobile-menu__links a span {
    display: block;
    transform: translateY(105%) rotate(4deg);
    transform-origin: 0 100%;
    transition: transform 0.3s var(--ease-in-out);
  }
  .mobile-menu.is-open .mobile-menu__links a span {
    transform: none;
    transition: transform 0.85s var(--ease-expo) calc(0.18s + var(--n) * 0.07s);
  }
  .mobile-menu__bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .mobile-menu.is-open .mobile-menu__bottom {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) 0.42s,
      transform 0.8s var(--ease-expo) 0.42s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu.is-open {
      clip-path: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .mobile-menu.is-open {
      opacity: 1;
    }
    .mobile-menu__links a span,
    .mobile-menu__bottom {
      transform: none !important;
    }
  }
  @media (max-width: 809px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
    :global(html.menu-open) .nav {
      position: fixed;
      top: 24px;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
    }
  }
  /* Let's cooperate: a dropdown of ways to get in touch. It grows out of
     the link (top-right origin, a slight scale + fade, 200ms ease-out),
     rows stagger in by 30ms; closing is quicker than opening */
  .nav__coop {
    position: relative;
    display: flex;
  }
  .nav__coop-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .nav__coop-btn[aria-expanded='true']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav__coop-panel {
    position: absolute;
    top: calc(100% + 14px);
    right: 0;
    z-index: 30;
    width: min(380px, calc(100vw - 32px));
    padding: 8px;
    border-radius: 16px;
    background: rgb(18, 18, 18);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 24px 48px -16px rgba(0, 0, 0, 0.5);
    color: rgb(240, 240, 238);
    text-transform: none;
    letter-spacing: normal;
    transform-origin: top right;
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
    transition:
      opacity 0.15s ease,
      transform 0.15s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__coop-panel.is-open {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.2s ease,
      transform 0.22s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__coop-h {
    margin: 6px 10px 8px;
    font: 500 12px / 1.2 var(--font-head);
    color: rgb(120, 120, 120);
  }
  .nav__coop-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav__coop-panel li {
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s ease,
      transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__coop-panel.is-open li {
    opacity: 1;
    transform: none;
  }
  .nav__coop-panel.is-open li:nth-child(1) { transition-delay: 30ms; }
  .nav__coop-panel.is-open li:nth-child(2) { transition-delay: 60ms; }
  .nav__coop-panel.is-open li:nth-child(3) { transition-delay: 90ms; }
  .nav__coop-panel.is-open li:nth-child(4) { transition-delay: 120ms; }
  .nav__coop-panel.is-open li:nth-child(5) { transition-delay: 150ms; }
  .nav__coop-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 12px;
    width: 100%;
    padding: 12px 10px;
    border: 0;
    border-radius: 10px;
    background: none;
    font: 500 16px / 1.2 var(--font-head);
    letter-spacing: -0.02em;
    color: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      transform 0.16s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .nav__coop-d {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
    letter-spacing: 0;
    color: rgb(120, 120, 120);
    transition:
      opacity 0.2s ease,
      filter 0.2s ease;
  }
  .nav__coop-d.is-swap {
    opacity: 0;
    filter: blur(2px);
  }
  .nav__coop-a {
    font-size: 13px;
    color: rgb(120, 120, 120);
    transition:
      color 0.15s ease,
      transform 0.2s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__coop-row:hover {
      background: rgba(255, 255, 255, 0.06);
    }
    .nav__coop-row:hover .nav__coop-a {
      color: rgb(240, 240, 238);
      transform: translate(2px, -2px);
    }
    button.nav__coop-row:hover .nav__coop-a {
      transform: none;
    }
  }
  .nav__coop-row:active {
    transform: scale(0.98);
  }
  .nav__coop-row:focus-visible {
    outline: 1px solid rgba(255, 255, 255, 0.5);
    outline-offset: -1px;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__coop-panel,
    .nav__coop-panel.is-open,
    .nav__coop-panel li {
      transform: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  let hideTimer = 0;
  const set = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    clearTimeout(hideTimer);
    if (open) {
      menu.hidden = false;
      // one frame closed first, so the wipe and the links play in
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
    } else {
      menu.classList.remove('is-open');
      // out of the way once the wipe back up has finished
      hideTimer = window.setTimeout(() => (menu.hidden = true), 560);
    }
  };
  toggle?.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') set(false);
  });

  // ---- Let's cooperate dropdown
  const coop = document.querySelector<HTMLElement>('[data-coop]');
  const coopBtn = coop?.querySelector<HTMLButtonElement>('[data-coop-btn]');
  const coopPanel = coop?.querySelector<HTMLElement>('[data-coop-panel]');
  if (coop && coopBtn && coopPanel) {
    let t = 0;
    const open = (v: boolean) => {
      coopBtn.setAttribute('aria-expanded', String(v));
      clearTimeout(t);
      if (v) {
        coopPanel.hidden = false;
        requestAnimationFrame(() => requestAnimationFrame(() => coopPanel.classList.add('is-open')));
      } else {
        coopPanel.classList.remove('is-open');
        t = window.setTimeout(() => (coopPanel.hidden = true), 160);
      }
    };
    coopBtn.addEventListener('click', () => open(coopBtn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('pointerdown', (e) => {
      if (coopBtn.getAttribute('aria-expanded') === 'true' && !coop.contains(e.target as Node)) open(false);
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && coopBtn.getAttribute('aria-expanded') === 'true') {
        open(false);
        coopBtn.focus();
      }
    });
    coopPanel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => open(false)));
    // copy the email, say so for a moment
    const copy = coopPanel.querySelector<HTMLButtonElement>('[data-coop-copy]');
    const copyT = copy?.querySelector<HTMLElement>('[data-coop-copy-t]');
    copy?.addEventListener('click', async () => {
      const mail = copy.dataset.coopCopy || '';
      try {
        await navigator.clipboard.writeText(mail);
      } catch {
        location.href = `mailto:${mail}`;
        return;
      }
      if (!copyT) return;
      const swap = (txt: string) => {
        copyT.classList.add('is-swap');
        setTimeout(() => {
          copyT.textContent = txt;
          copyT.classList.remove('is-swap');
        }, 150);
      };
      swap('Copied to clipboard');
      setTimeout(() => swap(mail), 1600);
    });
  }
</script>
