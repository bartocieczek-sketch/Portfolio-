---
interface Props {
  callUrl?: string;
  socials?: { _key: string; label: string; url: string }[];
  role?: string;
}
import { href } from '../lib/preview';
import glyphs from '../lib/monogram-b.json';
// the B monogram, flat, as the home link (font units are y-up, so flipped)
const [mPath, mBox] = glyphs.g.B as [string, number[], number];
const mView = `${mBox[0]} ${-mBox[3]} ${mBox[2] - mBox[0]} ${mBox[3] - mBox[1]}`;
const { callUrl, socials = [], role } = Astro.props;
const path = Astro.url.pathname;
const to = (p: string) => href(Astro.locals, p);
---

<nav class="nav" aria-label="Main">
  <a href={to("/")} class="nav__home" aria-label="Home" aria-current={path === '/' ? 'page' : undefined}>
    <svg viewBox={mView} aria-hidden="true"><path transform="scale(1,-1)" d={mPath} fill="currentColor" /></svg>
  </a>
  <div class="nav__links">
    <a href={to("/about-me")} class="u-link t-label" aria-current={path.startsWith('/about-me') ? 'page' : undefined}>About me</a>
    {callUrl && <a href={callUrl} target="_blank" rel="noopener" class="u-link t-label">Let's cooperate</a>}
  </div>
  <button class="nav__toggle t-label" type="button" aria-expanded="false" aria-controls="mobile-menu">
    <span class="nav__toggle-open">Menu</span>
    <span class="nav__toggle-close">Close</span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu__links">
    <a href={to("/")} class="t-display">Home</a>
    <a href={to("/about-me")} class="t-display">About me</a>
    {callUrl && <a href={callUrl} target="_blank" rel="noopener" class="t-display">Let's cooperate</a>}
  </div>
  <div class="mobile-menu__bottom">
    {role && <p class="t-body2 muted">{role}</p>}
    <div>
      {socials.map((s) => (
        <a class="line-button" href={s.url} target="_blank" rel="noopener"><span>{s.label}</span></a>
      ))}
    </div>
  </div>
</div>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    position: relative;
    z-index: 20;
  }
  .nav__links {
    width: 30%;
    display: flex;
    justify-content: space-between;
    gap: 30px;
  }
  /* the monogram as the home link: tips a little on hover */
  .nav__home {
    display: block;
    height: 26px;
    color: var(--text-primary);
  }
  .nav__home svg {
    display: block;
    height: 100%;
    width: auto;
    transition: transform 0.25s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__home:hover svg {
      transform: rotate(-8deg) scale(1.06);
    }
  }
  .nav__toggle {
    display: none;
    height: 18px;
  }
  .nav__toggle-close {
    display: none;
  }
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--surface-dark);
    padding: 80px var(--gutter) 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 80px;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mobile-menu__bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (max-width: 809px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
    :global(html.menu-open) .nav__toggle-open {
      display: none;
    }
    :global(html.menu-open) .nav__toggle-close {
      display: inline;
    }
    :global(html.menu-open) .nav {
      position: fixed;
      top: 24px;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    if (menu) menu.hidden = !open;
  });
</script>
