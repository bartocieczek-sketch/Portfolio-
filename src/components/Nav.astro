---
interface Props {
  callUrl?: string;
  socials?: { _key: string; label: string; url: string }[];
  role?: string;
}
import { href } from '../lib/preview';
import glyphs from '../lib/monogram-b.json';
// the B monogram, flat, as the home link (font units are y-up, so flipped)
const [mPath, mBox] = glyphs.g.B as [string, number[], number];
const mView = `${mBox[0]} ${-mBox[3]} ${mBox[2] - mBox[0]} ${mBox[3] - mBox[1]}`;
const { callUrl, socials = [], role } = Astro.props;
const path = Astro.url.pathname;
const to = (p: string) => href(Astro.locals, p);
---

<nav class="nav" aria-label="Main">
  <div class="nav__left">
  <a href={to("/")} class="nav__home" aria-label="Home" aria-current={path === '/' ? 'page' : undefined}>
    <span class="nav__home-3d">
      {/* a few copies stepped back in depth give the flat B some thickness when it turns */}
      {[0, 1, 2, 3, 4, 5].map((k) => (
        <svg viewBox={mView} aria-hidden="true" style={`--z:${k}`} class={k === 0 ? 'is-face' : 'is-side'}><path transform="scale(1,-1)" d={mPath} fill="currentColor" /></svg>
      ))}
    </span>
  </a>
  <a href={to("/work")} class="u-link t-label nav__work" data-work-link aria-current={path.startsWith('/work') ? 'page' : undefined}>Explorations</a>
  </div>
  <div class="nav__links">
    <a href={to("/about-me")} class="u-link t-label" aria-current={path.startsWith('/about-me') ? 'page' : undefined}>About me</a>
    {callUrl && <a href={callUrl} target="_blank" rel="noopener" class="u-link t-label">Let's cooperate</a>}
  </div>
  <button class="nav__toggle t-label" type="button" aria-expanded="false" aria-controls="mobile-menu">
    <span class="nav__toggle-open">Menu</span>
    <span class="nav__toggle-close">Close</span>
  </button>
</nav>

<div class="mobile-menu" id="mobile-menu" hidden>
  <div class="mobile-menu__links">
    <a href={to("/")} class="t-display" style="--n:0"><span>Home</span></a>
    <a href={to("/work")} class="t-display" style="--n:1"><span>Explorations</span></a>
    <a href={to("/about-me")} class="t-display" style="--n:2"><span>About me</span></a>
  </div>
  <div class="mobile-menu__bottom">
    {callUrl && <a href={callUrl} target="_blank" rel="noopener" class="mobile-menu__cta">Let's cooperate</a>}
  </div>
</div>

<style>
  /* the nav links read as words, not caps */
  .nav > a.t-label,
  .nav .nav__left > a.t-label,
  .nav .nav__right > a.t-label,
  .nav__links > a.t-label,
  .nav__toggle.t-label {
    text-transform: none;
    font-size: 14px;
    letter-spacing: -0.02em;
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 10px;
    position: relative;
    z-index: 20;
  }
  /* the B and, beside it, the way to every project */
  .nav__left {
    display: flex;
    align-items: center;
  }
  /* lines up with the second column of the project details on home (9%) */
  .nav__work {
    position: absolute;
    left: 9%;
  }
  .nav__links {
    /* "About me" lines up with the project names on home (Hero.astro) */
    width: calc(16% + 40px);
    display: flex;
    justify-content: space-between;
    gap: 30px;
  }
  /* the monogram as the home link: tips a little on hover */
  .nav__home {
    display: block;
    height: 26px;
    color: var(--text-primary);
  }
  .nav__home {
    transform-style: preserve-3d;
  }
  .nav__home-3d {
    position: relative;
    display: block;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.25s var(--ease-out);
  }
  .nav__home svg {
    display: block;
    height: 100%;
    width: auto;
  }
  .nav__home svg.is-side {
    position: absolute;
    left: 0;
    top: 0;
    transform: translateZ(calc(var(--z) * -0.55px));
    filter: brightness(0.55);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav__home:hover .nav__home-3d {
      transform: rotate(-8deg) scale(1.06);
    }
  }
  /* Menu ⇄ Close: the two labels roll past each other in a one-line mask */
  .nav__toggle {
    display: none;
    height: 18px;
    overflow: hidden;
    padding: 0;
  }
  .nav__toggle span {
    display: block;
    line-height: 18px;
    transition: transform 0.5s var(--ease-drawer);
  }
  :global(html.menu-open) .nav__toggle span {
    transform: translateY(-100%);
  }

  /* The menu: the panel wipes down from the top (iOS drawer curve), the big
     links rise out of their masks one after another, the bottom fades up
     last. Closing runs it back, quicker, links first. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--surface-dark);
    padding: 80px var(--gutter) 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 80px;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.42s var(--ease-in-out) 0.12s;
  }
  .mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
    transition: clip-path 0.62s var(--ease-drawer);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__links {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mobile-menu__links a {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
    font-size: 34px;
    line-height: 1;
    text-transform: none;
    letter-spacing: -0.02em;
  }
  .mobile-menu__links a span {
    display: block;
    transform: translateY(105%) rotate(4deg);
    transform-origin: 0 100%;
    transition: transform 0.3s var(--ease-in-out);
  }
  .mobile-menu.is-open .mobile-menu__links a span {
    transform: none;
    transition: transform 0.85s var(--ease-expo) calc(0.18s + var(--n) * 0.07s);
  }
  /* the call to action: a black pill in the middle of the bottom */
  .mobile-menu__cta {
    align-self: center;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    font: 500 16px / 1 var(--font-head);
    letter-spacing: -0.01em;
    transition: scale 0.16s var(--ease-out);
  }
  .mobile-menu__cta:active {
    scale: 0.97;
  }
  .mobile-menu__bottom {
    display: flex;
    flex-direction: column;
    gap: 24px;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.2s var(--ease-out),
      transform 0.2s var(--ease-out);
  }
  .mobile-menu.is-open .mobile-menu__bottom {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease-out) 0.42s,
      transform 0.8s var(--ease-expo) 0.42s;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .mobile-menu.is-open {
      clip-path: none;
      opacity: 0;
      transition: opacity 0.2s ease;
    }
    .mobile-menu.is-open {
      opacity: 1;
    }
    .mobile-menu__links a span,
    .mobile-menu__bottom {
      transform: none !important;
    }
  }
  @media (max-width: 809px) {
    .nav__links,
    .nav__work {
      display: none;
    }
    .nav__toggle {
      display: block;
    }
    :global(html.menu-open) .nav {
      position: fixed;
      top: 24px;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  let hideTimer = 0;
  const set = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    document.documentElement.classList.toggle('menu-open', open);
    clearTimeout(hideTimer);
    if (open) {
      menu.hidden = false;
      // one frame closed first, so the wipe and the links play in
      requestAnimationFrame(() => requestAnimationFrame(() => menu.classList.add('is-open')));
    } else {
      menu.classList.remove('is-open');
      // out of the way once the wipe back up has finished
      hideTimer = window.setTimeout(() => (menu.hidden = true), 560);
    }
  };
  toggle?.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') set(false);
  });
</script>
