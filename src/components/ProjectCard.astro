---
import { srcset, urlFor } from '../lib/sanity';
import { href } from '../lib/preview';

interface Props {
  project: {
    title: string;
    cardTitle?: string;
    year?: string;
    cardTags?: string[];
    slug: string;
    // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
    cover?: any;
  };
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const name = (project.cardTitle || project.title).trim();
const lqip = project.cover?.asset?.metadata?.lqip;
---

<a href={href(Astro.locals, `/${project.slug}`)} class="card" data-reveal>
  {project.cover?.asset && (
    <img
      class="card__img"
      src={urlFor(project.cover).width(900).quality(82).url()}
      srcset={srcset(project.cover, [400, 700, 900, 1300])}
      sizes="(max-width: 809px) 100vw, 32vw"
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={lqip ? `background-image:url(${lqip})` : undefined}
    />
  )}
  <span class="card__shade card__shade--top" aria-hidden="true"></span>
  <span class="card__shade card__shade--bottom" aria-hidden="true"></span>
  <span class="card__row card__row--top t-body2">
    <span>{name}</span>
    {project.year && <span>{project.year}</span>}
  </span>
  {project.cardTags?.length ? (
    <span class="card__row card__row--bottom t-body2">
      {project.cardTags.map((t) => <span>{t}</span>)}
    </span>
  ) : null}
</a>

<style>
  .card {
    position: relative;
    display: block;
    aspect-ratio: 0.82;
    overflow: hidden;
    background: #111;
    color: var(--text-highlight);
  }
  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
    transform: scale(1.001);
    transition: transform 0.6s var(--ease-out);
  }
  .card__shade {
    position: absolute;
    left: 0;
    right: 0;
    height: 30%;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .card__shade--top {
    top: 0;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent);
  }
  .card__shade--bottom {
    bottom: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), transparent);
  }
  .card__row {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .card__row--top {
    top: 0;
    justify-content: space-between;
    padding-bottom: 14px;
    transform: translateY(-6px);
  }
  .card__row--bottom {
    bottom: 0;
    flex-direction: column;
    transform: translateY(6px);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__img {
      transform: scale(1.03);
    }
    .card:hover .card__shade,
    .card:hover .card__row {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .card__img,
    .card__row {
      transform: none !important;
    }
  }
  /* Touch screens can't hover, so the labels are always visible there */
  @media (hover: none) {
    .card__shade,
    .card__row {
      opacity: 1;
      transform: none;
    }
  }
</style>
