---
// Capabilities graph (after ref.digital): one centre node, three labelled
// hubs with a small pixelated picture each, and a fan of thin lines out to
// the skills behind each hub. Everything drifts a little. Pointing at a hub
// darkens its fan and names its skills; pointing near a dot names that
// skill; a hub can be dragged and its lines follow. The fan grows out of the
// centre when it scrolls into view.
interface Props {
  groups: { name: string; img?: string | null; items: string[]; desc?: string }[];
  /** optional SVG markup for the centre (e.g. the B monogram) instead of a square */
  core?: string;
}
const { groups, core } = Astro.props;
---

<div class="cg" data-cg>
  <svg class="cg__lines" aria-hidden="true" data-cg-svg></svg>
  {core ? <span class="cg__core cg__core--mark" aria-hidden="true" data-cg-core set:html={core} /> : <span class="cg__core" aria-hidden="true" data-cg-core />}
  {groups.map((g, gi) => (
    <div class="cg__hub" data-hub={gi} tabindex="0" role="button" aria-label={`${g.name}: ${g.items.join(', ')}`}>
      {g.img && <img src={g.img} alt="" width="48" height="60" loading="lazy" />}
      <span class="cg__hub-t"><i></i>{g.name}</span>
      {g.desc && <span class="cg__hub-d">{g.desc}</span>}
    </div>
  ))}
  {groups.map((g, gi) =>
    g.items.map((it) => (
      <span class="cg__dot" data-dot={gi} aria-hidden="true">
        <i></i>
        <b>{it}</b>
      </span>
    )),
  )}
</div>

<style>
  .cg {
    --ink: rgb(17, 17, 17);
    position: relative;
    width: 100%;
    height: clamp(460px, 78svh, 820px);
    overflow: hidden;
    background: #ece9e3;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
  }
  .cg__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cg__lines :global(line) {
    stroke: rgba(17, 17, 17, 0.16);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transition: stroke 0.3s ease;
  }
  .cg__lines :global(line.is-hub) {
    stroke: rgba(17, 17, 17, 0.8);
  }
  .cg__lines :global(line.is-on) {
    stroke: rgba(17, 17, 17, 0.55);
  }
  .cg__core,
  .cg__hub,
  .cg__dot {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
  }
  .cg__core {
    width: 14px;
    height: 14px;
    margin: -7px 0 0 -7px;
    background: var(--ink);
  }
  /* a mark in the centre instead of the square: it sits on a disc that
     hides the lines' ends, and turns a little with the hovered hub */
  .cg__core--mark {
    z-index: 1;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #ece9e3;
    color: var(--ink);
  }
  .cg__core--mark :global(svg) {
    width: 38px;
    height: auto;
  }
  .cg__hub {
    margin: -6px 0 0 -6px;
    cursor: grab;
    outline: none;
  }
  .cg__hub:active {
    cursor: grabbing;
  }
  .cg__hub img {
    position: absolute;
    left: -6px;
    bottom: 22px;
    width: clamp(40px, 4vw, 64px);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.1);
    image-rendering: pixelated;
    transition: filter 0.3s ease;
  }
  .cg__hub-t {
    display: flex;
    align-items: center;
    gap: 9px;
    font: 500 clamp(13px, 1.1vw, 16px) / 1 var(--font-mono, var(--font-head));
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .cg__hub-t i {
    width: 12px;
    height: 12px;
    background: var(--ink);
    transition: transform 0.25s var(--e-out, ease-out);
  }
  /* an optional line under the hub's name (services) */
  .cg__hub-d {
    display: block;
    width: 24ch;
    margin: 8px 0 0 21px;
    font: 400 13px/1.4 var(--font-head);
    color: rgba(17, 17, 17, 0.55);
    white-space: normal;
  }
  /* hubs near the right edge put their label on the dot's left */
  .cg__hub.is-flip .cg__hub-t {
    flex-direction: row-reverse;
    transform: translateX(calc(-100% + 12px));
  }
  .cg__hub.is-flip .cg__hub-d {
    margin-left: 0;
    transform: translateX(calc(-100% + 12px));
    text-align: right;
  }
  .cg__hub.is-on .cg__hub-t i,
  .cg__hub:focus-visible .cg__hub-t i {
    transform: rotate(45deg);
  }
  .cg__hub.is-on img {
    filter: grayscale(0);
  }
  .cg__dot {
    margin: -2.5px 0 0 -2.5px;
    pointer-events: none;
  }
  .cg__dot i {
    display: block;
    width: 5px;
    height: 5px;
    background: rgba(17, 17, 17, 0.3);
    transition: background-color 0.25s ease;
  }
  .cg__dot b {
    position: absolute;
    left: 10px;
    top: -5px;
    font: 500 12px/1 var(--font-head);
    letter-spacing: 0.01em;
    color: var(--ink);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--e-out, ease-out);
  }
  .cg__dot.is-on i {
    background: var(--ink);
  }
  .cg__dot.is-on b {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-cg]').forEach((box) => {
    const NS = 'http://www.w3.org/2000/svg';
    const svg = box.querySelector<SVGSVGElement>('[data-cg-svg]')!;
    const core = box.querySelector<HTMLElement>('[data-cg-core]')!;
    const hubs = [...box.querySelectorAll<HTMLElement>('[data-hub]')];
    const dots = [...box.querySelectorAll<HTMLElement>('[data-dot]')];
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // layout, in fractions of the box: the hubs sit around the centre
    const H = hubs.length;
    // narrow boxes keep the hubs (and their labels) clear of the right edge
    const base =
      box.clientWidth < 640
        ? [
            { x: 0.08, y: 0.16 },
            { x: 0.6, y: 0.3 },
            { x: 0.14, y: 0.84 },
            { x: 0.58, y: 0.86 },
          ]
        : [
            { x: 0.12, y: 0.22 },
            { x: 0.84, y: 0.27 },
            { x: 0.27, y: 0.8 },
            { x: 0.7, y: 0.82 },
          ];
    let seed = 7;
    const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
    const hubPos = hubs.map((_, i) => ({ ...base[i % base.length], ox: 0, oy: 0, mx: 0, my: 0, ph: rnd() * 6.28 }));
    // magnet: a hub reaches for the pointer once it's within this distance
    // of its label, so it doesn't need to be hit exactly
    const SNAP = 90;
    // each skill sits somewhere in the cone between the centre and its hub
    // (best of a few tries: the spot farthest from the dots already placed,
    // measured in pixels, so the labels have room)
    const AR = box.clientWidth / Math.max(1, box.clientHeight);
    const placed: { g: number; x: number; y: number; ph: number }[] = [];
    const dotPos = dots.map((d) => {
      const g = Number(d.dataset.dot);
      const h = hubPos[g];
      let best = { g, x: 0.5, y: 0.5, ph: rnd() * 6.28 };
      let bestD = -1;
      for (let k = 0; k < 24; k++) {
        const ang = Math.atan2(h.y - 0.5, h.x - 0.5) + (rnd() - 0.5) * 1.1;
        const len = Math.hypot(h.x - 0.5, h.y - 0.5) * (0.35 + rnd() * 0.75);
        const c = { g, x: 0.5 + Math.cos(ang) * len, y: 0.5 + Math.sin(ang) * len, ph: best.ph };
        const dmin = Math.min(1e9, ...placed.map((o) => Math.hypot((o.x - c.x) * AR * 2, (o.y - c.y) * 3)), ...hubPos.map((o) => Math.hypot((o.x - c.x) * AR * 2, (o.y - c.y) * 3)));
        if (dmin > bestD) {
          bestD = dmin;
          best = c;
        }
      }
      placed.push(best);
      return best;
    });
    // each label's own vertical nudge, so lit labels never sit on each other
    const labels = dots.map((d) => d.querySelector('b') as HTMLElement);
    const nudge = dots.map(() => 0);
    const lines = [...hubs.map((_, i) => ({ hub: i })), ...dots.map((_, i) => ({ dot: i }))].map((l) => {
      const el = document.createElementNS(NS, 'line');
      if ('hub' in l) el.classList.add('is-hub');
      svg.append(el);
      return { ...l, el } as { hub?: number; dot?: number; el: SVGLineElement };
    });

    // interaction state
    let hot = -1; // hovered hub
    let near = -1; // dot near the pointer
    let px = -1e4;
    let py = -1e4;
    let drag: { i: number; sx: number; sy: number; ox: number; oy: number } | null = null;
    let focused = -1;
    let spx = -1e4;
    let spy = -1e4;
    let pnx = 0;
    let pny = 0;
    let reach = 0;
    // each skill's depth for the parallax (0.35 near the centre … 1.6 far)
    const depth = dotPos.map(() => 0.35 + rnd() * 1.25);
    // a page can point at a hub from outside (e.g. a list of services)
    box.addEventListener('cg:focus', (e) => (focused = (e as CustomEvent<number>).detail));
    // entrance: the centre settles in, then the hubs' lines shoot out, then
    // the skills' lines sweep round the centre one after another; each end
    // pops a little as its line lands
    let t0 = calm ? 0 : -1;
    const ease = (x: number) => 1 - Math.pow(1 - x, 4);
    const gAt = (now: number, delay: number, dur: number) =>
      calm ? 1 : t0 < 0 ? 0 : ease(Math.min(1, Math.max(0, (now - t0 - delay) / dur)));
    const hubDelay = hubs.map((_, i) => 220 + i * 110);
    // skills in the order they sit around the centre, so the sweep reads as one motion
    const order = dotPos
      .map((d, i) => ({ i, a: Math.atan2(d.y - 0.5, d.x - 0.5) }))
      .sort((a, b) => a.a - b.a)
      .map((o) => o.i);
    const dotDelay: number[] = [];
    order.forEach((i, k) => (dotDelay[i] = 520 + k * 32));
    const landed = new Set<HTMLElement>();
    const pop = (el: Element | null, from: number) =>
      el?.animate([{ transform: `scale(${from})` }, { transform: 'scale(1)' }], { duration: 420, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' });

    const setHot = (i: number) => {
      hot = i;
      hubs.forEach((h, k) => h.classList.toggle('is-on', k === i));
    };
    hubs.forEach((h, i) => {
      h.addEventListener('focus', () => (focused = i));
      h.addEventListener('blur', () => (focused = -1));
      h.addEventListener('pointerdown', (e) => {
        h.setPointerCapture(e.pointerId);
        drag = { i, sx: e.clientX, sy: e.clientY, ox: hubPos[i].ox, oy: hubPos[i].oy };
      });
    });
    // a snapped hub can be grabbed from anywhere within its pull
    box.addEventListener('pointerdown', (e) => {
      if (drag || hot < 0 || (e.target as HTMLElement).closest('[data-hub]')) return;
      box.setPointerCapture(e.pointerId);
      drag = { i: hot, sx: e.clientX, sy: e.clientY, ox: hubPos[hot].ox, oy: hubPos[hot].oy };
    });
    box.addEventListener('pointermove', (e) => {
      const r = box.getBoundingClientRect();
      px = e.clientX - r.left;
      py = e.clientY - r.top;
      if (drag) {
        hubPos[drag.i].ox = drag.ox + (e.clientX - drag.sx);
        hubPos[drag.i].oy = drag.oy + (e.clientY - drag.sy);
      }
    });
    box.addEventListener('pointerleave', () => {
      px = py = -1e4;
    });
    addEventListener('pointerup', () => {
      drag = null;
    });

    new IntersectionObserver(
      (es, o) => {
        if (es[0].isIntersecting) {
          t0 = performance.now();
          o.disconnect();
        }
      },
      { threshold: 0.35 },
    ).observe(box);

    const frame = (now: number) => {
      const W = box.clientWidth;
      const Hh = box.clientHeight;
      const t = calm ? 0 : now / 1000;
      // the whole graph leans with the pointer: a smoothed pointer drives a
      // parallax (each dot at its own depth, the centre a touch the other
      // way) and dots near it are nudged aside
      const on = px > -1e3 && !calm;
      if (on && spx < -1e3) {
        spx = px;
        spy = py;
      }
      spx += ((on ? px : spx) - spx) * 0.18;
      spy += ((on ? py : spy) - spy) * 0.18;
      pnx += ((on ? (px / W - 0.5) * 2 : 0) - pnx) * 0.06;
      pny += ((on ? (py / Hh - 0.5) * 2 : 0) - pny) * 0.06;
      reach += ((on ? 1 : 0) - reach) * 0.08;
      const cx = W / 2 - pnx * 10;
      const cy = Hh / 2 - pny * 8;
      const gc = gAt(now, 0, 600);
      core.style.transform = `translate(${cx}px,${cy}px) scale(${(0.7 + 0.3 * gc).toFixed(3)})`;
      core.style.opacity = gc.toFixed(3);
      // where each hub would sit, then the nearest one within SNAP of the
      // pointer leans toward it (a quick spring) and lights up
      const hg = hubPos.map((_, i) => gAt(now, hubDelay[i], 1000));
      const rest = hubPos.map((h, i) => ({
        x: cx + (h.x * W - cx) * hg[i] + h.ox + Math.sin(t * 0.5 + h.ph) * 6 + pnx * 26,
        y: cy + (h.y * Hh - cy) * hg[i] + h.oy + Math.cos(t * 0.4 + h.ph) * 6 + pny * 20,
      }));
      hubs.forEach((el, i) => {
        // the label follows its line out and fades up as it lands
        el.style.opacity = Math.min(1, Math.max(0, (hg[i] - 0.35) / 0.5)).toFixed(3);
        if (hg[i] > 0.97 && !landed.has(el)) {
          landed.add(el);
          if (!calm) pop(el.querySelector('.cg__hub-t i'), 2.2);
        }
      });
      let pick = drag ? drag.i : -1;
      if (!drag) {
        let bd = SNAP;
        rest.forEach((p, i) => {
          const w = hubs[i].offsetWidth;
          const mid = hubs[i].classList.contains('is-flip') ? p.x + 6 - w / 2 : p.x - 6 + w / 2;
          const d = Math.hypot(Math.max(0, Math.abs(px - mid) - w / 2), py - p.y);
          if (d < bd) {
            bd = d;
            pick = i;
          }
        });
      }
      if (pick < 0) pick = focused;
      if (pick !== hot) setHot(pick);
      box.style.cursor = hot >= 0 && focused !== hot ? (drag ? 'grabbing' : 'grab') : '';
      const hp = rest.map((p, i) => {
        const h = hubPos[i];
        let tx = 0;
        let ty = 0;
        if (i === pick && !drag && px > -1e3 && !calm) {
          const w = hubs[i].offsetWidth;
          tx = Math.max(-28, Math.min(28, (px - (hubs[i].classList.contains('is-flip') ? p.x + 6 - w / 2 : p.x - 6 + w / 2)) * 0.3));
          ty = Math.max(-28, Math.min(28, (py - p.y) * 0.4));
        }
        h.mx += (tx - h.mx) * 0.25;
        h.my += (ty - h.my) * 0.25;
        return { x: p.x + h.mx, y: p.y + h.my };
      });
      hp.forEach((p, i) => {
        hubs[i].style.transform = `translate(${p.x.toFixed(1)}px,${p.y.toFixed(1)}px)`;
        hubs[i].classList.toggle('is-flip', p.x + hubs[i].scrollWidth > W - 12);
      });
      // the dots follow their hub a little when it's dragged
      let best = 1e9;
      let nb = -1;
      const dg = dotPos.map((_, i) => gAt(now, dotDelay[i], 800));
      const dp = dotPos.map((d, i) => {
        const h = hubPos[d.g];
        let x = cx + (d.x * W - cx) * dg[i] + h.ox * 0.4 + Math.sin(t * 0.7 + d.ph) * 4 + pnx * 26 * depth[i];
        let y = cy + (d.y * Hh - cy) * dg[i] + h.oy * 0.4 + Math.cos(t * 0.6 + d.ph) * 4 + pny * 20 * depth[i];
        // a soft push away from the pointer
        const vx = x - spx;
        const vy = y - spy;
        const dd = Math.hypot(vx, vy) || 1;
        if (dd < 160 && reach > 0.01) {
          const f = (1 - dd / 160) ** 2 * 26 * reach;
          x += (vx / dd) * f;
          y += (vy / dd) * f;
        }
        const dist = Math.hypot(x - px, y - py);
        if (dist < best) {
          best = dist;
          nb = i;
        }
        return { x, y };
      });
      near = best < 36 ? nb : -1;
      const lit = dp.map((_, i) => i === near || dotPos[i].g === hot);
      // lit labels as boxes; push apart vertically any that would overlap,
      // hub labels count as fixed obstacles
      const LH = 16;
      const boxes = dp
        .map((p, i) => {
          const w = labels[i].offsetWidth;
          const flip = p.x + 14 + w > W - 8;
          return flip
            ? { i, x0: p.x - 14 - w, x1: p.x - 10, y: p.y, o: 0, flip }
            : { i, x0: p.x + 10, x1: p.x + 14 + w, y: p.y, o: 0, flip };
        })
        .filter((b) => lit[b.i]);
      const fixed = hp.map((p, i) => ({ x0: p.x - 8, x1: p.x + hubs[i].offsetWidth, y: p.y }));
      for (let pass = 0; pass < 8; pass++) {
        boxes.sort((a, b) => a.y + a.o - (b.y + b.o));
        for (let a = 0; a < boxes.length; a++) {
          const A = boxes[a];
          for (let b = a + 1; b < boxes.length; b++) {
            const B = boxes[b];
            if (A.x1 < B.x0 || B.x1 < A.x0) continue;
            const gap = B.y + B.o - (A.y + A.o);
            if (gap < LH) {
              A.o -= (LH - gap) / 2;
              B.o += (LH - gap) / 2;
            }
          }
          for (const F of fixed) {
            if (A.x1 < F.x0 || F.x1 < A.x0) continue;
            const gap = A.y + A.o - F.y;
            if (Math.abs(gap) < LH) A.o += (gap >= 0 ? 1 : -1) * (LH - Math.abs(gap));
          }
        }
      }
      const want = dp.map(() => 0);
      const flipped = dp.map(() => false);
      boxes.forEach((b) => {
        want[b.i] = Math.max(-40, Math.min(40, b.o));
        flipped[b.i] = b.flip;
      });
      dp.forEach((p, i) => {
        dots[i].style.transform = `translate(${p.x.toFixed(1)}px,${p.y.toFixed(1)}px)`;
        dots[i].style.opacity = Math.min(1, Math.max(0, (dg[i] - 0.3) / 0.5)).toFixed(3);
        if (dg[i] > 0.97 && !landed.has(dots[i])) {
          landed.add(dots[i]);
          if (!calm) pop(dots[i].firstElementChild, 2.6);
        }
        dots[i].classList.toggle('is-on', lit[i]);
        nudge[i] += (want[i] - nudge[i]) * 0.3;
        labels[i].style.translate = `0 ${nudge[i].toFixed(1)}px`;
        labels[i].style.left = flipped[i] ? `${-10 - labels[i].offsetWidth}px` : '';
      });
      lines.forEach((l) => {
        const p = l.hub !== undefined ? hp[l.hub] : dp[l.dot!];
        l.el.setAttribute('x1', cx.toFixed(1));
        l.el.setAttribute('y1', cy.toFixed(1));
        l.el.setAttribute('x2', p.x.toFixed(1));
        l.el.setAttribute('y2', p.y.toFixed(1));
        if (l.dot !== undefined) l.el.classList.toggle('is-on', dotPos[l.dot].g === hot || l.dot === near);
        const lg = l.hub !== undefined ? hg[l.hub] : dg[l.dot!];
        l.el.style.opacity = lg > 0.001 ? '1' : '0';
      });
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  });
</script>
