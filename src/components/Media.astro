---
import { srcset, urlFor } from '../lib/sanity';
import { edgeDetail } from '../lib/dhash';

interface Props {
  item: {
    _key: string;
    kind: 'image' | 'video' | 'lottie';
    size: 'full' | 'half';
    // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
    image?: any;
    // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
    poster?: any;
    videoUrl?: string;
    videoMime?: string;
    lottieUrl?: string;
  };
  eager?: boolean;
  /** the picture's own shape (width / height): the frame takes exactly
      that shape, so nothing is cropped */
  ratio?: number;
}
const { item, eager = false, ratio } = Astro.props;
const dims = item.image?.asset?.metadata?.dimensions;
const lqip = item.image?.asset?.metadata?.lqip;
const sizes = item.size === 'full' ? '(max-width: 809px) 100vw, 65vw' : '(max-width: 809px) 100vw, 32vw';
const isSvg = item.image?.asset?.mimeType === 'image/svg+xml';
// the parallax zoom trims ~7% off every edge: fine for a photo with quiet
// margins, not for a layout or UI that runs right to the edge — those stay
// still (shown whole)
const edge = edgeDetail((item.kind === 'image' ? item.image : item.poster)?.asset?.metadata?.lqip);
const EDGE_BUSY = 0.8;
const still = isSvg || (edge !== null && edge >= EDGE_BUSY);
---

<figure
  class={`media media--${item.size} media--${item.kind}${ratio ? ' media--fit' : ''}`}
  style={ratio ? `--r:${ratio.toFixed(4)}` : undefined}
  data-reveal
  data-parallax={item.kind === 'lottie' || still ? undefined : ''}
  data-edge={edge !== null ? edge.toFixed(2) : undefined}
>
  {item.kind === 'image' && item.image?.asset && (
    <img
      src={isSvg ? item.image.asset.url : urlFor(item.image).width(1600).quality(82).url()}
      srcset={isSvg ? undefined : srcset(item.image)}
      sizes={sizes}
      width={dims?.width}
      height={dims?.height}
      alt={item.image.alt ?? ''}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      style={lqip ? `background-image:url(${lqip})` : undefined}
    />
  )}
  {item.kind === 'video' && item.videoUrl && (
    <video
      data-src={item.videoUrl}
      data-autoplay
      muted
      loop
      playsinline
      preload="none"
      poster={item.poster?.asset ? urlFor(item.poster).width(1600).url() : undefined}
    />
  )}
  {item.kind === 'lottie' && item.lottieUrl && <div class="media__lottie" data-lottie={item.lottieUrl} />}
</figure>

<style>
  .media {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: #f2f2f2;
    border-radius: var(--photo-radius);
    /* keeps the corners clipped while the image inside moves (parallax) */
    isolation: isolate;
  }
  .media img,
  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-size: cover;
  }
  /* Half-width tiles use the same 0.82 portrait ratio as on the Framer site */
  .media--half {
    aspect-ratio: 0.82;
  }
  .media--full.media--image img {
    height: auto;
  }
  .media--full.media--video {
    aspect-ratio: 16 / 9;
  }
  .media--full.media--video:has(video[src]) {
    aspect-ratio: auto;
  }
  .media--full.media--video video {
    height: auto;
    min-height: 100%;
  }
  .media--lottie.media--full {
    aspect-ratio: 1.66;
  }
  /* exactly the picture's own shape (a video or animation corrects it once
     its real size is known): shown whole, never cropped */
  .media.media--fit {
    flex: var(--r) 1 0;
    min-width: 0;
    width: 100%;
    aspect-ratio: var(--r) !important;
  }
  .media--fit img,
  .media--fit video {
    height: 100% !important;
    min-height: 0;
  }
  .media__lottie {
    position: absolute;
    inset: 0;
  }
  .media__lottie :global(svg) {
    width: 100% !important;
    height: 100% !important;
  }
</style>
