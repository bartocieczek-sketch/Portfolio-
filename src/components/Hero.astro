---
import Nav from './Nav.astro';
import { stegaClean } from '@sanity/client/stega';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const name: string = stegaClean(settings.name ?? 'Bart Ocieczek').toUpperCase();
---

<script is:inline>
  // Decide before first paint whether to play the intro, so nothing flashes.
  // It plays on a fresh visit or a reload, but not when you come back to the
  // home page from another page of the site (link click or browser back).
  (function () {
    var skip = false;
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      skip = type === 'back_forward' || (type === 'navigate' && internal);
    } catch (e) {}
    if (!skip && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Start from the top instead of the restored scroll position
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      document.documentElement.classList.add('is-intro', 'is-scroll-locked');
    }
  })();
</script>

<section class="hero" data-hero>
  <canvas class="hero__dither intro-fade" aria-hidden="true" data-dither style="--delay:0ms"></canvas>

  <div class="hero__inner">
    <div class="intro-fade" style="--delay:0ms">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </div>

    <div class="hero__meta">
      <span class="t-label intro-fade" style="--delay:120ms">{home.established}</span>
      <span class="t-label intro-fade" style="--delay:160ms">{home.location}</span>
    </div>

    {home.heroVideoUrl && (
      <div class="hero__stage" data-hero-stage>
        <div class="hero__frame" data-intro-frame>
          <video src={home.heroVideoUrl} autoplay muted playsinline preload="auto" data-intro-video />
        </div>
        <span class="hero__mark hero__mark--tl intro-fade" aria-hidden="true" style="--delay:60ms"></span>
        <span class="hero__mark hero__mark--tr intro-fade" aria-hidden="true" style="--delay:90ms"></span>
        <span class="hero__mark hero__mark--bl intro-fade" aria-hidden="true" style="--delay:120ms"></span>
        <span class="hero__mark hero__mark--br intro-fade" aria-hidden="true" style="--delay:150ms"></span>
        <p class="hero__caption t-label-small intro-fade" style="--delay:200ms">
          <span>{name}</span>
          <span class="muted">Reel ©{new Date().getFullYear()}</span>
        </p>
      </div>
    )}

    <div class="hero__bottom">
      <div class="hero__headline">
        {home.badgeLabel && (
          <a class="badge intro-fade intro-rise" href={home.badgeUrl} target="_blank" rel="noopener" style="--delay:140ms">
            <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
            {home.badgeLabel}
          </a>
        )}
        {home.heroText && <h1 class="hero__statement t-subheading intro-rise" style="--delay:200ms">{home.heroText}</h1>}
      </div>
      <div class="hero__aside intro-fade intro-rise" style="--delay:280ms">
        {settings.role && <p class="t-label muted">{settings.role}</p>}
        <span class="hero__scroll t-label" aria-hidden="true">Scroll <span class="hero__arrow">↓</span></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    background: var(--surface-dark);
    overflow: clip;
    z-index: 1;
    padding: var(--gutter);
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 24px;
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
  }
  .hero__meta .t-label {
    color: var(--text-secondary);
  }

  /* ---------- Key visual ---------- */
  .hero__stage {
    position: relative;
    z-index: 5;
    align-self: center;
    justify-self: center;
    width: clamp(240px, 24vw, 460px);
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero__frame {
    position: relative;
    aspect-ratio: 1.43;
    overflow: hidden;
    transform-origin: 50% 50%;
  }
  .hero__frame video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Crop marks around the tile */
  .hero__mark {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 0 solid var(--text-secondary);
  }
  .hero__mark--tl {
    top: -10px;
    left: -10px;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .hero__mark--tr {
    top: -10px;
    right: -10px;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .hero__mark--bl {
    bottom: -10px;
    left: -10px;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .hero__mark--br {
    bottom: -10px;
    right: -10px;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }
  .hero__caption {
    position: absolute;
    top: calc(100% + 18px);
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--text-primary);
  }

  /* ---------- Bottom ---------- */
  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  .hero__headline {
    width: 504px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .hero__statement {
    margin: 0;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }
  .hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 16px;
    text-align: right;
  }
  .hero__aside .t-label {
    max-width: 320px;
    text-wrap: balance;
  }
  .hero__scroll {
    display: inline-flex;
    gap: 8px;
    color: var(--text-primary);
  }
  .hero__arrow {
    display: inline-block;
    animation: hero-nudge 1.8s var(--ease-in-out) infinite;
  }
  @keyframes hero-nudge {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(3px);
    }
  }

  /* ---------- Intro ----------
     1. The reel fills the whole screen and fades in.
     2. It plays for a moment, then shrinks into its small framed tile.
     3. Crop marks, captions and text arrive as it lands. Scroll is locked
        until then. */
  :global(html.is-intro) .intro-fade {
    opacity: 0;
  }
  :global(html.is-intro) .intro-rise {
    transform: translateY(12px);
  }
  /* 1% instead of 0 so the browser counts the h1 as painted from the first
     frame (otherwise Lighthouse reports NO_LCP). */
  :global(html.is-intro) .hero__statement {
    opacity: 0.01;
  }
  :global(html.is-intro) .hero__frame {
    opacity: 0;
  }
  .hero.is-ready .intro-fade,
  .hero.is-ready .intro-rise {
    opacity: 1;
    transform: none;
    transition: opacity 0.7s var(--ease-out), transform 0.9s var(--ease-expo);
    transition-delay: var(--delay, 0ms);
  }
  .hero.is-ready .hero__dither {
    transition-duration: 1.2s;
  }
  /* Safety net: if the intro script never runs, show everything anyway */
  :global(html.is-intro) .hero:not(.is-ready) .intro-fade,
  :global(html.is-intro) .hero:not(.is-ready) .intro-rise,
  :global(html.is-intro) .hero:not(.is-ready) .hero__frame {
    animation: intro-fallback 0.6s 4.5s forwards;
  }
  @keyframes intro-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.is-scroll-locked),
  :global(html.is-scroll-locked body) {
    overflow: hidden;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__arrow {
      animation: none;
    }
  }
  @media (max-width: 809px) {
    .hero__stage {
      width: min(72vw, 360px);
    }
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }
    .hero__aside {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      width: 100%;
      text-align: left;
    }
    .hero__statement {
      font-size: 22px;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finishIntro = () => {
    root.classList.remove('is-scroll-locked');
    document.dispatchEvent(new CustomEvent('intro:done'));
  };
  const frame = document.querySelector<HTMLElement>('[data-intro-frame]');

  // ---------- Intro ----------
  if (hero && root.classList.contains('is-intro') && frame) {
    // Timeline (ms):
    //   0–800      reel fades in full screen, settling from a slight zoom
    //   800–2000   holds while the reel plays
    //   2000–3200  shrinks into its tile; the rest arrives at ~55% of that
    const easeOut = 'cubic-bezier(0.23, 1, 0.32, 1)';
    const easeShrink = 'cubic-bezier(0.76, 0, 0.24, 1)';
    const ENTER = 800;
    const HOLD = 1200;
    const SHRINK = 1200;

    const r = frame.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Uniform scale that covers the screen (the video is object-fit: cover,
    // so it keeps its crop all the way down)
    const s = Math.max(vw / r.width, vh / r.height) * 1.02;
    const dx = vw / 2 - (r.left + r.width / 2);
    const dy = vh / 2 - (r.top + r.height / 2);
    const full = `translate(${dx}px, ${dy}px) scale(${s})`;

    frame.style.opacity = '1';
    frame.animate(
      [
        { transform: `translate(${dx}px, ${dy}px) scale(${s * 1.08})`, opacity: 0 },
        { transform: full, opacity: 1 },
      ],
      { duration: ENTER, easing: easeOut, fill: 'both' },
    );
    frame
      .animate([{ transform: full }, { transform: 'none' }], {
        duration: SHRINK,
        delay: ENTER + HOLD,
        easing: easeShrink,
        fill: 'both',
      })
      .finished.then(() => {
        frame.getAnimations().forEach((a) => a.cancel());
        finishIntro();
      });

    setTimeout(() => hero.classList.add('is-ready'), ENTER + HOLD + SHRINK * 0.55);
  } else {
    hero?.classList.add('is-ready');
    root.classList.remove('is-intro');
    finishIntro();
  }

  // ---------- Scroll ----------
  // While the page slides over the sticky hero, the tile grows a little and
  // the text around it fades, so the reel stays the last thing you see.
  const stage = document.querySelector<HTMLElement>('[data-hero-stage]');
  if (hero && stage && !reduceMotion) {
    const fading = [...hero.querySelectorAll<HTMLElement>('.hero__meta, .hero__bottom, .hero__caption, .hero__mark')];
    let queued = false;
    const update = () => {
      queued = false;
      const p = Math.min(1, Math.max(0, window.scrollY / window.innerHeight));
      stage.style.transform = p ? `translateY(${(p * 12).toFixed(2)}vh) scale(${(1 + p * 0.6).toFixed(4)})` : '';
      const o = p ? String(Math.max(0, 1 - p * 1.6).toFixed(3)) : '';
      for (const el of fading) el.style.opacity = o;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(update);
      },
      { passive: true },
    );
    update();
  }

  // ASCII cursor field (inspired by dovetail.com): an invisible grid of
  // monospace characters lights up around the pointer, flickers, and fades
  // out behind it, with the odd faint character twinkling in the background.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const CHARS = '0123.:*%+-=<>/|_';
    const CELL_W = 16;
    const CELL_H = 16;
    const RADIUS = 170;
    const DECAY = 0.955;
    const COLOR = '223, 223, 223';
    let cols = 0;
    let rows = 0;
    let energy = new Float32Array(0);
    let glyph = new Uint8Array(0);
    let dpr = 1;
    let visible = true;
    let lastPoint: { x: number; y: number } | null = null;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H);
      energy = new Float32Array(cols * rows);
      glyph = new Uint8Array(cols * rows).map(() => (Math.random() * CHARS.length) | 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // Light up cells in a ragged circle around a point
    const stamp = (px: number, py: number) => {
      const c0 = Math.max(0, Math.floor((px - RADIUS) / CELL_W));
      const c1 = Math.min(cols - 1, Math.ceil((px + RADIUS) / CELL_W));
      const r0 = Math.max(0, Math.floor((py - RADIUS) / CELL_H));
      const r1 = Math.min(rows - 1, Math.ceil((py + RADIUS) / CELL_H));
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          const dx = c * CELL_W + CELL_W / 2 - px;
          const dy = r * CELL_H + CELL_H / 2 - py;
          const d = Math.sqrt(dx * dx + dy * dy) / RADIUS;
          if (d >= 1) continue;
          // sparse, noisy fill so it reads as scattered glyphs, not a solid disc
          if (Math.random() > 0.55 + (1 - d) * 0.25) continue;
          const v = Math.pow(1 - d, 1.4) * (0.55 + Math.random() * 0.45);
          const i = r * cols + c;
          if (v > energy[i]) energy[i] = v;
        }
      }
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        if (y < -RADIUS || y > rect.height + RADIUS) {
          lastPoint = null;
          return;
        }
        // fill the gap between fast pointer moves so the trail stays continuous
        if (lastPoint) {
          const dist = Math.hypot(x - lastPoint.x, y - lastPoint.y);
          const steps = Math.min(8, Math.floor(dist / 40));
          for (let k = 1; k <= steps; k++) {
            stamp(lastPoint.x + ((x - lastPoint.x) * k) / (steps + 1), lastPoint.y + ((y - lastPoint.y) * k) / (steps + 1));
          }
        }
        stamp(x, y);
        lastPoint = { x, y };
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => (lastPoint = null));

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    let last = 0;
    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 40) return;
      last = now;

      // ambient twinkle: a couple of faint characters appear at random
      for (let k = 0; k < 2; k++) {
        const i = (Math.random() * energy.length) | 0;
        energy[i] = Math.max(energy[i], 0.12 + Math.random() * 0.12);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = `500 12px 'Chivo Mono', ui-monospace, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let i = 0; i < energy.length; i++) {
        const v = energy[i];
        if (v < 0.02) {
          energy[i] = 0;
          continue;
        }
        // lit characters flicker to a new glyph now and then
        if (Math.random() < 0.06) glyph[i] = (Math.random() * CHARS.length) | 0;
        const c = i % cols;
        const r = (i / cols) | 0;
        ctx.fillStyle = `rgba(${COLOR}, ${(v * 0.6).toFixed(3)})`;
        ctx.fillText(CHARS[glyph[i]], c * CELL_W + CELL_W / 2, r * CELL_H + CELL_H / 2);
        energy[i] = v * DECAY;
      }
    };
    requestAnimationFrame(draw);
  }
</script>
