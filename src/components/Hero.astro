---
import Nav from './Nav.astro';
import { stegaClean } from '@sanity/client/stega';
import { urlFor } from '../lib/sanity';
import { href } from '../lib/preview';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const name: string = stegaClean(settings.name ?? 'Bart Ocieczek');

// Up to four case studies flank the reel: half on each side
// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const picks: any[] = (home.projects ?? []).filter((p: any) => p?.cover?.asset).slice(0, 4);
const half = Math.ceil(picks.length / 2);
const tile = (p: any, side: 'l' | 'r', i: number) => ({
  title: (p.cardTitle || p.title || '').trim(),
  href: href(Astro.locals, `/${p.slug}`),
  src: urlFor(p.cover).width(520).quality(80).url(),
  side,
  // distance from the reel: 1 = next to it, 2 = outer
  dist: i,
});
const left = picks.slice(0, half).map((p, i, a) => tile(p, 'l', a.length - i));
const right = picks.slice(half).map((p, i) => tile(p, 'r', i + 1));
---

<script is:inline>
  // Decide before first paint whether to play the intro, so nothing flashes.
  // It plays on a fresh visit or a reload, but not when you come back to the
  // home page from another page of the site (link click or browser back).
  (function () {
    var skip = false;
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      skip = type === 'back_forward' || (type === 'navigate' && internal);
    } catch (e) {}
    if (!skip && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      document.documentElement.classList.add('is-intro');
    }
  })();
</script>

<section class="hero" data-hero>
  <div class="hero__sticky">
    <canvas class="hero__dither" aria-hidden="true" data-dither></canvas>

    <div class="hero__nav intro-item" style="--delay:0ms">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </div>

    <div class="hero__center">
      <div class="hero__text" data-hero-text>
        {home.badgeLabel && (
          <a class="badge intro-item" href={home.badgeUrl} target="_blank" rel="noopener" style="--delay:80ms">
            <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
            {home.badgeLabel}
          </a>
        )}
        {home.heroText && <h1 class="hero__statement intro-item" style="--delay:140ms">{home.heroText}</h1>}
      </div>

      <div class="hero__strip" data-hero-strip>
        {left.map((t) => (
          <a class="hero__tile intro-tile" href={t.href} data-side="l" style={`--dist:${t.dist}`}>
            <img src={t.src} alt="" loading="eager" decoding="async" />
            <span class="hero__tile-label t-label-small">{t.title}</span>
          </a>
        ))}
        {home.heroVideoUrl && (
          <div class="hero__reel intro-tile" style="--dist:0" data-hero-reel>
            <video src={home.heroVideoUrl} autoplay muted playsinline preload="auto" aria-label={`${name} showreel`} />
          </div>
        )}
        {right.map((t) => (
          <a class="hero__tile intro-tile" href={t.href} data-side="r" style={`--dist:${t.dist}`}>
            <img src={t.src} alt="" loading="eager" decoding="async" />
            <span class="hero__tile-label t-label-small">{t.title}</span>
          </a>
        ))}
      </div>

      <p class="hero__meta t-label-small intro-item" style="--delay:420ms" data-hero-meta>
        <span>{home.established}</span>
        <span aria-hidden="true">·</span>
        <span>{home.location}</span>
      </p>
    </div>
  </div>
</section>

<style>
  /* The section is taller than the screen: the content stays pinned while the
     extra height drives the reel's scroll scale. */
  .hero {
    position: relative;
    height: 200vh;
    background: var(--surface-dark);
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: clip;
    padding: var(--gutter);
    display: flex;
    flex-direction: column;
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__nav {
    position: relative;
    z-index: 3;
  }
  .hero__center {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 48px;
    padding-bottom: 32px;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hero__statement {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }

  /* ---------- Strip: projects around the reel ---------- */
  .hero__strip {
    --h: clamp(150px, 15vw, 250px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .hero__reel {
    position: relative;
    z-index: 2;
    height: var(--h);
    aspect-ratio: 1.43;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero__reel video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__tile {
    position: relative;
    height: calc(var(--h) * 0.62);
    aspect-ratio: 0.8;
    will-change: transform, opacity;
  }
  .hero__tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) brightness(0.7);
    transition: filter 0.4s var(--ease-out), transform 0.5s var(--ease-out);
  }
  .hero__tile-label {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    white-space: nowrap;
    color: var(--text-primary);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .hero__tile[data-side='l'] .hero__tile-label {
    left: auto;
    right: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__tile:hover img,
    .hero__tile:focus-visible img {
      filter: none;
      transform: scale(1.04);
    }
    .hero__tile:hover .hero__tile-label,
    .hero__tile:focus-visible .hero__tile-label {
      opacity: 1;
      transform: none;
    }
  }

  .hero__meta {
    display: flex;
    gap: 10px;
    color: var(--text-secondary);
  }

  /* ---------- Intro ----------
     Text rises in, then the tiles appear from the reel outwards. */
  :global(html.is-intro) .intro-item {
    opacity: 0;
    transform: translateY(14px);
  }
  /* 1% instead of 0 so the browser counts the h1 as painted from the first
     frame (otherwise Lighthouse reports NO_LCP). */
  :global(html.is-intro) .hero__statement {
    opacity: 0.01;
  }
  :global(html.is-intro) .intro-tile {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }
  .hero.is-ready .intro-item,
  .hero.is-ready .intro-tile {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-expo);
    transition-delay: var(--delay, 0ms);
  }
  .hero.is-ready .intro-tile {
    transition-delay: calc(260ms + var(--dist) * 90ms);
  }
  /* Once settled, scroll drives these directly; transitions would make it lag */
  .hero.is-settled :is(.intro-item, .intro-tile) {
    transition: none;
  }
  /* Safety net: if the intro script never runs, show everything anyway */
  :global(html.is-intro) .hero:not(.is-ready) :is(.intro-item, .intro-tile) {
    animation: intro-fallback 0.6s 3s forwards;
  }
  @keyframes intro-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 809px) {
    .hero {
      height: 170vh;
    }
    .hero__center {
      gap: 36px;
    }
    .hero__strip {
      --h: 46vw;
      gap: 8px;
    }
    /* Only the inner pair fits on a phone */
    .hero__tile[style*='--dist:2'] {
      display: none;
    }
    .hero__tile {
      height: calc(var(--h) * 0.7);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------- Intro ----------
  if (hero && root.classList.contains('is-intro')) {
    requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add('is-ready')));
    window.setTimeout(() => hero.classList.add('is-settled'), 1800);
  } else {
    hero?.classList.add('is-ready', 'is-settled');
    root.classList.remove('is-intro');
  }
  document.dispatchEvent(new CustomEvent('intro:done'));

  // ---------- Scroll ----------
  // While the hero is pinned, the reel grows to a large (not full-screen)
  // frame in the centre; the projects slide outwards and the text fades.
  const reel = document.querySelector<HTMLElement>('[data-hero-reel]');
  if (hero && reel && !reduceMotion) {
    const tiles = [...hero.querySelectorAll<HTMLElement>('.hero__tile')];
    const text = hero.querySelector<HTMLElement>('[data-hero-text]');
    const meta = hero.querySelector<HTMLElement>('[data-hero-meta]');
    let base = { w: 1, h: 1, cx: 0, cy: 0 };

    const measure = () => {
      const prev = reel.style.transform;
      reel.style.transform = '';
      const r = reel.getBoundingClientRect();
      const top = hero.getBoundingClientRect().top;
      base = { w: r.width, h: r.height, cx: r.left + r.width / 2, cy: r.top - top + r.height / 2 };
      reel.style.transform = prev;
    };

    let queued = false;
    const update = () => {
      queued = false;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const range = hero.offsetHeight - vh;
      const p = Math.min(1, Math.max(0, -hero.getBoundingClientRect().top / range));
      // ease the progress so the growth settles gently
      const e = 1 - Math.pow(1 - p, 3);

      // target: 72% of the width, never taller than 78% of the screen
      const target = Math.min((vw * 0.72) / base.w, (vh * 0.78) / base.h);
      const scale = 1 + (target - 1) * e;
      const dx = (vw / 2 - base.cx) * e;
      const dy = (vh / 2 - base.cy) * e;
      reel.style.transform = p ? `translate3d(${dx.toFixed(1)}px, ${dy.toFixed(1)}px, 0) scale(${scale.toFixed(4)})` : '';

      for (const t of tiles) {
        const dir = t.dataset.side === 'l' ? -1 : 1;
        const dist = Number(t.style.getPropertyValue('--dist')) || 1;
        const x = dir * e * (base.w * (target - 1) * 0.5 + 60 * dist);
        t.style.transform = p ? `translate3d(${x.toFixed(1)}px, ${(dy * 0.4).toFixed(1)}px, 0)` : '';
        t.style.opacity = p ? String(Math.max(0, 1 - p * 1.8).toFixed(3)) : '';
      }
      const fade = p ? String(Math.max(0, 1 - p * 2.4).toFixed(3)) : '';
      if (text) {
        text.style.opacity = fade;
        text.style.transform = p ? `translateY(${(-p * 60).toFixed(1)}px)` : '';
      }
      if (meta) meta.style.opacity = fade;
    };
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    measure();
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      update();
    });
  }

  // ASCII cursor field (inspired by dovetail.com): an invisible grid of
  // monospace characters lights up around the pointer, flickers, and fades
  // out behind it, with the odd faint character twinkling in the background.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const CHARS = '0123.:*%+-=<>/|_';
    const CELL_W = 16;
    const CELL_H = 16;
    const RADIUS = 170;
    const DECAY = 0.955;
    const COLOR = '223, 223, 223';
    let cols = 0;
    let rows = 0;
    let energy = new Float32Array(0);
    let glyph = new Uint8Array(0);
    let dpr = 1;
    let visible = true;
    let lastPoint: { x: number; y: number } | null = null;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H);
      energy = new Float32Array(cols * rows);
      glyph = new Uint8Array(cols * rows).map(() => (Math.random() * CHARS.length) | 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // Light up cells in a ragged circle around a point
    const stamp = (px: number, py: number) => {
      const c0 = Math.max(0, Math.floor((px - RADIUS) / CELL_W));
      const c1 = Math.min(cols - 1, Math.ceil((px + RADIUS) / CELL_W));
      const r0 = Math.max(0, Math.floor((py - RADIUS) / CELL_H));
      const r1 = Math.min(rows - 1, Math.ceil((py + RADIUS) / CELL_H));
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          const dx = c * CELL_W + CELL_W / 2 - px;
          const dy = r * CELL_H + CELL_H / 2 - py;
          const d = Math.sqrt(dx * dx + dy * dy) / RADIUS;
          if (d >= 1) continue;
          // sparse, noisy fill so it reads as scattered glyphs, not a solid disc
          if (Math.random() > 0.55 + (1 - d) * 0.25) continue;
          const v = Math.pow(1 - d, 1.4) * (0.55 + Math.random() * 0.45);
          const i = r * cols + c;
          if (v > energy[i]) energy[i] = v;
        }
      }
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        if (y < -RADIUS || y > rect.height + RADIUS) {
          lastPoint = null;
          return;
        }
        // fill the gap between fast pointer moves so the trail stays continuous
        if (lastPoint) {
          const dist = Math.hypot(x - lastPoint.x, y - lastPoint.y);
          const steps = Math.min(8, Math.floor(dist / 40));
          for (let k = 1; k <= steps; k++) {
            stamp(lastPoint.x + ((x - lastPoint.x) * k) / (steps + 1), lastPoint.y + ((y - lastPoint.y) * k) / (steps + 1));
          }
        }
        stamp(x, y);
        lastPoint = { x, y };
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => (lastPoint = null));

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    let last = 0;
    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 40) return;
      last = now;

      // ambient twinkle: a couple of faint characters appear at random
      for (let k = 0; k < 2; k++) {
        const i = (Math.random() * energy.length) | 0;
        energy[i] = Math.max(energy[i], 0.12 + Math.random() * 0.12);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = `500 12px 'Chivo Mono', ui-monospace, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let i = 0; i < energy.length; i++) {
        const v = energy[i];
        if (v < 0.02) {
          energy[i] = 0;
          continue;
        }
        // lit characters flicker to a new glyph now and then
        if (Math.random() < 0.06) glyph[i] = (Math.random() * CHARS.length) | 0;
        const c = i % cols;
        const r = (i / cols) | 0;
        ctx.fillStyle = `rgba(${COLOR}, ${(v * 0.6).toFixed(3)})`;
        ctx.fillText(CHARS[glyph[i]], c * CELL_W + CELL_W / 2, r * CELL_H + CELL_H / 2);
        energy[i] = v * DECAY;
      }
    };
    requestAnimationFrame(draw);
  }
</script>
