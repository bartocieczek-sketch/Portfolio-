---
import Nav from './Nav.astro';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const name: string = (settings.name ?? 'Bart Ocieczek').toUpperCase();
const center = (name.length - 1) / 2;
---

<script is:inline>
  // Decide before first paint whether to play the intro, so nothing flashes.
  // It plays once per visit: coming back to the home page from another page skips it.
  (function () {
    var seen = false;
    try {
      seen = sessionStorage.getItem('intro-played') === '1';
      sessionStorage.setItem('intro-played', '1');
    } catch (e) {}
    if (!seen && window.scrollY < 50 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('is-intro', 'is-scroll-locked');
    }
  })();
</script>

<section class="hero" data-hero>
  <canvas class="hero__dither intro-fade" aria-hidden="true" data-dither></canvas>

  <div class="hero__inner">
    <div class="intro-fade">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </div>

    <div class="hero__middle">
      <div class="hero__headline intro-fade">
        {home.badgeLabel && (
          <a class="badge" href={home.badgeUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
            {home.badgeLabel}
          </a>
        )}
        {home.heroText && <p class="t-subheading">{home.heroText}</p>}
      </div>
      {home.heroVideoUrl && (
        <div class="hero__video">
          <video src={home.heroVideoUrl} autoplay muted playsinline preload="auto" data-intro-video />
        </div>
      )}
    </div>

    <div class="hero__bottom">
      <div class="hero__meta intro-fade">
        <span class="t-label">{home.established}</span>
        <span class="t-label">{home.location}</span>
      </div>
      <h1 class="hero__name" data-fit aria-label={name}>
        {[...name].map((ch, i) => (
          <span class="hero__char" aria-hidden="true" style={`--d:${(Math.abs(i - center) * 0.06).toFixed(2)}s`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    background: var(--surface-dark);
    overflow: clip;
    z-index: 1;
    padding: var(--gutter);
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.14;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__middle {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }
  .hero__headline {
    width: 504px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }
  .hero__video {
    width: 30%;
    align-self: flex-start;
  }
  .hero__video video {
    position: relative;
    z-index: 5;
    width: clamp(160px, 14.35vw, 320px);
    aspect-ratio: 1.43;
    object-fit: cover;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
  }
  .hero__meta .t-label {
    color: var(--text-secondary);
  }
  .hero__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17.6vw;
    line-height: 0.82;
    letter-spacing: 0;
    white-space: nowrap;
    display: flex;
    width: max-content;
    margin-bottom: -0.06em;
  }
  .hero__char {
    display: inline-block;
    color: transparent;
    background: linear-gradient(180deg, #c4c4c4 0%, #8f8f8f 70%, #6c6c6c 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ---------- Intro / preloader (recreated from the Framer site) ----------
     1. The video tile rises into the centre of an empty dark screen.
     2. It plays for a moment, then shrinks and flies to its spot in the hero.
     3. Meanwhile the rest of the hero fades in and the letters rise from the
        centre outwards. Scroll is locked until the tile has landed. */
  :global(html.is-intro) .intro-fade {
    opacity: 0;
  }
  :global(html.is-intro) .hero__char {
    opacity: 0;
    transform: translateY(60px);
  }
  :global(html.is-intro) .hero__video video {
    opacity: 0;
  }
  .hero.is-ready .intro-fade {
    opacity: 1;
    transition: opacity 0.9s var(--ease-expo);
  }
  .hero.is-ready .hero__dither {
    opacity: 0.14;
    transition-duration: 1.6s;
  }
  .hero.is-ready .hero__char {
    opacity: 1;
    transform: none;
    transition: opacity 1.5s var(--ease-expo), transform 1.5s var(--ease-expo);
    transition-delay: calc(0.15s + var(--d));
  }
  /* Safety net: if the intro script never runs, show everything anyway */
  :global(html.is-intro) .hero:not(.is-ready) .intro-fade,
  :global(html.is-intro) .hero:not(.is-ready) .hero__char,
  :global(html.is-intro) .hero:not(.is-ready) .hero__video video {
    animation: intro-fallback 0.6s 4s forwards;
  }
  @keyframes intro-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.is-scroll-locked),
  :global(html.is-scroll-locked body) {
    overflow: hidden;
  }
  @media (max-width: 809px) {
    .hero__middle {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .hero__video {
      width: auto;
    }
    .hero__headline .t-subheading {
      font-size: 22px;
    }
  }
</style>

<script>
  // Make "BART OCIECZEK" exactly fill the content width
  const fit = () => {
    document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const parent = el.parentElement!;
      el.style.fontSize = '100px';
      const ratio = parent.clientWidth / el.getBoundingClientRect().width;
      el.style.fontSize = `${Math.floor(100 * ratio * 10) / 10}px`;
    });
  };
  document.fonts.ready.then(fit);
  window.addEventListener('resize', fit);
  fit();

  // ---------- Intro ----------
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;
  const finishIntro = () => {
    root.classList.remove('is-scroll-locked');
    document.dispatchEvent(new CustomEvent('intro:done'));
  };
  const video = document.querySelector<HTMLVideoElement>('[data-intro-video]');

  if (hero && root.classList.contains('is-intro') && video) {
    const ease = 'cubic-bezier(0.16, 1, 0.3, 1)';
    const r = video.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Size of the tile while it sits in the middle (22.4% of the width on desktop, like on Framer)
    const centreWidth = vw < 810 ? vw * 0.7 : vw * 0.224;
    const s = centreWidth / r.width;
    const dx = vw / 2 - (r.left + r.width / 2);
    const dy = vh / 2 - (r.top + r.height / 2);
    const centred = `translate(${dx}px, ${dy}px) scale(${s})`;

    video.style.opacity = '1';
    video
      .animate(
        [
          { transform: `translate(${dx}px, ${dy + 170}px) scale(${s})`, opacity: 0 },
          { transform: centred, opacity: 1 },
        ],
        { duration: 800, easing: ease, fill: 'both' },
      )
      .finished.then(() =>
        video.animate([{ transform: centred }, { transform: 'none' }], {
          duration: 850,
          delay: 950,
          easing: ease,
          fill: 'both',
        }).finished,
      )
      .then(finishIntro);

    // The rest of the hero starts appearing as the tile leaves the centre
    setTimeout(() => hero.classList.add('is-ready'), 1750);
  } else {
    hero?.classList.add('is-ready');
    root.classList.remove('is-intro');
    finishIntro();
  }


  // Recreation of the Framer "DitherShader" (circle variant): an ordered-dither
  // glow that drifts slowly and ripples where the pointer moves.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
    const cell = 3; // pixel size of one dither dot in CSS px
    let w = 0;
    let h = 0;
    let img: ImageData;
    const ripples: { x: number; y: number; t: number }[] = [];
    let visible = true;
    let last = 0;

    const resize = () => {
      w = Math.ceil(canvas.clientWidth / cell);
      h = Math.ceil(canvas.clientHeight / cell);
      canvas.width = w;
      canvas.height = h;
      canvas.style.imageRendering = 'pixelated';
      img = ctx.createImageData(w, h);
    };
    resize();
    window.addEventListener('resize', resize);

    let lastRipple = 0;
    window.addEventListener('pointermove', (e) => {
      const now = performance.now();
      if (now - lastRipple < 120) return;
      lastRipple = now;
      const r = canvas.getBoundingClientRect();
      ripples.push({ x: (e.clientX - r.left) / cell, y: (e.clientY - r.top) / cell, t: now });
      if (ripples.length > 6) ripples.shift();
    }, { passive: true });

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 30) return;
      last = now;
      const t = now * 0.0002;
      const cx = w * (0.5 + 0.18 * Math.sin(t * 1.3));
      const cy = h * (0.45 + 0.15 * Math.cos(t));
      const radius = Math.max(w, h) * 0.55;
      const data = img.data;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const dx = x - cx;
          const dy = y - cy;
          let v = 1 - Math.sqrt(dx * dx + dy * dy) / radius;
          v = v * v * 0.75 + 0.06 * Math.sin(x * 0.07 + y * 0.05 + t * 8);
          for (const rp of ripples) {
            const age = (now - rp.t) / 1000;
            if (age > 2) continue;
            const d = Math.hypot(x - rp.x, y - rp.y);
            const ring = Math.abs(d - age * 60);
            if (ring < 3) v += (1 - ring / 3) * 0.4 * (1 - age / 2);
          }
          // fade the edges
          const edge = Math.min(x, y, w - x, h - y) / (Math.min(w, h) * 0.55);
          v *= Math.min(1, edge);
          const on = v > bayer[(y & 3) * 4 + (x & 3)];
          const i = (y * w + x) * 4;
          data[i] = data[i + 1] = data[i + 2] = 223;
          data[i + 3] = on ? 255 : 0;
        }
      }
      ctx.putImageData(img, 0, 0);
    };
    requestAnimationFrame(draw);
  }
</script>
