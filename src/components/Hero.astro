---
// Home: an endless centred column of pill-shaped covers.
// - The column loops forever: wheel, trackpad, touch or arrow keys move it,
//   and when you let go it eases onto the nearest project.
// - The project in the middle drives the rolling texts on either side.
// - Covers near the top and bottom edges stretch, flare and split their colour,
//   more the faster they move (drawn in WebGL over the DOM images, which keep
//   the layout and the links).
// - On arrival the covers stream down from above the screen and settle.
import Nav from './Nav.astro';
import { urlFor } from '../lib/sanity';
import { href } from '../lib/preview';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
  // a big, barely-there 3D B behind the column (the /v2 variant)
  backdrop?: boolean;
}
const { home, settings, backdrop = false } = Astro.props;

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = (home.projects ?? []).filter((p: any) => p?.cover?.asset).map((p: any) => ({
  title: (p.cardTitle || p.title || '').trim(),
  year: p.year ?? '',
  tags: ((p.cardTags ?? []) as string[]).map((t) => t.replace(/,\s*$/, '')).slice(0, 3),
  href: href(Astro.locals, `/${p.slug}`),
  src: urlFor(p.cover).width(1000).height(1250).fit('crop').quality(82).url(),
}));
// Three laps are rendered; the script keeps the middle one in view and wraps
const LAPS = 3;
---

<script is:inline>
  // The column streams in on a fresh visit or reload, not when coming back
  // from another page of the site.
  (function () {
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      var skip = type === 'back_forward' || (type === 'navigate' && internal);
      var calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.add('is-endless');
      if (!skip && !calm) document.documentElement.classList.add('is-arriving', 'is-preloading');
    } catch (e) {}
  })();
</script>
<script>
  // the preloader's chrome B, drawn in three.js; it signals once drawn so the
  // drop-in waits for it, and is torn down when the preloader leaves
  import { mountPreloadMark } from '../lib/preload-mark';
  import { mountBackdropMark } from '../lib/backdrop-mark';
  mountPreloadMark();
  mountBackdropMark();
</script>

<div class="preload" aria-hidden="true" data-preload>
  <div class="preload__lock">
    <span class="preload__side preload__side--l"><span class="preload__w">Bart</span><span class="preload__w">Design</span></span>
    <canvas class="preload__mark" data-preload-mark></canvas>
    <span class="preload__side preload__side--r"><span class="preload__w">Ocieczek</span><span class="preload__w">Engineer</span></span>
  </div>
</div>
<script is:inline>
  // Preloader: the chrome B lands in the middle (its 3D side turns it to face
  // you); then, word by word as in the first preloader, Bart drops in to its
  // left and Ocieczek to its right, they fall on down while Designer and
  // Developer drop into their places, and those fall away with the B as the
  // column streams in. One timeline per element, so a busy main thread can
  // never skip a beat.
  (function () {
    var root = document.documentElement;
    var el = document.querySelector('[data-preload]');
    if (!el) return;
    if (!root.classList.contains('is-preloading') || !el.animate) {
      root.classList.remove('is-preloading');
      el.remove();
      return;
    }
    var mark = el.querySelector('[data-preload-mark]');
    var words = el.querySelectorAll('.preload__w');
    var OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
    var IN = 'cubic-bezier(0.16, 1, 0.3, 1)';
    var SWAP = 'cubic-bezier(0.77, 0, 0.175, 1)';
    var FALL = 'cubic-bezier(0.7, 0, 0.84, 0)';
    var down = 'translateY(-115%)', mid = 'none', up = 'translateY(115%)';
    var L = 650; // the B lands first
    var T = L + 2670;
    var LEAVE = L + 2150;
    var track = function (node, steps) {
      return node.animate(
        steps.map(function (s) {
          var f = Object.assign({}, s[1]);
          f.offset = s[0] / T;
          f.easing = s[2] || 'linear';
          return f;
        }),
        { duration: T, fill: 'both' },
      );
    };
    var started = false;
    var done = false;
    var finish = function () {
      if (done) return;
      done = true;
      root.classList.remove('is-preloading');
      window.dispatchEvent(new Event('preload:done'));
      el.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 450, easing: 'ease-out', fill: 'both' }).finished.then(function () {
        el.remove();
      });
    };
    var start = function () {
      if (started) return;
      started = true;
      var a = track(mark, [
        [0, { opacity: 0, transform: 'translateY(-12px) scale(0.9)' }, OUT],
        [750, { opacity: 1, transform: 'none' }],
        [LEAVE, { opacity: 1, transform: 'none' }, FALL],
        [T, { opacity: 0, transform: 'translateY(22%) scale(0.94)' }],
      ]);
      // the 3D side reads this timeline to spin away in step with the fall
      window.__preloadMark = { anim: a, leave: LEAVE, out: 520 };
      // [Bart, Design] on the left, [Ocieczek, Engineer] 60ms behind
      [0, 2].forEach(function (i, side) {
        var lag = side * 60;
        track(words[i], [
          [0, { transform: down }],
          [L + 120 + lag, { transform: down }, IN],
          [L + 920 + lag, { transform: mid }],
          [L + 1150 + lag, { transform: mid }, SWAP],
          [L + 1850 + lag, { transform: up }],
          [T, { transform: up }],
        ]);
        track(words[i + 1], [
          [0, { transform: down }],
          [L + 1150 + lag, { transform: down }, SWAP],
          [L + 1850 + lag, { transform: mid }],
          [LEAVE + lag, { transform: mid }, FALL],
          [Math.min(T, L + 2670 + lag), { transform: up }],
        ]);
      });
      // the column starts falling as the words leave (read off the timeline)
      var watch = function () {
        if (done) return;
        if (Number(a.currentTime) >= LEAVE + 300 || a.playState === 'finished') finish();
        else requestAnimationFrame(watch);
      };
      requestAnimationFrame(watch);
      a.finished.then(finish, finish);
      setTimeout(finish, T + 4000); // only if the timeline never ends
    };
    // wait for the 3D to be drawn (it signals) but never hold the page long
    window.addEventListener('preload:mark-ready', start, { once: true });
    setTimeout(start, 900);
  })();
</script>

<section class="vh" data-vh>
  <canvas class="vh__gl" aria-hidden="true" data-gl></canvas>
  {backdrop && <canvas class="vh__backdrop" aria-hidden="true" data-backdrop></canvas>}

  <div class="vh__nav">
    <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
  </div>

  <!-- Project details: a hairline across the middle of the screen, behind
       the column, with the centred project's details hanging under it -->
  <div class="vh__line" aria-hidden="true"></div>
  <div class="vh__details vh__fade" aria-hidden="true">
    <span class="vh__col vh__num"><span class="vh__track" data-vh-track>
      {Array.from({ length: 3 }, () => projects.map((_: any, i: number) => <span class="vh__cell">{String(i + 1).padStart(2, '0')}</span>))}
    </span></span>
    <span class="vh__col vh__tags"><span class="vh__track" data-vh-track>
      {Array.from({ length: 3 }, () => projects.map((p: any) => <span class="vh__cell">{p.tags.join(', ')}</span>))}
    </span></span>
    <span class="vh__col vh__names"><span class="vh__track" data-vh-track>
      {Array.from({ length: 3 }, () => projects.map((p: any) => <span class="vh__cell vh__name">{p.title}</span>))}
    </span></span>
    <span class="vh__col vh__year"><span class="vh__track" data-vh-track>
      {Array.from({ length: 3 }, () => projects.map((p: any) => <span class="vh__cell">{p.year}</span>))}
    </span></span>
  </div>

  <div class="vh__intro vh__fade">
    {home.badgeLabel && (
      <a class="badge" href={home.badgeUrl} target="_blank" rel="noopener">
        <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
        {home.badgeLabel}
      </a>
    )}
    {home.heroText && <h1 class="vh__statement">{home.heroText}</h1>}
  </div>

  <p class="vh__hint vh__fade t-label-small" aria-hidden="true">Scroll <span>↕</span></p>

  <div class="vh__viewport" data-vh-viewport>
    <ol class="vh__list" data-vh-list>
      {Array.from({ length: LAPS }, (_, lap) =>
        projects.map((p: any, i: number) => (
          <li class="vh__item" aria-hidden={lap === 1 ? undefined : 'true'}>
            <a
              class="vh__pill"
              href={p.href}
              data-media
              data-index={i}
              data-src={p.src}
              tabindex={lap === 1 ? undefined : -1}
              aria-label={lap === 1 ? `${p.title} case study` : undefined}
              draggable="false"
            >
              <img src={p.src} alt="" width="1000" height="1250" loading="eager" decoding="async" draggable="false" />
            </a>
          </li>
        )),
      )}
    </ol>
  </div>
</section>

<script is:inline>
  // The cover in the middle of the screen is drawn a little larger than the
  // ones coming in; its neighbours move out by just as much, so every gap
  // stays the same. Driven by the column's position (layout px, never by
  // measured, already-scaled boxes); desktop only.
  (function () {
    var big = matchMedia('(min-width: 810px)');
    // desktop: a touch larger; phones (as osply): half as wide again
    var FOCUS = 0.12, FOCUS_PHONE = 0.5;
    var last = [];
    // the details under the line: f = which project is centred, as a
    // fraction (0..N) of the way along the column
    var tracks = null, rowH = 18, on = -1;
    window.__vhDetails = function (f) {
      if (!tracks) {
        tracks = [].slice.call(document.querySelectorAll('[data-vh-track]'));
        if (!tracks.length) return;
        rowH = tracks[0].firstElementChild.offsetHeight || 18;
      }
      var n = tracks[0].children.length / 3;
      // as osply: every row sits at its distance from the centred project
      // (one row per project), fully there on the line and fading out over
      // one row's travel; the names below stay faintly visible (22%)
      var at = n + f;
      var y = (-at * rowH).toFixed(2);
      for (var i = 0; i < tracks.length; i++) {
        var tr = tracks[i];
        tr.style.transform = 'translate3d(0,' + y + 'px,0)';
        var isNames = i === 2;
        var cells = tr.children;
        for (var k = 0; k < cells.length; k++) {
          var d = Math.abs(k - at);
          var o = isNames ? (k < at - 1 ? 0 : 0.22 + 0.78 * Math.max(0, 1 - d)) : Math.max(0, 1 - d);
          var os = o.toFixed(3);
          if (cells[k]._o !== os) {
            cells[k]._o = os;
            cells[k].style.opacity = os;
          }
        }
      }
    };
    window.addEventListener('resize', function () { tracks = null; });
    window.__vhFocus = function (pills, step, lap, wrapped) {
      var K = big.matches ? FOCUS : FOCUS_PHONE;
      var h = pills[0].offsetHeight;
      var G = (K * h) / 2;
      var base = (pills[0].parentNode).offsetTop;
      for (var i = 0; i < pills.length; i++) {
        var d = ((pills[i].parentNode).offsetTop - base - (lap + wrapped)) / step;
        var a = Math.min(1, Math.abs(d));
        var w = (1 + Math.cos(Math.PI * a)) / 2;
        var t = K ? 'translate3d(0,' + ((d < 0 ? -1 : 1) * G * (1 - w)).toFixed(2) + 'px,0) scale(' + (1 + K * w).toFixed(4) + ')' : '';
        var sat = w.toFixed(3);
        if (last[i] !== t + sat) {
          last[i] = t + sat;
          pills[i].parentNode.style.transform = t;
          // the DOM pictures (shown until WebGL takes over) match its colour
          pills[i].parentNode.style.setProperty('--sat', sat);
        }
      }
    };
  })();
</script>
<script is:inline>
  // Back from a case study (see [slug].astro): the column is put back exactly
  // where it was when the project was opened, and the case study's cover flies
  // into the very pill that was clicked.
  (function () {
    try {
      var raw = sessionStorage.getItem('vt-back');
      if (!raw) return;
      var d = JSON.parse(raw);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var list = document.querySelector('[data-vh-list]');
      var pills = [].slice.call(list.querySelectorAll('[data-media]'));
      var N = pills.length / 3;
      var idx = -1;
      for (var i = 0; i < N; i++) {
        if (pills[N + i].getAttribute('href').replace(/\/$/, '').split('/').pop() === d.slug) idx = i;
      }
      if (idx < 0) return;
      var step = (pills[1].parentNode).offsetTop - (pills[0].parentNode).offsetTop;
      var lap = (pills[N].parentNode).offsetTop - (pills[0].parentNode).offsetTop;
      // the project comes back exactly centred, on the line, whatever spot
      // it was opened from
      var pos = idx * step;
      var p = pills[N + idx];
      var wrapped = ((pos % lap) + lap) % lap;
      window.__vhStart = pos;
      list.style.transform = 'translate3d(0,' + -(lap + wrapped) + 'px,0)';
      window.__vhFocus(pills, step, lap, wrapped);
      var hero = document.querySelector('[data-vh]');
      // the details under the line already show this project in the first frame
      window.__vhDetails(wrapped / step);
      // the cover was off screen on the case study: nothing flies, home simply
      // dissolves in with the column where it was
      if (d.still) return;
      p.classList.add('is-opening');
      var box = window.__pillCover(p, true);
      var html = document.documentElement;
      html.classList.add('is-cover-back');
      // corners ease from the case cover's radius into this pill's exact round
      // ends (px to px, so the rounding is even all the way)
      html.style.setProperty('--vt-from-radius', (d.r || 20) + 'px');
      if (d.frame && box) {
        var u =
          d.frame.x != null &&
          window.__vtFlight(
            { x: d.frame.x, y: d.frame.y, w: d.frame.w, h: d.frame.h },
            { x: box.x, y: box.y, w: box.w, h: box.h, nw: box.nw },
            { x: 0, y: 0, r: d.frame.r || 20 },
            { x: box.cx, y: box.cy, r: box.r },
          );
        if (!u) window.__vtSizes(box, d.frame, false, d.focus);
      }
    } catch (e) {}
  })();
</script>

<style>
  /* Home doesn't scroll as a page: the column scrolls inside the screen */
  :global(html.is-endless),
  :global(html.is-endless body) {
    height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
  }

  .vh {
    --pill-w: clamp(240px, 21vw, 370px);
    --pill-h: calc(var(--pill-w) / 0.75);
    --gap: 28px;
    position: relative;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--surface-dark);
    touch-action: none;
  }
  .vh__gl {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* the big B behind everything, a whisper of grey chrome */
  .vh__backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 2s var(--ease-out);
  }
  .vh__backdrop.is-on {
    opacity: 0.07;
  }
  .vh__nav {
    position: relative;
    z-index: 4;
    padding: var(--gutter) var(--gutter) 0;
  }

  /* ---------- Column ---------- */
  .vh__viewport {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .vh__list {
    list-style: none;
    margin: 0;
    /* the first cover of a lap sits in the middle of the screen at offset 0 */
    padding: calc(50svh - var(--pill-h) / 2) 0 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap);
    will-change: transform;
  }
  .vh__pill {
    position: relative;
    display: block;
    width: var(--pill-w);
    aspect-ratio: 0.75;
    border-radius: 999px;
    overflow: hidden;
    background: #f2f2f2;
    -webkit-user-drag: none;
  }
  .vh__pill img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .vh:not(.has-gl) .vh__pill:hover img {
      transform: scale(1.05);
    }
  }
  /* WebGL draws the covers; the DOM images keep the layout and the links */
  .vh.has-gl .vh__pill {
    background: none;
  }
  .vh.has-gl .vh__pill img {
    opacity: 0;
  }
  /* coming back to home (no falling arrival): each DOM picture stays until
     WebGL has drawn that cover, so no cover is ever blank while it loads */
  :global(html:not(.is-arriving)) .vh.has-gl .vh__pill:not(.gl-on) img {
    opacity: 1;
  }
  .vh.has-gl .vh__pill.is-opening img {
    opacity: 1;
  }
  /* out of focus: black and white, like the WebGL covers */
  .vh__pill:not(.is-opening) img {
    filter: grayscale(calc(1 - var(--sat, 1)));
  }

  /* ---------- Project details ---------- */
  .vh__line {
    position: absolute;
    z-index: 0;
    left: var(--gutter);
    right: var(--gutter);
    top: 50%;
    height: 1px;
    background: var(--line);
    pointer-events: none;
    transform-origin: 50% 50%;
    transition: transform 1.1s var(--ease-in-out);
  }
  .vh__details {
    --row: 18px;
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    right: var(--gutter);
    top: calc(50% + 10px);
    display: grid;
    grid-template-columns: 9% 1fr 16% auto;
    align-items: start;
    font-size: 14px;
    line-height: var(--row);
    letter-spacing: -0.01em;
    color: var(--text-primary);
    pointer-events: none;
  }
  /* Each column is the list of every project's value, moved with the
     column itself (not on a trigger): mid-scroll the outgoing row slides up
     under the line while the next one rises into place. Values sit just
     below the hairline; the names column lets the next names trail below. */
  .vh__col {
    position: relative;
    display: block;
    height: var(--row);
    overflow: hidden;
  }
  .vh__track {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  .vh__cell {
    display: block;
    height: var(--row);
    white-space: nowrap;
  }
  .vh__year {
    justify-self: end;
    text-align: right;
  }
  .vh__names {
    height: calc(var(--row) * 5);
    -webkit-mask-image: linear-gradient(to bottom, #000 0 calc(var(--row) * 4), transparent);
    mask-image: linear-gradient(to bottom, #000 0 calc(var(--row) * 4), transparent);
  }

  .vh__intro {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    bottom: var(--gutter);
    width: min(340px, 30vw);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .vh__statement {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: 17px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 12px;
    line-height: 1.2;
    border-radius: 999px;
  }
  .vh__hint {
    position: absolute;
    z-index: 3;
    right: var(--gutter);
    bottom: var(--gutter);
    display: flex;
    gap: 6px;
    color: var(--text-primary);
  }

  /* Texts come in once the covers have landed: the side rows roll up into
     place one after another, the corner texts rise in */
  .vh__col {
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .vh__tags {
    transition-delay: 70ms;
  }
  .vh__names {
    transition-delay: 140ms;
  }
  .vh__year {
    transition-delay: 210ms;
  }
  /* the hairline draws out from the middle as the covers land; the details
     rise in under it */
  :global(html.is-arriving) .vh__line {
    transform: scaleX(0);
  }
  :global(html.is-arriving) .vh__col {
    opacity: 0;
    transform: translateY(10px);
  }
  .vh__intro > *,
  .vh__hint {
    transition: opacity 0.8s var(--ease-out), transform 0.9s var(--ease-out);
  }
  .vh__intro > :nth-child(2) {
    transition-delay: 80ms;
  }
  .vh__hint {
    transition-delay: 160ms;
  }
  :global(html.is-arriving) :is(.vh__intro > *, .vh__hint) {
    opacity: 0;
    transform: translateY(16px);
  }
  :global(html.is-arriving) .vh__pill img {
    opacity: 0;
  }

  @media (max-width: 1099px) {
    .vh__intro {
      display: none;
    }
  }
  /* Phones, as on osply: the column alone on screen, the middle cover much
     larger than the ones coming in (see __vhFocus), the hairline through
     it, and the statement at the bottom; the detail rows stay out of the
     way on a narrow screen */
  @media (max-width: 809px) {
    .vh {
      --pill-w: 48vw;
      --gap: 12px;
    }
    .vh__details {
      display: none;
    }
    .vh__line {
      left: 0;
      right: 0;
    }
    .vh__hint {
      display: none;
    }
    .vh__intro {
      display: flex;
      left: var(--gutter);
      right: var(--gutter);
      width: auto;
      bottom: calc(var(--gutter) + env(safe-area-inset-bottom, 0px));
      align-items: center;
      text-align: center;
      gap: 10px;
    }
    .vh__intro .vh__statement {
      font-size: 13px;
      line-height: 1.3;
      max-width: 34ch;
    }
    .vh__intro .badge {
      display: none;
    }
    /* a soft wash of the page colour behind it, so it reads over the covers */
    .vh__intro::before {
      content: '';
      position: absolute;
      z-index: -1;
      left: calc(var(--gutter) * -1);
      right: calc(var(--gutter) * -1);
      bottom: calc(var(--gutter) * -1 - env(safe-area-inset-bottom, 0px));
      height: calc(100% + 72px);
      background: linear-gradient(to top, var(--surface-dark) 45%, transparent);
      pointer-events: none;
    }
  }

</style>

<script>
  const root = document.documentElement;
  const hero = document.querySelector<HTMLElement>('[data-vh]');
  const list = document.querySelector<HTMLElement>('[data-vh-list]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  // Page-level smooth scroll has nothing to do here
  document.dispatchEvent(new CustomEvent('intro:done'));
  requestAnimationFrame(() => (window as unknown as { lenis?: { stop(): void } }).lenis?.stop());

  if (hero && list) {
    const pills = [...hero.querySelectorAll<HTMLElement>('[data-media]')];
    const N = pills.length / 3;

    // ---------- Geometry ----------
    let step = 1; // distance between two covers
    let lap = 1; // height of one full set
    const measure = () => {
      step = pills[1] ? (pills[1].parentNode as HTMLElement).offsetTop - (pills[0].parentNode as HTMLElement).offsetTop : 1;
      lap = pills[N] ? (pills[N].parentNode as HTMLElement).offsetTop - (pills[0].parentNode as HTMLElement).offsetTop : step * N;
    };
    measure();
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);

    // ---------- Endless scroll ----------
    // `target` is where the column is going, `pos` eases towards it every frame.
    // Like a deck of slides: one wheel or trackpad gesture (or key press, or
    // flick) moves exactly one project on, on one long, soft glide that
    // settles with that project centred.
    // coming back from a case study, the inline script below already placed
    // the column on that project
    let pos = (window as unknown as { __vhStart?: number }).__vhStart ?? 0;
    let target = pos;
    // while a project is opening, the column ignores input
    let opening = false;
    // any input pauses the idle drift (see Frame) for a while
    let lastInput = performance.now();
    const touchInput = () => (lastInput = performance.now());
    // The column moves like osply's: a critically damped glide (smooth-damp
    // with a time constant, so it starts soft, carries real weight and lands
    // without overshoot). The wheel or trackpad moves it 1:1 while it is
    // being used; 140 ms after the last event it settles on a project: back
    // to where it started for a nudge, otherwise as many projects on as it
    // was moved (at least one).
    let glideT = 0.45; // seconds: the glide's time constant
    let glideV = 0; // px per second
    const smoothDamp = (cur: number, to: number, dt: number) => {
      const w = 2 / glideT;
      const x = w * dt;
      const k = 1 / (1 + x + 0.48 * x * x + 0.235 * x * x * x);
      const d = cur - to;
      const t = (glideV + w * d) * dt;
      glideV = (glideV - w * t) * k;
      return to + (d + t) * k;
    };
    /** settle on project index k, the glide's length scaled to the distance */
    const glideTo = (k: number) => {
      touchInput();
      if (opening) return;
      glideT = Math.min(0.8, 0.34 + 0.08 * Math.abs(k - pos / step));
      target = k * step;
    };
    const stepBy = (dir: number) => glideTo(Math.round(target / step) + dir);
    let wheelBase = 0;
    let wheelSum = 0;
    let wheelTimer = 0;
    window.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (opening) return;
        touchInput();
        const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
        const d = (Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX) * unit;
        if (!wheelTimer) wheelBase = Math.round(target / step);
        wheelSum += d;
        glideT = 0.42;
        target = wheelBase * step + wheelSum;
        window.clearTimeout(wheelTimer);
        wheelTimer = window.setTimeout(() => {
          const moved = (target - wheelBase * step) / step;
          const n = Math.abs(moved) < 0.12 ? 0 : Math.max(1, Math.round(Math.abs(moved)));
          target = (wheelBase + Math.sign(moved) * n) * step;
          glideT = 0.36 + 0.04 * Math.min(n, 6);
          wheelSum = 0;
          wheelTimer = 0;
        }, 140);
      },
      { passive: false },
    );
    // touch / pen drag with a flick at the end
    let dragY: number | null = null;
    let dragV = 0;
    let dragMoved = 0;
    hero.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      dragY = e.clientY;
      dragV = 0;
      dragMoved = 0;
    });
    window.addEventListener('pointermove', (e) => {
      if (dragY === null) return;
      touchInput();
      const d = dragY - e.clientY;
      dragY = e.clientY;
      dragMoved += Math.abs(d);
      dragV = d;
      target += d;
      pos += d; // follow the finger directly
      glideV = 0;
    });
    const endDrag = () => {
      if (dragY === null) return;
      dragY = null;
      touchInput();
      if (opening) return;
      // land on the project the flick heads for (at least the next one, for
      // a real flick)
      const aim = pos + dragV * 14;
      let k = Math.round(aim / step);
      const here = Math.round(pos / step);
      if (k === here && Math.abs(dragV) > 4) k += Math.sign(dragV);
      glideV = 0;
      glideTo(k);
    };
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    hero.addEventListener(
      'click',
      (e) => {
        if (dragMoved > 8) {
          e.preventDefault();
          e.stopPropagation();
          dragMoved = 0;
        }
      },
      true,
    );
    window.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'PageDown', ' '].includes(e.key)) {
        e.preventDefault();
        stepBy(1);
      } else if (['ArrowUp', 'PageUp'].includes(e.key)) {
        e.preventDefault();
        stepBy(-1);
      }
    });

    // ---------- Sound ----------
    // As osply: a tiny synthesized tick (a falling sine blip through a low
    // pass, with a short filtered noise click), pitched a little per project.
    // Browsers only allow sound after a click or key press, so it starts
    // working from the first one.
    let actx: AudioContext | null = null;
    let lastTick = 0;
    let tickAt: number | null = null;
    const VOLUME = 0.7;
    const unlock = () => {
      try {
        if (!actx) actx = new (window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();
        if (actx.state === 'suspended') actx.resume();
        loadKeys();
      } catch (err) {}
    };
    ['pointerdown', 'pointerup', 'touchend', 'keydown', 'click'].forEach((t) => window.addEventListener(t, unlock, { passive: true, capture: true }));
    // try straight away too, and on the first wheel/move: browsers allow it
    // whenever this visit already had a click (e.g. arriving from a project
    // or another page of the site) or the site is trusted for sound; otherwise
    // it simply stays muted until the first click or key
    unlock();
    ['wheel', 'pointermove', 'touchstart', 'scroll'].forEach((t) => window.addEventListener(t, () => { if (!actx || actx.state !== 'running') unlock(); }, { passive: true, capture: true }));
    document.addEventListener('visibilitychange', () => { if (!document.hidden && actx?.state === 'suspended') unlock(); });
    // Alpaca switch (smooth linear) recordings, from the Typersguild key
    // sound tester, kept in Sanity: each project reaching the middle is one
    // keystroke, a press (one of three takes, so it sounds like a real key,
    // not a loop) and its softer release just after.
    const ALPACA = 'https://cdn.sanity.io/files/jf65lv25/production/';
    const PRESS = ['2f3933a6a9a47bcc2b1d14965444fc15ec03c814', '0f9fc80630f9eed74f00c5971fa1f227eee6025c', '2517db4bf9ccae4306737fc710f0caa7ec182408'];
    const RELEASE = '5ce24c1d74b1905ae29ee313f5b6092cd024ed7b';
    let presses: AudioBuffer[] = [];
    let release: AudioBuffer | null = null;
    let loading = false;
    let lastPress = -1;
    let releaseSrc: AudioBufferSourceNode | null = null;
    const loadKeys = () => {
      if (loading || !actx) return;
      loading = true;
      const get = (id: string) =>
        fetch(`${ALPACA}${id}.mp3`)
          .then((r) => r.arrayBuffer())
          .then((b) => new Promise<AudioBuffer>((res, rej) => actx!.decodeAudioData(b, res, rej)));
      Promise.all(PRESS.map(get)).then((b) => (presses = b), () => (loading = false));
      get(RELEASE).then((b) => (release = b), () => {});
    };
    const play = (buf: AudioBuffer, at: number, gain: number) => {
      const src = actx!.createBufferSource();
      src.buffer = buf;
      const g = actx!.createGain();
      g.gain.value = gain;
      src.connect(g);
      g.connect(actx!.destination);
      src.start(at);
      return src;
    };
    const tick = (_i: number) => {
      if (!actx || reduceMotion) return;
      loadKeys();
      if (actx.state !== 'running' || !presses.length) return;
      const now = performance.now();
      if (now - lastTick < 60) return;
      const v = VOLUME * Math.min(1, Math.max(0.6, (now - lastTick) / 220));
      lastTick = now;
      const t = actx.currentTime + 0.002;
      // never the same take twice in a row
      let k = Math.floor(Math.random() * presses.length);
      if (k === lastPress) k = (k + 1) % presses.length;
      lastPress = k;
      // a new press cuts the previous key's release short, like a real key
      try {
        releaseSrc?.stop();
      } catch (err) {}
      // the recordings are quiet (peaks ~0.1 press, ~0.06 release): bring the
      // press up to ~0.35 and the release to ~0.15
      play(presses[k], t, v * 5);
      if (release) releaseSrc = play(release, t + 0.07, v * 3.6);
    };

    // ---------- Easter egg: a lucky spin ----------
    // Spin the column really hard (seven projects or more flying past within
    // a moment) and, once it settles, it pays out like a slot machine, in the
    // site's own quiet way: a short rising chime, a handful of thin line
    // clovers drifting up out of the middle cover, and "☘ ☘ ☘ Lucky spin"
    // rising in above the line for a moment.
    const spinTimes: number[] = [];
    let luckyArmed = false;
    let luckyAt = -1e9;
    const CLOVER =
      '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12c-1.6-3.6-6.2-4.4-6.2-1.3 0 2.8 4.1 3.2 6.2 1.3Zm0 0c3.6-1.6 4.4-6.2 1.3-6.2-2.8 0-3.2 4.1-1.3 6.2Zm0 0c1.6 3.6 6.2 4.4 6.2 1.3 0-2.8-4.1-3.2-6.2-1.3Zm0 0c-3.6 1.6-4.4 6.2-1.3 6.2 2.8 0 3.2-4.1 1.3-6.2Z"/><path d="M12 12c.8 3.4 2.6 5.8 5.4 7.6"/></svg>';
    const noteAt = (semi: number, when: number, len = 0.5, vol = 0.15) => {
      if (!actx || actx.state !== 'running') return;
      const t = actx.currentTime + when;
      const f = 392 * Math.pow(2, semi / 12);
      const o = actx.createOscillator();
      o.type = 'sine';
      o.frequency.setValueAtTime(f, t);
      const o2 = actx.createOscillator();
      o2.type = 'sine';
      o2.frequency.setValueAtTime(f * 2, t);
      const g = actx.createGain();
      g.gain.setValueAtTime(0.0001, t);
      g.gain.exponentialRampToValueAtTime(vol, t + 0.004);
      g.gain.exponentialRampToValueAtTime(0.0001, t + len);
      const g2 = actx.createGain();
      g2.gain.setValueAtTime(0.0001, t);
      g2.gain.exponentialRampToValueAtTime(vol * 0.18, t + 0.003);
      g2.gain.exponentialRampToValueAtTime(0.0001, t + len * 0.4);
      o.connect(g);
      o2.connect(g2);
      g.connect(actx.destination);
      g2.connect(actx.destination);
      o.start(t);
      o2.start(t);
      o.stop(t + len + 0.05);
      o2.stop(t + len + 0.05);
    };
    const noteSpin = () => {
      const now = performance.now();
      spinTimes.push(now);
      while (spinTimes.length && now - spinTimes[0] > 1600) spinTimes.shift();
      if (spinTimes.length >= 7 && now - luckyAt > 10000) luckyArmed = true;
    };
    const lucky = () => {
      luckyArmed = false;
      luckyAt = performance.now();
      spinTimes.length = 0;
      // chime: up the scale, the last note held
      [0, 4, 7, 12].forEach((s, k) => noteAt(s, k * 0.085, k === 3 ? 0.9 : 0.35, k === 3 ? 0.15 : 0.1));
      const layer = document.createElement('div');
      layer.className = 'vh-lucky';
      layer.setAttribute('aria-hidden', 'true');
      const badge = document.createElement('div');
      badge.className = 'vh-lucky__badge';
      badge.innerHTML = '<span>☘ ☘ ☘&nbsp;&nbsp;Lucky spin</span>';
      layer.append(badge);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const COUNT = 14;
      for (let k = 0; k < COUNT; k++) {
        const c = document.createElement('span');
        c.className = 'vh-lucky__clover';
        c.innerHTML = CLOVER;
        const size = 16 + Math.random() * 20;
        c.style.width = c.style.height = `${size}px`;
        c.style.left = `${vw / 2 - size / 2}px`;
        c.style.top = `${vh / 2 - size / 2}px`;
        if (k % 5 === 0) c.style.color = '#3f8f4a';
        layer.append(c);
        const a = (k / COUNT) * Math.PI * 2 + Math.random() * 0.5;
        const d = 140 + Math.random() * 260;
        const dx = Math.cos(a) * d;
        const dy = Math.sin(a) * d * 0.7 - 80 - Math.random() * 120;
        const rot = (Math.random() - 0.5) * 240;
        const dur = 1500 + Math.random() * 900;
        c.animate(
          [
            { transform: 'translate(0,0) scale(0.3) rotate(0deg)', opacity: 0 },
            { transform: `translate(${dx * 0.55}px,${dy * 0.55}px) scale(1) rotate(${rot * 0.5}deg)`, opacity: 1, offset: 0.35 },
            { transform: `translate(${dx}px,${dy - 60}px) scale(0.9) rotate(${rot}deg)`, opacity: 0 },
          ],
          { duration: dur, delay: k * 18, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'both' },
        );
      }
      hero.append(layer);
      window.setTimeout(() => layer.classList.add('is-out'), 2300);
      window.setTimeout(() => layer.remove(), 3200);
    };

    // ---------- Project details ----------
    // (drawn from the column's position every frame, see __vhDetails)
    const details = (window as unknown as { __vhDetails(f: number): void }).__vhDetails;

    // ---------- Edge lens gate ----------
    // The top/bottom lens eases away when a project opens (so home leaves
    // flat, calm, matching the flat flying cover) and eases back in when home
    // is shown again — it never cuts in or out.
    const lensGate = { from: 1, to: 1, t0: 0, dur: 1 };
    const gateAt = (now: number) => {
      const k = Math.min(1, Math.max(0, (now - lensGate.t0) / lensGate.dur));
      // ease-out cubic growing back in; flattening (going to 0) eases in and
      // out instead, so the neighbours' shapes settle rather than snap
      const e = lensGate.to < lensGate.from ? (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2) : 1 - (1 - k) * (1 - k) * (1 - k);
      return lensGate.from + (lensGate.to - lensGate.from) * e;
    };
    const gateTo = (to: number, dur: number, from?: number) => {
      const now = performance.now();
      lensGate.from = from ?? gateAt(now);
      lensGate.to = to;
      lensGate.t0 = now;
      lensGate.dur = dur;
    };

    // ---------- Hover + opening a project ----------
    let hovered: HTMLElement | null = null;
    pills.forEach((p) => {
      p.addEventListener('pointerenter', () => (hovered = p));
      p.addEventListener('pointerleave', () => hovered === p && (hovered = null));
      // get the case study ready while the pointer is on its cover
      p.addEventListener('pointerenter', () => warm(p.href));
      p.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey || !('startViewTransition' in document)) return;
        e.preventDefault();
        if (opening) return;
        opening = true;
        // the edge lens flattens out (220ms, eased both ends) before home is captured, so the
        // home left behind (blurred under the case study) matches the flat
        // stand-in for it there exactly
        gateTo(0, 220);
        warm(p.href);
        const domImg = p.querySelector('img');
        if (domImg) domImg.loading = 'eager';
        // ready the DOM picture now so the hand-over can't show an empty frame
        const decoded = domImg ? domImg.decode().catch(() => {}) : Promise.resolve();
        // the cover flies from exactly where it was clicked (no glide first)
        centring = () => {
          centring = null;
          // 2. hand the cover to the view transition: the (decoded) DOM image
          //    takes over from WebGL in the same frame, framed identically
          const flat = new Promise<void>((res) => {
            const t0 = performance.now();
            const wait = () => (gateAt(performance.now()) < 0.01 || performance.now() - t0 > 280 ? res() : requestAnimationFrame(wait));
            wait();
          });
          Promise.all([decoded, flat]).then(() => {
            const i = pills.indexOf(p);
            p.classList.add('is-opening');
            // the picture carries WebGL's hover zoom in its size
            const zoom = 1 / (1 - 0.06 * hover[i]);
            const box = (window as unknown as { __pillCover(p: HTMLElement, on: boolean, zoom?: number): { w: number; h: number; cx: number; cy: number; r: number } | null }).__pillCover(p, true, zoom);
            try {
              sessionStorage.setItem('vt-pill-shape', JSON.stringify({ r: box?.r ?? p.offsetWidth / 2, clip: box?.cx ?? 0, clipY: box?.cy ?? 0 }));
              sessionStorage.setItem('vt-pill', JSON.stringify(box));
              sessionStorage.setItem('vt-card', '1');
              // remember where it was, so coming back lands in the same spot
              sessionStorage.setItem('vh-from', JSON.stringify({ pos, i }));
              // where its neighbours are on screen, so the blurred stand-in
              // for home behind the case study sits exactly on them
              const nb = [pills[i - 1], pills[i + 1]].map((q) => {
                if (!q) return null;
                const r = q.getBoundingClientRect();
                return { x: r.left, y: r.top, w: r.width, h: r.height };
              });
              sessionStorage.setItem('vh-under', JSON.stringify({ prev: nb[0], next: nb[1], vw: innerWidth, vh: innerHeight }));
            } catch (err) {}
            // 3. go (after this frame has painted the DOM picture)
            requestAnimationFrame(() => (window.location.href = p.href));
          });
        };
      });
    });

    let centring: ((now: number) => void) | null = null;
    const pillCover = (p: HTMLElement, on: boolean) =>
      (window as unknown as { __pillCover(p: HTMLElement, on: boolean): { w: number; h: number } | null }).__pillCover(p, on);

    // ---------- Back from a case study ----------
    // Once the picture has landed (Base.astro fires 'cover-back:done'), WebGL
    // takes the cover over again as soon as its new texture is ready.
    const handBack = () => {
      try {
        sessionStorage.removeItem('vt-back');
      } catch (err) {}
      const p = pills.find((x) => x.classList.contains('is-opening'));
      if (!p) return;
      const release = () => {
        if (gl && !gl.ready([p])) {
          requestAnimationFrame(release);
          return;
        }
        // WebGL draws the cover again first (its canvas sits above the DOM
        // picture); the DOM picture is hidden only once that frame is up, so
        // there's never a frame with neither
        p.classList.add('is-releasing');
        glow[pills.indexOf(p)] = 1;
        pillCover(p, false);
        root.classList.remove('is-cover-back');
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            p.classList.remove('is-opening', 'is-releasing');
          }),
        );
      };
      let done = false;
      const go = () => {
        if (done) return;
        done = true;
        release();
        // the drift picks up again shortly after the landing (0.5s)
        lastInput = performance.now() - (IDLE_AFTER - 500);
      };
      document.addEventListener('cover-back:done', go, { once: true });
      window.setTimeout(go, 1800);
    };
    if (root.classList.contains('is-cover-back')) handBack();
    const warmed = new Set<string>();
    const canPrerender = (HTMLScriptElement as unknown as { supports?: (t: string) => boolean }).supports?.('speculationrules');
    function warm(url: string) {
      if (warmed.has(url)) return;
      warmed.add(url);
      if (canPrerender) {
        const sr = document.createElement('script');
        sr.type = 'speculationrules';
        sr.textContent = JSON.stringify({ prerender: [{ source: 'list', urls: [url] }] });
        document.head.append(sr);
      } else {
        const l = document.createElement('link');
        l.rel = 'prefetch';
        l.href = url;
        document.head.append(l);
      }
    }
    window.addEventListener('pageshow', (e) => {
      if (!(e as PageTransitionEvent).persisted) return;
      // back on home: the lens grows back in, from flat; and no drift yet
      gateTo(1, 700, 0);
      drift = 0;
      opening = false;
      centring = null;
      // nothing is hovered any more: WebGL must take the cover back unzoomed
      hovered = null;
      hover.fill(0);
      for (const p of pills) {
        p.classList.remove('is-opening');
        pillCover(p, false);
        const img = p.querySelector('img');
        if (img) img.style.transform = '';
      }
      // restored from the back/forward cache: the column is still where it was;
      // the cover flies back into the pill that was clicked
      try {
        const raw = sessionStorage.getItem('vt-back');
        const from = JSON.parse(sessionStorage.getItem('vh-from') || 'null') as { i: number } | null;
        const back = raw ? (JSON.parse(raw) as { slug: string; still?: boolean }) : null;
        const slugOf = (el: HTMLElement) => el.getAttribute('href')?.replace(/\/$/, '').split('/').pop();
        let p = from ? pills[from.i] : null;
        if (back?.still) sessionStorage.removeItem('vt-back');
        // the project comes back exactly centred, on the line (also when it
        // was opened off-centre, or reached via "Next project")
        if (back) {
          const N = pills.length / 3;
          const idx = pills.slice(N, 2 * N).findIndex((el) => slugOf(el) === back.slug);
          if (idx >= 0) {
            pos = target = idx * step;
            glideV = 0;
            const wrapped = ((pos % lap) + lap) % lap;
            list.style.transform = `translate3d(0, ${(-(lap + wrapped)).toFixed(2)}px, 0)`;
            (window as unknown as { __vhFocus(p: HTMLElement[], s: number, l: number, w: number): void }).__vhFocus(pills, step, lap, wrapped);
            details(wrapped / step);
            p = pills[N + idx];
          }
        }
        if (back && !back.still && p && !reduceMotion && slugOf(p) === back.slug) {
          p.classList.add('is-opening');
          const box = pillCover(p, true);
          root.classList.add('is-cover-back');
          root.style.setProperty('--vt-from-radius', `${(back as { r?: number }).r || 20}px`);
          const frame = (back as { frame?: { w: number; h: number } }).frame;
          const sizes = (window as unknown as { __vtSizes?: (a: object, b: object, f: boolean, focus?: object) => void }).__vtSizes;
          const fl = (window as unknown as { __vtFlight?: (a: object, b: object, c: object, d: object) => boolean }).__vtFlight;
          const fb = frame as { w: number; h: number; x?: number; y?: number; r?: number } | undefined;
          const bx = box as { w: number; h: number; nw?: number; x: number; y: number; cx: number; cy: number; r: number } | null;
          const u =
            !!fb && !!bx && fb.x != null && !!fl &&
            fl({ x: fb.x, y: fb.y, w: fb.w, h: fb.h }, { x: bx.x, y: bx.y, w: bx.w, h: bx.h, nw: bx.nw }, { x: 0, y: 0, r: fb.r || 20 }, { x: bx.cx, y: bx.cy, r: bx.r });
          if (!u && frame && sizes && box) sizes(box, frame, false, (back as { focus?: object }).focus);
          handBack();
        }
      } catch (err) {}
    });
    const hover = pills.map(() => 0);
    // colour held by a cover that just flew back, easing away to its focus
    const glow = pills.map(() => 0);

    // ---------- WebGL ----------
    let gl: ReturnType<typeof setupGL> = null;
    const enableGL = () => {
      if (gl || reduceMotion) return;
      gl = setupGL(hero.querySelector<HTMLCanvasElement>('[data-gl]')!);
      if (gl) {
        hero.classList.add('has-gl');
        // fetch every cover's texture now (one per project, shared by the
        // laps): one that arrived only as it scrolled in would fade in over
        // its flat DOM picture and show both shapes at once
        gl.ready(pills);
      }
    };
    if (finePointer) enableGL();
    else {
      const later = () =>
        'requestIdleCallback' in window
          ? (window as unknown as { requestIdleCallback(cb: () => void, o: object): void }).requestIdleCallback(enableGL, { timeout: 2500 })
          : window.setTimeout(enableGL, 1500);
      if (document.readyState === 'complete') later();
      else window.addEventListener('load', later, { once: true });
    }

    // ---------- Arrival ----------
    // Covers start above the screen and stream down into the column, the lower
    // ones first, each on a long ease-out so they glide to a stop. The speed of
    // each cover feeds the same edge stretch as scrolling does.
    const ARRIVE_MS = 1500;
    const ARRIVE_STAGGER = 70;
    let arriveAt = -1;
    let arriving = root.classList.contains('is-arriving');
    // shown again without the falling arrival (back from a project, or from
    // another page): the lens eases in from flat
    if (!arriving) gateTo(1, 700, 0);
    const endArrival = () => {
      arriving = false;
      arriveAt = -1;
      hero.classList.add('is-entering');
      root.classList.remove('is-arriving');
      window.setTimeout(() => hero.classList.remove('is-entering'), 1300);
    };
    if (arriving) {
      if (!gl) endArrival();
      else {
        let t0 = performance.now();
        const onScreen = () =>
          pills.filter((p) => {
            const r = p.getBoundingClientRect();
            return r.bottom > 0 && r.top < window.innerHeight;
          });
        let t0Set = false;
        const go = () => {
          // wait for the preloader to hand over; the picture wait is counted
          // from then on
          if (root.classList.contains('is-preloading')) {
            requestAnimationFrame(go);
            return;
          }
          if (!t0Set) {
            t0Set = true;
            t0 = Math.min(t0, performance.now());
          }
          // start only once every cover on screen has its picture (3s at most),
          // so none of them pops in or loads while falling
          if (!gl?.ready(onScreen()) && performance.now() - t0 < 3000) {
            requestAnimationFrame(go);
            return;
          }
          arriveAt = performance.now();
          window.setTimeout(endArrival, ARRIVE_MS + ARRIVE_STAGGER * 6);
        };
        requestAnimationFrame(go);
      }
    }
    const easeOutQuint = (t: number) => 1 - Math.pow(1 - t, 5);
    /** where a cover is in its fall: offset from its place, and k = 0..1 landed */
    const arrival = (r: DOMRect): { off: number; k: number } | null => {
      if (!arriving) return { off: 0, k: 1 };
      const vh = window.innerHeight;
      if (arriveAt < 0) return null; // not started: keep hidden
      // lower covers lead, upper ones follow
      const order = clamp(1 - (r.top + r.height / 2) / vh, 0, 1.5);
      const t = clamp((performance.now() - arriveAt - order * ARRIVE_STAGGER * 4) / ARRIVE_MS);
      const k = easeOutQuint(t);
      return { off: -(vh * 1.15) * (1 - k), k };
    };

    // covers keep their length while moving (only the edge lens and the smear
    // react to speed), so the gap between neighbours never shrinks
    const maxElong = () => 0;

    // ---------- Frame ----------
    let lastPos = 0;
    let vel = 0;
    // Idle drift: left alone, the column creeps along by itself, very slowly.
    // It eases in after a few quiet seconds and eases out at once on any
    // input, or while a cover is under the pointer (so it holds still to be
    // clicked).
    const DRIFT = 16; // px per second
    const IDLE_AFTER = 2500; // ms without input
    let drift = 0;
    let drifting = false;
    let lastT = performance.now();
    const frame = () => {
      requestAnimationFrame(frame);
      const now = performance.now();
      const dt = Math.min(0.05, (now - lastT) / 1000);
      lastT = now;
      const idle =
        !reduceMotion &&
        !arriving &&
        !opening &&
        !centring &&
        // a cover is flying back into its pill: the column holds perfectly
        // still until it has landed (then waits the usual quiet moment)
        !root.classList.contains('is-cover-back') &&
        !pills.some((el) => el.classList.contains('is-opening')) &&
        dragY === null &&
        !hovered &&
        !document.hidden &&
        now - lastInput > IDLE_AFTER;
      // ease in slowly, ease out quickly
      drift += ((idle ? DRIFT : 0) - drift) * (idle ? 0.02 : 0.15);
      if (Math.abs(drift) > 0.01) {
        target += drift * dt;
        pos += drift * dt;
        drifting = true;
      } else if (drifting && !idle) {
        // the drift has let go: settle on the nearest project
        drifting = false;
        if (!opening && !centring && dragY === null && !wheelTimer) glideTo(Math.round(target / step));
      }
      // ease towards the target; 0.055 per frame ≈ a long, buttery glide
      if (centring) centring(performance.now());
      else if (dragY === null) pos = smoothDamp(pos, target, Math.max(dt, 1 / 240));
      // keep the middle lap in view, wrapping invisibly
      const wrapped = ((pos % lap) + lap) % lap;
      list.style.transform = `translate3d(0, ${(-(lap + wrapped)).toFixed(2)}px, 0)`;
      (window as unknown as { __vhFocus(p: HTMLElement[], s: number, l: number, w: number): void }).__vhFocus(pills, step, lap, wrapped);
      vel += (pos - lastPos - vel) * 0.25;
      lastPos = pos;

      const vh = window.innerHeight;
      let best = 0;
      let bestD = Number.POSITIVE_INFINITY;
      for (let i = 0; i < pills.length; i++) {
        const r = pills[i].getBoundingClientRect();
        const d = Math.abs(r.top + r.height / 2 - vh / 2);
        if (d < bestD) {
          bestD = d;
          best = i;
        }
        hover[i] += ((hovered === pills[i] ? 1 : 0) - hover[i]) * 0.12;
        if (glow[i] > 0) glow[i] = pills[i].classList.contains('is-opening') ? 1 : Math.max(0, glow[i] - dt / 0.9);
      }
      details(wrapped / step);
      // the lucky spin pays out once the column has come to rest
      if (luckyArmed && !wheelTimer && dragY === null && Math.abs(target - pos) < 1.5 && Math.abs(glideV) < 20) lucky();
      // a soft tick each time a new project reaches the middle
      const nowAt = Math.round(pos / step);
      if (nowAt !== tickAt) {
        if (tickAt !== null) {
          tick(((nowAt % N) + N) % N);
          if (!reduceMotion) noteSpin();
        }
        tickAt = nowAt;
      }

      if (!gl) return;
      const speed = clamp(Math.abs(vel) / 45);
      gl.draw(pills, hover, (i, r) => {
        const a = arrival(r);
        if (!a) return null;
        // falling covers stay clean: no stretch, smear or colour split while
        // they come in; the edge lens eases in only as each one settles
        // colour: the cover in focus, one under the pointer, and one that has
        // just flown back from its case study (fading out of it gently)
        const fd = Math.min(1, Math.abs(r.top + r.height / 2 - vh / 2) / step);
        const sat = Math.max((1 + Math.cos(Math.PI * fd)) / 2, hover[i], glow[i]);
        return { top: r.top + a.off, speed: a.k < 1 ? 0 : speed * gateAt(performance.now()), lens: a.k * a.k * a.k * gateAt(performance.now()), sat };
      }, maxElong());
    };
    requestAnimationFrame(frame);
  }

  /* WebGL: one finely subdivided plane per cover, placed over its DOM box.
     - Pill shape from a rounded-rect distance field with anti-aliased edges.
     - Edge lens: near the top and bottom of the screen a cover stretches
       towards the edge, flares wider, smears and splits its colour; speed
       makes all of it stronger.
     - Covers fade in once their texture is ready; frames where nothing moved
       are skipped. */
  function setupGL(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: true });
    if (!gl) return null;

    const vs = `
      precision highp float;
      attribute vec2 aPos;
      uniform vec4 uRect;
      uniform vec2 uView;
      uniform float uSpeed;
      uniform float uLens;
      uniform float uElong;
      varying vec2 vUv;
      varying float vEdge;
      void main() {
        vUv = aPos;
        vec2 p = uRect.xy + aPos * uRect.zw;
        float cx = uRect.x + uRect.z * 0.5;
        float ny = (p.y - uView.y * 0.5) / (uView.y * 0.5);
        // the effect only lives in the outer band of the screen
        float t = 0.72 - 0.12 * uSpeed;
        float over = max(0.0, abs(ny) - t) * uLens;
        float k = 1.2 + 1.6 * uSpeed;
        p.y += sign(ny) * over * over * k * uView.y * 0.5;
        float e = smoothstep(t, 1.0, abs(ny)) * uLens;
        p.x = cx + (p.x - cx) * (1.0 + 0.2 * e);
        // moving fast also elongates a cover a little along its travel
        float c = uRect.y + uRect.w * 0.5;
        p.y = c + (p.y - c) * (1.0 + uElong);
        vEdge = e;
        vec2 clip = p / uView * 2.0 - 1.0;
        gl_Position = vec4(clip.x, -clip.y, 0.0, 1.0);
      }`;
    const fs = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
      #else
      precision mediump float;
      #endif
      uniform sampler2D uTex;
      uniform vec2 uImg;
      uniform vec4 uRect;
      uniform float uHover;
      uniform float uAlpha;
      uniform float uSpeed;
      uniform float uSat;
      varying vec2 vUv;
      varying float vEdge;
      vec2 cover(vec2 uv) {
        float rs = uRect.z / uRect.w;
        float ri = uImg.x / uImg.y;
        vec2 s = rs < ri ? vec2(rs / ri, 1.0) : vec2(1.0, ri / rs);
        uv = (uv - 0.5) * s + 0.5;
        return (uv - 0.5) * (1.0 - 0.06 * uHover) + 0.5;
      }
      void main() {
        vec2 size = uRect.zw;
        float r = size.x * 0.5;
        vec2 q = abs(vUv * size - size * 0.5) - (size * 0.5 - r);
        float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
        float mask = 1.0 - smoothstep(-1.0, 1.0, d);
        if (mask <= 0.0) discard;

        vec2 uv = cover(vUv);
        float e = clamp(vEdge + uSpeed * 0.3, 0.0, 1.0);
        float smear = 0.035 * e;
        float split = 0.018 * e;
        vec3 col = vec3(0.0);
        for (int i = 0; i < 5; i++) {
          float o = (float(i) / 4.0 - 0.5) * smear;
          col.r += texture2D(uTex, uv + vec2(0.0, o + split)).r;
          col.g += texture2D(uTex, uv + vec2(0.0, o)).g;
          col.b += texture2D(uTex, uv + vec2(0.0, o - split)).b;
        }
        col /= 5.0;
        // covers out of focus are drawn in black and white
        col = mix(vec3(dot(col, vec3(0.299, 0.587, 0.114))), col, uSat);
        gl_FragColor = vec4(col, 1.0) * uAlpha * mask;
      }`;
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
    gl.useProgram(prog);

    const SX = 16;
    const SY = 64;
    const verts: number[] = [];
    for (let j = 0; j <= SY; j++) for (let i = 0; i <= SX; i++) verts.push(i / SX, j / SY);
    const idx: number[] = [];
    for (let j = 0; j < SY; j++)
      for (let i = 0; i < SX; i++) {
        const a = j * (SX + 1) + i;
        idx.push(a, a + 1, a + SX + 1, a + 1, a + SX + 2, a + SX + 1);
      }
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(verts), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(idx), gl.STATIC_DRAW);

    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uRect = u('uRect');
    const uView = u('uView');
    const uSpeed = u('uSpeed');
    const uHover = u('uHover');
    const uAlpha = u('uAlpha');
    const uLens = u('uLens');
    const uElong = u('uElong');
    const uImg = u('uImg');
    const uSat = u('uSat');
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    // one texture per image, shared by the copies of a cover in each lap
    type Tex = { tex: WebGLTexture; w: number; h: number; at: number } | null;
    const textures = new Map<string, Tex>();
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    const load = (el: HTMLElement) => {
      const src = el.dataset.src!;
      if (textures.has(src)) return;
      textures.set(src, null);
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        const tex = gl.createTexture()!;
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        textures.set(src, { tex, w: img.naturalWidth, h: img.naturalHeight, at: performance.now() });
      };
      // phones: big enough for the enlarged middle cover at 2x
      img.src = coarse ? src.replace(/([?&])w=\d+/, '$1w=900').replace(/([?&])h=\d+/, '$1h=1125') : src;
    };
    const get = (el: HTMLElement) => textures.get(el.dataset.src!);

    let lastSig = '';
    // when covers were first put on screen (textures loaded by then show whole)
    let shownSince = -1;
    // when WebGL first drew the column: the edge lens grows in over a moment
    // from then, so taking over from the flat DOM pictures (e.g. coming back
    // to a freshly loaded home) never snaps into the distortion
    let firstDrawnAt = -1;
    const LENS_IN = 380;
    return {
      ready(els: HTMLElement[]) {
        // start every load first (every() would stop at the first missing one)
        els.forEach(load);
        return els.every((el) => !!get(el));
      },
      /** place(i, rect) returns where to draw a cover (top + speed) or null to skip it */
      /** maxElong: the most a cover may lengthen with speed (from the gap
          between covers), so neighbours never touch */
      draw(els: HTMLElement[], hover: number[], place: (i: number, r: DOMRect) => { top: number; speed: number; lens: number; sat: number } | null, maxElong = 0.04) {
        const cr = canvas.getBoundingClientRect();
        // phones draw at 2x (at 1x a 3x screen upscales the covers into pixels)
        const dpr = Math.min(window.devicePixelRatio || 1, coarse ? 2 : 1.5);
        const W = Math.round(cr.width * dpr);
        const H = Math.round(cr.height * dpr);
        if (canvas.width !== W || canvas.height !== H) {
          canvas.width = W;
          canvas.height = H;
        }
        const now = performance.now();
        const since = shownSince < 0 ? now : shownSince;
        type Job = { i: number; t: NonNullable<Tex>; x: number; y: number; w: number; h: number; alpha: number; speed: number; lens: number; sat: number };
        const jobs: Job[] = [];
        let sig = `${W},${H};`;
        els.forEach((el, i) => {
          if (el.classList.contains('is-opening') && !el.classList.contains('is-releasing')) return;
          const r = el.getBoundingClientRect();
          const p = place(i, r);
          if (!p) return;
          if (p.top + r.height < -r.height || p.top > cr.height + r.height) return;
          load(el);
          const t = get(el);
          if (!t) return;
          // covers ready before they're first shown appear whole; one whose
          // picture arrives later fades in over its slot
          const alpha = t.at <= since ? 1 : clamp((now - t.at) / 450);
          // one ramp for the whole column, from WebGL's first frame: a cover
          // that scrolls in later already has the full lens, so it never
          // enters flat and then bends
          if (firstDrawnAt < 0) firstDrawnAt = now;
          const li = clamp((now - firstDrawnAt) / LENS_IN);
          const lensIn = 1 - (1 - li) * (1 - li) * (1 - li); // ease-out cubic
          jobs.push({ i, t, x: r.left - cr.left, y: p.top - cr.top, w: r.width, h: r.height, alpha, speed: p.speed, lens: p.lens * lensIn, sat: p.sat });
          sig += `${i}:${r.left.toFixed(1)},${p.top.toFixed(1)},${r.width.toFixed(1)},${alpha.toFixed(3)},${hover[i].toFixed(3)},${p.speed.toFixed(3)},${(p.lens * lensIn).toFixed(3)},${p.sat.toFixed(3)};`;
        });
        if (jobs.length && shownSince < 0) shownSince = now;
        if (sig === lastSig) return;
        lastSig = sig;

        gl.viewport(0, 0, W, H);
        gl.clearColor(0, 0, 0, 0);
        gl.clear(gl.COLOR_BUFFER_BIT);
        gl.uniform2f(uView, cr.width, cr.height);
        for (const { i, t, x, y, w, h, alpha, speed, lens, sat } of jobs) {
          gl.bindTexture(gl.TEXTURE_2D, t.tex);
          gl.uniform4f(uRect, x, y, w, h);
          gl.uniform2f(uImg, t.w, t.h);
          gl.uniform1f(uHover, hover[i]);
          gl.uniform1f(uAlpha, alpha);
          gl.uniform1f(uSpeed, speed);
          gl.uniform1f(uLens, lens);
          gl.uniform1f(uSat, sat);
          gl.uniform1f(uElong, Math.min(0.12 * speed, maxElong));
          gl.drawElements(gl.TRIANGLES, idx.length, gl.UNSIGNED_SHORT, 0);
        }
        // covers drawn whole hide their DOM pictures in this same frame
        for (const { i, alpha } of jobs) if (alpha >= 1) els[i].classList.add('gl-on');
      },
    };
  }
</script>
