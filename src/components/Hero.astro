---
import Nav from './Nav.astro';
import { stegaClean } from '@sanity/client/stega';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const name: string = stegaClean(settings.name ?? 'Bart Ocieczek').toUpperCase();
const center = (name.length - 1) / 2;
---

<script is:inline>
  // Decide before first paint whether to play the intro, so nothing flashes.
  // It plays on a fresh visit or a reload, but not when you come back to the
  // home page from another page of the site (link click or browser back).
  (function () {
    var skip = false;
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      skip = type === 'back_forward' || (type === 'navigate' && internal);
    } catch (e) {}
    if (!skip && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // Start from the top instead of the restored scroll position
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      document.documentElement.classList.add('is-intro', 'is-scroll-locked');
    }
  })();
</script>

<section class="hero" data-hero>
  <canvas class="hero__dither intro-fade" aria-hidden="true" data-dither style="--delay:0ms"></canvas>

  <div class="hero__inner">
    <div class="intro-fade" style="--delay:0ms">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </div>

    <div class="hero__middle">
      <div class="hero__headline intro-fade intro-rise" style="--delay:90ms">
        {home.badgeLabel && (
          <a class="badge" href={home.badgeUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
            {home.badgeLabel}
          </a>
        )}
        {home.heroText && <p class="t-subheading">{home.heroText}</p>}
      </div>
      {home.heroVideoUrl && (
        <div class="hero__video">
          <video src={home.heroVideoUrl} autoplay muted playsinline preload="auto" data-intro-video />
        </div>
      )}
    </div>

    <div class="hero__bottom">
      <div class="hero__meta intro-fade" style="--delay:180ms">
        <span class="t-label">{home.established}</span>
        <span class="t-label">{home.location}</span>
      </div>
      <h1 class="hero__name" data-fit aria-label={name}>
        {[...name].map((ch, i) => (
          <span class="hero__char" aria-hidden="true" style={`--d:${Math.round(Math.abs(i - center) * 45)}ms`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    background: var(--surface-dark);
    overflow: clip;
    z-index: 1;
    padding: var(--gutter);
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__middle {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }
  .hero__headline {
    width: 504px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }
  .hero__video {
    width: 30%;
    align-self: flex-start;
  }
  .hero__video video {
    position: relative;
    z-index: 5;
    width: clamp(160px, 14.35vw, 320px);
    aspect-ratio: 1.43;
    object-fit: cover;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
  }
  .hero__meta .t-label {
    color: var(--text-secondary);
  }
  .hero__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17.6vw;
    line-height: 0.82;
    letter-spacing: 0;
    white-space: nowrap;
    display: flex;
    width: max-content;
    margin-bottom: -0.06em;
  }
  .hero__char {
    display: inline-block;
    color: transparent;
    background: linear-gradient(180deg, #c4c4c4 0%, #8f8f8f 70%, #6c6c6c 100%);
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ---------- Intro / preloader (recreated from the Framer site) ----------
     1. The video tile rises into the centre of an empty dark screen.
     2. It plays for a moment, then shrinks and flies to its spot in the hero.
     3. Meanwhile the rest of the hero fades in and the letters rise from the
        centre outwards. Scroll is locked until the tile has landed. */
  :global(html.is-intro) .intro-fade {
    opacity: 0;
  }
  :global(html.is-intro) .intro-rise {
    transform: translateY(10px);
  }
  /* 1% instead of 0 so the browser counts the name as painted from the first
     frame (otherwise Lighthouse reports NO_LCP). Invisible on the dark background. */
  :global(html.is-intro) .hero__char {
    opacity: 0.01;
    transform: translateY(0.3em);
  }
  :global(html.is-intro) .hero__video video {
    opacity: 0;
  }
  .hero.is-ready .intro-fade {
    opacity: 1;
    transform: none;
    transition: opacity 0.7s var(--ease-out), transform 0.7s var(--ease-out);
    transition-delay: var(--delay, 0ms);
  }
  .hero.is-ready .hero__dither {
    transition-duration: 1.2s;
  }
  /* Letters rise from the centre outwards */
  .hero.is-ready .hero__char {
    opacity: 1;
    transform: none;
    transition: opacity 0.9s var(--ease-out), transform 1.1s var(--ease-expo);
    transition-delay: calc(120ms + var(--d));
  }
  /* Safety net: if the intro script never runs, show everything anyway */
  :global(html.is-intro) .hero:not(.is-ready) .intro-fade,
  :global(html.is-intro) .hero:not(.is-ready) .hero__char,
  :global(html.is-intro) .hero:not(.is-ready) .hero__video video {
    animation: intro-fallback 0.6s 4.5s forwards;
  }
  @keyframes intro-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(html.is-scroll-locked),
  :global(html.is-scroll-locked body) {
    overflow: hidden;
  }
  @media (max-width: 809px) {
    .hero__middle {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .hero__video {
      width: auto;
    }
    .hero__headline .t-subheading {
      font-size: 22px;
    }
  }
</style>

<script>
  // Make "BART OCIECZEK" exactly fill the content width
  const fit = () => {
    document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const parent = el.parentElement!;
      el.style.fontSize = '100px';
      const ratio = parent.clientWidth / el.getBoundingClientRect().width;
      el.style.fontSize = `${Math.floor(100 * ratio * 10) / 10}px`;
    });
  };
  document.fonts.ready.then(fit);
  window.addEventListener('resize', fit);
  fit();

  // ---------- Intro ----------
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;
  const finishIntro = () => {
    root.classList.remove('is-scroll-locked');
    document.dispatchEvent(new CustomEvent('intro:done'));
  };
  const video = document.querySelector<HTMLVideoElement>('[data-intro-video]');

  if (hero && root.classList.contains('is-intro') && video) {
    // Timeline (ms) — entrance and flight match the Framer original:
    //   0–900     tile rises and fades into the centre
    //   900–1700  holds while the reel plays
    //   1700–2700 travels to its slot; hero content starts at ~35% of the trip
    const easeOut = 'cubic-bezier(0.23, 1, 0.32, 1)';
    const easeInOut = 'cubic-bezier(0.77, 0, 0.175, 1)';
    const ENTER = 900;
    const HOLD = 800;
    const FLY = 1000;

    const r = video.getBoundingClientRect();
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    // Size of the tile while it sits in the middle (22.4% of the width on desktop, like on Framer)
    const centreWidth = vw < 810 ? vw * 0.7 : vw * 0.224;
    const s = centreWidth / r.width;
    const dx = vw / 2 - (r.left + r.width / 2);
    const dy = vh / 2 - (r.top + r.height / 2);
    const centred = `translate(${dx}px, ${dy}px) scale(${s})`;
    const lift = r.height * s * 0.25;

    video.style.opacity = '1';
    // 1. Entrance: rises into the centre while fading in
    video.animate(
      [
        { transform: `translate(${dx}px, ${dy + lift}px) scale(${s})`, opacity: 0 },
        { opacity: 1, offset: 0.6 },
        { transform: centred, opacity: 1 },
      ],
      { duration: ENTER, easing: easeOut, fill: 'both' },
    );
    // 2–3. Hold, then travel to the hero slot (on-screen movement → ease-in-out)
    video
      .animate([{ transform: centred }, { transform: 'none' }], {
        duration: FLY,
        delay: ENTER + HOLD,
        easing: easeInOut,
        fill: 'both',
      })
      .finished.then(() => {
        video.getAnimations().forEach((a) => a.cancel());
        finishIntro();
      });

    setTimeout(() => hero.classList.add('is-ready'), ENTER + HOLD + FLY * 0.35);
  } else {
    hero?.classList.add('is-ready');
    root.classList.remove('is-intro');
    finishIntro();
  }


  // ASCII cursor field (inspired by dovetail.com): an invisible grid of
  // monospace characters lights up around the pointer, flickers, and fades
  // out behind it, with the odd faint character twinkling in the background.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const CHARS = '0123.:*%+-=<>/|_';
    const CELL_W = 16;
    const CELL_H = 16;
    const RADIUS = 170;
    const DECAY = 0.955;
    const COLOR = '223, 223, 223';
    let cols = 0;
    let rows = 0;
    let energy = new Float32Array(0);
    let glyph = new Uint8Array(0);
    let dpr = 1;
    let visible = true;
    let lastPoint: { x: number; y: number } | null = null;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H);
      energy = new Float32Array(cols * rows);
      glyph = new Uint8Array(cols * rows).map(() => (Math.random() * CHARS.length) | 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // Light up cells in a ragged circle around a point
    const stamp = (px: number, py: number) => {
      const c0 = Math.max(0, Math.floor((px - RADIUS) / CELL_W));
      const c1 = Math.min(cols - 1, Math.ceil((px + RADIUS) / CELL_W));
      const r0 = Math.max(0, Math.floor((py - RADIUS) / CELL_H));
      const r1 = Math.min(rows - 1, Math.ceil((py + RADIUS) / CELL_H));
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          const dx = c * CELL_W + CELL_W / 2 - px;
          const dy = r * CELL_H + CELL_H / 2 - py;
          const d = Math.sqrt(dx * dx + dy * dy) / RADIUS;
          if (d >= 1) continue;
          // sparse, noisy fill so it reads as scattered glyphs, not a solid disc
          if (Math.random() > 0.55 + (1 - d) * 0.25) continue;
          const v = Math.pow(1 - d, 1.4) * (0.55 + Math.random() * 0.45);
          const i = r * cols + c;
          if (v > energy[i]) energy[i] = v;
        }
      }
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        if (y < -RADIUS || y > rect.height + RADIUS) {
          lastPoint = null;
          return;
        }
        // fill the gap between fast pointer moves so the trail stays continuous
        if (lastPoint) {
          const dist = Math.hypot(x - lastPoint.x, y - lastPoint.y);
          const steps = Math.min(8, Math.floor(dist / 40));
          for (let k = 1; k <= steps; k++) {
            stamp(lastPoint.x + ((x - lastPoint.x) * k) / (steps + 1), lastPoint.y + ((y - lastPoint.y) * k) / (steps + 1));
          }
        }
        stamp(x, y);
        lastPoint = { x, y };
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => (lastPoint = null));

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    let last = 0;
    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 40) return;
      last = now;

      // ambient twinkle: a couple of faint characters appear at random
      for (let k = 0; k < 2; k++) {
        const i = (Math.random() * energy.length) | 0;
        energy[i] = Math.max(energy[i], 0.12 + Math.random() * 0.12);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = `500 12px 'Chivo Mono', ui-monospace, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let i = 0; i < energy.length; i++) {
        const v = energy[i];
        if (v < 0.02) {
          energy[i] = 0;
          continue;
        }
        // lit characters flicker to a new glyph now and then
        if (Math.random() < 0.06) glyph[i] = (Math.random() * CHARS.length) | 0;
        const c = i % cols;
        const r = (i / cols) | 0;
        ctx.fillStyle = `rgba(${COLOR}, ${(v * 0.6).toFixed(3)})`;
        ctx.fillText(CHARS[glyph[i]], c * CELL_W + CELL_W / 2, r * CELL_H + CELL_H / 2);
        energy[i] = v * DECAY;
      }
    };
    requestAnimationFrame(draw);
  }
</script>
