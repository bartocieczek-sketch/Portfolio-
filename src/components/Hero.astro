---
import Nav from './Nav.astro';
import { urlFor } from '../lib/sanity';
import { href } from '../lib/preview';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');

// biome-ignore lint/suspicious/noExplicitAny: GROQ projection
const projects = (home.projects ?? []).filter((p: any) => p?.cover?.asset).map((p: any) => ({
  title: (p.cardTitle || p.title || '').trim(),
  meta: [p.year, ...(p.cardTags ?? []).slice(0, 1)].filter(Boolean).join(' · '),
  href: href(Astro.locals, `/${p.slug}`),
  src: urlFor(p.cover).width(1000).height(1250).fit('crop').quality(82).url(),
}));
---

<script is:inline>
  // Decide before first paint whether to play the intro, so nothing flashes.
  // It plays on a fresh visit or a reload, but not when you come back to the
  // home page from another page of the site (link click or browser back).
  (function () {
    var skip = false;
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var type = nav ? nav.type : 'navigate';
      var internal = !!document.referrer && new URL(document.referrer).origin === location.origin;
      skip = type === 'back_forward' || (type === 'navigate' && internal);
    } catch (e) {}
    try {
      // a case study cover is flying back to its card: hide the rest until it lands
      if (sessionStorage.getItem('vt-return') && window.innerWidth >= 810 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('is-returning');
      }
    } catch (e) {}
    if (!skip && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);
      document.documentElement.classList.add('is-intro');
    }
  })();
</script>

<section class="hero" data-hero>
  <div class="hero__sticky" data-hero-sticky>
    <canvas class="hero__dither" aria-hidden="true" data-dither></canvas>

    <div class="hero__nav intro-item" style="--delay:0ms">
      <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />
    </div>

    <div class="hero__text">
      {home.badgeLabel && (
        <a class="badge intro-item" href={home.badgeUrl} target="_blank" rel="noopener" style="--delay:80ms">
          <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
          {home.badgeLabel}
        </a>
      )}
      {home.heroText && <h1 class="hero__statement intro-item" style="--delay:140ms">{home.heroText}</h1>}
    </div>

    <div class="hero__carousel" data-carousel>
      <ol class="hero__track" data-track>
        {projects.map((p: any, i: number) => (
          <li class="hcard" data-card>
            <a class="hcard__link" href={p.href}>
              <span class="hcard__media" data-media data-src={p.src}>
                <img src={p.src} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
              </span>
              <span class="hcard__info">
                <span class="hcard__num t-label-small">{pad(i + 1)}</span>
                <span class="hcard__title">{p.title}</span>
                <span class="hcard__meta t-label-small">{p.meta}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </div>

    <div class="hero__foot intro-item" style="--delay:500ms">
      <span class="t-label-small muted">{home.established}</span>
      <span class="hero__progress" aria-hidden="true"><span data-progress></span></span>
      <span class="t-label-small muted">{home.location}</span>
    </div>

    <canvas class="hero__gl" aria-hidden="true" data-gl></canvas>

    <span class="hero__cursor t-label-small" data-hero-cursor aria-hidden="true">View case</span>
  </div>
</section>

<style>
  /* Pinned while the vertical scroll drives the carousel sideways. The height
     is set from the track width in the script; this is the fallback. */
  .hero {
    position: relative;
    height: 320vh;
    background: var(--surface-dark);
  }
  .hero__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    overflow: clip;
    padding: var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__nav {
    position: relative;
    z-index: 4;
    padding: 0 var(--gutter);
  }
  .hero__text {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    padding: 0 var(--gutter);
  }
  .hero__statement {
    margin: 0;
    max-width: 560px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: clamp(22px, 1.9vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }

  /* ---------- Carousel ---------- */
  .hero__carousel {
    position: relative;
    z-index: 2;
    flex: 1;
    min-height: 0;
    display: flex;
    align-items: center;
  }
  .hero__track {
    --card-h: min(100%, 56vh);
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
    will-change: transform;
  }
  .hcard {
    flex: none;
    height: 100%;
    display: flex;
    align-items: center;
  }
  .hcard__link {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hcard__media {
    position: relative;
    display: block;
    height: calc(var(--track-h, 56vh) - 40px);
    aspect-ratio: 0.8;
    overflow: hidden;
    background: #222;
  }
  .hcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }
  /* With WebGL running, the canvas draws the images; the DOM ones keep layout */
  .hero.has-gl .hcard__media {
    background: none;
  }
  .hero.has-gl .hcard__media img {
    opacity: 0;
  }
  .hero.has-gl .hcard.is-opening .hcard__media img {
    opacity: 1;
  }
  .hcard__info {
    /* as wide as the image, never wider */
    width: 0;
    min-width: 100%;
    display: grid;
    grid-template-columns: 28px 1fr auto;
    align-items: baseline;
    gap: 10px;
  }
  .hcard__num,
  .hcard__meta {
    color: var(--text-secondary);
  }
  .hcard__meta {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 22ch;
  }
  .hcard__title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 17px;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (hover: hover) and (pointer: fine) {
    .hero:not(.has-gl) .hcard__link:hover img {
      transform: scale(1.04);
    }
  }
  .hcard__link:active .hcard__media {
    transform: scale(0.98);
    transition: transform 0.16s var(--ease-out);
  }
  .hero__gl {
    z-index: 3;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* While a cover flies to its case study, everything else steps back */
  .hero.is-flying :is(.hero__text, .hero__foot, .hcard__info) {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .hero.is-flying .hero__cursor {
    display: none;
  }
  :global(html.is-returning) .hero :is(.hero__text, .hero__foot, .hcard__info) {
    opacity: 0;
  }
  :global(html.is-returning) .hero .hcard__media img {
    opacity: 0;
  }

  /* ---------- Foot ---------- */
  .hero__foot {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    padding: 0 var(--gutter);
  }
  .hero__progress {
    position: relative;
    width: 160px;
    height: 1px;
    background: var(--line);
    overflow: hidden;
  }
  .hero__progress span {
    position: absolute;
    inset: 0;
    background: var(--text-primary);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* ---------- Cursor ---------- */
  .hero__cursor {
    position: absolute;
    z-index: 5;
    left: 0;
    top: 0;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--text-primary);
    color: var(--surface-dark);
    pointer-events: none;
    opacity: 0;
    transform: translate3d(-100px, -100px, 0) scale(0.9);
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }
  .hero__cursor.is-on {
    opacity: 1;
  }
  @media (hover: none), (pointer: coarse) {
    .hero__cursor {
      display: none;
    }
  }

  /* ---------- Intro ---------- */
  :global(html.is-intro) .intro-item {
    opacity: 0;
    transform: translateY(14px);
  }
  /* 1% instead of 0 so the browser counts the h1 as painted from the first
     frame (otherwise Lighthouse reports NO_LCP). */
  :global(html.is-intro) .hero__statement {
    opacity: 0.01;
  }
  :global(html.is-intro) .hero:not(.is-ready) .hcard {
    opacity: 0;
  }
  .hero.is-ready .intro-item {
    opacity: 1;
    transform: none;
    transition: opacity 0.8s var(--ease-out), transform 1s var(--ease-expo);
    transition-delay: var(--delay, 0ms);
  }
  .hero.is-settled .intro-item {
    transition: none;
  }
  :global(html.is-intro) .hero:not(.is-ready) :is(.intro-item, .hcard) {
    animation: intro-fallback 0.6s 3s forwards;
  }
  @keyframes intro-fallback {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 809px) {
    .hero__sticky {
      gap: 20px;
    }
    .hero__track {
      gap: 12px;
    }
    .hcard__info {
      grid-template-columns: 24px 1fr;
    }
    .hcard__meta {
      display: none;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const root = document.documentElement;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const EASE_EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

  const sticky = document.querySelector<HTMLElement>('[data-hero-sticky]');
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = document.querySelector<HTMLElement>('[data-track]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const medias = cards.map((c) => c.querySelector<HTMLElement>('[data-media]')!);

  // ---------- Intro: cards sweep in from the right, one after another ----------
  if (hero && root.classList.contains('is-intro')) {
    requestAnimationFrame(() => {
      hero.classList.add('is-ready');
      cards.forEach((c, i) => {
        c.animate(
          [
            { transform: `translate3d(${window.innerWidth * 0.7}px, 0, 0)`, opacity: 0 },
            { opacity: 1, offset: 0.3 },
            { transform: 'translate3d(0, 0, 0)', opacity: 1 },
          ],
          { duration: 1300, delay: 260 + i * 70, easing: EASE_EXPO, fill: 'backwards' },
        );
      });
    });
    window.setTimeout(() => {
      hero.classList.add('is-settled');
      root.classList.remove('is-intro');
    }, 2200);
  } else {
    hero?.classList.add('is-ready', 'is-settled');
    root.classList.remove('is-intro');
  }
  document.dispatchEvent(new CustomEvent('intro:done'));

  if (hero && sticky && carousel && track && cards.length) {
    // ---------- Layout: vertical scroll → horizontal travel ----------
    // First card starts centred, last card ends centred.
    let vw = 0;
    let vh = 0;
    let startX = 0;
    let travel = 0;
    const measure = () => {
      vw = window.innerWidth;
      vh = window.innerHeight;
      track.style.setProperty('--track-h', `${carousel.clientHeight}px`);
      const cw = medias[0].offsetWidth;
      const tw = track.scrollWidth;
      startX = vw / 2 - cw / 2;
      travel = Math.max(0, tw - cw);
      hero.style.height = `${vh + travel * 1.1 + vh * 0.25}px`;
    };

    const progressEl = hero.querySelector<HTMLElement>('[data-progress]');
    const cursor = hero.querySelector<HTMLElement>('[data-hero-cursor]');
    const ptr = { x: -200, y: -200, cx: -200, cy: -200 };
    let hovered = -1;
    if (finePointer) {
      window.addEventListener(
        'pointermove',
        (e) => {
          ptr.x = e.clientX;
          ptr.y = e.clientY;
        },
        { passive: true },
      );
      cards.forEach((c, i) => {
        c.addEventListener('pointerenter', () => (hovered = i));
        c.addEventListener('pointerleave', () => hovered === i && (hovered = -1));
      });
    }

    // ---------- WebGL: images drawn as soft, bendable planes ----------
    const gl = reduceMotion ? null : setupGL(sticky.querySelector<HTMLCanvasElement>('[data-gl]')!);
    if (gl) hero.classList.add('has-gl');

    let x = 0;
    let lastX = 0;
    let vel = 0;
    let visible = true;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(hero);
    const hover = cards.map(() => 0);

    // ---------- Opening a project: the cover flies to its spot on the case page ----------
    // Drawn by the same WebGL planes, so it bends and splits with its own speed
    // exactly like the carousel does on scroll. When it lands, the case study
    // page replaces this one underneath it with no visible cut.
    const FLY_MS = 950;
    type Rect = { left: number; top: number; width: number; height: number; right: number };
    let flight: null | { i: number; from: Rect; to: Rect; start: number; cx: number; cy: number; href: string; done: boolean; back: boolean } = null;
    const flyState = { i: -1, rect: { left: 0, top: 0, width: 0, height: 0, right: 0 }, bx: 0, by: 0, others: 1 };
    const easeInOut = (t: number) => (t < 0.5 ? 8 * t ** 4 : 1 - (-2 * t + 2) ** 4 / 2);
    // Where the cover sits on a case study page (see [slug].astro): first cell of
    // the 2-column gallery that takes 65% (60% below 1200px) of the content width
    const caseCoverRect = (): Rect | null => {
      const cw = document.documentElement.clientWidth;
      if (cw < 810) return null;
      const navEl = hero.querySelector<HTMLElement>('.hero__nav > *');
      if (!navEl) return null;
      const nr = navEl.getBoundingClientRect();
      const g = nr.left;
      const top = g + nr.height + 32;
      const galleryW = (cw - 2 * g) * (cw >= 1200 ? 0.65 : 0.6);
      const w = (galleryW - 12) / 2;
      return { left: g, top, width: w, height: w / 0.8, right: g + w };
    };

    const frame = () => {
      requestAnimationFrame(frame);
      if (flight) {
        const now = performance.now();
        const t = clamp((now - flight.start) / FLY_MS);
        const e = easeInOut(t);
        const { from, to } = flight;
        const r = {
          left: from.left + (to.left - from.left) * e,
          top: from.top + (to.top - from.top) * e,
          width: from.width + (to.width - from.width) * e,
          height: from.height + (to.height - from.height) * e,
          right: 0,
        };
        r.right = r.left + r.width;
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        flyState.bx += (clamp((cx - flight.cx) / 30, -1, 1) - flyState.bx) * 0.25;
        flyState.by += (clamp((cy - flight.cy) / 30, -1, 1) - flyState.by) * 0.25;
        flight.cx = cx;
        flight.cy = cy;
        flyState.i = flight.i;
        flyState.rect = r;
        // leaving: the other cards fade out early; coming back: they fade in late
        flyState.others = flight.back ? clamp((t - 0.45) / 0.55) : 1 - clamp(t / 0.35);
        hover[flight.i] *= 0.85;
        if (gl) gl.draw(medias, 0, hover, flyState);
        if (t >= 1 && flight.back) {
          flight = null;
          hero.classList.remove('is-flying');
          root.classList.remove('is-returning');
          (window as unknown as { lenis?: { start(): void } }).lenis?.start();
          return;
        }
        if (t >= 1 && !flight.done) {
          flight.done = true;
          try {
            sessionStorage.setItem('vt-card', 'gl');
          } catch (err) {}
          window.location.href = flight.href;
        }
        return;
      }
      if (!visible) return;
      const hr = hero.getBoundingClientRect();
      const range = hero.offsetHeight - vh;
      const p = clamp(-hr.top / (range || 1));
      // a short hold at both ends so the first and last card can be read
      const q = clamp((p - 0.04) / 0.86);
      x = startX - travel * q;
      track.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0)`;
      if (progressEl) progressEl.style.transform = `scaleX(${q.toFixed(4)})`;

      // horizontal speed of the track → how much the images bend
      vel += (x - lastX - vel) * 0.18;
      lastX = x;
      const bend = clamp(vel / 45, -1, 1);

      for (let i = 0; i < cards.length; i++) hover[i] += ((hovered === i ? 1 : 0) - hover[i]) * 0.12;
      if (gl) gl.draw(medias, bend, hover);

      if (cursor && finePointer) {
        const pinned = hr.bottom >= vh - 1;
        const on = pinned && hovered >= 0;
        cursor.classList.toggle('is-on', on);
        ptr.cx += (ptr.x - ptr.cx) * 0.2;
        ptr.cy += (ptr.y - ptr.cy) * 0.2;
        cursor.style.transform = `translate3d(${(ptr.cx + 14).toFixed(1)}px, ${(ptr.cy + 14).toFixed(1)}px, 0) scale(${on ? 1 : 0.9})`;
      }
    };

    // Get the case study ready before the click lands: prerender it (Chrome,
    // Edge) or at least prefetch it, so the page is there when the cover arrives
    const warmed = new Set<string>();
    const canPrerender = (HTMLScriptElement as unknown as { supports?: (t: string) => boolean }).supports?.('speculationrules');
    const warm = (href: string) => {
      if (warmed.has(href)) return;
      warmed.add(href);
      if (canPrerender) {
        const sr = document.createElement('script');
        sr.type = 'speculationrules';
        sr.textContent = JSON.stringify({ prerender: [{ source: 'list', urls: [href] }] });
        document.head.append(sr);
      } else {
        const l = document.createElement('link');
        l.rel = 'prefetch';
        l.href = href;
        document.head.append(l);
      }
    };
    cards.forEach((c) => {
      const href = c.querySelector<HTMLAnchorElement>('.hcard__link')?.href;
      if (!href) return;
      c.addEventListener('pointerenter', () => warm(href));
      c.addEventListener('pointerdown', () => warm(href));
      c.addEventListener('focusin', () => warm(href));
    });

    // Opening a project: the clicked cover is handed to the view transition
    // so it morphs into the case study's first image
    track.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.hcard__link');
      if (!link || e.defaultPrevented || e.metaKey || e.ctrlKey || e.shiftKey) return;
      const card = link.closest<HTMLElement>('[data-card]');
      const media = link.querySelector<HTMLElement>('[data-media]');
      if (!card || !media) return;
      warm(link.href);
      const target = gl ? caseCoverRect() : null;
      if (target && !flight) {
        e.preventDefault();
        const from = media.getBoundingClientRect();
        flight = {
          i: medias.indexOf(media),
          from: { left: from.left, top: from.top, width: from.width, height: from.height, right: from.right },
          to: target,
          start: performance.now(),
          cx: from.left + from.width / 2,
          cy: from.top + from.height / 2,
          href: link.href,
          done: false,
          back: false,
        };
        flyState.bx = 0;
        flyState.by = 0;
        hero.classList.add('is-flying');
        (window as unknown as { lenis?: { stop(): void } }).lenis?.stop();
        return;
      }
      if (!('startViewTransition' in document)) return;
      card.classList.add('is-opening');
      media.style.viewTransitionName = 'project-cover';
      try {
        sessionStorage.setItem('vt-card', '1');
      } catch (err) {}
    });
    // ---------- Coming back from a case study ----------
    // The case page leaves the cover's on-screen box in sessionStorage; the
    // carousel scrolls so that project's card sits in the middle, and the
    // cover flies from where it was back into the card.
    const lenisRef = () => (window as unknown as { lenis?: { stop(): void; start(): void; scrollTo(y: number, o?: object): void } }).lenis;
    const takeReturn = (): { slug: string; rect: Rect } | null => {
      try {
        const raw = sessionStorage.getItem('vt-return');
        sessionStorage.removeItem('vt-return');
        return raw ? JSON.parse(raw) : null;
      } catch (err) {
        return null;
      }
    };
    const startReturn = (keepScroll: boolean) => {
      const ret = takeReturn();
      const i = ret ? cards.findIndex((c) => c.querySelector<HTMLAnchorElement>('.hcard__link')?.pathname.replace(/\/$/, '').endsWith(`/${ret.slug}`)) : -1;
      if (!ret || i < 0 || !gl || document.documentElement.clientWidth < 810) {
        root.classList.remove('is-returning');
        return;
      }
      root.classList.add('is-returning');
      hero.classList.add('is-flying');
      if (!keepScroll && travel > 0) {
        const off = cards[i].offsetLeft;
        const q = clamp(off / travel);
        const y = hero.offsetTop + (0.04 + q * 0.86) * (hero.offsetHeight - vh);
        const l = lenisRef();
        if (l) l.scrollTo(y, { immediate: true, force: true });
        else window.scrollTo(0, y);
      }
      lenisRef()?.stop();
      // let one frame place the track, then measure the card and take off
      flight = null;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => {
          const hr = hero.getBoundingClientRect();
          const p = clamp(-hr.top / (hero.offsetHeight - vh || 1));
          const q = clamp((p - 0.04) / 0.86);
          x = startX - travel * q;
          lastX = x;
          track.style.transform = `translate3d(${x.toFixed(2)}px, 0, 0)`;
          const to = medias[i].getBoundingClientRect();
          const from = { ...ret.rect, right: ret.rect.left + ret.rect.width };
          flyState.bx = 0;
          flyState.by = 0;
          flight = {
            i,
            from,
            to: { left: to.left, top: to.top, width: to.width, height: to.height, right: to.right },
            start: performance.now(),
            cx: from.left + from.width / 2,
            cy: from.top + from.height / 2,
            href: '',
            done: true,
            back: true,
          };
        }),
      );
    };

    window.addEventListener('pageshow', (e) => {
      flight = null;
      hero.classList.remove('is-flying');
      lenisRef()?.start();
      track.querySelectorAll<HTMLElement>('[data-media]').forEach((m) => (m.style.viewTransitionName = ''));
      track.querySelectorAll('.is-opening').forEach((c) => c.classList.remove('is-opening'));
      // restored from the back/forward cache: the scroll is already where it was
      if ((e as PageTransitionEvent).persisted) startReturn(true);
    });

    measure();
    requestAnimationFrame(frame);
    startReturn(false);
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
  }

  /* A tiny WebGL renderer: one subdivided plane per card, positioned over the
     card's DOM box every frame. The vertex shader bows the plane against the
     direction of travel (like cloth dragged through air); the fragment shader
     adds a slight wave and colour split proportional to the speed, plus a
     gentle zoom on hover. */
  type Fly = {
    i: number;
    rect: { left: number; top: number; width: number; height: number; right: number };
    bx: number;
    by: number;
    others: number;
  };
  function setupGL(canvas: HTMLCanvasElement) {
    const gl = canvas.getContext('webgl', { alpha: true, premultipliedAlpha: true, antialias: true });
    if (!gl) return null;

    const vs = `
      precision highp float;
      attribute vec2 aPos;
      uniform vec4 uRect;   // x, y, w, h in CSS px, relative to the canvas
      uniform vec2 uView;
      uniform float uBend;
      uniform float uBendY;
      varying vec2 vUv;
      void main() {
        vUv = aPos;
        vec2 p = uRect.xy + aPos * uRect.zw;
        // bow sideways, most in the middle rows, trailing the motion
        float bow = sin(aPos.y * 3.14159265);
        p.x += bow * uBend * uRect.z * 0.09;
        // corners lift a touch so it reads as a soft sheet, not a skew
        p.y += (sin(aPos.x * 3.14159265) - 0.5) * abs(uBend) * uRect.w * 0.035;
        // same bow vertically when the sheet travels up or down
        p.y += sin(aPos.x * 3.14159265) * uBendY * uRect.w * 0.09;
        p.x += (sin(aPos.y * 3.14159265) - 0.5) * abs(uBendY) * uRect.z * 0.035;
        vec2 clip = p / uView * 2.0 - 1.0;
        gl_Position = vec4(clip.x, -clip.y, 0.0, 1.0);
      }`;
    // uniforms shared with the vertex shader must have the same precision
    const fs = `
      #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
      #else
      precision mediump float;
      #endif
      uniform sampler2D uTex;
      uniform vec2 uImg;
      uniform vec4 uRect;
      uniform float uBend;
      uniform float uHover;
      uniform float uAlpha;
      uniform float uTime;
      varying vec2 vUv;
      vec2 cover(vec2 uv) {
        float rs = uRect.z / uRect.w;
        float ri = uImg.x / uImg.y;
        vec2 s = rs < ri ? vec2(rs / ri, 1.0) : vec2(1.0, ri / rs);
        return (uv - 0.5) * s + 0.5;
      }
      void main() {
        vec2 uv = cover(vUv);
        uv = (uv - 0.5) * (1.0 - 0.06 * uHover) + 0.5;
        float a = abs(uBend);
        uv.x += sin(vUv.y * 9.0 + uTime * 2.0) * 0.012 * a;
        uv.y += sin(vUv.x * 7.0 + uTime * 1.6) * 0.008 * a;
        float split = 0.012 * uBend;
        float r = texture2D(uTex, uv + vec2(split, 0.0)).r;
        vec4 g = texture2D(uTex, uv);
        float b = texture2D(uTex, uv - vec2(split, 0.0)).b;
        gl_FragColor = vec4(r, g.g, b, 1.0) * uAlpha;
      }`;
    const compile = (type: number, src: string) => {
      const sh = gl.createShader(type)!;
      gl.shaderSource(sh, src);
      gl.compileShader(sh);
      return sh;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return null;
    gl.useProgram(prog);

    // 32×32 grid so the bend is smooth
    const SEG = 32;
    const verts: number[] = [];
    for (let j = 0; j <= SEG; j++) for (let i = 0; i <= SEG; i++) verts.push(i / SEG, j / SEG);
    const idx: number[] = [];
    for (let j = 0; j < SEG; j++)
      for (let i = 0; i < SEG; i++) {
        const a = j * (SEG + 1) + i;
        idx.push(a, a + 1, a + SEG + 1, a + 1, a + SEG + 2, a + SEG + 1);
      }
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array(verts), gl.STATIC_DRAW);
    const aPos = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(aPos);
    gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);
    gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, new Uint16Array(idx), gl.STATIC_DRAW);

    const u = (n: string) => gl.getUniformLocation(prog, n);
    const uRect = u('uRect');
    const uView = u('uView');
    const uBend = u('uBend');
    const uBendY = u('uBendY');
    const uHover = u('uHover');
    const uAlpha = u('uAlpha');
    const uImg = u('uImg');
    const uTime = u('uTime');
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    type Tex = { tex: WebGLTexture; w: number; h: number } | null;
    const textures = new Map<HTMLElement, Tex>();
    const load = (el: HTMLElement) => {
      if (textures.has(el)) return;
      textures.set(el, null);
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        const tex = gl.createTexture()!;
        gl.bindTexture(gl.TEXTURE_2D, tex);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
        gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
        gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
        textures.set(el, { tex, w: img.naturalWidth, h: img.naturalHeight });
      };
      img.src = el.dataset.src!;
    };

    let dpr = 1;
    const t0 = performance.now();
    return {
      draw(els: HTMLElement[], bend: number, hover: number[], fly?: Fly | null) {
        const cr = canvas.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        const W = Math.round(cr.width * dpr);
        const H = Math.round(cr.height * dpr);
        if (canvas.width !== W || canvas.height !== H) {
          canvas.width = W;
          canvas.height = H;
        }
        gl.viewport(0, 0, W, H);
        gl.clearColor(0, 0, 0, 0);
        gl.clear(gl.COLOR_BUFFER_BIT);
        gl.uniform2f(uView, cr.width, cr.height);
        gl.uniform1f(uTime, (performance.now() - t0) / 1000);
        els.forEach((el, i) => {
          let r: { left: number; top: number; width: number; height: number; right: number } = el.getBoundingClientRect();
          // the card being opened by the view-transition fallback shows its DOM image
          if (el.closest('.is-opening')) return;
          let bx = bend;
          let by = 0;
          let fade = 1;
          if (fly) {
            if (i === fly.i) {
              r = fly.rect;
              bx = fly.bx;
              by = fly.by;
            } else fade = fly.others;
          }
          if (fade <= 0.001 || r.right < cr.left - 200 || r.left > cr.right + 200) return;
          load(el);
          const t = textures.get(el);
          if (!t) return;
          const alpha = Number(getComputedStyle(el.closest('[data-card]')!).opacity) * fade;
          if (alpha <= 0.001) return;
          gl.bindTexture(gl.TEXTURE_2D, t.tex);
          gl.uniform4f(uRect, r.left - cr.left, r.top - cr.top, r.width, r.height);
          gl.uniform2f(uImg, t.w, t.h);
          gl.uniform1f(uHover, hover[i]);
          gl.uniform1f(uBend, bx);
          gl.uniform1f(uBendY, by);
          gl.uniform1f(uAlpha, alpha);
          gl.drawElements(gl.TRIANGLES, idx.length, gl.UNSIGNED_SHORT, 0);
        });
      },
    };
  }

  // ASCII cursor field (inspired by dovetail.com): an invisible grid of
  // monospace characters lights up around the pointer, flickers, and fades
  // out behind it, with the odd faint character twinkling in the background.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const CHARS = '0123.:*%+-=<>/|_';
    const CELL_W = 16;
    const CELL_H = 16;
    const RADIUS = 170;
    const DECAY = 0.955;
    const COLOR = '223, 223, 223';
    let cols = 0;
    let rows = 0;
    let energy = new Float32Array(0);
    let glyph = new Uint8Array(0);
    let dpr = 1;
    let visible = true;
    let lastPoint: { x: number; y: number } | null = null;

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / CELL_W);
      rows = Math.ceil(h / CELL_H);
      energy = new Float32Array(cols * rows);
      glyph = new Uint8Array(cols * rows).map(() => (Math.random() * CHARS.length) | 0);
    };
    resize();
    window.addEventListener('resize', resize);

    // Light up cells in a ragged circle around a point
    const stamp = (px: number, py: number) => {
      const c0 = Math.max(0, Math.floor((px - RADIUS) / CELL_W));
      const c1 = Math.min(cols - 1, Math.ceil((px + RADIUS) / CELL_W));
      const r0 = Math.max(0, Math.floor((py - RADIUS) / CELL_H));
      const r1 = Math.min(rows - 1, Math.ceil((py + RADIUS) / CELL_H));
      for (let r = r0; r <= r1; r++) {
        for (let c = c0; c <= c1; c++) {
          const dx = c * CELL_W + CELL_W / 2 - px;
          const dy = r * CELL_H + CELL_H / 2 - py;
          const d = Math.sqrt(dx * dx + dy * dy) / RADIUS;
          if (d >= 1) continue;
          // sparse, noisy fill so it reads as scattered glyphs, not a solid disc
          if (Math.random() > 0.55 + (1 - d) * 0.25) continue;
          const v = Math.pow(1 - d, 1.4) * (0.55 + Math.random() * 0.45);
          const i = r * cols + c;
          if (v > energy[i]) energy[i] = v;
        }
      }
    };

    window.addEventListener(
      'pointermove',
      (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        if (y < -RADIUS || y > rect.height + RADIUS) {
          lastPoint = null;
          return;
        }
        // fill the gap between fast pointer moves so the trail stays continuous
        if (lastPoint) {
          const dist = Math.hypot(x - lastPoint.x, y - lastPoint.y);
          const steps = Math.min(8, Math.floor(dist / 40));
          for (let k = 1; k <= steps; k++) {
            stamp(lastPoint.x + ((x - lastPoint.x) * k) / (steps + 1), lastPoint.y + ((y - lastPoint.y) * k) / (steps + 1));
          }
        }
        stamp(x, y);
        lastPoint = { x, y };
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => (lastPoint = null));

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    let last = 0;
    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 40) return;
      last = now;

      // ambient twinkle: a couple of faint characters appear at random
      for (let k = 0; k < 2; k++) {
        const i = (Math.random() * energy.length) | 0;
        energy[i] = Math.max(energy[i], 0.12 + Math.random() * 0.12);
      }

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.font = `500 12px 'Chivo Mono', ui-monospace, monospace`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      for (let i = 0; i < energy.length; i++) {
        const v = energy[i];
        if (v < 0.02) {
          energy[i] = 0;
          continue;
        }
        // lit characters flicker to a new glyph now and then
        if (Math.random() < 0.06) glyph[i] = (Math.random() * CHARS.length) | 0;
        const c = i % cols;
        const r = (i / cols) | 0;
        ctx.fillStyle = `rgba(${COLOR}, ${(v * 0.6).toFixed(3)})`;
        ctx.fillText(CHARS[glyph[i]], c * CELL_W + CELL_W / 2, r * CELL_H + CELL_H / 2);
        energy[i] = v * DECAY;
      }
    };
    requestAnimationFrame(draw);
  }
</script>
