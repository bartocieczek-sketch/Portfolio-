---
import Nav from './Nav.astro';

interface Props {
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  home: any;
  // biome-ignore lint/suspicious/noExplicitAny: GROQ projection
  settings: any;
}
const { home, settings } = Astro.props;
const name: string = (settings.name ?? 'Bart Ocieczek').toUpperCase();
---

<section class="hero">
  <canvas class="hero__dither" aria-hidden="true" data-dither></canvas>
  <div class="hero__curtain" aria-hidden="true"></div>

  <div class="hero__inner">
    <Nav callUrl={settings.callUrl} socials={settings.socials} role={settings.role} />

    <div class="hero__middle">
      <div class="hero__headline">
        {home.badgeLabel && (
          <a class="badge" href={home.badgeUrl} target="_blank" rel="noopener">
            <svg viewBox="0 0 10 15" width="8" height="12" aria-hidden="true"><path d="M0 0h10v5H5L0 0Zm0 5h5l5 5H5v5L0 10V5Z" fill="currentColor" /></svg>
            {home.badgeLabel}
          </a>
        )}
        {home.heroText && <p class="t-subheading">{home.heroText}</p>}
      </div>
      {home.heroVideoUrl && (
        <div class="hero__video">
          <video src={home.heroVideoUrl} autoplay muted loop playsinline preload="auto" />
        </div>
      )}
    </div>

    <div class="hero__bottom">
      <div class="hero__meta">
        <span class="t-label">{home.established}</span>
        <span class="t-label">{home.location}</span>
      </div>
      <h1 class="hero__name" data-fit aria-label={name}>
        {[...name].map((ch, i) => (
          <span class="hero__char" aria-hidden="true" style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>
        ))}
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    background: var(--surface-dark);
    overflow: clip;
    z-index: 1;
    padding: var(--gutter);
  }
  .hero__dither {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.14;
    pointer-events: none;
  }
  /* Framer "BlackOverlay" + preloader: the page fades in from black */
  .hero__curtain {
    position: absolute;
    inset: 0;
    background: var(--surface-black);
    z-index: 3;
    pointer-events: none;
    animation: curtain 1.1s 0.15s var(--ease-expo) forwards;
  }
  @keyframes curtain {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .hero__middle {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
  }
  .hero__headline {
    width: 504px;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: var(--text-primary);
    color: var(--surface-dark);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 12px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    border-radius: 2px;
  }
  .hero__video {
    width: 30%;
    align-self: flex-start;
  }
  .hero__video video {
    width: min(212px, 100%);
    aspect-ratio: 1.43;
    object-fit: cover;
  }
  .hero__bottom {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hero__meta {
    display: flex;
    justify-content: space-between;
  }
  .hero__meta .t-label {
    color: var(--text-secondary);
  }
  .hero__name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 17.6vw;
    line-height: 0.82;
    letter-spacing: 0;
    white-space: nowrap;
    display: flex;
    width: max-content;
    margin-bottom: -0.06em;
  }
  .hero__char {
    display: inline-block;
    color: transparent;
    background: linear-gradient(180deg, #c4c4c4 0%, #8f8f8f 70%, #6c6c6c 100%);
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0;
    transform: translateY(60px);
    animation: char-in 1.5s var(--ease-expo) forwards;
    animation-delay: calc(1.1s + var(--i) * 0.045s);
  }
  @keyframes char-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__char {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 809px) {
    .hero__middle {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .hero__video {
      width: auto;
    }
    .hero__headline .t-subheading {
      font-size: 22px;
    }
  }
</style>

<script>
  // Make "BART OCIECZEK" exactly fill the content width
  const fit = () => {
    document.querySelectorAll<HTMLElement>('[data-fit]').forEach((el) => {
      const parent = el.parentElement!;
      el.style.fontSize = '100px';
      const ratio = parent.clientWidth / el.getBoundingClientRect().width;
      el.style.fontSize = `${Math.floor(100 * ratio * 10) / 10}px`;
    });
  };
  document.fonts.ready.then(fit);
  window.addEventListener('resize', fit);
  fit();

  // Recreation of the Framer "DitherShader" (circle variant): an ordered-dither
  // glow that drifts slowly and ripples where the pointer moves.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-dither]');
  if (canvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = canvas.getContext('2d')!;
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
    const cell = 3; // pixel size of one dither dot in CSS px
    let w = 0;
    let h = 0;
    let img: ImageData;
    const ripples: { x: number; y: number; t: number }[] = [];
    let visible = true;
    let last = 0;

    const resize = () => {
      w = Math.ceil(canvas.clientWidth / cell);
      h = Math.ceil(canvas.clientHeight / cell);
      canvas.width = w;
      canvas.height = h;
      canvas.style.imageRendering = 'pixelated';
      img = ctx.createImageData(w, h);
    };
    resize();
    window.addEventListener('resize', resize);

    let lastRipple = 0;
    window.addEventListener('pointermove', (e) => {
      const now = performance.now();
      if (now - lastRipple < 120) return;
      lastRipple = now;
      const r = canvas.getBoundingClientRect();
      ripples.push({ x: (e.clientX - r.left) / cell, y: (e.clientY - r.top) / cell, t: now });
      if (ripples.length > 6) ripples.shift();
    }, { passive: true });

    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(canvas);

    const draw = (now: number) => {
      requestAnimationFrame(draw);
      if (!visible || now - last < 1000 / 30) return;
      last = now;
      const t = now * 0.0002;
      const cx = w * (0.5 + 0.18 * Math.sin(t * 1.3));
      const cy = h * (0.45 + 0.15 * Math.cos(t));
      const radius = Math.max(w, h) * 0.55;
      const data = img.data;
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const dx = x - cx;
          const dy = y - cy;
          let v = 1 - Math.sqrt(dx * dx + dy * dy) / radius;
          v = v * v * 0.75 + 0.06 * Math.sin(x * 0.07 + y * 0.05 + t * 8);
          for (const rp of ripples) {
            const age = (now - rp.t) / 1000;
            if (age > 2) continue;
            const d = Math.hypot(x - rp.x, y - rp.y);
            const ring = Math.abs(d - age * 60);
            if (ring < 3) v += (1 - ring / 3) * 0.4 * (1 - age / 2);
          }
          // fade the edges
          const edge = Math.min(x, y, w - x, h - y) / (Math.min(w, h) * 0.55);
          v *= Math.min(1, edge);
          const on = v > bayer[(y & 3) * 4 + (x & 3)];
          const i = (y * w + x) * 4;
          data[i] = data[i + 1] = data[i + 2] = 223;
          data[i + 3] = on ? 255 : 0;
        }
      }
      ctx.putImageData(img, 0, 0);
    };
    requestAnimationFrame(draw);
  }
</script>
